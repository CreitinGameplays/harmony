// harmony-base - the `audit` command (docs/harmony.md 13.6, 13.8).
//
// `harmony-base audit <file>` lists every `unchecked` site in one input:
// each `unchecked("reason") { ... }` block and each `unchecked("contract") fn`
// (13.1). Nothing here is type-checked - audit is a read-only report, so it
// runs the lexer and parser only. The listing is a pure function of the source
// (deterministic), which is what makes it usable as a CI gate (13.8).
//
// With no input the listing is empty; that is the "no project to audit" case
// the driver tests and the golden fixture pin.

// Per-run counters, filled by the counting pass and read by the printing pass.
int g_audit_sites;    // number of `unchecked` sites
int g_audit_lines;    // total source lines they cover
int g_audit_short;    // reasons under the 12-character floor (UNCK-02)
int g_audit_long;     // blocks longer than 10 lines (UNCK-03 blast radius)
int g_audit_json;     // 1 = --format=json
char* g_audit_path;   // the input path (single module for now)

// The reason string of an `unchecked fn` (stored on the fn node in `c`) or of
// an `unchecked` block (its `sval`).
char* audit_reason(struct AstNode* n) {
    if (n->kind == AST_FN || n->kind == AST_EXTERN_FN) {
        if (n->c != 0) { return n->c->sval; }
        return 0;
    }
    return n->sval;
}

// The line span of a site (end line - start line + 1); 1 when the span is a
// single line. Uses the node's byte span and the source line index.
int audit_span_lines(struct SourceFile* sf, struct AstNode* n) {
    int l0;
    int l1;
    int c;
    l0 = 0;
    l1 = 0;
    c = 0;
    source_line_col(sf, n->start, &l0, &c);
    source_line_col(sf, n->end, &l1, &c);
    if (l1 < l0) { l1 = l0; }
    return l1 - l0 + 1;
}

// Walks the AST and tallies sites (pass 1). Pre-order, so sites come out in
// source order and the counts match the printing pass exactly.
void audit_count(struct AstNode* n, struct SourceFile* sf) {
    int i;
    if (n == 0) { return; }
    if (n->kind == AST_UNCHECKED) {
        int span;
        char* reason;
        reason = audit_reason(n);
        span = audit_span_lines(sf, n);
        g_audit_sites = g_audit_sites + 1;
        g_audit_lines = g_audit_lines + span;
        if (reason == 0 || str_len(reason) < 12) { g_audit_short = g_audit_short + 1; }
        if (span > 10) { g_audit_long = g_audit_long + 1; }
    } else if ((n->kind == AST_FN || n->kind == AST_EXTERN_FN) && (n->ival & 1)) {
        // An `unchecked fn`: its contract is a site too, even though the body
        // is not automatically unchecked (13.4).
        char* reason;
        reason = audit_reason(n);
        g_audit_sites = g_audit_sites + 1;
        g_audit_lines = g_audit_lines + 1;
        if (reason == 0 || str_len(reason) < 12) { g_audit_short = g_audit_short + 1; }
    }
    audit_count(n->a, sf);
    audit_count(n->b, sf);
    audit_count(n->c, sf);
    if (n->kids != 0) {
        i = 0;
        while (i < n->kids->len) { audit_count(n->kids->items[i], sf); i = i + 1; }
    }
    if (n->kids2 != 0) {
        i = 0;
        while (i < n->kids2->len) { audit_count(n->kids2->items[i], sf); i = i + 1; }
    }
}

// Prints one JSON string literal (quoted) with the same minimal escaping the
// rest of the driver uses. A NUL reason prints as "".
void audit_json_str(char* s) {
    int i;
    out_str("\"");
    if (s != 0) {
        i = 0;
        while (s[i] != 0) {
            char c;
            c = s[i];
            if (c == '"') { out_str("\\\""); }
            else if (c == '\\') { out_str("\\\\"); }
            else if (c == 10) { out_str("\\n"); }
            else if (c == 9) { out_str("\\t"); }
            else if (c == 13) { out_str("\\r"); }
            else { out_char(c); }
            i = i + 1;
        }
    }
    out_str("\"");
}

// Prints sites in source order (pass 2). `first` tracks whether a comma is due
// in JSON mode.
int audit_print_walk(struct AstNode* n, struct SourceFile* sf, int first) {
    int i;
    if (n == 0) { return first; }
    if (n->kind == AST_UNCHECKED
        || ((n->kind == AST_FN || n->kind == AST_EXTERN_FN) && (n->ival & 1))) {
        int line;
        int col;
        int span;
        char* reason;
        char* kind;
        line = 0;
        col = 0;
        source_line_col(sf, n->start, &line, &col);
        reason = audit_reason(n);
        if (n->kind == AST_UNCHECKED) {
            kind = "block";
            span = audit_span_lines(sf, n);
        } else {
            kind = "fn";
            span = 1;
        }
        if (g_audit_json) {
            if (!first) { out_str(","); }
            out_str("{");
            out_str("\"file\":");
            audit_json_str(g_audit_path);
            out_str(",\"line\":");
            out_int(line);
            out_str(",\"kind\":");
            audit_json_str(kind);
            out_str(",\"lines\":");
            out_int(span);
            out_str(",\"reason\":");
            audit_json_str(reason);
            out_str("}");
        } else {
            out_str("  ");
            out_str(g_audit_path);
            out_char(':');
            out_int(line);
            out_str("   ");
            out_str(kind);
            out_str("   ");
            if (reason != 0) { out_str(reason); }
            out_nl();
        }
        first = 0;
    }
    first = audit_print_walk(n->a, sf, first);
    first = audit_print_walk(n->b, sf, first);
    first = audit_print_walk(n->c, sf, first);
    if (n->kids != 0) {
        i = 0;
        while (i < n->kids->len) {
            first = audit_print_walk(n->kids->items[i], sf, first);
            i = i + 1;
        }
    }
    if (n->kids2 != 0) {
        i = 0;
        while (i < n->kids2->len) {
            first = audit_print_walk(n->kids2->items[i], sf, first);
            i = i + 1;
        }
    }
    return first;
}

// Prints the header (plain) or the JSON tail, then the sites.
void audit_emit(struct AstNode* root, struct SourceFile* sf) {
    if (g_audit_json) {
        out_str("{\"file\":");
        audit_json_str(g_audit_path);
        out_str(",\"sites\":[");
        audit_print_walk(root, sf, 1);
        out_str("],\"total\":");
        out_int(g_audit_sites);
        out_str(",\"lines\":");
        out_int(g_audit_lines);
        out_str(",\"short\":");
        out_int(g_audit_short);
        out_str(",\"oversized\":");
        out_int(g_audit_long);
        out_str("}");
        out_nl();
        return;
    }
    out_str("unchecked audit - ");
    out_int(g_audit_sites);
    out_str(" sites - ");
    out_int(g_audit_lines);
    out_str(" lines total");
    out_nl();
    if (g_audit_sites > 0) {
        out_nl();
        audit_print_walk(root, sf, 1);
        out_nl();
        out_str("  ");
        out_int(g_audit_short);
        out_str(" sites under 12 characters - ");
        out_int(g_audit_long);
        out_str(" sites over 10 lines");
        out_nl();
    }
}

// `harmony-base audit [file] [--format=json]`. Returns a driver exit code.
int audit_run(struct Options* opts) {
    struct SourceFile sf;
    char* toks;
    struct AstNode* root;
    int n;

    g_audit_json = (opts->format == FORMAT_JSON);

    // No input: nothing to audit. Print the empty listing (the CI gate reads
    // "0 sites" and passes) and exit cleanly.
    if (opts->input == 0) {
        g_audit_path = "";
        g_audit_sites = 0;
        g_audit_lines = 0;
        g_audit_short = 0;
        g_audit_long = 0;
        audit_emit(0, 0);
        return EXIT_OK;
    }

    arena_reset();
    lexbuf_release();
    diag_reset();
    if (source_load(opts->input, &sf) != 0) {
        diag_plain("source.not-found", opts->input);
        return EXIT_USAGE;
    }
    diag_register_file(&sf);

    n = lexer_run(&sf, (struct Token**) &toks);
    if (n < 0) {
        diag_flush(opts->format, opts->all);
        return EXIT_STOP;
    }
    root = parser_run(&sf, (struct Token*) toks, n);
    if (root == 0 || parser_stop_count() > 0) {
        // A file that does not parse has no trustworthy listing; surface the
        // syntax stops instead of a misleading "0 sites" (§19.1 stage 2).
        diag_flush(opts->format, opts->all);
        return EXIT_STOP;
    }

    g_audit_path = opts->input;
    g_audit_sites = 0;
    g_audit_lines = 0;
    g_audit_short = 0;
    g_audit_long = 0;
    audit_count(root, &sf);
    audit_emit(root, &sf);
    return EXIT_OK;
}
