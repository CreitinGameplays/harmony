// harmony-base — the type checker, part 2: expressions
// (docs/harmony.md §7, §5.9, §12).
//
// The parser already built a precedence-shaped tree, so this pass is a
// bottom-up fold: infer each operand's type, check the operator against it,
// and store the result type on the node (`n->ty`). Untyped integer/float
// literals (§5.9) carry CTY_UINT_LIT / CTY_FLOAT_LIT and adapt to whatever
// the context wants, so `let x: u8 = 200;` needs no suffix.
//
// M1 scope: literals, paths, calls (incl. methods), field access, indexing,
// binary/unary operators with trapping semantics, casts, `heap`, `sizeof`,
// struct/array literals, and references. Move/borrow analysis is M2–M3; this
// pass records the types the later analyses will need.

// ---------------------------------------------------------------------------
// Forward declarations (c2x-seed resolves names from earlier text only).
// ---------------------------------------------------------------------------
int ck_coercible(int want, int got);
int ck_expr(struct AstNode* n);
int ck_expr_enum_path(struct AstNode* n);
int ck_expr_path(struct AstNode* n);
int ck_expr_variant_unqualified(struct AstNode* n);
int ck_expr_binary(struct AstNode* n);
int ck_expr_unary(struct AstNode* n);
int ck_expr_field(struct AstNode* n);
int ck_expr_index(struct AstNode* n);
int ck_expr_call(struct AstNode* n);
int ck_expr_generic_call(struct AstNode* n);
int ck_infer_generic_call(struct AstNode* n, struct AstNode* callee, struct AstList* args);
int ck_unify(struct AstNode* tn, int ty);
int ck_expr_method_call(struct AstNode* n, struct AstNode* callee, struct AstList* args);
int ck_expr_assoc_call(struct AstNode* n, struct AstNode* callee, struct AstList* args);
int ck_assoc_call_ty(struct AstNode* n, int ty, char* mname, struct AstList* args);
int ck_enum_construct(struct AstNode* n, struct AstNode* callee, struct AstList* args);
int ck_enum_construct_unqualified(struct AstNode* n, struct AstList* args);
int ck_enum_construct_ty(struct AstNode* n, int ty, char* vname, struct AstList* args);
int ck_argc(struct AstList* args);
int ck_expr_as(struct AstNode* n);
int ck_expr_struct_init(struct AstNode* n);
int ck_expr_array_lit(struct AstNode* n);
int ck_expr_borrow(struct AstNode* n);
int ck_expr_deref(struct AstNode* n);
int ck_expr_raw(struct AstNode* n);
int ck_expr_heap(struct AstNode* n);
int ck_expr_sizeof(struct AstNode* n);

// A raw-pointer operation that is unlocked only inside `unchecked` (§13.2/13.4,
// UNCK-01). Shared by the §13.5 toolbox intrinsics (`p.read`, `p.write`,
// `p.plus`/`p.minus`, `p[i]`).
void ck_raw_needs_unchecked(struct AstNode* at, char* what) {
    if (!ck_in_unchecked()) {
        ck_err_needs_unchecked(at, what);
    }
}

// ---------------------------------------------------------------------------
// Compatibility: does `got` fit where `want` is expected? Untyped literals
// adapt within their class (§5.9); everything else is structural equality.
// ---------------------------------------------------------------------------
int ck_coercible(int want, int got) {
    if (ty_eq(want, got)) { return 1; }
    // `never` (a `trap`/`exit`/`unreachable` expression) coerces to any type
    // (§5.1): control never reaches the point where the value is used.
    if (got == TY_NEVER) { return 1; }
    // A `Heap<T>` borrows to `&T` (§12.2): the box owns the value, so a
    // shared reference to it is always sound.
    if (ty_is_thin_ref(want) && ty_is_heap(got)) {
        if (ty_eq(ty_elem(want), ty_elem(got))) { return 1; }
    }
    // An aggregate place borrows to `&T` at a call site (§10.1): the
    // argument is address-represented, so the borrow is free and sound.
    if (ty_is_thin_ref(want) && ck_is_aggregate(got)) {
        if (ty_eq(ty_elem(want), got)) { return 1; }
    }
    // `raw mut T` coerces to `raw T`: discarding write capability is always
    // sound (§13.5). The reverse is not allowed — that would add a power.
    if (ty_kind(want) == CTY_PTR && ty_kind(got) == CTY_MUTPTR) {
        if (ty_eq(ty_elem(want), ty_elem(got))) { return 1; }
    }
    // Widening integer conversions are explicit-only (§5.8): no implicit
    // widening, no implicit sign change. Only the untyped-literal rules above
    // (in ty_eq) adapt.
    return 0;
}

// Adopts `want` on untyped literal nodes (§5.9). The checker lets a literal
// flow into any numeric context; the backend emits each node from its own
// `ty`, so contexts stamp the concrete type here (`let x: i64 = 1`, `f(1)`
// with an i64 parameter, `x + 1` with x: i64) instead of leaving "untyped
// integer" behind. Only literal-shaped subtrees are touched: a child with a
// concrete type stops the recursion, so no expression is silently converted.
//
// A node whose own type is *not* numeric (a comparison yields `bool`, say)
// gives its operands their own semantics, so we must not reach through it and
// force the outer type on them: `let a = (1 < 2);` must compare two i32s, not
// two i1s. Arithmetic already stamps its literal operands as it checks them
// (ck_expr_binary), so the numeric-node recursion is only a convenience for
// literal-only subtrees.
void ck_stamp_lits(struct AstNode* n, int want) {
    if (n == 0) { return; }
    if (n->ty != 0 && !ty_is_untyped_lit(n->ty)
        && !ty_is_integer(n->ty) && !ty_is_float(n->ty)) {
        return;
    }
    if (n->a != 0 && ty_is_untyped_lit(n->a->ty)) { ck_stamp_lits(n->a, want); }
    if (n->b != 0 && ty_is_untyped_lit(n->b->ty)) { ck_stamp_lits(n->b, want); }
    if (ty_is_untyped_lit(n->ty)) { n->ty = want; }
}

// Checks an expression and returns its type id (TY_INVALID after a stop).
int ck_expr(struct AstNode* n) {
    int t;
    if (n == 0) { return TY_UNIT; }
    if (n->ty != 0) { return n->ty; }   // already checked (idempotent)
    t = TY_INVALID;
    if (n->kind == AST_INT_LIT) {
        // A suffix names the literal's type outright (`5u8`, `7i64`); it is
        // not an untyped literal, so it will not adapt to another context.
        if (n->sval != 0) { n->ty = ck_suffix_ty(n->sval); return n->ty; }
        n->ty = TY_UINT_LIT;
        return n->ty;
    }
    if (n->kind == AST_FLOAT_LIT) {
        // A suffix names the literal's type outright (`2.5f32`, `1.0f64`); it
        // is not an untyped literal, so it will not adapt to another context
        // (§4.3, mirroring the integer suffix rule). Without this, `1.5f32`
        // was treated as untyped and defaulted to `f64`, so `let x = 1.5f32`
        // (and `[1.0f32, ...]`, which infers its element type from the first
        // element) silently became `f64`.
        if (n->sfx != 0) {
            if (str_eq(n->sfx, "f32")) { n->ty = TY_F32; return n->ty; }
            if (str_eq(n->sfx, "f64")) { n->ty = TY_F64; return n->ty; }
        }
        n->ty = TY_FLOAT_LIT;
        return n->ty;
    }
    if (n->kind == AST_STRING_LIT) { n->ty = ty_new(CTY_STRREF, "&str", TY_U8, 0); return n->ty; }
    if (n->kind == AST_CHAR_LIT) { n->ty = TY_CHAR; return n->ty; }
    if (n->kind == AST_BOOL_LIT) { n->ty = TY_BOOL; return n->ty; }
    if (n->kind == AST_UNIT_LIT) { n->ty = TY_UNIT; return n->ty; }
    if (n->kind == AST_PATH) { t = ck_expr_path(n); n->ty = t; return t; }
    if (n->kind == AST_BINARY) { t = ck_expr_binary(n); n->ty = t; return t; }
    if (n->kind == AST_UNARY) { t = ck_expr_unary(n); n->ty = t; return t; }
    if (n->kind == AST_FIELD_ACC) { t = ck_expr_field(n); n->ty = t; return t; }
    if (n->kind == AST_INDEX) { t = ck_expr_index(n); n->ty = t; return t; }
    if (n->kind == AST_CALL) { t = ck_expr_call(n); n->ty = t; return t; }
    if (n->kind == AST_AS) { t = ck_expr_as(n); n->ty = t; return t; }
    if (n->kind == AST_STRUCT_INIT) { t = ck_expr_struct_init(n); n->ty = t; return t; }
    if (n->kind == AST_ARRAY_LIT) { t = ck_expr_array_lit(n); n->ty = t; return t; }
    if (n->kind == AST_BORROW) { t = ck_expr_borrow(n); n->ty = t; return t; }
    if (n->kind == AST_DEREF) { t = ck_expr_deref(n); n->ty = t; return t; }
    if (n->kind == AST_HEAP) { t = ck_expr_heap(n); n->ty = t; return t; }
    if (n->kind == AST_SIZEOF) { t = ck_expr_sizeof(n); n->ty = t; return t; }
    if (n->kind == AST_RAW_EXPR) { t = ck_expr_raw(n); n->ty = t; return t; }
    if (n->kind == AST_BLOCK) {
        // A block used as an expression: its value is the last expression
        // statement (§8.1). M1 keeps it simple: blocks in expression position
        // yield unit.
        ck_stmt_block(n);
        n->ty = TY_UNIT;
        return TY_UNIT;
    }
    diag_stop("TYPE-05", "unsupported expression",
              "This expression form is not supported yet.",
              diag_file(n->file), n->start, n->end);
    n->ty = TY_INVALID;
    return TY_INVALID;
}

// A path: a bare name, or `Enum::Variant` (the parser flattens `A::B` into
// the single string "A::B", so split on the last `::` here).
int ck_expr_path(struct AstNode* n) {
    int sym;
    // A bare generic variant path (`Opt<i32>::None`): the parser stored the
    // type arguments on the path node. Instantiate the enum and construct the
    // payload-less variant.
    if (n->kind == AST_PATH && n->kids != 0 && n->kids->len > 0
        && str_contains(n->sval, "::")) {
        int cut;
        char* ename;
        char* vname;
        int ety;
        cut = str_rfind(n->sval, "::");
        ename = str_prefix(n->sval, cut);
        vname = n->sval + cut + 2;
        ety = ck_instantiate_type(n, ename, n->kids);
        if (ety == TY_INVALID) { return TY_INVALID; }
        {
            int vi;
            vi = ty_find_member(ety, vname);
            if (vi < 0) {
                ck_err_no_field(n, ety, vname);
                return TY_INVALID;
            }
            if (ty_member_count(ty_member_type(ety, vi)) != 0) {
                diag_stop("TYPE-01", "this variant has a payload",
                          "Construct it with `Enum::Variant(value)`.",
                          diag_file(n->file), n->start, n->end);
                return TY_INVALID;
            }
            n->ival = 1000 + vi;
        }
        return ety;
    }
    if (n->a != 0) {        // Qualified path: resolve the base type, then the final segment.
        int base;
        int seg;
        base = ck_expr(n->a);
        if (base == TY_INVALID) { return TY_INVALID; }
        if (n->kids != 0 && n->kids->len > 0) {
            seg = n->kids->items[n->kids->len - 1];
            if (ty_kind(base) == CTY_ENUM) {
                int vi;
                vi = ty_find_member(base, seg->sval);
                if (vi < 0) {
                    ck_err_no_field(n, base, seg->sval);
                    return TY_INVALID;
                }
                // A variant with no payload is a value of the enum type.
                if (ty_member_count(ty_member_type(base, vi)) == 0) {
                    return base;
                }
                // A payload variant needs construction (M2: `Has(...)` sugar).
                return ty_member_type(base, vi);
            }
            ck_err_no_field(n, base, seg->sval);
            return TY_INVALID;
        }
        return base;
    }
    if (str_contains(n->sval, "::")) {
        return ck_expr_enum_path(n);
    }
    sym = ck_lookup(n->sval);
    if (sym < 0) {
        // Could still be an enum variant of some enum (unqualified, §8.4).
        if (ck_expr_variant_unqualified(n)) { return n->ty; }
        ck_err_unknown_name(n->sval, n, 0);
        return TY_INVALID;
    }
    if (g_sym_kind[sym] == SK_CONST || g_sym_kind[sym] == SK_LET
        || g_sym_kind[sym] == SK_PARAM) {
        if ((g_sym_kind[sym] == SK_LET || g_sym_kind[sym] == SK_PARAM)
            && !g_sym_init[sym]) {
            ck_err_uninit(n, n->sval);
        }
        return g_sym_ty[sym];
    }
    if (g_sym_kind[sym] == SK_FN) {
        // A function named without calling it: function values arrive in v1
        // (§20.3 item 7). For now the name only makes sense in a call.
        return TY_UNIT;
    }
    if (g_sym_kind[sym] == SK_TYPE) {
        diag_stop("TYPE-05", "a type is not a value",
                  "Type names can only appear in type position.",
                  diag_file(n->file), n->start, n->end);
        return TY_INVALID;
    }
    return g_sym_ty[sym];
}

// `Enum::Variant` (the parser hands us the flattened "Enum::Variant" string).
// Splits on the last `::`, resolves the enum, and returns the variant's type:
// the enum type for a payload-less variant, its payload struct otherwise.
int ck_expr_enum_path(struct AstNode* n) {
    int cut;
    char* ename;
    char* vname;
    int sym;
    int ty;
    int vi;
    cut = str_rfind(n->sval, "::");
    ename = str_prefix(n->sval, cut);
    vname = n->sval + cut + 2;
    sym = ck_lookup(ename);
    if (sym < 0 || g_sym_kind[sym] != SK_TYPE) {
        ck_err_unknown_name(ename, n, "the name before `::` must be an enum or module");
        return TY_INVALID;
    }
    ty = g_sym_ty[sym];
    if (ty_kind(ty) != CTY_ENUM) {
        ck_err_no_field(n, ty, vname);
        return TY_INVALID;
    }
    vi = ty_find_member(ty, vname);
    if (vi < 0) {
        ck_err_no_field(n, ty, vname);
        return TY_INVALID;
    }
    if (ty_member_count(ty_member_type(ty, vi)) == 0) {
        return ty;   // payload-less variant: a value of the enum type
    }
    return ty_member_type(ty, vi);
}

// An unqualified name that matches exactly one enum variant in scope.
// Sets n->ty and returns 1 on success.
int ck_expr_variant_unqualified(struct AstNode* n) {
    int i;
    int found;
    int fty;
    found = 0;
    fty = TY_INVALID;
    // An expected type narrows the search: `let m: Maybe<i32> = Empty` knows
    // the enum from the annotation (a prelude template instance is not a
    // symbol, so a plain scan would miss it).
    if (g_expected_ty != 0 && ty_kind(g_expected_ty) == CTY_ENUM) {
        int vi;
        vi = ty_find_member(g_expected_ty, n->sval);
        if (vi >= 0) {
            if (ty_member_count(ty_member_type(g_expected_ty, vi)) != 0) {
                return 0;   // payload variant: needs construction
            }
            n->ty = g_expected_ty;
            return 1;
        }
    }
    i = 0;
    while (i < g_nsyms) {
        if (g_sym_kind[i] == SK_TYPE && ty_kind(g_sym_ty[i]) == CTY_ENUM) {
            if (ty_find_member(g_sym_ty[i], n->sval) >= 0) {
                if (found) {
                    // Ambiguous: two enums define this variant name.
                    return 0;
                }
                found = 1;
                fty = g_sym_ty[i];
            }
        }
        i = i + 1;
    }
    if (!found) { return 0; }
    if (ty_member_count(ty_member_type(fty, ty_find_member(fty, n->sval))) != 0) {
        return 0;   // payload variant: needs construction
    }
    n->ty = fty;
    return 1;
}

// Binary operators. Comparison/logical ops yield bool; arithmetic keeps the
// operand type (traps on overflow per §3.2 — the backend emits the checks).
int ck_expr_binary(struct AstNode* n) {
    int lt;
    int rt;
    char* op;
    op = n->sval;
    lt = ck_expr(n->a);
    rt = ck_expr(n->b);
    if (lt == TY_INVALID || rt == TY_INVALID) { return TY_INVALID; }
    // An untyped literal adopts the other operand's type (§5.9); stamping the
    // leaves keeps the backend's per-node types exact (`x + 1` with x: i64
    // must emit an i64 add, and a shift amount must match its value type).
    if (ty_is_untyped_lit(lt) && !ty_is_untyped_lit(rt)) {
        ck_stamp_lits(n->a, rt);
        lt = rt;
    } else if (ty_is_untyped_lit(rt) && !ty_is_untyped_lit(lt)) {
        ck_stamp_lits(n->b, lt);
        rt = lt;
    }
    if (str_eq(op, "==") || str_eq(op, "!=") || str_eq(op, "<")
        || str_eq(op, "<=") || str_eq(op, ">") || str_eq(op, ">=")
        || str_eq(op, "&&") || str_eq(op, "||")) {
        if (!ty_eq(lt, rt)) {
            ck_err_type_mismatch(n, lt, rt, "comparison");
            return TY_INVALID;
        }
        if ((str_eq(op, "&&") || str_eq(op, "||")) && !ty_eq(lt, TY_BOOL)) {
            ck_err_type_mismatch(n->a, TY_BOOL, lt, "logical operand");
            return TY_INVALID;
        }
        return TY_BOOL;
    }
    // Arithmetic / bitwise: integers and floats only, same type both sides.
    if (str_eq(op, "+") || str_eq(op, "-") || str_eq(op, "*") || str_eq(op, "/")
        || str_eq(op, "%") || str_eq(op, "&") || str_eq(op, "|")
        || str_eq(op, "^") || str_eq(op, "<<") || str_eq(op, ">>")) {
        int lt2;
        int rt2;
        lt2 = lt;
        rt2 = rt;
        if (ty_is_untyped_lit(lt2)) { lt2 = rt2; }
        if (ty_is_untyped_lit(rt2)) { rt2 = lt2; }
        if (!ty_eq(lt2, rt2)) {
            ck_err_type_mismatch(n, lt2, rt2, "arithmetic operands");
            return TY_INVALID;
        }
        if (str_eq(op, "<<") || str_eq(op, ">>")) {
            // The shift amount may be any integer type; the shifted value
            // keeps its own type (§7.3).
            if (!ty_is_integer(lt2) && !ty_is_untyped_lit(lt)) {
                diag_stop("TYPE-01", "cannot shift a non-integer",
                          "Only integer types can be shifted.",
                          diag_file(n->a->file), n->a->start, n->a->end);
                return TY_INVALID;
            }
            return lt;
        }
        if (!ty_is_integer(lt2) && !ty_is_float(lt2) && !ty_is_untyped_lit(lt2)) {
            diag_stop("TYPE-01", "arithmetic needs numbers",
                      "These operands are not numeric.",
                      diag_file(n->file), n->start, n->end);
            return TY_INVALID;
        }
        if (str_eq(op, "%") || str_eq(op, "&") || str_eq(op, "|") || str_eq(op, "^")) {
            if (!ty_is_integer(lt2) && !ty_is_untyped_lit(lt2)) {
                diag_stop("TYPE-01", "integer-only operator",
                          "This operator needs integer operands.",
                          diag_file(n->file), n->start, n->end);
                return TY_INVALID;
            }
        }
        return lt2;
    }
    // Range and assignment-shaped operators never appear in a value position.
    diag_stop("TYPE-05", "unsupported operator",
              "This operator cannot be used here.",
              diag_file(n->file), n->start, n->end);
    return TY_INVALID;
}

int ck_expr_unary(struct AstNode* n) {
    char* op;
    int t;
    op = n->sval;
    t = ck_expr(n->a);
    if (t == TY_INVALID) { return TY_INVALID; }
    if (str_eq(op, "-") || str_eq(op, "~")) {
        if (ty_is_untyped_lit(t)) { return t; }
        if (!ty_is_integer(t) && !ty_is_float(t)) {
            diag_stop("TYPE-01", "cannot negate this type",
                      "Unary `-` needs a number; `~` needs an integer.",
                      diag_file(n->a->file), n->a->start, n->a->end);
            return TY_INVALID;
        }
        if (str_eq(op, "~") && !ty_is_integer(t)) {
            diag_stop("TYPE-01", "`~` needs an integer",
                      "Bitwise not is integer-only.",
                      diag_file(n->a->file), n->a->start, n->a->end);
            return TY_INVALID;
        }
        return t;
    }
    if (str_eq(op, "!")) {
        if (!ty_eq(t, TY_BOOL)) {
            ck_err_type_mismatch(n->a, TY_BOOL, t, "`!` operand");
            return TY_INVALID;
        }
        return TY_BOOL;
    }
    diag_stop("TYPE-05", "unsupported unary operator",
              "This operator cannot be used here.",
              diag_file(n->file), n->start, n->end);
    return TY_INVALID;
}

// Field access: `base.field`, with one auto-deref level for references and
// heap boxes (§12.4). Returns the field's type.
int ck_expr_field(struct AstNode* n) {
    int base;
    int bt;
    int fi;
    base = ck_expr(n->a);
    if (base == TY_INVALID) { return TY_INVALID; }
    bt = base;
    // Auto-deref: &T / &mut T / heap T expose T's members.
    while (ty_is_ref(bt) || ty_is_heap(bt)) {
        bt = ty_elem(bt);
    }
    if (ty_kind(bt) != CTY_STRUCT && ty_kind(bt) != CTY_ENUM) {
        diag_stop("TYPE-02", "no fields on this type",
                  "Only structs and enums have named members.",
                  diag_file(n->a->file), n->a->start, n->a->end);
        return TY_INVALID;
    }
    fi = ty_find_member(bt, n->sval);
    if (fi < 0) {
        ck_err_no_field(n, bt, n->sval);
        return TY_INVALID;
    }
    return ty_member_type(bt, fi);
}

// Indexing: arrays, slices, and &str. Bounds checks are the backend's job
// (§3.2); here we only check that the index is an integer. A range index
// (`a[lo..hi]`, `a[..]`) yields a slice reference; it is normally consumed by
// a borrow (`&a[lo..hi]`), and making a slice value alone is harmless.
int ck_expr_index(struct AstNode* n) {
    int base;
    int it;
    int rng;
    base = ck_expr(n->a);
    if (base == TY_INVALID) { return TY_INVALID; }
    rng = 0;
    if (n->b != 0 && n->b->kind == AST_BINARY
        && (str_eq(n->b->sval, "..") || str_eq(n->b->sval, "..="))) {
        rng = 1;
    }

    if (rng) {
        // Slice ranges work on arrays, slices, and `&str` (through one
        // reference for arrays). A `&str` byte range yields a `&str` (§5.2);
        // the runtime traps if either end is off a character boundary.
        int st;
        st = base;
        // Check `&str` before unwrapping: it *is* a reference (fat), so
        // `ty_is_ref` would otherwise reduce it to its byte element.
        if (ty_kind(st) == CTY_STRREF) {
            if (n->b->a != 0) {
                int lo;
                lo = ck_expr(n->b->a);
                if (lo == TY_INVALID) { return TY_INVALID; }
                if (!ty_is_integer(lo) && !ty_is_untyped_lit(lo)) {
                    ck_err_type_mismatch(n->b->a, TY_ISIZE, lo, "slice start");
                    return TY_INVALID;
                }
                ck_stamp_lits(n->b->a, TY_ISIZE);
            }
            if (n->b->b != 0) {
                int hi;
                hi = ck_expr(n->b->b);
                if (hi == TY_INVALID) { return TY_INVALID; }
                if (!ty_is_integer(hi) && !ty_is_untyped_lit(hi)) {
                    ck_err_type_mismatch(n->b->b, TY_ISIZE, hi, "slice end");
                    return TY_INVALID;
                }
                ck_stamp_lits(n->b->b, TY_ISIZE);
            }
            return ty_new(CTY_STRREF, "&str", TY_U8, 0);
        }
        if (ty_is_ref(st) || ty_is_heap(st)) { st = ty_elem(st); }
        if (!ty_is_array(st) && ty_kind(st) != CTY_SLICE) {
            diag_stop("TYPE-02", "cannot slice this type",
                      "Slices are made from arrays and slices: `&a[1..3]`.",
                      diag_file(n->a->file), n->a->start, n->a->end);
            return TY_INVALID;
        }
        if (n->b->a != 0) {
            int lo;
            lo = ck_expr(n->b->a);
            if (lo == TY_INVALID) { return TY_INVALID; }
            if (!ty_is_integer(lo) && !ty_is_untyped_lit(lo)) {
                ck_err_type_mismatch(n->b->a, TY_ISIZE, lo, "slice start");
                return TY_INVALID;
            }
            // A signed range keeps `-1` visible so the runtime traps on it.
            ck_stamp_lits(n->b->a, TY_ISIZE);
        }
        if (n->b->b != 0) {
            int hi;
            hi = ck_expr(n->b->b);
            if (hi == TY_INVALID) { return TY_INVALID; }
            if (!ty_is_integer(hi) && !ty_is_untyped_lit(hi)) {
                ck_err_type_mismatch(n->b->b, TY_ISIZE, hi, "slice end");
                return TY_INVALID;
            }
            ck_stamp_lits(n->b->b, TY_ISIZE);
        }
        // The range keeps the base's exclusivity: reslicing a `&mut [T]`
        // stays `&mut [T]` (else `&mut s[1..3]` would silently downgrade and
        // writes through it would be rejected). A plain array base is shared
        // until a `&mut` borrow upgrades it (ck_expr_borrow).
        return ck_slice_ty_mut(ty_elem(st), ty_slice_is_mut(st));
    }

    it = ck_expr(n->b);
    if (it == TY_INVALID) { return TY_INVALID; }
    // Check the base type first: "you cannot index this" is more useful than
    // "the index is not an integer" when both are wrong.
    if (ty_is_array(base) || ty_kind(base) == CTY_SLICE) {
        if (!ty_is_integer(it) && !ty_is_untyped_lit(it)) {
            ck_err_type_mismatch(n->b, TY_USIZE, it, "index");
            return TY_INVALID;
        }
        return ty_elem(base);
    }
    // A `str` is not integer-indexable (§5.2): "the 3rd what?" — a byte, a
    // scalar, or a grapheme? Use `s.as_bytes()[i]` for a byte, `s.chars()` for
    // scalars, or a byte-range slice `&s[lo..hi]` for a piece of text.
    if (ty_kind(base) == CTY_STRREF) {
        diag_stop("TYPE-02", "cannot index a `str`",
                  "A `str` is indexed by byte with `s.as_bytes()[i]`, by scalar with `s.chars()`, or sliced by byte range with `&s[lo..hi]`.",
                  diag_file(n->a->file), n->a->start, n->a->end);
        return TY_INVALID;
    }
    if (ty_is_ref(base) || ty_is_heap(base)) {
        // Indexing through a reference/box indexes the pointee.
        int inner;
        inner = ty_elem(base);
        if (ty_is_array(inner) || ty_kind(inner) == CTY_SLICE) {
            return ty_elem(inner);
        }
    }
    // A raw pointer is indexed like an array (§13.5): `p[i]` is `*(p + i)`.
    // This is an unlocked operation (UNCK-01). `n->ival` marks it so the
    // backend lowers it as a GEP.
    if (ty_is_ptr(base)) {
        ck_raw_needs_unchecked(n, "indexing through a raw pointer");
        if (!ty_is_integer(it) && !ty_is_untyped_lit(it)) {
            ck_err_type_mismatch(n->b, TY_USIZE, it, "index");
            return TY_INVALID;
        }
        ck_stamp_lits(n->b, TY_USIZE);
        n->ival = 9;
        return ty_elem(base);
    }
    diag_stop("TYPE-02", "cannot index this type",
              "Only arrays, slices, &str, and raw pointers can be indexed.",
              diag_file(n->a->file), n->a->start, n->a->end);
    return TY_INVALID;
}

// ---------------------------------------------------------------------------
// Generic-call type inference (§18). A call to a generic template without
// explicit `<...>` arguments infers each parameter from the arguments' types:
// `id(7)` becomes `id<i32>(7)`. The parameter type node is unified against the
// argument's resolved type, pinning any `T` it mentions.
// ---------------------------------------------------------------------------
struct AstNode* g_infer_targs[16];   // pinned type node per parameter (or 0)
char* g_infer_names[16];             // parameter name per slot
int g_infer_n;

// Pins template parameters in `tn` from the concrete argument type `ty`.
// Returns 1 (unification is best-effort; a structural mismatch just leaves the
// parameter unpinned, and the caller reports "cannot infer").
int ck_unify(struct AstNode* tn, int ty) {
    int i;
    int k;
    if (tn == 0 || ty == TY_INVALID) { return 1; }
    k = tn->kind;
    if (k == AST_TYPE_NAME) {
        // `Heap<T>`: match the head name, then the element.
        if (tn->sval != 0 && str_eq(tn->sval, "Heap")
            && tn->kids != 0 && tn->kids->len == 1) {
            if (ty_is_heap(ty)) { return ck_unify(tn->kids->items[0], ty_elem(ty)); }
            return 1;
        }
        // A bare name: a parameter to pin, or a concrete type to ignore.
        if (tn->kids == 0 || tn->kids->len == 0) {
            i = 0;
            while (i < g_infer_n) {
                if (g_infer_names[i] != 0 && str_eq(tn->sval, g_infer_names[i])) {
                    if (g_infer_targs[i] == 0) { g_infer_targs[i] = ck_ty_to_ast(ty); }
                    return 1;
                }
                i = i + 1;
            }
            return 1;
        }
        return 1;
    }
    if (k == AST_TYPE_REF) {
        // `&[T]` / `&str` are fat pairs; `&T` is thin. A slice arg is the pair
        // itself, so recurse into the element node against the slice type.
        if (ty_kind(ty) == CTY_SLICE) { return ck_unify(tn->a, ty); }
        if (ty_is_ref(ty) || ty_is_ptr(ty) || ty_is_heap(ty)) {
            return ck_unify(tn->a, ty_elem(ty));
        }
        return 1;
    }
    if (k == AST_TYPE_SLICE) {
        if (ty_kind(ty) == CTY_SLICE) { return ck_unify(tn->a, ty_elem(ty)); }
        return 1;
    }
    if (k == AST_TYPE_ARRAY) {
        if (ty_is_array(ty)) { return ck_unify(tn->a, ty_elem(ty)); }
        return 1;
    }
    if (k == AST_TYPE_RAW) {
        if (ty_is_ptr(ty)) { return ck_unify(tn->a, ty_elem(ty)); }
        return 1;
    }
    return 1;
}

// `name(args)` where `name` is a generic template: infer the type arguments
// from the argument types, instantiate, and check the call (§18).
// True when a type node mentions one of the enclosing template's parameters
// (`T`, `U`, ...). Used during generic-call inference: a parameter typed `T`
// cannot supply an expected type (that is exactly what the pass infers), and
// resolving it would emit "no type named `T`" — a diagnostic about a type
// that is perfectly legal in that position.
int ck_type_mentions_template_param(struct AstNode* n) {
    int i;
    if (n == 0) { return 0; }
    if (n->kind == AST_TYPE_NAME && n->sval != 0) {
        i = 0;
        while (i < g_infer_n) {
            if (g_infer_names[i] != 0 && str_eq(n->sval, g_infer_names[i])) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (ck_type_mentions_template_param(n->a)) { return 1; }
    if (ck_type_mentions_template_param(n->b)) { return 1; }
    if (ck_type_mentions_template_param(n->c)) { return 1; }
    if (n->kids != 0) {
        i = 0;
        while (i < n->kids->len) {
            if (ck_type_mentions_template_param(n->kids->items[i])) { return 1; }
            i = i + 1;
        }
    }
    return 0;
}

int ck_infer_generic_call(struct AstNode* n, struct AstNode* callee, struct AstList* args) {
    int ti;
    struct AstNode* tmpl;
    struct AstList* params;
    struct AstList* targs;
    int ntargs;
    int na;
    int npar;
    int i;
    int idx;
    struct AstNode* inst;

    ti = ck_find_template(callee->sval);
    if (ti < 0) { return TY_INVALID; }
    tmpl = ck_template_decl(ti);
    ntargs = ck_template_nparams(tmpl);
    params = tmpl->kids2;
    na = ast_list_len(args);
    npar = ast_list_len(params);
    if (npar != na) {
        ck_err_arity(n, callee->sval, npar, na);
        return TY_INVALID;
    }
    if (ntargs > 16) { ntargs = 16; }

    // Set up the per-call inference slots.
    g_infer_n = ntargs;
    i = 0;
    while (i < ntargs) {
        g_infer_names[i] = ck_template_param(tmpl, i);
        g_infer_targs[i] = 0;
        i = i + 1;
    }

    // Pin parameters from each argument's type. An untyped literal adopts its
    // default (`i32`/`f64`) first, so `id(7)` infers `id<i32>` (§5.9).
    i = 0;
    while (i < na) {
        int at;
        int saved_expected;
        // A parameter whose type is already concrete (`Maybe<i32>`) can
        // supply the expected type for a bare constructor argument
        // (`g(9, Empty)`); a `T`-typed one cannot, because `T` is exactly what
        // this pass is inferring. Setting the hint only for concrete params
        // keeps inference intact.
        saved_expected = g_expected_ty;
        // Only a parameter whose declared type is written *without* a
        // template parameter can supply a hint. Inspecting it textually avoids
        // resolving `T` (which would emit "no type named `T`" during
        // inference — the very pass that is meant to discover it).
        if (params->items[i]->a != 0
            && !ck_type_mentions_template_param(params->items[i]->a)) {
            int pt;
            pt = ck_resolve_type_nocache(params->items[i]->a);
            if (pt != TY_INVALID && !ty_is_untyped_lit(pt)) {
                g_expected_ty = pt;
            }
        }
        at = ck_expr(args->items[i]);
        g_expected_ty = saved_expected;
        if (at == TY_UINT_LIT) { ck_stamp_lits(args->items[i], TY_I32); at = TY_I32; }
        else if (at == TY_FLOAT_LIT) { ck_stamp_lits(args->items[i], TY_F64); at = TY_F64; }
        if (at != TY_INVALID) { ck_unify(params->items[i]->a, at); }
        i = i + 1;
    }

    // Every parameter must be pinned to a concrete type.
    targs = ast_list_new();
    i = 0;
    while (i < ntargs) {
        if (g_infer_targs[i] == 0) {
            lexbuf_reset();
            lexbuf_push_str("cannot infer `");
            lexbuf_push_str(g_infer_names[i]);
            lexbuf_push_str("` for `");
            lexbuf_push_str(callee->sval);
            lexbuf_push_str("` from the argument types; write it explicitly");
            diag_stop("TYPE-01", "cannot infer the generic type arguments",
                      lexbuf_finish(),
                      diag_file(callee->file), callee->start, callee->end);
            return TY_INVALID;
        }
        ast_list_push(targs, g_infer_targs[i]);
        i = i + 1;
    }

    idx = ck_instantiate(n, callee->sval, targs);
    if (idx < 0) { return TY_INVALID; }
    inst = g_fn_decl[idx];
    // The instance is now an ordinary function. Mirror an explicit generic
    // call exactly: `n->b` holds the instance and `n->a` is cleared, so the
    // backend takes its generic-call path (it keys on `callee == 0`).
    n->a = 0;
    n->b = inst;
    n->ty = inst->ty;
    // Check the argument coercions against the instantiated parameters.
    i = 0;
    while (i < na) {
        int at;
        at = ck_expr(args->items[i]);
        if (at != TY_INVALID && inst->kids2->items[i]->ty != TY_INVALID
            && !ck_coercible(inst->kids2->items[i]->ty, at)) {
            ck_err_type_mismatch(args->items[i], inst->kids2->items[i]->ty, at,
                                 "argument");
        }
        ck_stamp_lits(args->items[i], inst->kids2->items[i]->ty);
        i = i + 1;
    }
    return inst->ty;
}

// Calls: free functions, methods, generic calls, and (later) function values.
int ck_expr_call(struct AstNode* n) {
    struct AstNode* callee;
    struct AstList* args;
    int i;
    int ret;
    callee = n->a;
    args = n->kids;   // AST_CALL: a = callee, kids = argument list
    // Generic call `name<T, ...>(args)`: the parser puts the callee's name in
    // sval and the type arguments in kids2, leaving `a` empty (§18).
    if (callee == 0) {
        return ck_expr_generic_call(n);
    }
    // Method call: callee is a field-access-shaped path `recv.name`.
    if (callee->kind == AST_FIELD_ACC) {
        return ck_expr_method_call(n, callee, args);
    }
    if (callee->kind != AST_PATH) {
        int ct;
        ct = ck_expr(callee);
        if (ct == TY_INVALID) { ct = TY_UNIT; }
        ck_err_not_callable(callee, ct);
        return TY_INVALID;
    }
    {
        int sym;
        if (callee->kids != 0 && callee->kids->len > 0
            && str_contains(callee->sval, "::")) {
            // `Opt<i32>::Some(3)` or `Box<i32>::make(3)`: the callee path
            // carries the generic type arguments. Instantiate the type, then
            // dispatch: an enum constructor, or an associated function.
            int cut;
            char* ename;
            char* vname;
            int ety;
            cut = str_rfind(callee->sval, "::");
            ename = str_prefix(callee->sval, cut);
            vname = callee->sval + cut + 2;
            ety = ck_instantiate_type(callee, ename, callee->kids);
            if (ety == TY_INVALID) { return TY_INVALID; }
            if (ty_kind(ety) == CTY_ENUM) {
                return ck_enum_construct_ty(n, ety, vname, args);
            }
            // An associated function on the instance (`Box__i32::make`): the
            // symbol is `ll_method_symbol(instance, name)`, so rewrite the
            // callee path to the instance's display name for `ll_call_symbol`.
            lexbuf_reset();
            lexbuf_push_str(ty_display(ety));
            lexbuf_push_str("::");
            lexbuf_push_str(vname);
            callee->sval = lexbuf_finish();
            return ck_assoc_call_ty(n, ety, vname, args);
        }
        if (str_contains(callee->sval, "::")) {
            int modsym;
            // A module function first (`geometry::length`, 6.7): the merged
            // symbol is exactly this flattened name. Then the enum forms.
            modsym = ck_lookup(callee->sval);
            if (modsym >= 0 && g_sym_kind[modsym] == SK_FN) {
                sym = modsym;
            } else {
                // `Enum::Variant(payload)` next; then a generic template
                // called through a namespace (`geometry::id(7)`, 6.7 + 18),
                // inferred like a bare call; then `Type::assoc(...)`.
                int ev;
                ev = ck_enum_construct(n, callee, args);
                if (ev != TY_INVALID) { return ev; }
                if (ck_find_template(callee->sval) >= 0) {
                    return ck_infer_generic_call(n, callee, args);
                }
                return ck_expr_assoc_call(n, callee, args);
            }
        } else {
            // An unqualified variant construction `Has(x)` (6.5): resolve
            // against every in-scope enum before treating it as a function.
            int ev;
            ev = ck_enum_construct_unqualified(n, args);
            if (ev != TY_INVALID) { return ev; }
            sym = ck_lookup(callee->sval);
        }
        // The print family is recognized by the compiler only for its format
        // string (§15.1, §19.8.6): there are no variadics, so the placeholder
        // count and argument types are checked here (FMT-01). `n->ival` marks
        // which builtin this is for the backend.
        if (str_eq(callee->sval, "print")) {
            n->ival = 1;
            ck_check_format(n, "print", args);
            return TY_UNIT;
        }
        if (str_eq(callee->sval, "println")) {
            n->ival = 2;
            ck_check_format(n, "println", args);
            return TY_UNIT;
        }
        if (str_eq(callee->sval, "eprintln")) {
            n->ival = 3;
            ck_check_format(n, "eprintln", args);
            return TY_UNIT;
        }
        // The other prelude builtins the rewrite needs (§15.1): `trap`,
        // `assert`, `unreachable`, `exit`. Like the print family, these are
        // recognized by name; their bodies are runtime hooks. `n->ival` marks
        // which one for the backend (4..7).
        if (str_eq(callee->sval, "trap")) {
            n->ival = 4;
            return ck_builtin_trap(n, args);
        }
        if (str_eq(callee->sval, "assert")) {
            n->ival = 5;
            return ck_builtin_assert(n, args);
        }
        if (str_eq(callee->sval, "unreachable")) {
            n->ival = 6;
            return ck_builtin_unreachable(n, args);
        }
        if (str_eq(callee->sval, "args")) {
            // `args() -> &[&str]` (§15.6): the safe process-argument view.
            n->ival = 8;
            return ck_builtin_args(n, args);
        }
        if (str_eq(callee->sval, "exit")) {
            n->ival = 7;
            return ck_builtin_exit(n, args);
        }
        if (sym < 0 || g_sym_kind[sym] != SK_FN) {
            // A generic template is callable without explicit `<...>`: infer
            // its type arguments from the arguments (§18). The old fallback
            // ("give its type arguments") is replaced by inference, with a
            // clear stop when a parameter cannot be pinned.
            if (ck_find_template(callee->sval) >= 0) {
                return ck_infer_generic_call(n, callee, args);
            }
            ck_err_unknown_name(callee->sval, callee, "did you mean to call a function?");
            return TY_INVALID;
        }
        // The escape hatch (§13.2/§13.4): an `extern fn` call is unlocked
        // (UNCK-01), and calling an `unchecked fn` needs a promise too
        // (UNCK-04). Both are fine inside `unchecked("...")`.
        if (!ck_in_unchecked()) {
            struct AstNode* fndecl;
            fndecl = g_sym_decl[sym];
            if (fndecl != 0 && fndecl->kind == AST_EXTERN_FN) {
                ck_err_needs_unchecked(callee, "calling an `extern fn`");
            } else if (fndecl != 0 && (fndecl->ival & 1)) {
                ck_err_needs_unchecked_fn(callee, callee->sval);
            }
        }
        ret = g_sym_ty[sym];
    }
    // Check arguments against the callee's parameters.
    {
        struct AstNode* fndecl;
        struct AstList* params;
        int sym;
        sym = ck_lookup(callee->sval);
        fndecl = g_sym_decl[sym];
        params = fndecl->kids2;
        {
            int np;
            int na;
            np = 0;
            na = 0;
            if (params != 0) { np = params->len; }
            if (args != 0) { na = args->len; }
            if (np != na) {
                ck_err_arity(n, callee->sval, np, na);
                return ret;
            }
            i = 0;
            while (i < na) {
                int at;
                int saved_expected;
                // A bare constructor argument (`g(Has(3))` where `g` takes a
                // `Maybe<i32>`) resolves its instantiation from the expected
                // parameter type, exactly like `let m: Maybe<i32> = Has(3)`
                // (§8.5). Without the hint it was NAME-01 "no `Has` in
                // scope" even though the signature said which type it was.
                saved_expected = g_expected_ty;
                g_expected_ty = params->items[i]->ty;
                at = ck_expr(args->items[i]);
                g_expected_ty = saved_expected;
                if (at != TY_INVALID && params->items[i]->ty != TY_INVALID
                    && !ck_coercible(params->items[i]->ty, at)) {
                    ck_err_type_mismatch(args->items[i], params->items[i]->ty, at,
                                         "argument");
                }
                ck_stamp_lits(args->items[i], params->items[i]->ty);
                i = i + 1;
            }
        }
    }
    return ret;
}

// Generic call `name<T, ...>(args)`. The parser stores the name in sval and
// the type arguments in kids2 (`a` stays empty). We instantiate the template
// (a concrete `name__T` function) and check the call against it.
int ck_expr_generic_call(struct AstNode* n) {
    int idx;
    struct AstNode* inst;
    struct AstList* params;
    struct AstList* args;
    int i;
    int np;
    int na;

    // `Raw::null<T>()` (§13.5): a null `raw T`, safe outside `unchecked`
    // (creating a null raw pointer is not itself an unlocked operation). It is
    // not a generic function template, so it is recognized here by name; the
    // backend synthesizes an LLVM `null` (`n->ival = 8`).
    if (str_eq(n->sval, "Raw::null")) {
        int elem;
        n->ival = 8;
        if (n->kids2 == 0 || n->kids2->len != 1) {
            ck_err_arity(n, "Raw::null", 1, ast_list_len(n->kids2));
            n->ty = ty_new(CTY_PTR, "raw ?", TY_U8, 0);
            return n->ty;
        }
        elem = ck_resolve_type(n->kids2->items[0]);
        if (elem == TY_INVALID) { elem = TY_U8; }
        // A null raw pointer is `raw mut T` (the stronger form); the
        // `raw mut T` -> `raw T` coercion (in `ck_coercible`) lets it stand
        // wherever a shared `raw T` is wanted (§13.5).
        n->ty = ty_new(CTY_MUTPTR, ck_ref_name("raw mut", elem), elem, 0);
        return n->ty;
    }

    // `alloc<T>(n)` / `dealloc<T>(p, n)` (§13.5): the raw allocator. Both are
    // unlocked (UNCK-01). `alloc` yields `raw mut T`; `dealloc` is unit. The
    // backend lowers them to the `lc_alloc`/`lc_dealloc` runtime hooks, scaling
    // the element count by `sizeof(T)`.
    if (str_eq(n->sval, "alloc") || str_eq(n->sval, "dealloc")) {
        int is_alloc;
        int elem;
        is_alloc = str_eq(n->sval, "alloc");
        if (is_alloc) { n->ival = 10; } else { n->ival = 11; }
        elem = TY_U8;
        if (n->kids2 == 0 || n->kids2->len != 1) {
            ck_err_arity(n, n->sval, 1, ast_list_len(n->kids2));
        } else {
            elem = ck_resolve_type(n->kids2->items[0]);
            if (elem == TY_INVALID) { elem = TY_U8; }
        }
        if (is_alloc) {
            ck_raw_needs_unchecked(n, "calling `alloc`");
        } else {
            ck_raw_needs_unchecked(n, "calling `dealloc`");
        }
        // Argument shapes (§13.5): `alloc<T>(n)` — one count; `dealloc<T>(p,
        // n)` — pointer then count. The count is the last argument.
        {
            int want;
            int countidx;
            if (is_alloc) { want = 1; countidx = 0; } else { want = 2; countidx = 1; }
            if (n->kids != 0 && n->kids->len == want) {
                // `dealloc`'s first argument is the pointer.
                if (!is_alloc) {
                    int pt;
                    pt = ck_expr(n->kids->items[0]);
                    if (pt != TY_INVALID && !ty_is_ptr(pt)) {
                        ck_err_type_mismatch(n->kids->items[0],
                                             ty_new(CTY_MUTPTR, "raw mut T", elem, 0),
                                             pt, "`dealloc` pointer");
                    }
                }
                {
                    int ct;
                    ct = ck_expr(n->kids->items[countidx]);
                    if (ct != TY_INVALID && !ty_is_integer(ct) && !ty_is_untyped_lit(ct)) {
                        ck_err_type_mismatch(n->kids->items[countidx], TY_USIZE, ct, "`alloc`/`dealloc` count");
                    }
                    ck_stamp_lits(n->kids->items[countidx], TY_USIZE);
                }
            } else {
                ck_err_arity(n, n->sval, want, ast_list_len(n->kids));
            }
        }
        // Record the element type so the backend can scale by its size.
        if (is_alloc) {
            n->ty = ty_new(CTY_MUTPTR, ck_ref_name("raw mut", elem), elem, 0);
        } else {
            n->ty = TY_UNIT;
        }
        n->b = ast_node_new(AST_TYPE_NAME);
        n->b->ty = elem;
        return n->ty;
    }

    // `reinterpret<T, U>(x)` (§13.5): bit-reinterpret `x: T` as `U` (same
    // size). Unlocked. `x` must be a scalar or a raw pointer of the same
    // width; the backend is a plain `bitcast`-equivalent (values already share
    // a register width for same-size scalars/pointers).
    if (str_eq(n->sval, "reinterpret")) {
        int from;
        int to;
        n->ival = 12;
        if (n->kids2 == 0 || n->kids2->len != 2) {
            ck_err_arity(n, "reinterpret", 2, ast_list_len(n->kids2));
            n->ty = TY_U8;
            return n->ty;
        }
        from = ck_resolve_type(n->kids2->items[0]);
        to = ck_resolve_type(n->kids2->items[1]);
        if (from == TY_INVALID || to == TY_INVALID) { n->ty = TY_U8; return n->ty; }
        ck_raw_needs_unchecked(n, "calling `reinterpret`");
        if (n->kids != 0 && n->kids->len >= 1) {
            int at;
            at = ck_expr(n->kids->items[0]);
            if (at != TY_INVALID && !ty_eq(at, from) && !ck_coercible(from, at)) {
                ck_err_type_mismatch(n->kids->items[0], from, at, "`reinterpret` value");
            }
        } else {
            ck_err_arity(n, "reinterpret", 1, ast_list_len(n->kids));
        }
        if (ty_size(from) != ty_size(to)) {
            diag_stop("TYPE-01", "`reinterpret` sizes must match",
                      "Both types must have the same size; use `as` for value conversions.",
                      diag_file(n->file), n->start, n->end);
        }
        // Stash both type ids on the node for the backend.
        n->b = ast_node_new(AST_TYPE_NAME);
        n->b->ty = to;
        n->b->ival = from;
        n->ty = to;
        return to;
    }

    idx = ck_instantiate(n, n->sval, n->kids2);
    if (idx < 0) { return TY_INVALID; }
    inst = g_fn_decl[idx];
    // The instance is now an ordinary function; record it on the call node so
    // the backend can call the mangled symbol directly.
    n->b = inst;
    n->ty = inst->ty;

    args = n->kids;
    params = inst->kids2;
    np = 0;
    na = 0;
    if (params != 0) { np = params->len; }
    if (args != 0) { na = args->len; }
    // Skip a `self` receiver that an instance would carry (none today for a
    // free generic function, so np == na).
    if (np != na) {
        ck_err_arity(n, n->sval, np, na);
        return inst->ty;
    }
    i = 0;
    while (i < na) {
        int at;
        int saved_expected;
        // Same expected-type hint as a non-generic call: after instantiation
        // `params` are the concrete parameter types, so a bare `Empty`/`Has`
        // argument resolves from them (§8.5). Without it, `g<i32>(9, Empty)`
        // was NAME-01 "no `Empty` in scope".
        saved_expected = g_expected_ty;
        g_expected_ty = params->items[i]->ty;
        at = ck_expr(args->items[i]);
        g_expected_ty = saved_expected;
        if (at != TY_INVALID && params->items[i]->ty != TY_INVALID
            && !ck_coercible(params->items[i]->ty, at)) {
            ck_err_type_mismatch(args->items[i], params->items[i]->ty, at,
                                 "argument");
        }
        ck_stamp_lits(args->items[i], params->items[i]->ty);
        i = i + 1;
    }
    return inst->ty;
}

// `recv.name(args)`: find the method on the receiver's type and check args.
int ck_expr_method_call(struct AstNode* n, struct AstNode* callee, struct AstList* args) {
    int recv;
    int rt;
    int i;
    int found;
    int fidx;
    recv = ck_expr(callee->a);
    if (recv == TY_INVALID) { return TY_INVALID; }
    // Builtin `.len()` on arrays and slices (§15.1 lists it on the slice
    // surface). Arrays fold to a constant; slices read their length field.
    // `n->ival` marks the call as the intrinsic for the backend.
    if (str_eq(callee->sval, "len") && (args == 0 || args->len == 0)) {
        int lt;
        lt = recv;
        // A slice or `&str` is the fat pair itself (its length is the second
        // half); a plain reference to an array has to be unwrapped first.
        if (ty_kind(lt) == CTY_SLICE || ty_kind(lt) == CTY_STRREF) {
            n->ival = 1;
            return TY_USIZE;
        }
        // Unwrap references and `Heap` boxes: `.len()` auto-derefs through
        // both, so `heap([0u8; N]).len()` is N, like `.field` and `[]` do.
        while (ty_is_ref(lt) || ty_is_heap(lt)) { lt = ty_elem(lt); }
        if (ty_is_array(lt)) {
            n->ival = 1;
            return TY_USIZE;
        }
    }
    // `.as_bytes()` on `&str` (§15.2): the same (pointer, length) pair, viewed
    // as `&[u8]`. `n->ival` marks the intrinsic for the backend.
    if (str_eq(callee->sval, "as_bytes") && (args == 0 || args->len == 0)
        && ty_kind(recv) == CTY_STRREF) {
        n->ival = 2;
        return ck_slice_ty(TY_U8);
    }
    // ---- Raw pointer toolbox (§13.5) ----
    // Each of these is an intrinsic on a `raw T` receiver. The checker marks
    // the call node (`n->ival`) so the backend lowers it directly, sets the
    // result type, and gates the ones that need `unchecked` (UNCK-01).
    if (ty_is_ptr(recv)) {
        int elem;
        elem = ty_elem(recv);
        // `p.is_null()` -> bool, no `unchecked` (comparison is always safe).
        if (str_eq(callee->sval, "is_null") && (args == 0 || args->len == 0)) {
            n->ival = 3;
            return TY_BOOL;
        }
        // `p.read()` -> T. Moves a value out of the pointed-to slot.
        if (str_eq(callee->sval, "read") && (args == 0 || args->len == 0)) {
            ck_raw_needs_unchecked(n, "reading through a raw pointer");
            n->ival = 4;
            return elem;
        }
        // `p.write(v: T)` -> unit. Moves a value into the slot.
        if (str_eq(callee->sval, "write") && args != 0 && args->len == 1) {
            int vt;
            ck_raw_needs_unchecked(n, "writing through a raw pointer");
            vt = ck_expr(args->items[0]);
            if (!ck_coercible(elem, vt)) {
                ck_err_type_mismatch(args->items[0], elem, vt, "`p.write` value");
            }
            ck_stamp_lits(args->items[0], elem);
            n->ival = 5;
            return TY_UNIT;
        }
        // `p.plus(n: usize)` / `p.minus(n: usize)` -> the same raw pointer,
        // offset by n elements.
        if ((str_eq(callee->sval, "plus") || str_eq(callee->sval, "minus"))
            && args != 0 && args->len == 1) {
            int at;
            ck_raw_needs_unchecked(n, "raw pointer arithmetic");
            at = ck_expr(args->items[0]);
            if (!ck_coercible(TY_USIZE, at)) {
                ck_err_type_mismatch(args->items[0], TY_USIZE, at, "pointer offset");
            }
            ck_stamp_lits(args->items[0], TY_USIZE);
            if (str_eq(callee->sval, "plus")) { n->ival = 6; } else { n->ival = 7; }
            return recv;
        }
    }
    // `v.get_unchecked(i)` (§13.5): a bounds-check-free index into an array or
    // slice. Unlocked (UNCK-01); yields `&T` (a pointer to the element).
    if (str_eq(callee->sval, "get_unchecked") && args != 0 && args->len == 1) {
        int base;
        base = recv;
        while (ty_is_ref(base) || ty_is_heap(base)) { base = ty_elem(base); }
        if (ty_is_array(base) || ty_kind(base) == CTY_SLICE) {
            int at;
            ck_raw_needs_unchecked(n, "`get_unchecked`");
            at = ck_expr(args->items[0]);
            if (!ty_is_integer(at) && !ty_is_untyped_lit(at)) {
                ck_err_type_mismatch(args->items[0], TY_USIZE, at, "index");
            }
            ck_stamp_lits(args->items[0], TY_USIZE);
            n->ival = 13;
            return ty_new(CTY_REF, ck_ref_name("&", ty_elem(base)), ty_elem(base), 0);
        }
    }
    rt = recv;
    while (ty_is_ref(rt) || ty_is_heap(rt)) { rt = ty_elem(rt); }
    found = 0;
    fidx = -1;
    i = 0;
    while (i < g_nmeth) {
        if (str_eq(g_meth_name[i], callee->sval) && g_meth_ty[i] == rt) {
            found = 1;
            fidx = g_meth_fn[i];
        }
        i = i + 1;
    }
    if (!found) {
        // A generic method on a generic type (`b.get()` on `Box<i32>`): find
        // the template on the instance's base name and instantiate it for this
        // receiver. The result is registered as an ordinary method.
        char* ibase;
        int gi;
        ibase = ck_ty_instance_base(rt);
        if (ibase != 0) {
            gi = ck_find_gtmeth(ibase, callee->sval);
            if (gi >= 0) {
                int midx;
                midx = ck_instantiate_gtmeth(gi, rt);
                if (midx >= 0) {
                    found = 1;
                    fidx = midx;
                }
            }
        }
    }
    if (!found) {
        ck_err_no_field(callee, rt, callee->sval);
        return TY_INVALID;
    }
    {
        struct AstNode* fndecl;
        struct AstList* params;
        int np;
        int na;
        fndecl = g_fn_decl[fidx];
        params = fndecl->kids2;
        np = 0;
        na = 0;
        if (params != 0) { np = params->len; }
        if (args != 0) { na = args->len; }
        // `self` is implicit: the receiver supplies it.
        if (np > 0) { np = np - 1; }
        if (np != na) {
            ck_err_arity(n, callee->sval, np, na);
            return fndecl->ty;
        }
        i = 0;
        while (i < na) {
            int at;
            at = ck_expr(args->items[i]);
            if (at != TY_INVALID && params->items[i + 1]->ty != TY_INVALID
                && !ck_coercible(params->items[i + 1]->ty, at)) {
                ck_err_type_mismatch(args->items[i], params->items[i + 1]->ty, at,
                                     "argument");
            }
            ck_stamp_lits(args->items[i], params->items[i + 1]->ty);
            i = i + 1;
        }
    }
    return g_fn_decl[fidx]->ty;
}

// `Type::method(args)`: an associated function (a method with no `self`).
// The parser flattens the path to "Type::method", so split on the last `::`.
// The shared construction core: `ty` is the enum, `vname` the variant. Checks
// payload arity and argument types, marks the call node, and returns the enum
// type. Returns TY_INVALID without a diagnostic when the variant does not
// exist.
int ck_enum_construct_ty(struct AstNode* n, int ty, char* vname, struct AstList* args) {
    int vi;
    int pid;
    int i;
    int np;
    int na;
    if (ty_kind(ty) != CTY_ENUM) { return TY_INVALID; }
    vi = ty_find_member(ty, vname);
    if (vi < 0) { return TY_INVALID; }
    pid = ty_member_type(ty, vi);
    // Check the payload arity and the argument types.
    np = ty_member_count(pid);
    na = ck_argc(args);
    if (np != na) {
        ck_err_arity(n, vname, np, na);
        return ty;
    }
    i = 0;
    while (i < na) {
        int at;
        int want;
        at = ck_expr(args->items[i]);
        want = ty_member_type(pid, i);
        if (at != TY_INVALID && !ck_coercible(want, at)) {
            ck_err_type_mismatch(args->items[i], want, at, "argument");
        }
        ck_stamp_lits(args->items[i], want);
        i = i + 1;
    }
    // `n->ival` carries the variant index offset by a base so it never
    // collides with the builtin markers the backend checks (1..7) or with 0
    // (a plain call). `n->ival` is an integer field, so the AST walkers that
    // dereference the pointer fields never see it.
    n->ival = 1000 + vi;
    n->ty = ty;
    return ty;
}

// `Enum::Variant(payload...)` constructs an enum value (§6.5). The tag is the
// variant index; the payload fields are the variant's members. Returns
// TY_INVALID (and leaves no diagnostic) when the name is not an enum variant,
// so the caller can fall through to a type associated-function call.
int ck_enum_construct(struct AstNode* n, struct AstNode* callee, struct AstList* args) {
    int cut;
    char* ename;
    char* vname;
    int sym;
    int ty;
    cut = str_rfind(callee->sval, "::");
    ename = str_prefix(callee->sval, cut);
    vname = callee->sval + cut + 2;
    sym = ck_lookup(ename);
    if (sym < 0 || g_sym_kind[sym] != SK_TYPE) { return TY_INVALID; }
    ty = g_sym_ty[sym];
    return ck_enum_construct_ty(n, ty, vname, args);
}

// An unqualified `Variant(payload...)` call (§6.5): resolve the variant
// against every in-scope enum, rejecting ambiguity. Returns TY_INVALID (no
// diagnostic) when no enum defines the name.
int ck_enum_construct_unqualified(struct AstNode* n, struct AstList* args) {
    int i;
    int found;
    int fty;
    found = 0;
    fty = TY_INVALID;
    // An expected type narrows the search first (§5.3 prelude enums are
    // templates, so a plain symbol scan would not see `Maybe<i32>`).
    if (g_expected_ty != 0 && ty_kind(g_expected_ty) == CTY_ENUM
        && ty_find_member(g_expected_ty, n->a->sval) >= 0) {
        return ck_enum_construct_ty(n, g_expected_ty, n->a->sval, args);
    }
    i = 0;
    while (i < g_nsyms) {
        if (g_sym_kind[i] == SK_TYPE && ty_kind(g_sym_ty[i]) == CTY_ENUM) {
            if (ty_find_member(g_sym_ty[i], n->a->sval) >= 0) {
                if (found) { return TY_INVALID; }   // ambiguous
                found = 1;
                fty = g_sym_ty[i];
            }
        }
        i = i + 1;
    }
    if (!found) { return TY_INVALID; }
    return ck_enum_construct_ty(n, fty, n->a->sval, args);
}

int ck_expr_assoc_call(struct AstNode* n, struct AstNode* callee, struct AstList* args) {
    int cut;
    char* tname;
    char* mname;
    int sym;
    int ty;
    int i;
    cut = str_rfind(callee->sval, "::");
    tname = str_prefix(callee->sval, cut);
    mname = callee->sval + cut + 2;

    // `Heap::from_raw(p)` / `Heap::into_raw(h)` (§13.5). `Heap` is a
    // compiler-recognized type, not a registered one, so these are matched by
    // name. `into_raw` yields the box's pointer (safe: it only stops
    // tracking); `from_raw` re-takes ownership (unlocked).
    if (str_eq(tname, "Heap")) {
        if (str_eq(mname, "into_raw") && args != 0 && args->len == 1) {
            int at;
            at = ck_expr(args->items[0]);
            if (!ty_is_heap(at)) {
                ck_err_type_mismatch(args->items[0], ty_new(CTY_HEAP, "Heap<T>", TY_U8, 0), at, "`Heap::into_raw` value");
            }
            {
                int elem;
                elem = TY_U8;
                if (ty_is_heap(at)) { elem = ty_elem(at); }
                n->ival = 14;
                n->ty = ty_new(CTY_MUTPTR, ck_ref_name("raw mut", elem), elem, 0);
                return n->ty;
            }
        }
        if (str_eq(mname, "from_raw") && args != 0 && args->len == 1) {
            int at;
            ck_raw_needs_unchecked(n, "`Heap::from_raw`");
            at = ck_expr(args->items[0]);
            if (!ty_is_ptr(at)) {
                ck_err_type_mismatch(args->items[0], ty_new(CTY_MUTPTR, "raw mut T", TY_U8, 0), at, "`Heap::from_raw` value");
            }
            {
                int elem;
                elem = TY_U8;
                if (ty_is_ptr(at)) { elem = ty_elem(at); }
                n->ival = 15;
                n->ty = ty_new(CTY_HEAP, ck_ref_name("heap", elem), elem, 0);
                return n->ty;
            }
        }
    }

    sym = ck_lookup(tname);
    if (sym < 0 || g_sym_kind[sym] != SK_TYPE) {
        ck_err_unknown_name(tname, callee, "the name before `::` must be a type");
        return TY_INVALID;
    }
    ty = g_sym_ty[sym];
    return ck_assoc_call_ty(n, ty, mname, args);
}

// Checks `Type::assoc(args)` against an already-resolved receiver type id:
// finds the (non-receiver) method `mname` on `ty` and checks the arguments.
int ck_assoc_call_ty(struct AstNode* n, int ty, char* mname, struct AstList* args) {
    int i;
    // A generic method template on a generic type: `Box<i32>::make(3)`.
    {
        char* ibase;
        ibase = ck_ty_instance_base(ty);
        if (ibase != 0) {
            int gi;
            gi = ck_find_gtmeth(ibase, mname);
            if (gi >= 0) {
                // Only an associated (no-receiver) can be reached here; the
                // instance is keyed by receiver type, so ensure one exists.
                ck_instantiate_gtmeth(gi, ty);
            }
        }
    }
    i = 0;
    while (i < g_nmeth) {
        if (g_meth_ty[i] == ty && str_eq(g_meth_name[i], mname)) {
            struct AstNode* fn;
            struct AstList* params;
            int np;
            int na;
            fn = g_fn_decl[g_meth_fn[i]];
            params = fn->kids2;
            np = 0;
            na = 0;
            if (params != 0) { np = params->len; }
            if (args != 0) { na = args->len; }
            // An associated function has no receiver.
            if (np != na) {
                ck_err_arity(n, mname, np, na);
                return fn->ty;
            }
            {
                int k;
                k = 0;
                while (k < na) {
                    int at;
                    at = ck_expr(args->items[k]);
                    if (at != TY_INVALID && params->items[k]->ty != TY_INVALID
                        && !ck_coercible(params->items[k]->ty, at)) {
                        ck_err_type_mismatch(args->items[k], params->items[k]->ty, at,
                                             "argument");
                    }
                    ck_stamp_lits(args->items[k], params->items[k]->ty);
                    k = k + 1;
                }
            }
            return fn->ty;
        }
        i = i + 1;
    }
    ck_err_no_field(n, ty, mname);
    return TY_INVALID;
}

// `expr as Type` (§5.10): explicit-only, **lossless** conversions. `char` has
// exactly two documented conversions — `char as u32` (a scalar always fits in
// a u32) and `u8 as char` (every u8 is a valid scalar). Anything else that
// would lose data or fabricate an invalid scalar is rejected.
int ck_expr_as(struct AstNode* n) {
    int from;
    int to;
    from = ck_expr(n->a);
    to = ck_resolve_type(n->b);
    if (from == TY_INVALID || to == TY_INVALID) { return TY_INVALID; }
    if (ty_is_untyped_lit(from)) { return to; }
    if (from == TY_CHAR && to == TY_U32) { return to; }
    if (from == TY_U8 && to == TY_CHAR) { return to; }
    if (ty_is_integer(from) && ty_is_integer(to)) { return to; }
    if (ty_is_float(from) && ty_is_float(to)) { return to; }
    if (ty_is_integer(from) && ty_is_float(to)) { return to; }
    if (ty_is_float(from) && ty_is_integer(to)) { return to; }
    if (ty_is_ref(from) && ty_is_ptr(to)) { return to; }   // unchecked-gated in M6
    // Raw pointer <-> integer (§13.5, §5.10): reaching an address as a number
    // (or turning an integer back into an address) is an unlocked operation.
    if (ty_is_ptr(from) && ty_is_integer(to)) {
        ck_raw_needs_unchecked(n, "casting a raw pointer to an integer");
        return to;
    }
    if (ty_is_integer(from) && ty_is_ptr(to)) {
        ck_raw_needs_unchecked(n, "casting an integer to a raw pointer");
        return to;
    }
    if (ty_is_ptr(from) && ty_is_ptr(to)) { return to; }   // unchecked-gated below
    diag_stop("TYPE-05", "unsupported cast",
              "These types have no `as` conversion.",
              diag_file(n->file), n->start, n->end);
    return TY_INVALID;
}

// `Name { field: value, ... }`.
int ck_expr_struct_init(struct AstNode* n) {
    int sym;
    int ty;
    int i;
    struct AstList* inits;
    // A generic struct literal (`Box<i32> { .v = 1 }`): the parser stores the
    // type arguments in `n->kids2` (the field initializers are in `kids`).
    if (n->kids2 != 0 && n->kids2->len > 0) {
        ty = ck_instantiate_type(n, n->sval, n->kids2);
        if (ty == TY_INVALID) { return TY_INVALID; }
    } else {
        sym = ck_lookup(n->sval);
        if (sym < 0 || g_sym_kind[sym] != SK_TYPE) {
            // A generic template name without arguments: a clear stop.
            if (ck_find_ty_template(n->sval) >= 0) {
                diag_stop("TYPE-01", "a generic type needs type arguments",
                          "Write the instantiation: `Box<i32> { ... }` (§5.8).",
                          diag_file(n->file), n->start, n->end);
                return TY_INVALID;
            }
            ck_err_unknown_type(n->sval, n);
            return TY_INVALID;
        }
        ty = g_sym_ty[sym];
    }
    inits = n->kids;
    if (inits != 0) {
        i = 0;
        while (i < inits->len) {
            struct AstNode* fi;
            int vt;
            int mi;
            fi = inits->items[i];
            vt = ck_expr(fi->a);
            mi = ty_find_member(ty, fi->sval);
            if (mi < 0) {
                ck_err_no_field(fi, ty, fi->sval);
            } else {
                int want;
                want = ty_member_type(ty, mi);
                if (vt != TY_INVALID && want != TY_INVALID && !ck_coercible(want, vt)) {
                    ck_err_type_mismatch(fi, want, vt, "field value");
                }
                ck_stamp_lits(fi->a, want);
            }
            i = i + 1;
        }
    }
    return ty;
}

// The concrete type named by an integer literal suffix (`42u8`, `7i64`).
// Mirrors the backend's `ll_suffix_ty`; the suffix set is the primitive types
// (lexlit's `suffix_is_known`). Unknown suffixes never reach here.
int ck_suffix_ty(char* suffix) {
    if (str_eq(suffix, "u8")) { return TY_U8; }
    if (str_eq(suffix, "u16")) { return TY_U16; }
    if (str_eq(suffix, "u32")) { return TY_U32; }
    if (str_eq(suffix, "u64")) { return TY_U64; }
    if (str_eq(suffix, "usize")) { return TY_USIZE; }
    if (str_eq(suffix, "i8")) { return TY_I8; }
    if (str_eq(suffix, "i16")) { return TY_I16; }
    if (str_eq(suffix, "i32")) { return TY_I32; }
    if (str_eq(suffix, "i64")) { return TY_I64; }
    if (str_eq(suffix, "isize")) { return TY_ISIZE; }
    return TY_I32;
}

// `[a, b, c]` or `[v; n]`.
int ck_expr_array_lit(struct AstNode* n) {
    int et;
    int i;
    int hint;
    struct AstList* els;
    els = n->kids;
    et = TY_INVALID;
    // Consume the declared-element-type hint (§5.9) exactly once: a *nested*
    // array literal must not see the outer context's hint.
    hint = g_array_elem_hint;
    g_array_elem_hint = 0;
    if (els != 0 && els->len > 0) {
        et = ck_expr(els->items[0]);
        i = 1;
        while (i < els->len) {
            int t2;
            t2 = ck_expr(els->items[i]);
            if (et != TY_INVALID && t2 != TY_INVALID && !ty_eq(et, t2)) {
                ck_err_type_mismatch(els->items[i], et, t2, "array element");
            }
            i = i + 1;
        }
        // The element type: a declared array context (§5.9) wins over the
        // i32/f64 default; otherwise the first element's type, defaulted.
        if (hint != 0) {
            et = hint;
        } else {
            if (et == TY_UINT_LIT) { et = TY_I32; }
            if (et == TY_FLOAT_LIT) { et = TY_F64; }
        }
        if (els != 0) {
            i = 0;
            while (i < els->len) {
                ck_stamp_lits(els->items[i], et);
                i = i + 1;
            }
        }
        lexbuf_reset();
        lexbuf_push_str("[");
        lexbuf_push_str(ty_display(et));
        lexbuf_push_str("; ");
        lexbuf_push_int(els->len);
        lexbuf_push_str("]");
        return ty_new(CTY_ARRAY, lexbuf_finish(), et, els->len);
    }
    // `[v; n]` form: a = value, b = count expr.
    if (n->a != 0) {
        et = ck_expr(n->a);
        if (hint != 0) {
            et = hint;
        } else {
            if (et == TY_UINT_LIT) { et = TY_I32; }
            if (et == TY_FLOAT_LIT) { et = TY_F64; }
        }
        ck_stamp_lits(n->a, et);
        {
            int len;
            len = ceval_const_int(n->b);
            if (len < 0) { len = 0; }
            lexbuf_reset();
            lexbuf_push_str("[");
            lexbuf_push_str(ty_display(et));
            lexbuf_push_str("; ");
            lexbuf_push_int(len);
            lexbuf_push_str("]");
            return ty_new(CTY_ARRAY, lexbuf_finish(), et, len);
        }
    }
    diag_stop("TYPE-05", "empty array literal",
              "An array needs at least one element (or use `[v; n]`).",
              diag_file(n->file), n->start, n->end);
    return TY_INVALID;
}

int ck_expr_borrow(struct AstNode* n) {
    int t;
    int is_mut;
    is_mut = n->ival & 1;
    t = ck_expr(n->a);
    if (t == TY_INVALID) { return TY_INVALID; }
    // A slice or `&str` is already a reference (a fat pointer): `&a[1..3]` /
    // `&s[1..4]` borrows the range and yields the pair itself, not another
    // layer (§5.2). `&mut a[..]` upgrades a slice to the exclusive type so
    // writes through it are sound.
    if (ty_kind(t) == CTY_STRREF) {
        return t;
    }
    if (ty_kind(t) == CTY_SLICE) {
        if (is_mut && !ty_slice_is_mut(t)) {
            return ck_slice_ty_mut(ty_elem(t), 1);
        }
        // A shared reborrow of an exclusive slice (`&s[..]`) is shared: the
        // resulting type reflects the borrow that was written, not the
        // capability of the source.
        if (!is_mut && ty_slice_is_mut(t)) {
            return ck_slice_ty_mut(ty_elem(t), 0);
        }
        return t;
    }
    if (is_mut) {
        return ty_new(CTY_MUTREF, ck_ref_name("&mut", t), t, 0);
    }
    return ty_new(CTY_REF, ck_ref_name("&", t), t, 0);
}

int ck_expr_deref(struct AstNode* n) {
    int t;
    t = ck_expr(n->a);
    if (t == TY_INVALID) { return TY_INVALID; }
    if (!ty_is_ref(t) && !ty_is_heap(t) && !ty_is_ptr(t)) {
        diag_stop("TYPE-02", "cannot dereference this type",
                  "Only references, raw pointers, and `heap` boxes can be dereferenced.",
                  diag_file(n->a->file), n->a->start, n->a->end);
        return TY_INVALID;
    }
    return ty_elem(t);
}

// `raw(&x)` / `raw(&mut x)` (§13.5): a safe raw-pointer *creation* that yields
// `raw T` / `raw mut T` over the referent. Only a borrow is accepted, so the
// operand's address is well-defined (no dangling temporary). Creating a raw
// pointer from an existing `raw` value is a no-op (keeps its pointer-ness).
int ck_expr_raw(struct AstNode* n) {
    int t;
    int elem;
    int is_mut;
    t = ck_expr(n->a);
    if (t == TY_INVALID) { return TY_INVALID; }
    // Already a raw pointer: `raw(p)` is the identity on the raw type.
    if (ty_is_ptr(t)) { return t; }
    if (!ty_is_ref(t)) {
        diag_stop("TYPE-02", "cannot make a raw pointer from this",
                  "`raw(...)` takes a borrow: write `raw(&x)` or `raw(&mut x)`.",
                  diag_file(n->a->file), n->a->start, n->a->end);
        return TY_INVALID;
    }
    elem = ty_elem(t);
    is_mut = ty_kind(t) == CTY_MUTREF;
    if (is_mut) {
        return ty_new(CTY_MUTPTR, ck_ref_name("raw mut", elem), elem, 0);
    }
    return ty_new(CTY_PTR, ck_ref_name("raw", elem), elem, 0);
}

// `heap(expr)` (§12): a heap box over the operand's type.
int ck_expr_heap(struct AstNode* n) {
    int t;
    t = ck_expr(n->a);
    if (t == TY_INVALID) { return TY_INVALID; }
    if (t == TY_UINT_LIT) { t = TY_I32; }
    if (t == TY_FLOAT_LIT) { t = TY_F64; }
    return ty_new(CTY_HEAP, ck_ref_name("heap", t), t, 0);
}

int ck_expr_sizeof(struct AstNode* n) {
    int t;
    t = ck_resolve_type(n->a);
    if (t == TY_INVALID) { return TY_INVALID; }
    n->ival = ty_size(t);
    return TY_USIZE;
}
