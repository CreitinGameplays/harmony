// harmony-base — the type checker, part 1: items, symbols, types, statements
// (docs/harmony.md §5, §6, §8, §19.1 stage 4).
//
// Two passes over the program:
//   1. register items — structs/enums (with their members), consts, function
//      signatures, and methods — so a body can reference anything declared
//      anywhere in the module (c2x-seed itself requires use-before-decl, but
//      the *language* does not);
//   2. check bodies — walk statements and expressions, fill `n->ty`, and
//      report the §16 diagnostics.
//
// Layout:
//   check.c2 — symbol table, item registration, type resolution, statements
//   cexpr.c2 — expressions (precedence-free: the parser already built the tree)
//
// M1 scope: scalars, functions, structs, enums, `switch`, arrays/slices,
// references, `heap`, `sizeof`, casts. Loans (`life`), drop elaboration and
// the borrow checker arrive in M2–M4 (§19.7); this pass already rejects the
// cases it can see (unknown names, arity, type mismatches, non-exhaustive
// switches, missing returns) so the diagnostics pipeline is exercised.

// ---------------------------------------------------------------------------
// Forward declarations. c2x-seed resolves names from earlier text only, so
// every function in this file is declared up front; the expression half of
// the checker (cexpr.c2) is declared in common.c2.
// ---------------------------------------------------------------------------
void ck_register_primitives(void);
void ck_check_main(void);
void ck_scope_push(void);
void ck_scope_pop(void);
int ck_declare(char* name, int kind, int ty, struct AstNode* decl, int mut);
int ck_lookup(char* name);
int ck_lookup_type(char* name);
int ck_sym_kind(char* name);
void ck_err_name_taken(char* name, struct AstNode* at);
void ck_err_unknown_name(char* name, struct AstNode* at, char* what);
void ck_err_unknown_type(char* name, struct AstNode* at);
void ck_err_type_mismatch(struct AstNode* at, int want, int got, char* what);
void ck_err_arity(struct AstNode* at, char* name, int want, int got);
void ck_err_not_callable(struct AstNode* at, int ty);
void ck_err_no_field(struct AstNode* at, int ty, char* field);
void ck_err_not_mut(struct AstNode* at, char* name);
void ck_err_uninit(struct AstNode* at, char* name);
void ck_err_nonexhaustive(struct AstNode* at, int ty);
void ck_err_missing_return(struct AstNode* fn);
void ck_stamp_lits(struct AstNode* n, int want);
void ck_err_needs_unchecked(struct AstNode* at, char* what);
void ck_err_needs_unchecked_fn(struct AstNode* at, char* name);
void ck_err_weak_reason(struct AstNode* at);
void ck_err_deny_unchecked(struct AstNode* at);
void ck_set_deny_unchecked(int on);
int  ck_in_unchecked(void);
int ck_cur_fn(void);
int ck_is_self_param(struct AstNode* p);
int ck_resolve_type(struct AstNode* t);
char* ck_ref_name(char* pre, int inner);
void ck_register_program(struct AstNode* prog);
void ck_register_item(struct AstNode* n);
void ck_register_struct(struct AstNode* n);
void ck_register_enum(struct AstNode* n);
void ck_fill_struct(struct AstNode* n);
void ck_fill_enum(struct AstNode* n);
void ck_register_const(struct AstNode* n);
void ck_register_fn(struct AstNode* n);
void ck_register_extern(struct AstNode* n);
void ck_register_methods(struct AstNode* n);
void ck_check_bodies(void);
void ck_check_fn(struct AstNode* fn, int idx);
int ck_block_ends_in_return(struct AstNode* blk);
void ck_stmt_block(struct AstNode* blk);
void ck_stmt(struct AstNode* n);
void ck_stmt_let(struct AstNode* n);
void ck_stmt_assign(struct AstNode* n);
int ck_place(struct AstNode* n);
void ck_check_place_mut(struct AstNode* n);
void ck_stmt_if(struct AstNode* n);
void ck_stmt_while(struct AstNode* n);
void ck_stmt_for(struct AstNode* n);
void ck_stmt_switch(struct AstNode* n);
void ck_check_pattern(struct AstNode* p, int st, int* seen, int* nseen);
void ck_note_variant(struct AstNode* p, int st, int vi, int* seen, int* nseen);
void ck_stmt_return(struct AstNode* n);
int ceval_const_int(struct AstNode* n);
void check_program(struct AstNode* prog);

// ---------------------------------------------------------------------------
// Symbol table. Flat, resizable; scopes are marks into the array.
// ---------------------------------------------------------------------------
const int SK_FN     = 1;   // function: ty = return type, decl = AST_FN
const int SK_CONST  = 2;   // constant: ty = declared type
const int SK_LET    = 3;   // local binding: ty = inferred/declared type
const int SK_PARAM  = 4;   // parameter
const int SK_TYPE   = 5;   // nominal type: ty = type id
const int SK_SELF   = 6;   // `self` inside a methods block
const int SK_GEN    = 7;   // generic parameter (T): ty = its placeholder id

// `unchecked` state (§13): a depth counter so nested blocks work, and the
// --deny-unchecked switch (UNCK-05). Both are consulted by expression checks
// for operations that need the escape hatch (extern calls, unchecked fns).
int g_unchecked_depth;
int g_deny_unchecked;

char* g_sym_name[4096];
int g_sym_kind[4096];
int g_sym_ty[4096];
struct AstNode* g_sym_decl[4096];
int g_sym_mut[4096];
int g_sym_init[4096];  // definite-initialization tracking (INIT-01)
int g_nsyms;
int g_scope[256];      // scope start marks
int g_nscope;

void ck_scope_push(void) {
    g_scope[g_nscope] = g_nsyms;
    g_nscope = g_nscope + 1;
}

void ck_scope_pop(void) {
    if (g_nscope > 0) {
        g_nscope = g_nscope - 1;
        g_nsyms = g_scope[g_nscope];
    }
}

// Adds a symbol. Returns its index, or -1 when the name is already taken in
// the *current* scope (NAME-03).
int ck_declare(char* name, int kind, int ty, struct AstNode* decl, int mut) {
    int i;
    int lo;
    lo = 0;
    if (g_nscope > 0) { lo = g_scope[g_nscope - 1]; }
    i = g_nsyms - 1;
    while (i >= lo) {
        if (str_eq(g_sym_name[i], name)) {
            ck_err_name_taken(name, decl);
            return -1;
        }
        i = i - 1;
    }
    if (g_nsyms >= 4096) { return -1; }
    g_sym_name[g_nsyms] = name;
    g_sym_kind[g_nsyms] = kind;
    g_sym_ty[g_nsyms] = ty;
    g_sym_decl[g_nsyms] = decl;
    g_sym_mut[g_nsyms] = mut;
    // Parameters and constants hold a value from the moment they exist;
    // locals start uninitialized and are marked by `ck_stmt_let`.
    if (kind == SK_PARAM || kind == SK_CONST || kind == SK_SELF) {
        g_sym_init[g_nsyms] = 1;
    } else {
        g_sym_init[g_nsyms] = 0;
    }
    g_nsyms = g_nsyms + 1;
    return g_nsyms - 1;
}

// Innermost binding of a name (shadowing: later entries win).
int ck_lookup(char* name) {
    int i;
    i = g_nsyms - 1;
    while (i >= 0) {
        if (str_eq(g_sym_name[i], name)) { return i; }
        i = i - 1;
    }
    return -1;
}

// ---- Registry accessors for the backend (see common.c2) ----

int ck_nfn(void) { return g_nfn; }

struct AstNode* ck_fn(int i) {
    if (i < 0 || i >= g_nfn) { return 0; }
    return g_fn_decl[i];
}

int ck_nmeth(void) { return g_nmeth; }

// Generic-function instances (monomorphized templates), emitted alongside the
// source functions.
int ck_ngen_inst(void) { return g_ngen_inst; }
struct AstNode* ck_gen_inst(int i) {
    if (i < 0 || i >= g_ngen_inst) { return 0; }
    return g_gen_inst[i];
}

int ck_meth_fn(int i) {
    if (i < 0 || i >= g_nmeth) { return -1; }
    return g_meth_fn[i];
}

char* ck_meth_name(int i) {
    if (i < 0 || i >= g_nmeth) { return 0; }
    return g_meth_name[i];
}

int ck_meth_ty(int i) {
    if (i < 0 || i >= g_nmeth) { return 0; }
    return g_meth_ty[i];
}

int ck_fn_self_ty(int i) {
    if (i < 0 || i >= 1024) { return 0; }
    return g_fn_self_ty[i];
}

int ck_fn_ret_ty(struct AstNode* fn) {
    if (fn == 0) { return TY_UNIT; }
    if (fn->ty == 0) { return TY_UNIT; }
    return fn->ty;
}

// The symbol-kind id of a name (or 0), for the backend's queries.
int ck_sym_kind(char* name) {
    int i;
    i = g_nsyms - 1;
    while (i >= 0) {
        if (str_eq(g_sym_name[i], name)) { return g_sym_kind[i]; }
        i = i - 1;
    }
    return 0;
}

// True when `name` resolves to an `extern fn` declaration (the backend keeps
// the C symbol unmangled for it).
int ck_sym_is_extern(char* name) {
    int i;
    i = g_nsyms - 1;
    while (i >= 0) {
        if (str_eq(g_sym_name[i], name)) {
            return g_sym_kind[i] == SK_FN && g_sym_decl[i] != 0
                && g_sym_decl[i]->kind == AST_EXTERN_FN;
        }
        i = i - 1;
    }
    return 0;
}

// Resolves a type name to its type id, or TY_INVALID. Looks for a nominal
// type or a generic parameter (both register as SK_TYPE / SK_GEN).
int ck_lookup_type(char* name) {
    int i;
    i = g_nsyms - 1;
    while (i >= 0) {
        if (str_eq(g_sym_name[i], name)) {
            if (g_sym_kind[i] == SK_TYPE || g_sym_kind[i] == SK_GEN) {
                return g_sym_ty[i];
            }
            return TY_INVALID;
        }
        i = i - 1;
    }
    return TY_INVALID;
}

// ---------------------------------------------------------------------------
// Item registries.
// ---------------------------------------------------------------------------
struct AstNode* g_fn_decl[1024];   // AST_FN nodes, in declaration order
int g_nfn;

// Generic-function templates and their monomorphized instances (§18). A
// generic `fn` is *not* registered as a callable symbol; each call site with
// explicit type arguments clones the template, substitutes the type nodes, and
// registers a concrete instance (`id__i32`) as an ordinary function, which the
// normal body-checking and emission then handle.
struct AstNode* g_gen_decl[256];   // template AST_FN nodes
char* g_gen_name[256];
int g_ngen;

struct AstNode* g_gen_inst[512];   // instantiated AST_FN clones (emitted too)
int g_ngen_inst;

int g_meth_ty[1024];               // receiver type id per method
char* g_meth_name[1024];
int g_meth_fn[1024];               // index into g_fn_decl
int g_nmeth;

struct AstNode* g_prog;            // program root (for --dump-ast and later)

// Element-type hint for the next array literal (§5.9). Set while a `let` with
// a declared array type checks its initializer, so `let a: [i64; 3] = [1, 2, 3]`
// stamps the elements as i64 instead of the i32 default. 0 = no hint.
int g_array_elem_hint;

// ---------------------------------------------------------------------------
// Diagnostics helpers (§16). Every stop carries a `try:` fix where one is
// obvious; the wording lives in reports.c2 (`lc explain`).
// ---------------------------------------------------------------------------
void ck_err_name_taken(char* name, struct AstNode* at) {
    lexbuf_reset();
    lexbuf_push_str("the name `");
    lexbuf_push_str(name);
    lexbuf_push_str("` is already used in this scope");
    diag_stop("NAME-03", "name already in use", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_unknown_name(char* name, struct AstNode* at, char* what) {
    lexbuf_reset();
    lexbuf_push_str("no `");
    lexbuf_push_str(name);
    lexbuf_push_str("` in scope");
    diag_stop("NAME-01", "unknown name", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
    if (what != 0) {
        // A short "did you mean…" note travels with the diagnostic; the
        // long-form lesson lives in reports.c2 (`lc explain NAME-01`).
        diag_fix(diag_get(diag_stop_count() - 1), "hint", what);
    }
}

void ck_err_unknown_type(char* name, struct AstNode* at) {
    lexbuf_reset();
    lexbuf_push_str("no type named `");
    lexbuf_push_str(name);
    lexbuf_push_str("`");
    diag_stop("NAME-01", "unknown type", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_type_mismatch(struct AstNode* at, int want, int got, char* what) {
    lexbuf_reset();
    lexbuf_push_str(what);
    lexbuf_push_str(": expected `");
    lexbuf_push_str(ty_display(want));
    lexbuf_push_str("`, found `");
    lexbuf_push_str(ty_display(got));
    lexbuf_push_str("`");
    diag_stop("TYPE-01", "type mismatch", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_arity(struct AstNode* at, char* name, int want, int got) {
    lexbuf_reset();
    lexbuf_push_str("`");
    lexbuf_push_str(name);
    lexbuf_push_str("` takes ");
    lexbuf_push_int(want);
    lexbuf_push_str(" argument(s), got ");
    lexbuf_push_int(got);
    diag_stop("TYPE-03", "wrong number of arguments", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_not_callable(struct AstNode* at, int ty) {
    lexbuf_reset();
    lexbuf_push_str("`");
    lexbuf_push_str(ty_display(ty));
    lexbuf_push_str("` is not callable");
    diag_stop("TYPE-04", "not callable", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_no_field(struct AstNode* at, int ty, char* field) {
    lexbuf_reset();
    lexbuf_push_str("`");
    lexbuf_push_str(ty_display(ty));
    lexbuf_push_str("` has no field `");
    lexbuf_push_str(field);
    lexbuf_push_str("`");
    diag_stop("TYPE-02", "no such field", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_not_mut(struct AstNode* at, char* name) {
    lexbuf_reset();
    lexbuf_push_str("cannot assign to `");
    lexbuf_push_str(name);
    lexbuf_push_str("`: it is not declared `mut`");
    diag_stop("MUT-01", "assignment to immutable binding", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_uninit(struct AstNode* at, char* name) {
    lexbuf_reset();
    lexbuf_push_str("`");
    lexbuf_push_str(name);
    lexbuf_push_str("` is used before it is initialized");
    diag_stop("INIT-01", "use of uninitialized value", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_nonexhaustive(struct AstNode* at, int ty) {
    lexbuf_reset();
    lexbuf_push_str("`switch` on `");
    lexbuf_push_str(ty_display(ty));
    lexbuf_push_str("` needs a `default` arm (or every variant)");
    diag_stop("CASE-01", "non-exhaustive switch", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

void ck_err_missing_return(struct AstNode* fn) {
    lexbuf_reset();
    lexbuf_push_str("`");
    lexbuf_push_str(fn->sval);
    lexbuf_push_str("` must return `");
    lexbuf_push_str(ty_display(g_fn_ret_ty[ck_cur_fn()]));
    lexbuf_push_str("`, but control can reach the end of the body");
    diag_stop("RET-01", "missing return value", lexbuf_finish(),
              diag_file(fn->file), fn->start, fn->end);
}

// UNCK-01: an unlocked operation (here: calling an `extern fn`) outside an
// `unchecked("...")` block (§13.2).
void ck_err_needs_unchecked(struct AstNode* at, char* what) {
    lexbuf_reset();
    lexbuf_push_str(what);
    lexbuf_push_str(" needs `unchecked(\"why\") { ... }`");
    diag_stop("UNCK-01", "operation needs `unchecked`", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

// UNCK-04: calling a function whose declaration itself carries a contract
// (`unchecked("...") fn ...`) without promising it at the call site (§13.4).
void ck_err_needs_unchecked_fn(struct AstNode* at, char* name) {
    lexbuf_reset();
    lexbuf_push_str("`");
    lexbuf_push_str(name);
    lexbuf_push_str("` is an `unchecked fn`; calling it needs an `unchecked` block");
    diag_stop("UNCK-04", "calling a contract without promising it", lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

// UNCK-02: the reason must be a real reason — at least 12 characters.
void ck_err_weak_reason(struct AstNode* at) {
    diag_stop("UNCK-02", "the reason has to be a reason",
              "`unchecked` reasons must be at least 12 characters; say what makes the operation sound.",
              diag_file(at->file), at->start, at->end);
}

// UNCK-05: --deny-unchecked forbids the escape hatch entirely (§13.4).
void ck_err_deny_unchecked(struct AstNode* at) {
    diag_stop("UNCK-05", "`unchecked` is disabled by --deny-unchecked",
              "This build forbids the escape hatch. Remove the block or drop the flag.",
              diag_file(at->file), at->start, at->end);
}

void ck_set_deny_unchecked(int on) { g_deny_unchecked = on; }
int ck_in_unchecked(void) { return g_unchecked_depth > 0; }

// ---------------------------------------------------------------------------
// Format strings (FMT-01, §15.1). `print`/`println`/`eprintln`/`format` are
// recognized only for their format strings; the arguments are checked against
// the placeholders here.
// ---------------------------------------------------------------------------
void ck_err_fmt(struct AstNode* at, char* title, char* summary) {
    lexbuf_reset();
    lexbuf_push_str(summary);
    diag_stop("FMT-01", title, lexbuf_finish(),
              diag_file(at->file), at->start, at->end);
}

// Is `ty` displayable with `{}`? Scalars, `&str`, `char`, `bool`, and (for
// `{?}`) anything with a structural form. M1 accepts the scalar surface.
int ck_fmt_displayable(int ty) {
    if (ty == TY_UNIT) { return 1; }
    if (ty_is_untyped_lit(ty)) { return 1; }
    if (ty_is_integer(ty) || ty_is_float(ty) || ty_is_bool(ty) || ty_is_char(ty)) { return 1; }
    if (ty_kind(ty) == CTY_STRREF) { return 1; }
    return 0;
}

// Checks the format string (argument 0) of a print-family call against the
// remaining arguments. `fmt` is the literal node; `args` the full argument
// list. Returns 0 when the call is well-formed.
int ck_check_format(struct AstNode* n, char* fname, struct AstList* args) {
    struct AstNode* fmt;
    int nfields;
    int i;
    if (args == 0 || args->len == 0) {
        ck_err_fmt(n, "format string missing",
                   "This function needs a format string as its first argument.");
        return 1;
    }
    fmt = args->items[0];
    if (fmt->kind != AST_STRING_LIT) {
        ck_err_fmt(fmt, "format string must be a literal",
                   "The format must be a plain string literal so it can be checked at compile time.");
        return 1;
    }
    nfields = fmt_parse(fmt->sval, fmt->ival);
    if (nfields < 0) {
        ck_err_fmt(fmt, "malformed format string",
                   "A `{` must close with `}`, and a lone `}` must be written `}}`.");
        return 1;
    }
    if (args->len - 1 != nfields) {
        lexbuf_reset();
        lexbuf_push_str(fname);
        lexbuf_push_str(" has ");
        lexbuf_push_int(nfields);
        lexbuf_push_str(" placeholder(s) but ");
        lexbuf_push_int(args->len - 1);
        lexbuf_push_str(" argument(s)");
        ck_err_fmt(fmt, "argument count does not match the format", lexbuf_finish());
        return 1;
    }
    // Check each argument's type against its placeholder.
    i = 0;
    while (i < nfields) {
        struct AstNode* arg;
        int at;
        int j;
        j = i;
        arg = args->items[i + 1];
        at = ck_expr(arg);
        // An untyped literal adopts a concrete type here: integers -> i32,
        // floats -> f64 (the same defaults as `let x = 1`).
        if (at == TY_UINT_LIT) { ck_stamp_lits(arg, TY_I32); at = TY_I32; }
        else if (at == TY_FLOAT_LIT) { ck_stamp_lits(arg, TY_F64); at = TY_F64; }
        // Find the i-th field piece (skip literal pieces).
        {
            int k;
            int seen;
            int kind;
            k = 0;
            seen = 0;
            kind = FMT_DISP;
            while (k < g_fmt_n) {
                if (g_fmt_kind[k] != FMT_LIT) {
                    if (seen == j) { kind = g_fmt_kind[k]; break; }
                    seen = seen + 1;
                }
                k = k + 1;
            }
            if (at != TY_INVALID) {
                if (kind == FMT_HEX && !ty_is_integer(at) && !ty_is_untyped_lit(at)) {
                    ck_err_fmt(arg, "`{:x}` needs an integer",
                               "Hexadecimal formatting is defined for integer types only.");
                } else if (kind == FMT_DISP && !ck_fmt_displayable(at)) {
                    ck_err_fmt(arg, "this type cannot be displayed",
                               "`{}` accepts integers, floats, bool, char, and &str in M1.");
                }
            }
        }
        i = i + 1;
    }
    return 0;
}


// ---------------------------------------------------------------------------
// Function context (the body currently being checked).
// ---------------------------------------------------------------------------
int g_fn_ret_ty[64];   // return type id per nesting levelint g_fn_idx[64];      // index into g_fn_decl
int g_fn_depth;
int g_loop_depth;

// Per-function receiver type (0 for a free function): the type of `self`
// inside a method body.
int g_fn_self_ty[1024];

int ck_cur_fn(void) {
    if (g_fn_depth <= 0) { return 0; }
    return g_fn_depth - 1;
}

// The four `self` parameter spellings (§6.6).
int ck_is_self_param(struct AstNode* p) {
    if (p == 0 || p->sval == 0) { return 0; }
    if (str_eq(p->sval, "self") || str_eq(p->sval, "mut self")) { return 1; }
    if (str_eq(p->sval, "&self") || str_eq(p->sval, "&mut self")) { return 1; }
    return 0;
}

// ---------------------------------------------------------------------------
// Type resolution: a type AST node -> type id.
//
// Nominal types dedup by name so `Point` used twice is one id. Generic
// parameters resolve to their placeholder ids (registered as SK_GEN).
// ---------------------------------------------------------------------------
// The one slice-reference type for an element type (§5.2). A slice is
// represented as the (pointer, length) pair itself, so `&[T]` and `&mut [T]`
// differ only by the exclusivity bit stored in the type entry (`b`):
// mutability of a slice is part of its type, since writing through it must be
// allowed (and holding a shared alias forbidden) exactly when it is exclusive.
int ck_slice_ty_mut(int elem, int is_mut) {
    lexbuf_reset();
    if (is_mut) { lexbuf_push_str("&mut ["); } else { lexbuf_push_str("&["); }
    lexbuf_push_str(ty_display(elem));
    lexbuf_push_str("]");
    return ty_new(CTY_SLICE, lexbuf_finish(), elem, is_mut);
}

int ck_slice_ty(int elem) {
    return ck_slice_ty_mut(elem, 0);
}

// True when a type is an aggregate *value* (addressed, not a scalar/pointer):
// struct, enum, array, slice, or `&str`. Used by call-argument coercion
// (an aggregate place borrows to `&T`), mirroring the backend's criterion.
int ck_is_aggregate(int ty) {
    int k;
    k = ty_kind(ty);
    return k == CTY_STRUCT || k == CTY_ENUM || k == CTY_ARRAY
        || k == CTY_SLICE || k == CTY_STRREF;
}

int ck_resolve_type(struct AstNode* t) {
    int k;
    if (t == 0) { return TY_UNIT; }
    k = t->kind;
    if (k == AST_TYPE_NAME) {
        int sym;
        // `Heap<T>` is a §12 compiler-recognized type (the `heap(x)` form is
        // its constructor): resolve it to the box type directly.
        if (str_eq(t->sval, "Heap")) {
            int inner;
            if (t->kids == 0 || t->kids->len == 0) {
                ck_err_unknown_type(t->sval, t);
                return TY_INVALID;
            }
            inner = ck_resolve_type(t->kids->items[0]);
            if (inner == TY_INVALID) { return TY_INVALID; }
            return ty_new(CTY_HEAP, ck_ref_name("heap", inner), inner, 0);
        }
        sym = ck_lookup(t->sval);
        if (sym < 0) {
            ck_err_unknown_type(t->sval, t);
            return TY_INVALID;
        }
        if (g_sym_kind[sym] != SK_TYPE && g_sym_kind[sym] != SK_GEN) {
            ck_err_unknown_type(t->sval, t);
            return TY_INVALID;
        }
        return g_sym_ty[sym];
    }
    if (k == AST_TYPE_REF) {
        int inner;
        // `&str` is the fat string-reference type (§5.3): `str` is unsized, so
        // it only appears behind a reference and resolves to the pair itself.
        if (t->a != 0 && t->a->kind == AST_TYPE_NAME && str_eq(t->a->sval, "str")) {
            return ty_new(CTY_STRREF, "&str", TY_U8, 0);
        }
        // `&[T]` / `&mut [T]` is a slice reference: the fat (pointer, length)
        // pair is the value itself (§5.2), so no extra reference layer is
        // added — but the `mut` keyword selects the exclusive slice type.
        if (t->a != 0 && t->a->kind == AST_TYPE_SLICE) {
            int elem;
            elem = ck_resolve_type(t->a->a);
            if (elem == TY_INVALID) { return TY_INVALID; }
            return ck_slice_ty_mut(elem, t->ival & 1);
        }
        inner = ck_resolve_type(t->a);
        if (inner == TY_INVALID) { return TY_INVALID; }
        if (t->ival & 1) {
            return ty_new(CTY_MUTREF, ck_ref_name("&mut", inner), inner, 0);
        }
        return ty_new(CTY_REF, ck_ref_name("&", inner), inner, 0);
    }
    if (k == AST_TYPE_RAW) {
        int inner;
        inner = ck_resolve_type(t->a);
        if (inner == TY_INVALID) { return TY_INVALID; }
        if (t->ival & 1) {
            return ty_new(CTY_MUTPTR, ck_ref_name("raw mut", inner), inner, 0);
        }
        return ty_new(CTY_PTR, ck_ref_name("raw", inner), inner, 0);
    }
    if (k == AST_TYPE_ARRAY) {
        int inner;
        int len;
        inner = ck_resolve_type(t->a);
        if (inner == TY_INVALID) { return TY_INVALID; }
        len = ceval_const_int(t->b);
        if (len < 0) {
            diag_stop("TYPE-05", "array length must be a constant",
                      "The length of `[T; N]` must be a constant expression.",
                      t->file, t->start, t->end);
            return TY_INVALID;
        }
        lexbuf_reset();
        lexbuf_push_str("[");
        lexbuf_push_str(ty_display(inner));
        lexbuf_push_str("; ");
        lexbuf_push_int(len);
        lexbuf_push_str("]");
        return ty_new(CTY_ARRAY, lexbuf_finish(), inner, len);
    }
    if (k == AST_TYPE_SLICE) {
        int inner;
        inner = ck_resolve_type(t->a);
        if (inner == TY_INVALID) { return TY_INVALID; }
        return ck_slice_ty(inner);
    }
    if (k == AST_TYPE_UNIT) { return TY_UNIT; }
    diag_stop("TYPE-05", "unsupported type",
              "This type form is not supported yet.", t->file, t->start, t->end);
    return TY_INVALID;
}

// ---------------------------------------------------------------------------
// Prelude builtins beyond the print family (§15.1): `trap`, `assert`,
// `unreachable`, `exit`. Each is recognized by name; the argument shape is
// checked here and the backend lowers it to a runtime hook.
// ---------------------------------------------------------------------------

// Count of arguments (0 when there is no list).
int ck_argc(struct AstList* args) {
    if (args == 0) { return 0; }
    return args->len;
}

// `trap(msg: &str) -> never`.
int ck_builtin_trap(struct AstNode* n, struct AstList* args) {
    if (ck_argc(args) != 1) {
        ck_err_arity(n, "trap", 1, ck_argc(args));
        return TY_NEVER;
    }
    {
        int at;
        at = ck_expr(args->items[0]);
        if (at != TY_INVALID && ty_kind(at) != CTY_STRREF) {
            ck_err_type_mismatch(args->items[0], TY_INVALID, at, "trap message");
        }
    }
    return TY_NEVER;
}

// `assert(cond: bool)` / `assert(cond: bool, msg: &str)`.
int ck_builtin_assert(struct AstNode* n, struct AstList* args) {
    int na;
    na = ck_argc(args);
    if (na < 1 || na > 2) {
        ck_err_arity(n, "assert", 1, na);
        return TY_UNIT;
    }
    {
        int at;
        at = ck_expr(args->items[0]);
        if (at != TY_INVALID && at != TY_BOOL) {
            ck_err_type_mismatch(args->items[0], TY_BOOL, at, "assert condition");
        }
    }
    if (na == 2) {
        int at;
        at = ck_expr(args->items[1]);
        if (at != TY_INVALID && ty_kind(at) != CTY_STRREF) {
            ck_err_type_mismatch(args->items[1], TY_INVALID, at, "assert message");
        }
    }
    return TY_UNIT;
}

// `unreachable() -> never`.
int ck_builtin_unreachable(struct AstNode* n, struct AstList* args) {
    if (ck_argc(args) != 0) {
        ck_err_arity(n, "unreachable", 0, ck_argc(args));
    }
    return TY_NEVER;
}

// `args() -> &[&str]` (§15.6, bootstrap form). The program's command-line
// arguments as a slice of string slices; argv[0] is the program path. The
// full std library will wrap this in `env::args() -> Vec<String>`, but the
// bootstrap has no `Vec`, so the safe raw view is the builtin the rewrite
// needs. `&str` is a fat pair and a slice is a fat pair, so the element size
// is 16 and indexing scales correctly.
int ck_builtin_args(struct AstNode* n, struct AstList* args) {
    if (ck_argc(args) != 0) {
        ck_err_arity(n, "args", 0, ck_argc(args));
    }
    {
        int elem;
        elem = ty_new(CTY_STRREF, "&str", TY_U8, 0);
        return ck_slice_ty(elem);
    }
}

// `exit(code: i32) -> never`.
int ck_builtin_exit(struct AstNode* n, struct AstList* args) {
    if (ck_argc(args) != 1) {
        ck_err_arity(n, "exit", 1, ck_argc(args));
        return TY_NEVER;
    }
    {
        int at;
        at = ck_expr(args->items[0]);
        if (!ck_coercible(TY_I32, at)) {
            ck_err_type_mismatch(args->items[0], TY_I32, at, "exit code");
        }
        ck_stamp_lits(args->items[0], TY_I32);
    }
    return TY_NEVER;
}

// Builds "&T"-style display names for reference types.
char* ck_ref_name(char* pre, int inner) {
    lexbuf_reset();
    lexbuf_push_str(pre);
    // Word-like prefixes (`&mut`, `heap`, `raw`, `raw mut`) need a space so
    // the display reads `&mut i32` / `heap Node` / `raw mut u8` rather than
    // `&muti32` / `heapNode` / `raw mutu8` (§16.2). The bare `&` glues on:
    // `&i32`, not `& i32`.
    if (!str_eq(pre, "&")) { lexbuf_push_str(" "); }
    lexbuf_push_str(ty_display(inner));
    return lexbuf_finish();
}

// ---------------------------------------------------------------------------
// Pass 1: register items.
// ---------------------------------------------------------------------------
// Two-pass item registration (§12.3 needs forward references):
//   pass 1 — declare every struct/enum *name* (an empty type id);
//   pass 2 — resolve their members (any nominal name now resolves);
//   pass 3 — consts, fns, methods (their signatures see full member lists).
void ck_register_program(struct AstNode* prog) {
    int i;
    struct AstList* items;
    items = prog->kids;
    if (items == 0) { return; }
    // Pass 1: the nominal type names.
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if (it->kind == AST_STRUCT) { ck_register_struct(it); }
        if (it->kind == AST_ENUM) { ck_register_enum(it); }
        i = i + 1;
    }
    // Pass 2: their members (fields, variant payloads).
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if (it->kind == AST_STRUCT) { ck_fill_struct(it); }
        if (it->kind == AST_ENUM) { ck_fill_enum(it); }
        i = i + 1;
    }
    // Pass 3: everything else.
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if (it->kind == AST_STRUCT || it->kind == AST_ENUM) {
            i = i + 1;
            continue;
        }
        ck_register_item(it);
        i = i + 1;
    }
}

void ck_register_item(struct AstNode* n) {
    if (n == 0) { return; }
    if (n->kind == AST_STRUCT) { ck_register_struct(n); return; }
    if (n->kind == AST_ENUM) { ck_register_enum(n); return; }
    if (n->kind == AST_CONST) { ck_register_const(n); return; }
    if (n->kind == AST_FN) { ck_register_fn(n); return; }
    if (n->kind == AST_EXTERN_FN) { ck_register_extern(n); return; }
    if (n->kind == AST_METHODS) { ck_register_methods(n); return; }
}

// Registers a struct: a CTY_STRUCT type whose members are its fields.
// Field types are resolved immediately (the struct's own name is already
// registered, so a field may reference the struct through a pointer).
// Pass 1: declare every struct/enum *name* with its (empty) type id, so
// forward references between nominal types resolve (§12.3's `struct Node`
// containing a `Maybe` declared earlier, or vice versa). Members are filled
// by pass 2 (ck_register_members).
void ck_register_struct(struct AstNode* n) {
    int id;
    id = ty_new_typed(CTY_STRUCT, n->sval, n);
    if (ck_declare(n->sval, SK_TYPE, id, n, 0) < 0) { return; }
}

void ck_register_enum(struct AstNode* n) {
    int id;
    id = ty_new_typed(CTY_ENUM, n->sval, n);
    if (ck_declare(n->sval, SK_TYPE, id, n, 0) < 0) { return; }
}

// Pass 2: resolve the members of one struct/enum now that every nominal name
// exists. The type id was recorded on the decl node in pass 1.
void ck_fill_struct(struct AstNode* n) {
    int id;
    int i;
    struct AstList* fields;
    id = ck_lookup_type(n->sval);
    if (id == TY_INVALID) { return; }
    fields = n->kids2;
    if (fields == 0) { return; }
    i = 0;
    while (i < fields->len) {
        struct AstNode* f;
        int ft;
        f = fields->items[i];
        ft = ck_resolve_type(f->a);
        if (ft == TY_INVALID) { ft = TY_I32; }   // keep going; the stop is reported
        ty_add_member(id, f->sval, ft);
        f->ty = ft;
        i = i + 1;
    }
}

// Pass 2 for enums: the payload struct of every variant, then the enum's own
// member list (contiguous). Ordering matters: the payload structs exist
// before any member lookup, so variant payloads may reference the enum itself
// (`enum Tree { Branch(Heap<Tree>) }`).
void ck_fill_enum(struct AstNode* n) {
    int id;
    int i;
    struct AstList* variants;
    id = ck_lookup_type(n->sval);
    if (id == TY_INVALID) { return; }
    variants = n->kids2;
    if (variants == 0) { return; }
    // Phase A: the payload struct of every variant.
    i = 0;
    while (i < variants->len) {
        struct AstNode* v;
        int pid;
        int j;
        v = variants->items[i];
        lexbuf_reset();
        lexbuf_push_str(n->sval);
        lexbuf_push_str("::");
        lexbuf_push_str(v->sval);
        pid = ty_new_typed(CTY_STRUCT, lexbuf_finish(), v);
        j = 0;
        if (v->kids != 0) {
            while (j < v->kids->len) {
                int pt;
                pt = ck_resolve_type(v->kids->items[j]);
                if (pt == TY_INVALID) { pt = TY_I32; }
                lexbuf_reset();
                lexbuf_push_str("_");
                lexbuf_push_int(j);
                ty_add_member(pid, lexbuf_finish(), pt);
                j = j + 1;
            }
        }
        v->ty = pid;
        i = i + 1;
    }
    // Phase B: the enum's own member list (contiguous).
    i = 0;
    while (i < variants->len) {
        struct AstNode* v;
        v = variants->items[i];
        ty_add_member(id, v->sval, v->ty);
        i = i + 1;
    }
}

void ck_register_const(struct AstNode* n) {
    int ty;
    ty = ck_resolve_type(n->a);
    if (ty == TY_INVALID) { ty = TY_I32; }
    n->ty = ty;
    ck_declare(n->sval, SK_CONST, ty, n, 0);
}

// Registers a function node in the function table and resolves its signature.
// `declare_name` is non-null to bind it as a callable symbol; an instance of a
// generic template (a synthesized node) passes null and is registered only in
// the function table, since it is reached through `ck_instantiate`.
int ck_fn_register_node(struct AstNode* n) {
    int ret;
    int i;
    int idx;
    struct AstList* params;
    if (g_nfn >= 1024) { return -1; }
    idx = g_nfn;
    g_fn_decl[g_nfn] = n;
    // The body node carries the function index for return-type lookup; an
    // extern declaration has no body (it lowers to a `declare`).
    if (n->b != 0) { n->b->ival = g_nfn; }
    g_nfn = g_nfn + 1;
    ret = TY_UNIT;
    if (n->a != 0) {
        ret = ck_resolve_type(n->a);
        if (ret == TY_INVALID) { ret = TY_UNIT; }
    }
    n->ty = ret;
    params = n->kids2;
    if (params != 0) {
        i = 0;
        while (i < params->len) {
            struct AstNode* p;
            p = params->items[i];
            p->ty = ck_resolve_type(p->a);
            if (p->ty == TY_INVALID) { p->ty = TY_I32; }
            i = i + 1;
        }
    }
    return idx;
}

// Registers a function: its signature (params + return type) so calls from
// any body resolve. The body is checked in pass 2. A generic function is
// instead recorded as a *template* (its `T` has no type yet) and is not
// callable by name — only instantiations are.
void ck_register_fn(struct AstNode* n) {
    // A generic `fn id<T>(...)` is a template (§18): record it, do not bind a
    // symbol. Its `T` type nodes cannot resolve without concrete arguments.
    if (n->kids != 0) {
        if (g_ngen < 256) {
            g_gen_decl[g_ngen] = n;
            g_gen_name[g_ngen] = n->sval;
            g_ngen = g_ngen + 1;
        }
        return;
    }
    {
        int idx;
        idx = ck_fn_register_node(n);
        if (idx < 0) { return; }
        ck_declare(n->sval, SK_FN, n->ty, n, 0);
    }
}

// Looks up a generic template by name (index, or -1).
int ck_find_template(char* name) {
    int i;
    i = 0;
    while (i < g_ngen) {
        if (str_eq(g_gen_name[i], name)) { return i; }
        i = i + 1;
    }
    return -1;
}

// The i-th generic parameter name of a template (or 0). A bounded parameter
// is stored as `T: ord`, so the bound suffix after `:` is trimmed here.
char* ck_template_param(struct AstNode* tmpl, int i) {
    char* s;
    int c;
    if (tmpl->kids == 0 || i >= tmpl->kids->len) { return 0; }
    s = tmpl->kids->items[i]->sval;
    if (s == 0) { return 0; }
    c = str_rfind(s, ":");
    if (c >= 0) { return str_prefix(s, c); }
    return s;
}

// Accessors shared with cexpr.c2 (which cannot see the tables directly).
struct AstNode* ck_template_decl(int ti) {
    if (ti < 0 || ti >= g_ngen) { return 0; }
    return g_gen_decl[ti];
}

int ck_template_nparams(struct AstNode* tmpl) {
    if (tmpl == 0 || tmpl->kids == 0) { return 0; }
    return tmpl->kids->len;
}

// Builds a synthetic *type* AST node for a resolved type id. Used by call-site
// generic inference (§18): once an argument pins a parameter to a concrete
// type, that type is turned back into the type-node form the substitution pass
// expects (`Vec<i32>` -> `AST_TYPE_NAME "Vec" <i32>`).
struct AstNode* ck_ty_to_ast(int ty) {
    struct AstNode* n;
    int k;
    if (ty <= 0) { return 0; }
    k = ty_kind(ty);
    n = ast_node_new(AST_TYPE_NAME);
    if (k == CTY_REF || k == CTY_MUTREF) {
        n->kind = AST_TYPE_REF;
        n->ival = (k == CTY_MUTREF);
        n->a = ck_ty_to_ast(ty_elem(ty));
        return n;
    }
    if (k == CTY_SLICE) {
        n->kind = AST_TYPE_REF;
        n->ival = ty_slice_is_mut(ty);
        n->a = ast_node_new(AST_TYPE_SLICE);
        n->a->a = ck_ty_to_ast(ty_elem(ty));
        return n;
    }
    if (k == CTY_STRREF) {
        n->kind = AST_TYPE_REF;
        n->a = ast_node_new(AST_TYPE_NAME);
        n->a->sval = "str";
        return n;
    }
    if (k == CTY_HEAP) {
        n->sval = "Heap";
        n->kids = ast_list_new();
        ast_list_push(n->kids, ck_ty_to_ast(ty_elem(ty)));
        return n;
    }
    if (k == CTY_PTR || k == CTY_MUTPTR) {
        n->kind = AST_TYPE_RAW;
        n->ival = (k == CTY_MUTPTR);
        n->a = ck_ty_to_ast(ty_elem(ty));
        return n;
    }
    if (k == CTY_ARRAY) {
        struct AstNode* len;
        n->kind = AST_TYPE_ARRAY;
        n->a = ck_ty_to_ast(ty_elem(ty));
        len = ast_node_new(AST_INT_LIT);
        len->ival = ty_array_len(ty);
        n->b = len;
        return n;
    }
    // A named type (primitive, struct, enum): its display name is the source
    // spelling, which is exactly what a type node carries.
    n->sval = ty_display(ty);
    return n;
}

// Substitutes generic parameter names in a type node with the concrete type
// nodes for an instantiation. Walks `n` in place, replacing any
// `AST_TYPE_NAME` whose name matches a template parameter with a clone of the
// corresponding argument. Returns 1, or 0 when an unbound parameter remains.
int ck_subst_type(struct AstNode* n, struct AstNode* tmpl, struct AstList* targs, int ntargs) {
    int i;
    if (n == 0) { return 1; }
    if (n->kind == AST_TYPE_NAME) {
        i = 0;
        while (i < ntargs) {
            char* pname;
            pname = ck_template_param(tmpl, i);
            if (pname != 0 && str_eq(n->sval, pname)) {
                struct AstNode* arg;
                arg = ast_clone(targs->items[i]);
                // Copy the argument's shape into this node (it may be any
                // type form: name, ref, array, slice, path with args).
                n->kind = arg->kind;
                n->file = arg->file;
                n->start = arg->start;
                n->end = arg->end;
                n->ival = arg->ival;
                n->sval = arg->sval;
                n->a = arg->a;
                n->b = arg->b;
                n->c = arg->c;
                n->kids = arg->kids;
                n->kids2 = arg->kids2;
                return 1;
            }
            i = i + 1;
        }
        return 1;   // a concrete (non-parameter) name survives
    }
    if (!ck_subst_type(n->a, tmpl, targs, ntargs)) { return 0; }
    if (!ck_subst_type(n->b, tmpl, targs, ntargs)) { return 0; }
    if (!ck_subst_type(n->c, tmpl, targs, ntargs)) { return 0; }
    if (n->kids != 0) {
        i = 0;
        while (i < n->kids->len) {
            if (!ck_subst_type(n->kids->items[i], tmpl, targs, ntargs)) { return 0; }
            i = i + 1;
        }
    }
    if (n->kids2 != 0) {
        i = 0;
        while (i < n->kids2->len) {
            if (!ck_subst_type(n->kids2->items[i], tmpl, targs, ntargs)) { return 0; }
            i = i + 1;
        }
    }
    return 1;
}

// The mangled instance name: `id__i32`, `first__Rstr`, etc. Type displays can
// contain characters that are illegal in a symbol (`&`, `[`, `]`, `;`), so
// each is mapped to a distinct letter (never dropped, which could collide:
// `&[i32]` and `i32` must stay apart).
char* ck_mangle_ty(int ty) {
    char* d;
    int i;
    lexbuf_reset();
    d = ty_display(ty);
    i = 0;
    while (d[i] != 0) {
        char c;
        c = d[i];
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
            || (c >= '0' && c <= '9') || c == '_') {
            lexbuf_push(c);
        } else if (c == '&') { lexbuf_push('R'); }   // reference
        else if (c == '[')  { lexbuf_push('A'); }    // array / slice
        else if (c == ']')  { lexbuf_push('Z'); }
        else if (c == ';')  { lexbuf_push('S'); }
        else if (c != ' ')  { lexbuf_push('X'); }    // other punctuation (skip spaces)
        i = i + 1;
    }
    return lexbuf_finish();
}

char* ck_instance_name(char* base, struct AstList* targs) {
    int i;
    int n;
    char* parts[16];
    n = targs->len;
    if (n > 16) { n = 16; }
    // Resolve every mangled type first: each builds in the shared scratch
    // buffer, so they cannot be produced while the outer name is mid-build.
    i = 0;
    while (i < n) {
        parts[i] = ck_mangle_ty(ck_resolve_type(targs->items[i]));
        i = i + 1;
    }
    lexbuf_reset();
    lexbuf_push_str(base);
    i = 0;
    while (i < n) {
        lexbuf_push_str("__");
        lexbuf_push_str(parts[i]);
        i = i + 1;
    }
    return lexbuf_finish();
}

// Instantiates `name<args>`: clones the template, substitutes the parameters,
// registers the instance, and returns its function index (or -1 after a stop).
int ck_instantiate(struct AstNode* n, char* name, struct AstList* targs) {
    int ti;
    int ntargs;
    struct AstNode* tmpl;
    struct AstNode* inst;
    char* iname;
    int idx;
    int i;

    ti = ck_find_template(name);
    if (ti < 0) {
        ck_err_unknown_name(name, n, "no generic function of that name is in scope");
        return -1;
    }
    tmpl = g_gen_decl[ti];
    ntargs = 0;
    if (tmpl->kids != 0) { ntargs = tmpl->kids->len; }
    if (targs == 0 || targs->len != ntargs) {
        ck_err_arity(n, name, ntargs, ast_list_len(targs));
        return -1;
    }
    // Only type parameters are supported for now: a `life` parameter has
    // ival bit 0 set and is rejected clearly instead of mis-substituted.
    i = 0;
    while (i < ntargs) {
        if (tmpl->kids->items[i]->ival != 0) {
            diag_stop("TYPE-01", "life parameters are not implemented yet",
                      "Generic life parameters arrive with the borrow checker (M4).",
                      diag_file(n->file), n->start, n->end);
            return -1;
        }
        i = i + 1;
    }

    iname = ck_instance_name(name, targs);
    // Reuse an existing instance of the same concrete signature.
    i = 0;
    while (i < g_nfn) {
        if (str_eq(g_fn_decl[i]->sval, iname)) { return i; }
        i = i + 1;
    }
    if (g_nfn >= 1024) { return -1; }

    inst = ast_clone(tmpl);
    inst->sval = iname;
    if (!ck_subst_type(inst->a, tmpl, targs, ntargs)) { return -1; }
    if (inst->kids2 != 0) {
        i = 0;
        while (i < inst->kids2->len) {
            struct AstNode* p;
            p = inst->kids2->items[i];
            if (!ck_subst_type(p->a, tmpl, targs, ntargs)) { return -1; }
            i = i + 1;
        }
    }
    // Substitute inside the body too (nested generic calls, `let x: T = ...`).
    if (!ck_subst_type(inst->b, tmpl, targs, ntargs)) { return -1; }

    idx = ck_fn_register_node(inst);
    if (idx < 0) { return -1; }
    if (g_ngen_inst < 512) {
        g_gen_inst[g_ngen_inst] = inst;
        g_ngen_inst = g_ngen_inst + 1;
    }
    return idx;
}

// True when `ty` may cross the C boundary in an `extern fn` signature (§6.8):
// only primitives and raw pointers. A reference (`&T`, `&str`), a slice, a
// `Heap`, or any aggregate by value is rejected — `&str`/`&[T]` are fat pairs
// emitted as a single `ptr`, and a struct by value uses a different ABI than C
// (harmony emits `sret`; C returns small structs in registers), so both
// silently miscompile. `unit` is allowed only as a return (C `void`), which
// the caller checks separately.
int ck_ffi_ty_ok(int ty) {
    if (ty_is_ptr(ty)) { return 1; }
    if (ty_is_primitive(ty) && ty != TY_UNIT && ty != TY_NEVER) { return 1; }
    return 0;
}

// Reports an out-of-spec `extern fn` signature type (§6.8). `where` names the
// offending position ("parameter `p`", "return type").
void ck_err_ffi_ty(struct AstNode* at, int ty, char* where) {
    lexbuf_reset();
    lexbuf_push_str(where);
    lexbuf_push_str(": `");
    lexbuf_push_str(ty_display(ty));
    lexbuf_push_str("` cannot cross the C boundary");
    {
        int idx;
        idx = diag_stop("TYPE-02", "not an FFI type", lexbuf_finish(),
                        diag_file(at->file), at->start, at->end);
        if (idx >= 0) {
            diag_fix(diag_get(idx), "use a primitive or a raw pointer",
                     "extern fn abs(x: i32) -> i32;   // or a raw pointer like `raw u8`");
        }
    }
}

void ck_register_extern(struct AstNode* n) {
    // Extern declarations are checked like functions but have no body. The
    // signature is then restricted to what the C ABI the compiler assumes can
    // actually carry (§6.8: primitives and `raw` pointers only).
    ck_register_fn(n);
    {
        struct AstList* params;
        int i;
        params = n->kids2;
        if (params != 0) {
            i = 0;
            while (i < params->len) {
                struct AstNode* p;
                p = params->items[i];
                // A `self` parameter (no type node) is always out of spec:
                // there is no receiver across the C boundary.
                if (p->a == 0) {
                    int idx;
                    idx = diag_stop("TYPE-02", "not an FFI type",
                                    "a foreign function cannot have a `self` parameter",
                                    diag_file(p->file), p->start, p->end);
                    if (idx >= 0) {
                        diag_fix(diag_get(idx), "name a value parameter",
                                 "extern fn abs(x: i32) -> i32;");
                    }
                } else if (!ck_ffi_ty_ok(p->ty)) {
                    char* where;
                    where = str_concat("parameter `", p->sval);
                    where = str_concat(where, "`");
                    ck_err_ffi_ty(p, p->ty, where);
                }
                i = i + 1;
            }
        }
        // Return type: a value must be an FFI type; `unit` (C `void`) is fine.
        if (n->a != 0 && n->ty != TY_UNIT && !ck_ffi_ty_ok(n->ty)) {
            ck_err_ffi_ty(n->a, n->ty, "return type");
        }
    }
}

// Registers the methods of a `methods Type { ... }` block. The receiver is
// the first parameter named `self` (§6.6): `self` takes the type by value,
// `&self` a shared reference, `&mut self` an exclusive one.
void ck_register_methods(struct AstNode* n) {
    int i;
    int base;
    int recv;
    struct AstList* fns;
    base = ck_lookup(n->sval);
    if (base < 0 || g_sym_kind[base] != SK_TYPE) {
        ck_err_unknown_type(n->sval, n);
        return;
    }
    recv = g_sym_ty[base];
    fns = n->kids2;
    if (fns == 0) { return; }
    i = 0;
    while (i < fns->len) {
        struct AstNode* f;
        f = fns->items[i];
        if (g_nmeth < 1024) {
            g_meth_ty[g_nmeth] = recv;
            g_meth_name[g_nmeth] = f->sval;
            g_meth_fn[g_nmeth] = g_nfn;
            g_nmeth = g_nmeth + 1;
        }
        ck_register_fn(f);
        // Record the receiver type on the (just-registered) function, and
        // give its `self` parameter the right reference shape.
        if (g_nfn > 0) { g_fn_self_ty[g_nfn - 1] = recv; }
        {
            struct AstList* ps;
            ps = f->kids2;
            if (ps != 0 && ps->len > 0 && ps->items[0]->sval != 0) {
                struct AstNode* sp;
                sp = ps->items[0];
                if (str_eq(sp->sval, "self")) { sp->ty = recv; }
                else if (str_eq(sp->sval, "mut self")) { sp->ty = recv; }
                else if (str_eq(sp->sval, "&self")) { sp->ty = ty_new(CTY_REF, ck_ref_name("&", recv), recv, 0); }
                else if (str_eq(sp->sval, "&mut self")) { sp->ty = ty_new(CTY_MUTREF, ck_ref_name("&mut", recv), recv, 0); }
            }
        }
        i = i + 1;
    }
}

// ---------------------------------------------------------------------------
// Pass 2: check bodies.
// ---------------------------------------------------------------------------
void ck_check_bodies(void) {
    int i;
    i = 0;
    while (i < g_nfn) {
        ck_check_fn(g_fn_decl[i], i);
        i = i + 1;
    }
}

void ck_check_fn(struct AstNode* fn, int idx) {
    int ret;
    struct AstList* params;
    int i;
    if (fn->b == 0) { return; }   // extern declaration: no body
    ret = fn->ty;
    g_fn_ret_ty[g_fn_depth] = ret;
    g_fn_idx[g_fn_depth] = idx;
    g_fn_depth = g_fn_depth + 1;
    ck_scope_push();
    // A method's `self` is a binding like any other parameter (§6.6). Its
    // type mirrors the declared shape: `self`/`mut self` take the receiver by
    // value; `&self`/`&mut self` take a reference to it (the checker already
    // resolved that reference type onto the param node).
    if (g_fn_self_ty[idx] != 0) {
        int smut;
        int selfty;
        struct AstNode* sp;
        smut = 0;
        selfty = g_fn_self_ty[idx];
        sp = 0;
        params = fn->kids2;
        if (params != 0 && params->len > 0) {
            sp = params->items[0];
            if (ck_is_self_param(sp) && sp->ty != 0) {
                selfty = sp->ty;   // the reference-typed shape
            }
            if (str_eq(sp->sval, "mut self") || str_eq(sp->sval, "&mut self")) {
                smut = 1;
            }
        }
        ck_declare("self", SK_SELF, selfty, fn, smut);
    }
    params = fn->kids2;
    if (params != 0) {
        i = 0;
        while (i < params->len) {
            struct AstNode* p;
            p = params->items[i];
            // A `self` parameter is handled by the receiver binding above.
            if (!ck_is_self_param(p)) {
                ck_declare(p->sval, SK_PARAM, p->ty, p, p->ival & 1);
            }
            i = i + 1;
        }
    }
    ck_stmt_block(fn->b);
    // §8.2: a function with a non-unit return type must return on every path.
    // M1 uses the simple form: the body's last statement must be a `return`
    // (or the type is unit/never).
    if (ret != TY_UNIT && ret != TY_NEVER) {
        if (!ck_block_ends_in_return(fn->b)) {
            ck_err_missing_return(fn);
        }
    }
    ck_scope_pop();
    g_fn_depth = g_fn_depth - 1;
}

// True when the block's last statement is a `return` (M1 approximation of
// "all paths return"; the CFG-based analysis arrives with lowering).
int ck_block_ends_in_return(struct AstNode* blk) {
    struct AstList* stmts;
    struct AstNode* last;
    if (blk == 0 || blk->kids == 0) { return 0; }
    stmts = blk->kids;
    if (stmts->len == 0) { return 0; }
    last = stmts->items[stmts->len - 1];
    if (last->kind == AST_RETURN) { return 1; }
    // A final expression statement typed `never` (a `trap`/`exit`/
    // `unreachable` call, §5.1/§15.1) also ends the function: control never
    // reaches the end of the body.
    if (last->ty == TY_NEVER) { return 1; }
    return 0;
}

// ---------------------------------------------------------------------------
// Statements.
// ---------------------------------------------------------------------------
void ck_stmt_block(struct AstNode* blk) {
    struct AstList* stmts;
    int i;
    if (blk == 0) { return; }
    if (blk->ty == 0) { blk->ty = TY_UNIT; }
    ck_scope_push();
    stmts = blk->kids;
    if (stmts != 0) {
        i = 0;
        while (i < stmts->len) {
            ck_stmt(stmts->items[i]);
            i = i + 1;
        }
    }
    ck_scope_pop();
}

void ck_stmt(struct AstNode* n) {
    if (n == 0) { return; }
    if (n->kind == AST_LET) { ck_stmt_let(n); return; }
    if (n->kind == AST_ASSIGN) { ck_stmt_assign(n); return; }
    if (n->kind == AST_EXPR_STMT) { ck_expr(n->a); n->ty = n->a->ty; return; }
    if (n->kind == AST_IF) { ck_stmt_if(n); return; }
    if (n->kind == AST_WHILE) { ck_stmt_while(n); return; }
    if (n->kind == AST_FOR) { ck_stmt_for(n); return; }
    if (n->kind == AST_SWITCH) { ck_stmt_switch(n); return; }
    if (n->kind == AST_RETURN) { ck_stmt_return(n); return; }
    if (n->kind == AST_BREAK || n->kind == AST_CONTINUE) {
        if (g_loop_depth <= 0) {
            diag_stop("SYN-06", "`break` outside a loop",
                      "`break` and `continue` only make sense inside `while` or `for`.",
                      n->file, n->start, n->end);
        }
        n->ty = TY_NEVER;
        return;
    }
    if (n->kind == AST_BLOCK) { ck_stmt_block(n); n->ty = TY_UNIT; return; }
    if (n->kind == AST_UNCHECKED) {
        // §13.2: the reason is a promise, and a promise needs substance.
        // §13.4: --deny-unchecked refuses the block outright.
        if (g_deny_unchecked) { ck_err_deny_unchecked(n); }
        if (n->sval == 0 || str_len(n->sval) < 12) { ck_err_weak_reason(n); }
        g_unchecked_depth = g_unchecked_depth + 1;
        ck_stmt_block(n->a);
        g_unchecked_depth = g_unchecked_depth - 1;
        n->ty = TY_UNIT;
        return;
    }
    // Unknown statement kind: evaluate as an expression statement if it can be.
    ck_expr(n);
    n->ty = TY_UNIT;
}

void ck_stmt_let(struct AstNode* n) {
    int ty;
    int init;
    init = 0;
    if (n->a != 0) {
        ty = ck_resolve_type(n->a);
        if (ty == TY_INVALID) { ty = TY_I32; }
    } else {
        ty = 0;   // infer from the initializer
    }
    if (n->b != 0) {
        init = 1;
        // An array literal with a declared array type adapts its *elements* to
        // the declared element type (§5.9): `let a: [i64; 3] = [1, 2, 3];` must
        // not leave the elements as the i32 default. The hint is read by
        // ck_expr_array_lit (elements live in `kids`, which ck_stamp_lits does
        // not walk).
        if (ty != 0 && ty_is_array(ty) && n->b->kind == AST_ARRAY_LIT) {
            g_array_elem_hint = ty_elem(ty);
        }
        ck_expr(n->b);
        g_array_elem_hint = 0;
        if (ty == 0) {
            // No type given: infer from the initializer. An untyped literal
            // defaults to i32 / f64 (§5.9).
            ty = n->b->ty;
            if (ty == TY_UINT_LIT) { ty = TY_I32; }
            if (ty == TY_FLOAT_LIT) { ty = TY_F64; }
        } else if (!ty_eq(ty, n->b->ty)) {
            ck_err_type_mismatch(n, ty, n->b->ty, "`let` initializer");
        }
        // Adopt the concrete type on untyped literals (§5.9) so the backend
        // emits the right width (`let x: i64 = 1` stores an i64).
        ck_stamp_lits(n->b, ty);
    }
    if (ty == 0) {
        // No type and no initializer: unusable (INIT-01 will fire on use).
        ty = TY_I32;
        diag_stop("TYPE-05", "cannot infer the type of this binding",
                  "Annotate it: `let name: Type = ...;`",
                  n->file, n->start, n->end);
    }
    n->ty = ty;
    {
        int idx;
        idx = ck_declare(n->sval, SK_LET, ty, n, n->ival & 1);
        if (idx >= 0 && init) { g_sym_init[idx] = 1; }
    }
}

void ck_stmt_assign(struct AstNode* n) {
    int lt;
    int rt;
    lt = ck_place(n->a);
    ck_expr(n->b);
    rt = n->b->ty;
    n->ty = TY_UNIT;
    if (lt == TY_INVALID || rt == TY_INVALID) { return; }
    if (!ty_eq(lt, rt)) {
        ck_err_type_mismatch(n, lt, rt, "assignment");
    }
    // `x = 1` / `x += 1` with x: i64 adapts the literal to the place's type.
    ck_stamp_lits(n->b, lt);
}

// Checks an lvalue (assignment target): returns its type, or TY_INVALID.
// Rejects assignment to non-`mut` bindings (MUT-01) and to immutable places.
int ck_place(struct AstNode* n) {
    int ty;
    ty = ck_expr(n);
    if (ty == TY_INVALID) { return TY_INVALID; }
    ck_check_place_mut(n);
    return ty;
}

// Walks a place to its root binding and checks it is writable (§8.1).
// M1 rules: a `let mut` binding, a `mut` parameter, or anything reached
// through a `&mut`/raw-mut place is writable; a field or index inherits the
// root's mutability. Full loan tracking is M2–M3.
void ck_check_place_mut(struct AstNode* n) {
    if (n == 0) { return; }
    if (n->kind == AST_INDEX) {
        // Writing through an exclusive slice (`xs[i]` where `xs: &mut [T]`,
        // possibly a struct field) is the capability the slice type grants,
        // so it is allowed regardless of the binding's own mutability — the
        // same rule that makes `*r` writable for `r: &mut T` (§5.2, §10).
        if (ty_slice_is_mut(n->a->ty)) { return; }
        ck_check_place_mut(n->a);
        return;
    }
    if (n->kind == AST_FIELD_ACC) {
        ck_check_place_mut(n->a);
        return;
    }
    if (n->kind == AST_DEREF) {
        // `*r` is writable iff `r` is an exclusive reference or a raw mut
        // pointer; that is the subject of the borrow checker in M3, so M1
        // accepts it here.
        return;
    }
    if (n->kind == AST_PATH && n->a == 0) {
        int sym;
        sym = ck_lookup(n->sval);
        if (sym < 0) { return; }
        // Writing through a `&mut T` or `&mut [T]` place is always allowed:
        // the reference is the capability (§10). The binding itself may still
        // be read-only.
        if (ty_kind(g_sym_ty[sym]) == CTY_MUTREF || ty_slice_is_mut(g_sym_ty[sym])) {
            return;
        }
        if (!g_sym_mut[sym]) {
            if (g_sym_kind[sym] == SK_LET || g_sym_kind[sym] == SK_PARAM
                || g_sym_kind[sym] == SK_SELF) {
                ck_err_not_mut(n, n->sval);
            }
        }
        return;
    }
}

void ck_stmt_if(struct AstNode* n) {
    int ct;
    ct = ck_expr(n->a);
    if (ct != TY_INVALID && !ty_eq(ct, TY_BOOL)) {
        ck_err_type_mismatch(n->a, TY_BOOL, ct, "`if` condition");
    }
    ck_stmt_block(n->b);
    if (n->c != 0) {
        if (n->c->kind == AST_BLOCK) {
            ck_stmt_block(n->c);
        } else {
            ck_stmt_if(n->c);   // `else if`
        }
    }
    n->ty = TY_UNIT;
}

void ck_stmt_while(struct AstNode* n) {
    int ct;
    ct = ck_expr(n->a);
    if (ct != TY_INVALID && !ty_eq(ct, TY_BOOL)) {
        ck_err_type_mismatch(n->a, TY_BOOL, ct, "`while` condition");
    }
    g_loop_depth = g_loop_depth + 1;
    ck_stmt_block(n->b);
    g_loop_depth = g_loop_depth - 1;
    n->ty = TY_UNIT;
}

void ck_stmt_for(struct AstNode* n) {
    g_loop_depth = g_loop_depth + 1;
    ck_scope_push();
    if (n->a != 0) { ck_stmt(n->a); }
    if (n->b != 0) {
        int ct;
        ct = ck_expr(n->b);
        if (ct != TY_INVALID && !ty_eq(ct, TY_BOOL)) {
            ck_err_type_mismatch(n->b, TY_BOOL, ct, "`for` condition");
        }
    }
    if (n->c != 0) { ck_stmt(n->c); }
    if (n->kids != 0) {
        int i;
        i = 0;
        while (i < n->kids->len) {
            ck_stmt(n->kids->items[i]);
            i = i + 1;
        }
    }
    ck_scope_pop();
    g_loop_depth = g_loop_depth - 1;
    n->ty = TY_UNIT;
}

void ck_stmt_switch(struct AstNode* n) {
    int st;
    struct AstList* arms;
    int i;
    int saw_default;
    int seen[64];      // variant indices already covered
    int nseen;
    st = ck_expr(n->a);
    // Switching through a reference or heap box switches on the pointee
    // (§10.1: a place reached through `&`/`Heap`); the patterns see the
    // underlying enum.
    while (ty_is_ref(st) || ty_is_heap(st)) { st = ty_elem(st); }
    n->ty = TY_UNIT;
    arms = n->kids;
    if (arms == 0) { return; }
    saw_default = 0;
    nseen = 0;
    i = 0;
    while (i < arms->len) {
        struct AstNode* arm;
        arm = arms->items[i];
        // An arm's patterns live in `kids` (several for or-patterns); an arm
        // with no patterns is the `default` arm.
        if (arm->kids == 0 || arm->kids->len == 0) {
            saw_default = 1;
        } else {
            int k;
            // Each arm is its own scope: `case Circle(r)` binds `r` for that
            // arm's body only.
            ck_scope_push();
            k = 0;
            while (k < arm->kids->len) {
                ck_check_pattern(arm->kids->items[k], st, seen, &nseen);
                k = k + 1;
            }
        }
        ck_stmt_block(arm->b);
        if (arm->kids != 0 && arm->kids->len != 0) { ck_scope_pop(); }
        i = i + 1;
    }
    // Exhaustiveness (§8.4): a switch on an enum must cover every variant or
    // provide `default`. Switches on scalars must have a `default` too.
    if (!saw_default) {
        if (ty_is_nominal(st) && ty_kind(st) == CTY_ENUM) {
            int total;
            total = ty_member_count(st);
            if (nseen < total) {
                ck_err_nonexhaustive(n, st);
            }
        } else {
            ck_err_nonexhaustive(n, st);
        }
    }
}

// Checks one switch pattern against the subject type, recording which enum
// variants it covers (for exhaustiveness).
void ck_check_pattern(struct AstNode* p, int st, int* seen, int* nseen) {
    if (p == 0) { return; }
    if (p->kind == AST_PAT_WILD) { return; }
    if (p->kind == AST_PAT_LIT) {
        ck_expr(p->a);
        if (st != TY_INVALID && !ty_eq(st, p->a->ty)) {
            ck_err_type_mismatch(p, st, p->a->ty, "switch pattern");
        }
        return;
    }
    if (p->kind == AST_PAT_BIND) {
        // The parser makes a bare identifier a binding; when switching on an
        // enum and the name is a variant of it (or `Enum::Variant`), it is a
        // variant pattern instead (§8.6).
        if (ty_is_nominal(st) && ty_kind(st) == CTY_ENUM) {
            char* vname;
            vname = p->sval;
            if (str_contains(vname, "::")) {
                vname = p->sval + str_rfind(p->sval, "::") + 2;
            }
            {
                int vi;
                vi = ty_find_member(st, vname);
                if (vi >= 0) {
                    ck_note_variant(p, st, vi, seen, nseen);
                    return;
                }
            }
        }
        ck_declare(p->sval, SK_LET, st, p, 1);
        return;
    }
    if (p->kind == AST_PAT_VARIANT) {
        char* vname;
        vname = p->sval;
        if (str_contains(vname, "::")) {
            vname = p->sval + str_rfind(p->sval, "::") + 2;
        }
        if (ty_is_nominal(st) && ty_kind(st) == CTY_ENUM) {
            int vi;
            vi = ty_find_member(st, vname);
            if (vi < 0) {
                ck_err_no_field(p, st, vname);
            } else {
                ck_note_variant(p, st, vi, seen, nseen);
                // Bind the payload sub-patterns: `Circle(r)` binds `r` to the
                // variant's first payload field (§8.6). A payload field is a
                // member of the variant's payload struct.
                if (p->kids != 0) {
                    int pid;
                    int k;
                    pid = ty_member_type(st, vi);
                    k = 0;
                    while (k < p->kids->len && k < ty_member_count(pid)) {
                        struct AstNode* sub;
                        sub = p->kids->items[k];
                        if (sub->kind == AST_PAT_BIND) {
                            int si;
                            si = ck_declare(sub->sval, SK_LET, ty_member_type(pid, k), sub, 1);
                            // A pattern binding holds a value from the match:
                            // mark it initialized (INIT-01).
                            if (si >= 0) { g_sym_init[si] = 1; }
                        } else if (sub->kind != AST_PAT_WILD) {
                            ck_check_pattern(sub, ty_member_type(pid, k), seen, nseen);
                        }
                        k = k + 1;
                    }
                }
            }
        } else {
            ck_err_unknown_name(p->sval, p, "switch patterns name an enum variant");
        }
        return;
    }
    if (p->kind == AST_PAT_RANGE) {
        ck_expr(p->a);
        ck_expr(p->b);
        return;
    }
}

// Records that variant `vi` of the subject enum is covered, warning when an
// earlier arm already covered it (CASE-02).
void ck_note_variant(struct AstNode* p, int st, int vi, int* seen, int* nseen) {
    int j;
    j = 0;
    while (j < *nseen) {
        if (seen[j] == vi) {
            diag_warn("CASE-02", "unreachable pattern",
                      "This variant is already covered by an earlier arm.",
                      diag_file(p->file), p->start, p->end);
            return;
        }
        j = j + 1;
    }
    if (*nseen < 64) { seen[*nseen] = vi; *nseen = *nseen + 1; }
}

void ck_stmt_return(struct AstNode* n) {
    int want;
    int got;
    want = g_fn_ret_ty[ck_cur_fn()];
    if (n->a == 0) {
        got = TY_UNIT;
    } else {
        got = ck_expr(n->a);
    }
    n->ty = TY_NEVER;
    if (want == TY_INVALID || got == TY_INVALID) { return; }
    if (!ty_eq(want, got)) {
        ck_err_type_mismatch(n, want, got, "`return` value");
    }
    if (n->a != 0) { ck_stamp_lits(n->a, want); }
}

// ---------------------------------------------------------------------------
// Const evaluation (array lengths, const initializers). M1 supports integer
// literals, unary minus, and references to integer consts.
// ---------------------------------------------------------------------------
int ceval_const_int(struct AstNode* n) {
    int sym;
    if (n == 0) { return -1; }
    if (n->kind == AST_INT_LIT) { return n->ival; }
    if (n->kind == AST_UNARY) {
        int v;
        if (!str_eq(n->sval, "-")) { return -1; }
        v = ceval_const_int(n->a);
        if (v < 0) { return -1; }
        return -v;
    }
    if (n->kind == AST_BINARY) {
        int l;
        int r;
        l = ceval_const_int(n->a);
        r = ceval_const_int(n->b);
        if (l < 0 || r < 0) { return -1; }
        if (str_eq(n->sval, "+")) { return l + r; }
        if (str_eq(n->sval, "-")) { return l - r; }
        if (str_eq(n->sval, "*")) { return l * r; }
        if (str_eq(n->sval, "/")) { if (r == 0) { return -1; } return l / r; }
        return -1;
    }
    if (n->kind == AST_PATH && n->a == 0) {
        sym = ck_lookup(n->sval);
        if (sym >= 0 && g_sym_kind[sym] == SK_CONST) {
            return ceval_const_int(g_sym_decl[sym]->b);
        }
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Driver: check a whole program. Called from pipeline.c2 after parsing.
// ---------------------------------------------------------------------------
void check_program(struct AstNode* prog) {
    g_prog = prog;
    g_nsyms = 0;
    g_nscope = 0;
    g_nfn = 0;
    g_nmeth = 0;
    g_fn_depth = 0;
    g_loop_depth = 0;
    {
        int i;
        i = 0;
        while (i < 4096) { g_sym_init[i] = 0; i = i + 1; }
    }
    types_reset();
    ck_register_primitives();
    ck_register_program(prog);
    ck_check_main();
    ck_check_bodies();
}

// §6.3: the entry point is `fn main()` or `fn main() -> i32`; the returned
// i32 becomes the process exit code. A main with another return type, or
// with parameters, is rejected here (the runtime calls it with no args).
void ck_check_main(void) {
    int sym;
    struct AstNode* fn;
    struct AstList* params;
    sym = ck_lookup("main");
    if (sym < 0) {
        // No main is only a problem for `build`/`run`; `check` on a library
        // file is fine, so this is a warning, not a stop.
        return;
    }
    if (g_sym_kind[sym] != SK_FN) {
        diag_stop("TYPE-06", "`main` is not a function",
                  "The entry point must be `fn main() -> i32` or `fn main()`.",
                  diag_file(0), 0, 0);
        return;
    }
    fn = g_sym_decl[sym];
    params = fn->kids2;
    if (params != 0 && params->len > 0) {
        diag_stop("TYPE-06", "`main` takes no parameters",
                  "The runtime calls `main` with no arguments; read them from the arguments module instead.",
                  diag_file(fn->file), fn->start, fn->end);
    }
    if (fn->ty != TY_UNIT && fn->ty != TY_I32 && fn->ty != TY_NEVER) {
        diag_stop("TYPE-06", "`main` must return `i32` or nothing",
                  "The returned `i32` becomes the process exit code (§6.3).",
                  diag_file(fn->file), fn->start, fn->end);
    }
}

// The primitive type names (§5.2) are always in scope.
void ck_register_primitives(void) {
    ck_declare("i8", SK_TYPE, TY_I8, 0, 0);
    ck_declare("i16", SK_TYPE, TY_I16, 0, 0);
    ck_declare("i32", SK_TYPE, TY_I32, 0, 0);
    ck_declare("i64", SK_TYPE, TY_I64, 0, 0);
    ck_declare("isize", SK_TYPE, TY_ISIZE, 0, 0);
    ck_declare("u8", SK_TYPE, TY_U8, 0, 0);
    ck_declare("u16", SK_TYPE, TY_U16, 0, 0);
    ck_declare("u32", SK_TYPE, TY_U32, 0, 0);
    ck_declare("u64", SK_TYPE, TY_U64, 0, 0);
    ck_declare("usize", SK_TYPE, TY_USIZE, 0, 0);
    ck_declare("f32", SK_TYPE, TY_F32, 0, 0);
    ck_declare("f64", SK_TYPE, TY_F64, 0, 0);
    ck_declare("bool", SK_TYPE, TY_BOOL, 0, 0);
    ck_declare("char", SK_TYPE, TY_CHAR, 0, 0);
}
