// harmony-base — diagnostics (docs/harmony.md §16).
//
// One root cause, one report (§16.1). A diagnostic tells the story of the
// value: a numbered timeline of source steps (born → moved → used), each
// labelled, with the triggering step marked `◂ here`. Stored at analysis
// time, printed once at flush:
//   * sorted by primary location (§16.9);
//   * capped: 5 stops, then "…and N more stops (use --all)"; 10 warns
//     (§16.9) — unless `all`;
//   * rendered as pretty (§16.2), line (§16.7), or json (§16.7).
// Driver/usage errors stay on stderr immediately (diag_plain), so the
// machine-readable outputs stay pure.

struct Diagnostic g_diags[128];
int g_ndiags;
int g_nstops;
int g_nwarns;
int g_nhints;

// Source files, registered by index so steps resolve file/line/col.
struct SourceFile* g_files[64];
int g_nfiles;

// Emission order (diagnostic indices), sorted by primary location at flush.
int g_order[128];

void diag_register_file(struct SourceFile* sf) {
    if (g_nfiles < 64) {
        g_files[g_nfiles] = sf;
        g_nfiles = g_nfiles + 1;
    }
}

int diag_stop_count(void) { return g_nstops; }
int diag_warn_count(void) { return g_nwarns; }
int diag_hint_count(void) { return g_nhints; }

// The number of source files registered so far (the module loader gives each
// imported file its diag index so parser stops render with the right name).
int diag_file_count(void) { return g_nfiles; }

// The registered SourceFile for an AST `file` index (0 = the main module).
// Returns 0 when the index is out of range, which diag_step tolerates.
struct SourceFile* diag_file(int idx) {
    if (idx < 0 || idx >= g_nfiles) { return 0; }
    return g_files[idx];
}

void diag_reset(void) {
    g_ndiags = 0;
    g_nstops = 0;
    g_nwarns = 0;
    g_nhints = 0;
    g_nfiles = 0;
}

// ---------------------------------------------------------------------------
// Construction.
// ---------------------------------------------------------------------------

// The index a SourceFile was registered under. Diagnostics store indices, not
// pointers, so a checker stop in an imported module resolves to that module's
// path and line map at render time.
int diag_file_index(struct SourceFile* sf) {
    int i;
    if (sf == 0) { return -1; }
    i = 0;
    while (i < g_nfiles) {
        if (g_files[i] == sf) { return i; }
        i = i + 1;
    }
    return -1;
}

int diag_add(char* code, int sev, char* title, char* summary,
             struct SourceFile* sf, int off, int end) {
    struct Diagnostic* d;
    int idx;

    if (g_ndiags >= 128) {
        // Keep counting, but stop storing.
        if (sev == SEV_STOP) { g_nstops = g_nstops + 1; }
        else if (sev == SEV_WARN) { g_nwarns = g_nwarns + 1; }
        else { g_nhints = g_nhints + 1; }
        return -1;
    }
    idx = g_ndiags;
    g_ndiags = g_ndiags + 1;
    if (sev == SEV_STOP) { g_nstops = g_nstops + 1; }
    else if (sev == SEV_WARN) { g_nwarns = g_nwarns + 1; }
    else { g_nhints = g_nhints + 1; }

    d = &g_diags[idx];
    d->code = code;
    d->sev = sev;
    d->title = title;
    d->summary = summary;
    d->nstory = 0;
    d->nfixes = 0;
    if (sf != 0) {
        d->pfile = diag_file_index(sf);
        d->pstart = off;
        d->pend = end;
    } else {
        d->pfile = -1;
        d->pstart = 0;
        d->pend = 0;
    }
    return idx;
}

int diag_stop(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end) {
    return diag_add(code, SEV_STOP, title, summary, sf, off, end);
}

int diag_warn(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end) {
    return diag_add(code, SEV_WARN, title, summary, sf, off, end);
}

int diag_hint(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end) {
    return diag_add(code, SEV_HINT, title, summary, sf, off, end);
}

struct Diagnostic* diag_get(int idx) {
    if (idx < 0 || idx >= g_ndiags) { return 0; }
    return &g_diags[idx];
}

int diag_step(struct Diagnostic* d, int role, int file, int start, int end,
              char* label, int trigger) {
    struct Step* s;
    if (d == 0 || d->nstory >= MAX_STORY) { return -1; }
    s = &d->story[d->nstory];
    s->role = role;
    s->file = file;
    s->start = start;
    s->end = end;
    s->label = label;
    s->trigger = trigger;
    d->nstory = d->nstory + 1;
    return 0;
}

int diag_fix(struct Diagnostic* d, char* label, char* text) {
    struct Fix* f;
    if (d == 0 || d->nfixes >= MAX_FIXES) { return -1; }
    f = &d->fixes[d->nfixes];
    f->label = label;
    f->text = text;
    d->nfixes = d->nfixes + 1;
    return 0;
}

// ---------------------------------------------------------------------------
// Shared helpers.
// ---------------------------------------------------------------------------

void sev_word(int sev, int lowercase) {
    if (sev == SEV_STOP) {
        if (lowercase) { out_str("stop"); } else { out_str("STOP"); }
    } else if (sev == SEV_WARN) {
        if (lowercase) { out_str("warn"); } else { out_str("WARN"); }
    } else {
        if (lowercase) { out_str("hint"); } else { out_str("HINT"); }
    }
}

void role_word(int role) {
    if (role == ROLE_BORN) { out_str("born"); }
    else if (role == ROLE_MOVED) { out_str("moved"); }
    else if (role == ROLE_BORROWED) { out_str("borrowed"); }
    else if (role == ROLE_USED) { out_str("used"); }
    else if (role == ROLE_MUTATED) { out_str("mutated"); }
    else if (role == ROLE_DROPPED) { out_str("dropped"); }
    else if (role == ROLE_DECLARED) { out_str("declared"); }
    else { out_str("defined"); }
}

// ---------------------------------------------------------------------------
// JSON twin (§16.7): one object per diagnostic, stable keys.
// ---------------------------------------------------------------------------

void out_json_char(char c) {
    char b[2];
    b[0] = c;
    b[1] = 0;
    out_str(b);
}

void out_json_str(char* s) {
    int i;
    char c;
    out_str("\"");
    if (s != 0) {
        i = 0;
        while (s[i] != 0) {
            c = s[i];
            if (c == 34) { out_str("\\\""); }        // 34 = '"'
            else if (c == 92) { out_str("\\\\"); }   // 92 = backslash
            else if (c == 10) { out_str("\\n"); }
            else if (c == 13) { out_str("\\r"); }
            else if (c == 9) { out_str("\\t"); }
            else { out_json_char(c); }
            i = i + 1;
        }
    }
    out_str("\"");
}

void out_json_loc(int file, int off) {
    struct SourceFile* sf;
    int line;
    int col;
    line = 0;
    col = 0;
    sf = 0;
    if (file >= 0 && file < g_nfiles) { sf = g_files[file]; }
    if (sf != 0) { source_line_col(sf, off, &line, &col); }
    out_str("\"file\": ");
    if (sf != 0) { out_json_str(sf->path); } else { out_json_str(""); }
    out_str(", \"line\": ");
    out_int(line);
    out_str(", \"col\": ");
    out_int(col);
}

void diag_emit_json(struct Diagnostic* d) {
    struct Step* s;
    struct Fix* f;
    int line;
    int col;
    int i;

    s = 0;
    f = 0;
    line = 0;
    col = 0;

    out_str("{\"severity\": ");
    if (d->sev == SEV_STOP) { out_str("\"stop\""); }
    else if (d->sev == SEV_WARN) { out_str("\"warn\""); }
    else { out_str("\"hint\""); }
    out_str(", \"code\": ");
    out_json_str(d->code);
    out_str(", \"title\": ");
    out_json_str(d->title);
    out_str(", \"summary\": ");
    out_json_str(d->summary);
    out_str(", \"primary\": {");
    out_json_loc(d->pfile, d->pstart);
    out_str("}");
    out_str(", \"story\": [");
    i = 0;
    while (i < d->nstory) {
        s = &d->story[i];
        if (i > 0) { out_str(", "); }
        out_str("{\"step\": ");
        out_int(i + 1);
        out_str(", \"role\": ");
        role_word(s->role);
        out_str(", ");
        out_json_loc(s->file, s->start);
        out_str(", \"label\": ");
        out_json_str(s->label);
        if (s->trigger) { out_str(", \"trigger\": true"); }
        out_str("}");
        i = i + 1;
    }
    out_str("]");
    out_str(", \"fixes\": [");
    i = 0;
    while (i < d->nfixes) {
        f = &d->fixes[i];
        if (i > 0) { out_str(", "); }
        out_str("{\"label\": ");
        out_json_str(f->label);
        out_str(", \"edits\": [ {");
        out_json_loc(d->pfile, d->pstart);
        // Editors need the extent; the story/fix engine fills exact spans
        // once fix-it application lands (§16.7 `len`/`with`).
        out_str(", \"len\": 0, \"with\": ");
        out_json_str(f->text);
        out_str("} ]}");
        i = i + 1;
    }
    out_str("]");
    // `code` is a strict AREA-NN ASCII identifier (§16.10), so it needs no
    // JSON escaping — embed it directly inside the literal.
    out_str(", \"learn\": \"harmony-base explain ");
    out_str(d->code);
    out_str("\"}");
    out_nl();
}

// ---------------------------------------------------------------------------
// Line format (§16.7): one grep-friendly line per diagnostic.
//   main.harmony:11:10: stop[MOVE-01]: use of moved value `name`
// ---------------------------------------------------------------------------

void diag_emit_line(struct Diagnostic* d) {
    struct SourceFile* sf;
    int line;
    int col;
    line = 0;
    col = 0;
    sf = 0;
    if (d->pfile >= 0 && d->pfile < g_nfiles) { sf = g_files[d->pfile]; }
    if (sf != 0) { source_line_col(sf, d->pstart, &line, &col); }
    if (sf != 0) { out_str(sf->path); } else { out_str("<driver>"); }
    out_str(":");
    out_int(line);
    out_str(":");
    out_int(col);
    out_str(": ");
    sev_word(d->sev, 1);
    out_str("[");
    out_str(d->code);
    out_str("]: ");
    out_str(d->title);
    out_nl();
}

// ---------------------------------------------------------------------------
// Pretty format (§16.2 anatomy):
//   STOP  MOVE-01  main.src:11:10
//   use of moved value `name`
//
//      `name` was handed to consume() on line 10, ...
//
//      ①   8  let mut name = ...;   born: ...
//      ...
//
//   try:  lend it         consume(&name);
//   learn: harmony-base explain MOVE-01
// ---------------------------------------------------------------------------

void diag_emit_pretty(struct Diagnostic* d) {
    struct Step* s;
    struct Fix* f;
    struct SourceFile* sf;
    int line;
    int col;
    int i;

    s = 0;
    f = 0;
    sf = 0;
    line = 0;
    col = 0;

    // Header (always one line): SEVERITY  CODE  file:line:col
    sev_word(d->sev, 0);
    out_str("  ");
    out_str(d->code);
    out_str("  ");
    if (d->pfile >= 0 && d->pfile < g_nfiles) {
        sf = g_files[d->pfile];
        source_line_col(sf, d->pstart, &line, &col);
        out_str(sf->path);
        out_str(":");
        out_int(line);
        out_str(":");
        out_int(col);
    }
    out_nl();

    // Title: one short line, lowercase, no period.
    out_str(d->title);
    out_nl();
    out_nl();

    // Summary: at most two plain-English sentences.
    if (d->summary != 0 && d->summary[0] != 0) {
        out_str("   ");
        out_str(d->summary);
        out_nl();
        out_nl();
    }

    // Story: 1 to 5 steps in time order, source line trimmed, labelled.
    // Single-site diagnostics show `▸` instead of a number.
    i = 0;
    while (i < d->nstory) {
        s = &d->story[i];
        out_str("   ");
        if (d->nstory == 1) {
            out_str("\xe2\x96\xb8");        // ▸
        } else {
            // ①..⑤ are 3-byte UTF-8 sequences starting at U+2460.
            out_json_char(0xe2);
            out_json_char(0x91);
            out_json_char(0xa0 + i);
        }
        out_str("  ");
        if (s->file >= 0 && s->file < g_nfiles) {
            sf = g_files[s->file];
            source_line_col(sf, s->start, &line, &col);
            out_int(line);
            out_str("  ");
            out_str(source_line(sf, line));
        }
        if (s->label != 0 && s->label[0] != 0) {
            out_str("   ");
            out_str(s->label);
        }
        if (s->trigger) {
            out_str("  \xe2\x97\x82 here");  // ◂ here
        }
        out_nl();
        i = i + 1;
    }
    if (d->nstory > 0) { out_nl(); }

    // Fixes: `try:` is the preferred fix; `or:` are alternatives. Code in a
    // fix is valid code, with names filled in.
    i = 0;
    while (i < d->nfixes) {
        f = &d->fixes[i];
        out_str("   ");
        if (i == 0) { out_str("try:  "); } else { out_str("or:   "); }
        if (f->label != 0 && f->label[0] != 0) {
            out_str(f->label);
            if (f->text != 0 && f->text[0] != 0) {
                out_str("   ");
            }
        }
        if (f->text != 0 && f->text[0] != 0) { out_str(f->text); }
        out_nl();
        i = i + 1;
    }
    if (d->nfixes > 0) { out_nl(); }

    // Learn footer (always last).
    out_str("   learn: harmony-base explain ");
    out_str(d->code);
    out_nl();
}

// ---------------------------------------------------------------------------
// Flush: sort by primary location, cap per §16.9, render.
// ---------------------------------------------------------------------------

int diag_before(int ia, int ib) {
    struct Diagnostic* a;
    struct Diagnostic* b;
    a = &g_diags[ia];
    b = &g_diags[ib];
    if (a->pfile < 0 && b->pfile < 0) { return 0; }
    if (a->pfile < 0) { return 0; }
    if (b->pfile < 0) { return 1; }
    if (a->pstart != b->pstart) { return a->pstart < b->pstart; }
    return a->pfile < b->pfile;
}

void diag_flush(int format, int all) {
    struct Diagnostic* d;
    int i;
    int j;
    int tmp;
    int stops_shown;
    int stops_hidden;
    int warns_shown;
    int warn_pend;

    d = 0;

    // Sort by primary location, ascending (§16.9). Insertion sort: the
    // diagnostic count is small, and a stable order keeps the golden tests
    // honest.
    i = 0;
    while (i < g_ndiags) { g_order[i] = i; i = i + 1; }
    i = 1;
    while (i < g_ndiags) {
        j = i;
        while (j > 0 && diag_before(g_order[j], g_order[j - 1])) {
            tmp = g_order[j - 1];
            g_order[j - 1] = g_order[j];
            g_order[j] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }

    stops_shown = 0;
    stops_hidden = 0;
    warns_shown = 0;
    warn_pend = 0;

    i = 0;
    while (i < g_ndiags) {
        d = &g_diags[g_order[i]];
        if (d->sev == SEV_STOP) {
            if (stops_shown >= 5 && all == 0) {
                stops_hidden = stops_hidden + 1;
                i = i + 1;
                continue;
            }
            if (warn_pend == 0 && warns_shown > 0) {
                // Warnings print after a blank line, never before a stop.
                warn_pend = 1;
            }
            if (format == FORMAT_JSON) { diag_emit_json(d); }
            else if (format == FORMAT_LINE) { diag_emit_line(d); }
            else { diag_emit_pretty(d); }
            stops_shown = stops_shown + 1;
        } else if (d->sev == SEV_WARN) {
            if (warns_shown >= 10 && all == 0) {
                i = i + 1;
                continue;
            }
            if (stops_shown > 0 && warn_pend == 0) {
                out_nl();
                warn_pend = 1;
            }
            if (format == FORMAT_JSON) { diag_emit_json(d); }
            else if (format == FORMAT_LINE) { diag_emit_line(d); }
            else { diag_emit_pretty(d); }
            warns_shown = warns_shown + 1;
        } else {
            if (format == FORMAT_JSON) { diag_emit_json(d); }
            else if (format == FORMAT_LINE) { diag_emit_line(d); }
            else { diag_emit_pretty(d); }
        }
        i = i + 1;
    }

    // §16.9 tail: "…and N more stops (use --all)".
    if (stops_hidden > 0 && format != FORMAT_JSON) {
        out_str("…and ");
        out_int(stops_hidden);
        out_str(" more stops (use --all)");
        out_nl();
    }
}

// A flat message used for driver/usage errors and I/O failures. These are not
// language diagnostics: they go to stderr immediately and never enter the
// diagnostic list, so --format=json output stays pure.
void diag_plain(char* id, char* msg) {
    err_str("harmony-base: ");
    err_str(id);
    err_str(": ");
    err_str(msg);
    err_nl();
}
