// harmony-base — toolchain driver (docs/harmony.md §19.4, §19.5).
//
// After the checker accepts a program, `emit-llvm` prints the IR, `build`
// turns it into an executable (via clang + the freestanding runtime), and
// `run` also executes it. Spawning uses fork/execve directly (the driver is
// freestanding; there is no libc). Everything is written to temp files under
// /tmp so nothing depends on the current directory.

// The runtime source, relative to the repo root (the compiler is run from
// there). M1 links the runtime by compiling it with clang on demand; a
// prebuilt rt.o arrives with the stdlib build step. The bootstrap runtime
// lives under library/runtime/ (AGENTS.md layout).
char* g_rt_c = "library/runtime/rt.c";

// Temp paths for the generated IR and the linked binary. They live under
// /tmp, never inside the source tree, so a build leaves the working copy
// clean.
//
// The names are per-process (`<pid>`) because compilations are independent
// processes and must not collide: with fixed names, two concurrent `run`s
// raced on /tmp/harmony-base.bin — one clang would truncate the binary the
// other had just linked, and the loser's exec failed with status 127. A
// fuzzing campaign runs several compilations at once by design (and the final
// `harmony` is multi-core by default), so the collision was a real driver
// bug, not a fuzzer artifact.
char* g_tmp_ir = 0;
char* g_tmp_bin = 0;
char* g_tmp_cc_log = 0;

// Builds "<stem><pid><suffix>" in one arena allocation. Called three times,
// lazily on the first emit, so a tiny one-off allocation is fine and keeps the
// code simple.
char* emit_tmp_path(char* stem, char* suffix) {
    char* buf;
    int n;
    int pid;
    int i;
    char digits[24];
    pid = syscall_getpid();
    buf = arena_alloc(96);
    n = 0;
    i = 0;
    while (stem[i] != 0) { buf[n] = stem[i]; n = n + 1; i = i + 1; }
    // Decimal pid, most significant digit first (small scratch, reversed).
    i = 0;
    if (pid == 0) { digits[0] = '0'; i = 1; }
    while (pid > 0) { digits[i] = (char) ('0' + (pid - (pid / 10) * 10)); pid = pid / 10; i = i + 1; }
    while (i > 0) { i = i - 1; buf[n] = digits[i]; n = n + 1; }
    i = 0;
    while (suffix[i] != 0) { buf[n] = suffix[i]; n = n + 1; i = i + 1; }
    buf[n] = 0;
    return buf;
}

// Creates the three temp paths on first use (see above for why they are
// per-process).
void emit_init_tmp_paths(void) {
    if (g_tmp_ir != 0) { return; }
    g_tmp_ir = emit_tmp_path("/tmp/harmony-base-", ".ll");
    g_tmp_bin = emit_tmp_path("/tmp/harmony-base-", ".bin");
    g_tmp_cc_log = emit_tmp_path("/tmp/harmony-base-", ".clang.log");
}

// Removes `path` when it exists and is empty. Used to leave no litter behind
// on the happy path (a clean clang link writes an empty log).
void emit_unlink_if_empty(char* path) {
    int fd;
    int n;
    char c;
    fd = syscall_open(path, O_RDONLY, 0);
    if (fd < 0) { return; }
    n = syscall_read(fd, &c, 1);
    syscall_close(fd);
    if (n == 0) { syscall_unlink(path); }
}

// ---------------------------------------------------------------------------
// Files.
// ---------------------------------------------------------------------------
int emit_write_file(char* path, char* text, int len) {
    int fd;
    int off;
    int n;
    fd = syscall_open(path, O_WRONLY | O_CREAT | O_TRUNC, 420);
    if (fd < 0) { return fd; }
    off = 0;
    while (off < len) {
        n = syscall_write(fd, text + off, len - off);
        if (n <= 0) { syscall_close(fd); return -1; }
        off = off + n;
    }
    syscall_close(fd);
    return 0;
}

// ---------------------------------------------------------------------------
// Process spawn. `argv` is NULL-terminated. Returns the child's exit status
// (0..255), or -1 when fork/exec fails.
//
// `logpath` (when non-null) receives the child's stderr: the compiler driver
// is not a terminal firehose, so clang's diagnostics are captured here and
// only replayed on request (`-v`) or condensed on failure.
// ---------------------------------------------------------------------------
int sys_spawn_log(char** argv, char* logpath) {
    int pid;
    int status;
    int w;
    // A minimal environment: clang needs PATH to find `ld` and friends; with
    // an empty envp it cannot exec the linker.
    char* envp[2];
    envp[0] = "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";
    envp[1] = 0;
    pid = syscall_fork();
    if (pid < 0) { return -1; }
    if (pid == 0) {
        // Child: capture stderr (fd 2) into the log before exec.
        if (logpath != 0) {
            int fd;
            fd = syscall_open(logpath, O_WRONLY | O_CREAT | O_TRUNC, 420);
            if (fd >= 0) {
                if (fd != 2) {
                    syscall_dup2(fd, 2);
                    syscall_close(fd);
                }
            }
        }
        syscall_execve(argv[0], argv, envp);
        syscall_exit(127);   // exec failed
    }
    status = 0;
    // Wait for this specific child.
    w = syscall_wait4(pid, &status, 0, 0);
    if (w < 0) { return -1; }
    // WIFSIGNALED: the low 7 bits hold the signal, and there is no exit
    // status. Report it as 128+signal so a caller sees an abnormal death
    // (a `run` that crashed must not look like a success).
    if ((status & 0x7f) != 0) { return 128 + (status & 0x7f); }
    // exit status is in bits 8..15 when WIFEXITED.
    return (status >> 8) & 0xff;
}

int sys_spawn(char** argv) {
    return sys_spawn_log(argv, 0);
}

// ---------------------------------------------------------------------------
// Like sys_spawn, but also reports *how* the child ended. `*signal_no` gets
// the terminating signal (0 when the child exited normally); the return value
// is the exit status, or 128+signal for a signal death (the shell convention).
//
// The distinction matters: a `main` that returns 139 exits with status 139
// legitimately (the exit code is the value mod 256), so looking at the numeric
// code alone cannot tell "the program crashed" from "the program returned
// 139". The fuzzer's opt-level oracle needs the real signal number, and a
// `run` that traps this way should say so instead of masquerading as a
// successful run.
// ---------------------------------------------------------------------------
int sys_spawn_status(char** argv, int* signal_no) {
    int pid;
    int status;
    int w;
    char* envp[2];
    int sig;
    if (signal_no != 0) { *signal_no = 0; }
    envp[0] = "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";
    envp[1] = 0;
    pid = syscall_fork();
    if (pid < 0) { return -1; }
    if (pid == 0) {
        syscall_execve(argv[0], argv, envp);
        syscall_exit(127);   // exec failed
    }
    status = 0;
    w = syscall_wait4(pid, &status, 0, 0);
    if (w < 0) { return -1; }
    sig = status & 0x7f;
    if (sig != 0) {
        if (signal_no != 0) { *signal_no = sig; }
        return 128 + sig;
    }
    return (status >> 8) & 0xff;
}

// ---------------------------------------------------------------------------
// Spawn with a text payload on the child's stdin. Used to feed the generated
// LLVM IR straight to clang (`-x ir -`) with no `.ll` temp file (AGENTS.md).
// The parent writes `text` into a pipe and the child reads it as stdin; a
// large IR would block if we waited, so fork first, dup the read end to fd 0
// in the child, then write in the parent before waiting.
// ---------------------------------------------------------------------------
int sys_spawn_stdin(char** argv, char* text, int len, char* logpath) {
    char fdbuf[16];
    int fd0;
    int fd1;
    int pid;
    int status;
    int w;
    int off;
    char* envp[2];
    // pipe2 writes two 32-bit fds, but a c2x-seed `int` is 8 bytes, so the
    // pair is decoded from a byte buffer (little-endian), not an int[2].
    if (syscall_pipe2(fdbuf, 0) < 0) { return -1; }
    fd0 = (fdbuf[0] & 0xFF) | ((fdbuf[1] & 0xFF) << 8)
        | ((fdbuf[2] & 0xFF) << 16) | ((fdbuf[3] & 0xFF) << 24);
    fd1 = (fdbuf[4] & 0xFF) | ((fdbuf[5] & 0xFF) << 8)
        | ((fdbuf[6] & 0xFF) << 16) | ((fdbuf[7] & 0xFF) << 24);
    envp[0] = "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";
    envp[1] = 0;
    pid = syscall_fork();
    if (pid < 0) {
        syscall_close(fd0);
        syscall_close(fd1);
        return -1;
    }
    if (pid == 0) {
        // Child: read end becomes stdin; capture stderr into the log.
        syscall_dup2(fd0, 0);
        syscall_close(fd0);
        syscall_close(fd1);
        if (logpath != 0) {
            int fd;
            fd = syscall_open(logpath, O_WRONLY | O_CREAT | O_TRUNC, 420);
            if (fd >= 0) {
                if (fd != 2) {
                    syscall_dup2(fd, 2);
                    syscall_close(fd);
                }
            }
        }
        syscall_execve(argv[0], argv, envp);
        syscall_exit(127);
    }
    // Parent: write the whole payload, then close so the child sees EOF.
    syscall_close(fd0);
    off = 0;
    while (off < len) {
        int n;
        n = syscall_write(fd1, text + off, len - off);
        if (n <= 0) { break; }
        off = off + n;
    }
    syscall_close(fd1);
    status = 0;
    w = syscall_wait4(pid, &status, 0, 0);
    if (w < 0) { return -1; }
    if ((status & 0x7f) != 0) { return 128 + (status & 0x7f); }
    return (status >> 8) & 0xff;
}

// ---------------------------------------------------------------------------
// Compiler-log reporting. A rejected IR is an ICE-class failure: the user's
// program type-checked, so the noise points at the backend. Default output is
// one summary line plus the first clang error; `-v` replays the whole log.
// ---------------------------------------------------------------------------
char* emit_read_file(char* path, int max) {
    int fd;
    int n;
    int len;
    char* buf;
    buf = arena_alloc(max + 1);
    fd = syscall_open(path, O_RDONLY, 0);
    if (fd < 0) { buf[0] = 0; return buf; }
    len = 0;
    while (len < max) {
        n = syscall_read(fd, buf + len, max - len);
        if (n <= 0) { break; }
        len = len + n;
    }
    syscall_close(fd);
    buf[len] = 0;
    return buf;
}

// Index of `needle` in the NUL-terminated `s`, or -1.
int emit_index_of(char* s, char* needle) {
    int i;
    int j;
    i = 0;
    while (s[i] != 0) {
        j = 0;
        while (needle[j] != 0 && s[i + j] == needle[j]) { j = j + 1; }
        if (needle[j] == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

// Counts non-overlapping occurrences of `needle` in `s`.
int emit_count_str(char* s, char* needle) {
    int n;
    int i;
    int k;
    n = 0;
    i = 0;
    while (1) {
        k = emit_index_of(s + i, needle);
        if (k < 0) { break; }
        n = n + 1;
        i = i + k + str_len(needle);
    }
    return n;
}

// Replays the log (or a condensed form) after clang fails.
void emit_report_cc_log(char* path, int verbose) {
    char* log;
    int i;
    int start;
    int nerr;
    int shown;

    log = emit_read_file(path, 65536);
    nerr = emit_count_str(log, "error:");

    err_str("harmony-base: emit.cc: clang rejected the generated IR");
    if (nerr > 0) {
        err_str(" (");
        err_int(nerr);
        err_str(" error");
        if (nerr != 1) { err_str("s"); }
        err_str(")");
    }
    err_nl();

    if (verbose) {
        // The full log, verbatim.
        err_str(log);
        return;
    }

    // Quiet path: the first `error:` line only, then where to find the rest.
    i = 0;
    start = 0;
    shown = 0;
    while (log[i] != 0 && !shown) {
        if (log[i] == '\n') {
            if (emit_index_of(str_prefix(log + start, i - start), "error:") >= 0) {
                err_str(str_prefix(log + start, i - start));
                err_nl();
                shown = 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (shown) {
        err_str("harmony-base: emit.cc: full clang log: ");
        err_str(path);
        err_str(" (re-run with -v to print it)");
        err_nl();
    }
}

// ---------------------------------------------------------------------------
// Little string list builder for argv.
// ---------------------------------------------------------------------------
char* sp_argv[32];

void argv_reset(void) {
    int i;
    i = 0;
    while (i < 32) { sp_argv[i] = 0; i = i + 1; }
}

// ---------------------------------------------------------------------------
// The command. `emit-llvm` prints IR to stdout; `build`/`run` compile + link.
// ---------------------------------------------------------------------------

// `emit-llvm -O<level>`: run the LLVM optimizer over the generated IR and
// print the optimized IR. clang compiles IR on stdin and re-emits IR on
// stdout (`-S -emit-llvm -o -`), so every level clang accepts works here
// (including the clang-only `-Og`/`-Ofast`, which the standalone `opt`
// binary rejects) with no extra toolchain dependency. clang's diagnostics go
// to the log and are reported as an ICE if it rejects our IR.
int emit_optimize_ir(struct Options* opts) {
    int rc;
    argv_reset();
    sp_argv[0] = "/usr/bin/clang";
    sp_argv[1] = "-x";
    sp_argv[2] = "ir";
    sp_argv[3] = "-";
    sp_argv[4] = "-S";
    sp_argv[5] = "-emit-llvm";
    sp_argv[6] = "-o";
    sp_argv[7] = "-";
    sp_argv[8] = opts->opt_flag;
    sp_argv[9] = "-Wno-override-module";
    rc = sys_spawn_stdin(sp_argv, g_out, g_out_len, g_tmp_cc_log);
    if (rc != 0) {
        emit_report_cc_log(g_tmp_cc_log, opts->verbose);
        return EXIT_STOP;
    }
    return EXIT_OK;
}

// A program that calls the LLVM-C shim needs the hosted link template
// generated by tools/gen-hostlink.py. The IR is compiled to an object with
// clang (build/debug tooling only); linking uses ld directly below.
int emit_host_link(char* binpath, char* objpath) {
    struct SourceFile cfg;
    char** argv;
    char* p;
    char* end;
    int n;
    if (source_load("build/host-link.txt", &cfg) != 0) { return -1; }
    argv = arena_alloc(512 * 8);
    n = 0;
    p = cfg.data;
    end = cfg.data + cfg.len;
    while (p < end) {
        while (p < end && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) { p = p + 1; }
        if (p >= end) { break; }
        if (*p == '#') {
            while (p < end && *p != '\n') { p = p + 1; }
            continue;
        }
        {
            char* start;
            int tlen;
            int k;
            char* tok;
            start = p;
            while (p < end && *p != ' ' && *p != '\t' && *p != '\n' && *p != '\r') { p = p + 1; }
            tlen = p - start;
            tok = arena_alloc(tlen + 1);
            k = 0;
            while (k < tlen) { tok[k] = start[k]; k = k + 1; }
            tok[tlen] = 0;
            if (str_eq(tok, "<OUT>")) { argv[n] = binpath; n = n + 1; }
            else if (str_eq(tok, "<OBJ>")) { argv[n] = objpath; n = n + 1; }
            else if (str_eq(tok, "<LLVMC>")) { argv[n] = "build/llvmc.o"; n = n + 1; }
            else if (str_eq(tok, "<HOSTRT>")) { argv[n] = "build/hostrt.o"; n = n + 1; }
            else if (str_eq(tok, "<HOSTMAIN>")) { argv[n] = "build/hostmain.o"; n = n + 1; }
            else { argv[n] = tok; n = n + 1; }
        }
    }
    argv[n] = 0;
    return sys_spawn_log(argv, g_tmp_cc_log);
}

int emit_host_build(char* binpath, struct Options* opts) {
    char* objpath;
    int rc;
    objpath = emit_tmp_path("/tmp/harmony-base-", "-llvm.o");
    argv_reset();
    sp_argv[0] = "/usr/bin/clang";
    sp_argv[1] = "-x";
    sp_argv[2] = "ir";
    sp_argv[3] = "-";
    sp_argv[4] = "-c";
    sp_argv[5] = "-o";
    sp_argv[6] = objpath;
    sp_argv[7] = opts->opt_flag;
    sp_argv[8] = "-fPIC";
    sp_argv[9] = "-Wno-override-module";
    rc = sys_spawn_stdin(sp_argv, g_out, g_out_len, g_tmp_cc_log);
    if (rc == 0) { rc = emit_host_link(binpath, objpath); }
    if (rc != 0) {
        emit_report_cc_log(g_tmp_cc_log, opts->verbose);
    }
    syscall_unlink(objpath);
    emit_unlink_if_empty(g_tmp_cc_log);
    return rc;
}

int emit_command(struct Options* opts, struct AstNode* prog) {
    emit_init_tmp_paths();
    ll_emit_module(prog);

    if (opts->cmd == CMD_EMIT_LLVM) {
        // No flag: print our own IR, which is byte-deterministic (the property
        // tests, goldens, and the self-host byte-identity milestone rely on).
        // An explicit `-O` asks for the optimizer, so print its output instead.
        if (opts->opt_given) { return emit_optimize_ir(opts); }
        out_str(g_out);
        return EXIT_OK;
    }

    // build / run: feed the IR to clang on stdin (`-x ir -`) and link the
    // runtime — no `.ll` temp file (AGENTS.md). The IR bytes are `g_out`.
    {
        char* binpath;
        int rc;
        int sig;

        sig = 0;
        binpath = g_tmp_bin;
        if (opts->output != 0) { binpath = opts->output; }

        if (str_contains(g_out, "hc_llvm_")) {
            rc = emit_host_build(binpath, opts);
            if (rc != 0) { return EXIT_STOP; }
            if (opts->cmd == CMD_BUILD) { return EXIT_OK; }
        } else {
        // clang -x ir - -x c <rt.c> -o <bin> <opt> -ffreestanding ...
        // The `-x ir` applies to `-`; `-x c` resets for the runtime file
        // (otherwise clang would parse rt.c as IR and hang). The optimization
        // flag is passed straight through (default -O2, §19.5).
        argv_reset();
        sp_argv[0] = "/usr/bin/clang";
        sp_argv[1] = "-x";
        sp_argv[2] = "ir";
        sp_argv[3] = "-";
        sp_argv[4] = "-x";
        sp_argv[5] = "c";
        sp_argv[6] = g_rt_c;
        sp_argv[7] = "-o";
        sp_argv[8] = binpath;
        sp_argv[9] = opts->opt_flag;
        sp_argv[10] = "-ffreestanding";
        sp_argv[11] = "-fno-stack-protector";
        sp_argv[12] = "-fstack-clash-protection";
        sp_argv[13] = "-nostdlib";
        sp_argv[14] = "-static";
        sp_argv[15] = "-Wno-override-module";
        rc = sys_spawn_stdin(sp_argv, g_out, g_out_len, g_tmp_cc_log);
        if (rc != 0) {
            // A rejected IR is our bug (the program type-checked). Keep the
            // terminal quiet: one summary plus the first error by default, the
            // whole log under -v. When -v is set, also keep a copy of the IR
            // so it can be inspected.
            if (opts->verbose) {
                emit_write_file(g_tmp_ir, g_out, g_out_len);
            }
            emit_report_cc_log(g_tmp_cc_log, opts->verbose);
            return EXIT_STOP;
        }

        if (opts->cmd == CMD_BUILD) {
            if (opts->verbose) {
                err_str("harmony-base: wrote ");
                err_str(binpath);
                err_nl();
            }
            return EXIT_OK;
        }
        }

        // run: execute the binary, forward its exit status. A signal death is
        // reported explicitly *and* keeps the shell convention (128+signal):
        // the numeric code alone cannot distinguish a crash from a `main`
        // that legitimately returned that value (the exit code is the value
        // mod 256), so the message is what makes the two unambiguous. Common
        // causes are a violated `unchecked` contract (§13.6) or an abort from
        // an `extern "C"` call.
        argv_reset();
        sp_argv[0] = binpath;
        sig = 0;
        rc = sys_spawn_status(sp_argv, &sig);
        if (sig != 0) {
            err_str("harmony-base: the compiled program was killed by signal ");
            err_int(sig);
            err_nl();
        }
        // `run` produces no artifact the user asked for, so the per-process
        // binary is disposable. The clang log is only kept when it has
        // something to say (it is empty on a clean link).
        if (opts->output == 0) {
            syscall_unlink(g_tmp_bin);
        }
        emit_unlink_if_empty(g_tmp_cc_log);
        return rc;
    }
}
