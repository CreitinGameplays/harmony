// harmony-base — LLVM lowering, part 2: expressions (docs/harmony.md §7, §19.4).
//
// Every expression lowers to an SSA value name (or a literal constant string)
// and records its type in `g_expr_ty`. Trapping arithmetic (§7.3) uses the
// `llvm.*.with.overflow` intrinsics and calls @lc_trap when the overflow bit
// is set; division, remainder and shifts get explicit checks.
//
// M1 slice: literals, local paths, integer/float arithmetic, comparisons,
// and short-circuit `&&`/`||`. Fields, indexing, calls, casts, structs,
// enums, and `switch` land in the next batch (their AST nodes fall through
// to a zeroed value, and the checker has already validated the program).

// ---- Forward declarations (c2x-seed resolves names from earlier text) ----
char* ll_bin(char* op, int ty, char* a, char* b);
char* ll_cmp(char* op, int ty, char* a, char* b);
char* ll_const_int(int v, int ty);
char* ll_load(int ty, char* ptr);
int   ll_suffix_ty(char* suffix);
char* ll_expr_path(struct AstNode* n);
char* ll_expr_binary(struct AstNode* n);
char* ll_expr_unary(struct AstNode* n);
char* ll_expr_field(struct AstNode* n);
char* ll_expr_index(struct AstNode* n);
char* ll_expr_call(struct AstNode* n);
char* ll_expr_cast(struct AstNode* n);
char* ll_expr_struct_init(struct AstNode* n);
char* ll_expr_borrow(struct AstNode* n);
char* ll_expr_raw(struct AstNode* n);
int   ll_is_place(struct AstNode* n);
char* ll_local_temp(int t, char* v);
char* ll_expr_deref(struct AstNode* n);
char* ll_expr_heap(struct AstNode* n);
char* ll_expr_array_lit(struct AstNode* n);
char* ll_expr_variant(struct AstNode* n);
char* ll_make_enum(int ty, int tag);
char* ll_addr(struct AstNode* n);
char* ll_field_addr(struct AstNode* n);
char* ll_index_addr(struct AstNode* n);
char* ll_struct_gep(char* base, int struct_ty, int field);
char* ll_array_gep(char* base, int elem, char* idx);
char* ll_array_gep_i64(char* base, int elem, char* idx);
void  ll_bounds_check(char* idx, int n, struct AstNode* at);
void  ll_bounds_check_n(char* idx, char* len, struct AstNode* at);
char* ll_index_to_i64(char* idx);
char* ll_slice_data(char* pair);
char* ll_slice_len(char* pair);
char* ll_slice_eq(char* a, char* b);
char* ll_slice_pair(struct AstNode* n);
char* ll_len_value(struct AstNode* n);
void  ll_store_value(char* addr, int ty, char* v);
char* ll_str_literal(char* s, int len);
char* ll_format_call(struct AstNode* n, struct AstList* args);
char* ll_emit_call_args(struct AstNode* n, char* symbol, int retty, struct AstList* args);
char* ll_builtin_trap(struct AstNode* n, struct AstList* args);
char* ll_builtin_assert(struct AstNode* n, struct AstList* args);
char* ll_builtin_unreachable(struct AstNode* n, struct AstList* args);
char* ll_builtin_args(struct AstNode* n);
char* ll_builtin_exit(struct AstNode* n, struct AstList* args);
char* ll_enum_construct(struct AstNode* n, int ty, int vi, struct AstList* args);
char* ll_offset_addr(char* base, int byteoff);
char* ll_str_arg(struct AstNode* a);
void  ll_call_noreturn(char* symbol, char* arglist);
void  ll_call_void(char* symbol, char* arglist);
char* ll_i64_const(int v);
char* ll_widen_index(char* idx);
int   ty_array_len(int id);
char* ll_int_convert(char* v, int from, int to);
char* ll_convert_instr(char* op, char* v, int from, int to);
char* ll_fp_convert(char* v, int from, int to, int is_float_seq);
char* ll_int_cmp(char* op, int ty, char* l, char* r);
char* ll_logical_and(struct AstNode* n);
char* ll_logical_or(struct AstNode* n);
char* ll_overflow_op(char* which, int ty, struct AstNode* n, char* l, char* r);
char* ll_div_checked(int ty, struct AstNode* n, char* l, char* r, int is_rem);
char* ll_shift(int ty, struct AstNode* n, char* l, char* r, int is_right);
char* ll_float_bin(char* op, int ty, struct AstNode* n, char* l, char* r);
void  ll_str_append(char* buf, char* s);
void  ll_str_copy(char* dst, char* src);
int   ll_is_aggregate(int ty);
int   ll_sret_on(void);
int   ll_sret_ty(void);
void  ll_set_sret(int on, int ty);
char* ll_call_symbol(char* name);
char* ll_method_call(struct AstNode* n, struct AstNode* callee, struct AstList* args, int retty);
char* ll_emit_call(char* symbol, char* arglist, int retty, int agg);
int   ll_find_method(int rt, char* name);
char* ll_method_symbol(int rt, char* name);
char* ll_checked_bin(char* op, int ty, struct AstNode* n, char* l, char* r);
int   ll_get_terminated(void);
void  ll_set_terminated(int v);

int g_expr_ty;   // type of the most recently lowered expression

// ---- Declarations shared across the lowering files (llvm.c2 / lstmt.c2) ----
char* ll_expr(struct AstNode* n);
void  ll_block(struct AstNode* blk);
void  ll_stmt(struct AstNode* n);
void  ll_emit_trap(int code, struct AstNode* at, char* detail);
char* ll_new_reg(void);
char* ll_new_label(char* hint);
char* ll_type_name(int id);
char* ll_zero_of(int id);
int   ll_is_float_ty(int id);
char* ll_local_slot(char* name);
int   ll_local_ty(char* name);
void  ll_local_declare(char* name, char* slot, int ty);
void  ll_out_str(char* s);
void  ll_out_int(int v);
void  ll_out_nl(void);
char* ll_int_type_suffix(int ty);

// ---------------------------------------------------------------------------
// Small instruction helpers.
// ---------------------------------------------------------------------------
char* ll_bin(char* op, int ty, char* a, char* b) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = ");
    ll_out_str(op);
    ll_out_str(" ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" ");
    ll_out_str(a);
    ll_out_str(", ");
    ll_out_str(b);
    ll_out_nl();
    return r;
}

char* ll_cmp(char* op, int ty, char* a, char* b) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = ");
    ll_out_str(op);
    ll_out_str(" ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" ");
    ll_out_str(a);
    ll_out_str(", ");
    ll_out_str(b);
    ll_out_nl();
    return r;
}

char* ll_const_int(int v, int ty) {
    char* r;
    r = arena_alloc(24);
    g_expr_ty = ty;
    ll_int_into(r, v);
    return r;
}

// Loads a value of `ty` from pointer `ptr`.
char* ll_load(int ty, char* ptr) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = load ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(", ptr ");
    ll_out_str(ptr);
    ll_out_nl();
    return r;
}

// ---------------------------------------------------------------------------
// Literals.
// ---------------------------------------------------------------------------
int ll_suffix_ty(char* suffix) {
    if (str_eq(suffix, "u8")) { return TY_U8; }
    if (str_eq(suffix, "u16")) { return TY_U16; }
    if (str_eq(suffix, "u32")) { return TY_U32; }
    if (str_eq(suffix, "u64")) { return TY_U64; }
    if (str_eq(suffix, "usize")) { return TY_USIZE; }
    if (str_eq(suffix, "i8")) { return TY_I8; }
    if (str_eq(suffix, "i16")) { return TY_I16; }
    if (str_eq(suffix, "i32")) { return TY_I32; }
    if (str_eq(suffix, "i64")) { return TY_I64; }
    if (str_eq(suffix, "isize")) { return TY_ISIZE; }
    return TY_I32;
}

// The type an expression node was given by the checker (0 -> i32 fallback).
int ll_node_ty(struct AstNode* n) {
    if (n == 0 || n->ty == 0) { return TY_I32; }
    if (n->ty == TY_UINT_LIT) { return TY_I32; }
    if (n->ty == TY_FLOAT_LIT) { return TY_F64; }
    return n->ty;
}

// ---------------------------------------------------------------------------
// Expression entry point.
// ---------------------------------------------------------------------------
char* ll_expr(struct AstNode* n) {
    if (n == 0) { g_expr_ty = TY_UNIT; return "0"; }
    if (n->kind == AST_BOOL_LIT) {
        g_expr_ty = TY_BOOL;
        if (n->ival != 0) { return "true"; }
        return "false";
    }
    if (n->kind == AST_INT_LIT) {
        char* r;
        r = arena_alloc(24);
        // The checker stamps the concrete type when a literal adapts to its
        // context (§5.9); otherwise a suffix wins, then the i32 default.
        if (n->ty != 0 && !ty_is_untyped_lit(n->ty)) {
            g_expr_ty = n->ty;
        } else if (n->sval != 0) {
            g_expr_ty = ll_suffix_ty(n->sval);
        } else {
            g_expr_ty = TY_I32;
        }
        ll_int_into(r, n->ival);
        return r;
    }
    if (n->kind == AST_FLOAT_LIT) {
        int ft;
        if (n->ty != 0 && !ty_is_untyped_lit(n->ty)) { ft = n->ty; }
        else { ft = TY_F64; }
        g_expr_ty = ft;
        // LLVM accepts an f32 decimal constant only when it is exactly
        // representable (`float 1.5` is fine; `float 1.66` is rejected with
        // "floating point constant invalid for type"). Emit the literal at
        // double precision and truncate, so every f32 spelling round-trips:
        // `%v = fptrunc double 1.66 to float`. An f64 literal is returned as
        // the plain constant (unchanged, so its IR bytes stay identical).
        if (ft == TY_F32) {
            char* r;
            r = ll_new_reg();
            ll_out_str("  ");
            ll_out_str(r);
            ll_out_str(" = fptrunc double ");
            ll_out_str(n->sval);
            ll_out_str(" to float\n");
            return r;
        }
        return n->sval;
    }
    if (n->kind == AST_CHAR_LIT) {
        char* r;
        r = arena_alloc(24);
        g_expr_ty = TY_CHAR;
        ll_int_into(r, n->ival);
        return r;
    }
    if (n->kind == AST_STRING_LIT) {
        // A `&str` literal: register the bytes (deduped) and yield the fat
        // pair's address — an alloca holding { ptr to the global, length }.
        return ll_str_literal(n->sval, n->ival);
    }
    if (n->kind == AST_UNIT_LIT) { g_expr_ty = TY_UNIT; return "0"; }
    if (n->kind == AST_PATH) { return ll_expr_path(n); }
    if (n->kind == AST_BINARY) { return ll_expr_binary(n); }
    if (n->kind == AST_UNARY) { return ll_expr_unary(n); }
    if (n->kind == AST_FIELD_ACC) { return ll_expr_field(n); }
    if (n->kind == AST_INDEX) { return ll_expr_index(n); }
    if (n->kind == AST_CALL) { return ll_expr_call(n); }
    if (n->kind == AST_AS) { return ll_expr_cast(n); }
    if (n->kind == AST_STRUCT_INIT) { return ll_expr_struct_init(n); }
    if (n->kind == AST_BORROW) { return ll_expr_borrow(n); }
    if (n->kind == AST_RAW_EXPR) { return ll_expr_raw(n); }
    if (n->kind == AST_DEREF) { return ll_expr_deref(n); }
    if (n->kind == AST_HEAP) { return ll_expr_heap(n); }
    if (n->kind == AST_ARRAY_LIT) { return ll_expr_array_lit(n); }
    if (n->kind == AST_SIZEOF) {
        g_expr_ty = TY_USIZE;
        return ll_const_int(ty_size(ck_resolve_type(n->a)), TY_USIZE);
    }
    g_expr_ty = ll_node_ty(n);
    return ll_zero_of(g_expr_ty);
}

// A local binding: load from its alloca slot. An aggregate binding is
// returned by address (the caller's place logic handles it).
char* ll_expr_path(struct AstNode* n) {
    char* slot;
    int ty;
    struct AstNode* cd;
    // A qualified path (`Enum::Variant`, `Type::assoc`) is not a local.
    if (str_contains(n->sval, "::")) {
        return ll_expr_variant(n);
    }
    slot = ll_local_slot(n->sval);
    if (slot != 0) {
        ty = ll_local_ty(n->sval);
        g_expr_ty = ty;
        if (ll_is_aggregate(ty)) {
            return slot;
        }
        return ll_load(ty, slot);
    }
    // A name that is not a local may be a `const` (§6.2). Constants are
    // inlined: lower the (already checked and stamped) initializer in place, so
    // the use site sees the value rather than a zero. `ll_expr` sets
    // `g_expr_ty`, which is the constant's declared type.
    cd = ck_sym_decl_node(n->sval);
    if (cd != 0 && cd->kind == AST_CONST && cd->b != 0) {
        return ll_expr(cd->b);
    }
    // An unqualified *variant* (`Empty`, `Has`) has no local slot: build the
    // tagged enum value (§6.5). The checker resolved the enum type onto the
    // node; a unit variant is a zero-payload construction.
    ty = ll_node_ty(n);
    if (ty_kind(ty) == CTY_ENUM) {
        int vi;
        vi = ty_find_member(ty, n->sval);
        if (vi >= 0) {
            return ll_enum_construct(n, ty, vi, 0);
        }
    }
    g_expr_ty = ty;
    return ll_zero_of(ty);
}

// A bare enum variant value (`Enum::Variant`, or the prelude's bare `Empty`):
// build the tagged aggregate with the payload cleared.
char* ll_expr_variant(struct AstNode* n) {
    char* vname;
    int ty;
    int vi;
    vname = n->sval;
    if (str_contains(vname, "::")) {
        vname = vname + str_rfind(vname, "::") + 2;
    }
    ty = ll_node_ty(n);
    if (ty_kind(ty) != CTY_ENUM) { return ll_zero_of(ty); }
    vi = ty_find_member(ty, vname);
    if (vi < 0) { vi = 0; }
    return ll_make_enum(ty, vi);
}

// Builds `{ i32 tag, [N x i8] payload }` with the payload zeroed.
char* ll_make_enum(int ty, int tag) {
    char* slot;
    char* tp;
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(ty));
    ll_out_nl();
    ll_out_str("  store ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" zeroinitializer, ptr ");
    ll_out_str(slot);
    ll_out_nl();
    tp = ll_struct_gep(slot, ty, 0);
    ll_out_str("  store i32 ");
    ll_out_int(tag);
    ll_out_str(", ptr ");
    ll_out_str(tp);
    ll_out_nl();
    g_expr_ty = ty;
    return slot;   // aggregates are represented by their address
}

// ---------------------------------------------------------------------------
// Binary operators.
// ---------------------------------------------------------------------------
char* ll_expr_binary(struct AstNode* n) {
    char* op;
    char* l;
    char* r;
    int lt;
    int rt;
    op = n->sval;

    if (str_eq(op, "&&")) { return ll_logical_and(n); }
    if (str_eq(op, "||")) { return ll_logical_or(n); }

    l = ll_expr(n->a);
    lt = g_expr_ty;
    r = ll_expr(n->b);
    rt = g_expr_ty;
    if (ty_is_untyped_lit(lt)) { lt = rt; }
    return ll_checked_bin(op, lt, n, l, r);
}

// Applies an operator to already-lowered operands. Shared by binary
// expressions and compound assignments (`x += y`).
char* ll_checked_bin(char* op, int ty, struct AstNode* n, char* l, char* r) {
    if (ll_is_float_ty(ty)) { return ll_float_bin(op, ty, n, l, r); }
    // `==`/`!=` on a slice or `&str` compares contents (§7.4), not the pair
    // addresses: lower to the runtime's element-wise `lc_slice_eq`. `l` and
    // `r` are the addresses of the two (pointer, length) pairs.
    if ((str_eq(op, "==") || str_eq(op, "!="))
        && (ty_kind(ty) == CTY_SLICE || ty_kind(ty) == CTY_STRREF)) {
        char* eq;
        eq = ll_slice_eq(l, r);
        if (str_eq(op, "==")) { g_expr_ty = TY_BOOL; return eq; }
        {
            char* rv;
            rv = ll_new_reg();
            ll_out_str("  ");
            ll_out_str(rv);
            ll_out_str(" = xor i1 ");
            ll_out_str(eq);
            ll_out_str(", true\n");
            g_expr_ty = TY_BOOL;
            return rv;
        }
    }
    if (str_eq(op, "==") || str_eq(op, "!=") || str_eq(op, "<") || str_eq(op, "<=")
        || str_eq(op, ">") || str_eq(op, ">=")) {
        return ll_int_cmp(op, ty, l, r);
    }
    if (str_eq(op, "+")) { return ll_overflow_op("add", ty, n, l, r); }
    if (str_eq(op, "-")) { return ll_overflow_op("sub", ty, n, l, r); }
    if (str_eq(op, "*")) { return ll_overflow_op("mul", ty, n, l, r); }
    if (str_eq(op, "/")) { return ll_div_checked(ty, n, l, r, 0); }
    if (str_eq(op, "%")) { return ll_div_checked(ty, n, l, r, 1); }
    if (str_eq(op, "&")) { g_expr_ty = ty; return ll_bin("and", ty, l, r); }
    if (str_eq(op, "|")) { g_expr_ty = ty; return ll_bin("or", ty, l, r); }
    if (str_eq(op, "^")) { g_expr_ty = ty; return ll_bin("xor", ty, l, r); }
    if (str_eq(op, "<<")) { return ll_shift(ty, n, l, r, 0); }
    if (str_eq(op, ">>")) { return ll_shift(ty, n, l, r, 1); }
    g_expr_ty = ty;
    return ll_zero_of(ty);
}

char* ll_int_cmp(char* op, int ty, char* l, char* r) {
    char* ir;
    int sgnd;
    sgnd = 1;
    if (ty_is_unsigned(ty) || ty == TY_BOOL) { sgnd = 0; }
    // Pointers are ordered unsigned (addresses are not signed integers).
    if (ty_is_ptr(ty)) { sgnd = 0; }
    if (str_eq(op, "==")) { ir = "icmp eq"; }
    else if (str_eq(op, "!=")) { ir = "icmp ne"; }
    else if (str_eq(op, "<")) { if (sgnd) { ir = "icmp slt"; } else { ir = "icmp ult"; } }
    else if (str_eq(op, "<=")) { if (sgnd) { ir = "icmp sle"; } else { ir = "icmp ule"; } }
    else if (str_eq(op, ">")) { if (sgnd) { ir = "icmp sgt"; } else { ir = "icmp ugt"; } }
    else { if (sgnd) { ir = "icmp sge"; } else { ir = "icmp uge"; } }
    // A raw pointer compares against `null`, not the integer `0` (LLVM
    // rejects `icmp eq ptr %x, 0`). The literal is lowered to "null" by
    // ll_zero_of for pointer kinds; a pointer-vs-pointer compare is already
    // "null"-free. Only the pointer-vs-zero case needs the swap.
    if (ty_is_ptr(ty)) {
        if (str_eq(r, "0")) { r = "null"; }
        if (str_eq(l, "0")) { l = "null"; }
    }
    g_expr_ty = TY_BOOL;
    return ll_cmp(ir, ty, l, r);
}

// `&&`: evaluate the right side only when the left is true.
char* ll_logical_and(struct AstNode* n) {
    char* l;
    char* lslot;
    char* rhslbl;
    char* endlbl;
    char* res;
    l = ll_expr(n->a);
    lslot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(lslot);
    ll_out_str(" = alloca i1\n  store i1 ");
    ll_out_str(l);
    ll_out_str(", ptr ");
    ll_out_str(lslot);
    ll_out_nl();
    rhslbl = ll_new_label("and.rhs");
    endlbl = ll_new_label("and.end");
    ll_out_str("  br i1 ");
    ll_out_str(l);
    ll_out_str(", label %");
    ll_out_str(rhslbl);
    ll_out_str(", label %");
    ll_out_str(endlbl);
    ll_out_nl();
    ll_out_str(rhslbl);
    ll_out_str(":\n");
    {
        char* rr;
        rr = ll_expr(n->b);
        ll_out_str("  store i1 ");
        ll_out_str(rr);
        ll_out_str(", ptr ");
        ll_out_str(lslot);
        ll_out_nl();
        ll_out_str("  br label %");
        ll_out_str(endlbl);
        ll_out_nl();
    }
    ll_out_str(endlbl);
    ll_out_str(":\n");
    res = ll_load(TY_BOOL, lslot);
    g_expr_ty = TY_BOOL;
    return res;
}

char* ll_logical_or(struct AstNode* n) {
    char* l;
    char* lslot;
    char* rhslbl;
    char* endlbl;
    char* res;
    l = ll_expr(n->a);
    lslot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(lslot);
    ll_out_str(" = alloca i1\n  store i1 ");
    ll_out_str(l);
    ll_out_str(", ptr ");
    ll_out_str(lslot);
    ll_out_nl();
    rhslbl = ll_new_label("or.rhs");
    endlbl = ll_new_label("or.end");
    ll_out_str("  br i1 ");
    ll_out_str(l);
    ll_out_str(", label %");
    ll_out_str(endlbl);
    ll_out_str(", label %");
    ll_out_str(rhslbl);
    ll_out_nl();
    ll_out_str(rhslbl);
    ll_out_str(":\n");
    {
        char* rr;
        rr = ll_expr(n->b);
        ll_out_str("  store i1 ");
        ll_out_str(rr);
        ll_out_str(", ptr ");
        ll_out_str(lslot);
        ll_out_nl();
        ll_out_str("  br label %");
        ll_out_str(endlbl);
        ll_out_nl();
    }
    ll_out_str(endlbl);
    ll_out_str(":\n");
    res = ll_load(TY_BOOL, lslot);
    g_expr_ty = TY_BOOL;
    return res;
}

// Checked + - *: `llvm.{s,u}{add,sub,mul}.with.overflow`, then trap on bit 1.
char* ll_overflow_op(char* which, int ty, struct AstNode* n, char* l, char* r) {
    char* pair;
    char* val;
    char* ovf;
    char* oklbl;
    char* taplbl;
    pair = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(pair);
    ll_out_str(" = call { ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(", i1 } @llvm.");
    if (ty_is_unsigned(ty)) { ll_out_str("u"); } else { ll_out_str("s"); }
    ll_out_str(which);
    ll_out_str(".with.overflow.");
    ll_out_str(ll_int_type_suffix(ty));
    ll_out_str("(");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" ");
    ll_out_str(l);
    ll_out_str(", ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" ");
    ll_out_str(r);
    ll_out_str(")\n");
    val = ll_new_reg();
    ovf = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(val);
    ll_out_str(" = extractvalue { ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(", i1 } ");
    ll_out_str(pair);
    ll_out_str(", 0\n  ");
    ll_out_str(ovf);
    ll_out_str(" = extractvalue { ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(", i1 } ");
    ll_out_str(pair);
    ll_out_str(", 1\n");
    oklbl = ll_new_label("arith.ok");
    taplbl = ll_new_label("arith.trap");
    ll_out_str("  br i1 ");
    ll_out_str(ovf);
    ll_out_str(", label %");
    ll_out_str(taplbl);
    ll_out_str(", label %");
    ll_out_str(oklbl);
    ll_out_nl();
    ll_out_str(taplbl);
    ll_out_str(":\n");
    ll_emit_trap(3 /* T-OVERFLOW */, n, 0);
    ll_out_str(oklbl);
    ll_out_str(":\n");
    g_expr_ty = ty;
    return val;
}

// Division/remainder: reject a zero divisor (T-DIV0), then divide.
char* ll_div_checked(int ty, struct AstNode* n, char* l, char* r, int is_rem) {
    char* iszero;
    char* zerolbl;
    char* oklbl;
    iszero = ll_cmp("icmp eq", ty, r, "0");
    zerolbl = ll_new_label("div.zero");
    oklbl = ll_new_label("div.ok");
    ll_out_str("  br i1 ");
    ll_out_str(iszero);
    ll_out_str(", label %");
    ll_out_str(zerolbl);
    ll_out_str(", label %");
    ll_out_str(oklbl);
    ll_out_nl();
    ll_out_str(zerolbl);
    ll_out_str(":\n");
    ll_emit_trap(4 /* T-DIV0 */, n, 0);
    ll_out_str(oklbl);
    ll_out_str(":\n");
    g_expr_ty = ty;
    if (is_rem) { return ll_bin("srem", ty, l, r); }
    if (ty_is_unsigned(ty)) { return ll_bin("udiv", ty, l, r); }
    return ll_bin("sdiv", ty, l, r);
}

// Shifts: the amount must be < the bit width (T-SHIFT).
char* ll_shift(int ty, struct AstNode* n, char* l, char* r, int is_right) {
    char* inrange;
    char* badlbl;
    char* oklbl;
    inrange = ll_cmp("icmp ult", ty, r, ll_const_int(ty_bit_width(ty), ty));
    badlbl = ll_new_label("shift.bad");
    oklbl = ll_new_label("shift.ok");
    ll_out_str("  br i1 ");
    ll_out_str(inrange);
    ll_out_str(", label %");
    ll_out_str(oklbl);
    ll_out_str(", label %");
    ll_out_str(badlbl);
    ll_out_nl();
    ll_out_str(badlbl);
    ll_out_str(":\n");
    ll_emit_trap(5 /* T-SHIFT */, n, 0);
    ll_out_str(oklbl);
    ll_out_str(":\n");
    g_expr_ty = ty;
    if (is_right) {
        if (ty_is_unsigned(ty)) { return ll_bin("lshr", ty, l, r); }
        return ll_bin("ashr", ty, l, r);
    }
    return ll_bin("shl", ty, l, r);
}

// Float arithmetic / comparison (IEEE, no traps, §7.3).
//
// `ty` is the operand type from the checker (either `f32` or `f64`): the
// emitted `fadd`/`fcmp`/... must match the operands' width, or LLVM rejects
// the IR ("defined with type 'float' but expected 'double'"). An untyped
// float literal defaults to `f64` (§5.9).
char* ll_float_bin(char* op, int ty, struct AstNode* n, char* l, char* r) {
    if (ty_is_untyped_lit(ty)) { ty = TY_F64; }
    if (str_eq(op, "==") || str_eq(op, "!=") || str_eq(op, "<") || str_eq(op, "<=")
        || str_eq(op, ">") || str_eq(op, ">=")) {
        char* ir;
        if (str_eq(op, "==")) { ir = "fcmp oeq"; }
        else if (str_eq(op, "!=")) { ir = "fcmp une"; }
        else if (str_eq(op, "<")) { ir = "fcmp olt"; }
        else if (str_eq(op, "<=")) { ir = "fcmp ole"; }
        else if (str_eq(op, ">")) { ir = "fcmp ogt"; }
        else { ir = "fcmp oge"; }
        g_expr_ty = TY_BOOL;
        return ll_cmp(ir, ty, l, r);
    }
    g_expr_ty = ty;
    if (str_eq(op, "+")) { return ll_bin("fadd", ty, l, r); }
    if (str_eq(op, "-")) { return ll_bin("fsub", ty, l, r); }
    if (str_eq(op, "*")) { return ll_bin("fmul", ty, l, r); }
    if (str_eq(op, "/")) { return ll_bin("fdiv", ty, l, r); }
    g_expr_ty = ty;
    return ll_zero_of(ty);
}

// ---------------------------------------------------------------------------
// Unary operators.
// ---------------------------------------------------------------------------
char* ll_expr_unary(struct AstNode* n) {
    char* op;
    op = n->sval;
    if (str_eq(op, "-")) {
        char* v;
        int ty;
        v = ll_expr(n->a);
        ty = g_expr_ty;
        if (ll_is_float_ty(ty)) {
            g_expr_ty = ty;
            return ll_bin("fsub", ty, ll_zero_of(ty), v);
        }
        // MIN negation traps; reuse the checked-sub logic with l = 0.
        return ll_overflow_op("sub", ty, n, ll_zero_of(ty), v);
    }
    if (str_eq(op, "!")) {
        char* v;
        char* r;
        v = ll_expr(n->a);
        r = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(r);
        ll_out_str(" = xor i1 ");
        ll_out_str(v);
        ll_out_str(", true\n");
        g_expr_ty = TY_BOOL;
        return r;
    }
    if (str_eq(op, "~")) {
        char* v;
        int ty;
        v = ll_expr(n->a);
        ty = g_expr_ty;
        g_expr_ty = ty;
        return ll_bin("xor", ty, v, "-1");
    }
    return ll_expr(n->a);
}

// ---------------------------------------------------------------------------
// Lvalues: compute the address of a place (variable, field, array element,
// dereference). Returns a pointer-valued SSA name.
// ---------------------------------------------------------------------------
char* ll_addr(struct AstNode* n) {
    if (n == 0) { return "null"; }
    if (n->kind == AST_PATH) {
        char* slot;
        struct AstNode* cd;
        slot = ll_local_slot(n->sval);
        if (slot != 0) { return slot; }
        // A `const` aggregate (array/struct) has no storage of its own; the
        // index/field logic needs an address, so materialize a fresh copy by
        // lowering the inlined initializer (aggregates are address-represented).
        cd = ck_sym_decl_node(n->sval);
        if (cd != 0 && cd->kind == AST_CONST && cd->b != 0) {
            return ll_expr(cd->b);
        }
        return "null";
    }
    if (n->kind == AST_DEREF) {
        // `*p` — the pointer value itself is the address.
        return ll_expr(n->a);
    }
    if (n->kind == AST_FIELD_ACC) { return ll_field_addr(n); }
    if (n->kind == AST_INDEX) {
        // A range index is a slice/`&str` value: its address is a fresh pair.
        if (ty_kind(n->ty) == CTY_SLICE || ty_kind(n->ty) == CTY_STRREF) {
            return ll_slice_pair(n);
        }
        return ll_index_addr(n);
    }
    return "null";
}

// Address of `base.field`.
char* ll_field_addr(struct AstNode* n) {
    int bt;
    char* baseaddr;
    int fi;
    bt = n->a->ty;
    if (ty_is_ref(bt) || ty_is_heap(bt)) {
        // `r.field`: the base is a pointer already.
        baseaddr = ll_expr(n->a);
        bt = ty_elem(bt);
    } else {
        baseaddr = ll_addr(n->a);
    }
    fi = ty_find_member(bt, n->sval);
    if (fi < 0) { fi = 0; }
    return ll_struct_gep(baseaddr, bt, fi);
}

// `getelementptr inbounds %struct.X, ptr base, i32 0, i32 i`.
char* ll_struct_gep(char* base, int struct_ty, int field) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = getelementptr inbounds ");
    ll_out_str(ll_type_name(struct_ty));
    ll_out_str(", ptr ");
    ll_out_str(base);
    ll_out_str(", i32 0, i32 ");
    ll_out_int(field);
    ll_out_nl();
    return r;
}

// Address of `base[i]` with a bounds check (§3.2).
char* ll_index_addr(struct AstNode* n) {
    int bt;
    int elem;
    int alen;
    char* baseaddr;
    char* idx;
    char* wide;

    bt = n->a->ty;
    if (ty_kind(bt) == CTY_SLICE) {
        // Slice indexing: the pair carries a runtime length.
        char* pair;
        char* data;
        char* len;
        pair = ll_expr(n->a);
        data = ll_slice_data(pair);
        len = ll_slice_len(pair);
        idx = ll_expr(n->b);
        wide = ll_index_to_i64(idx);
        ll_bounds_check_n(wide, len, n);
        elem = ty_elem(bt);
        if (elem == 0) { elem = TY_I32; }
        return ll_array_gep_i64(data, elem, wide);
    }
    if (ty_is_ref(bt) || ty_is_ptr(bt) || ty_is_heap(bt)) {
        // A reference, raw pointer, or `Heap` box evaluates to a pointer to the
        // element data already, so it *is* the base address: `h[i]` auto-derefs
        // through `Heap` exactly like `h.field` does (§5, §12.2). Taking
        // `ll_addr` here would index off the box's own storage instead of the
        // pointee — a silent wrong-value read/write.
        baseaddr = ll_expr(n->a);
        bt = ty_elem(bt);
    } else {
        baseaddr = ll_addr(n->a);
    }
    idx = ll_expr(n->b);
    wide = ll_index_to_i64(idx);

    if (ty_is_array(bt)) {
        elem = ty_elem(bt);
        alen = ty_array_len(bt);
        ll_bounds_check_n(wide, ll_const_int(alen, TY_ISIZE), n);
        return ll_array_gep_i64(baseaddr, elem, wide);
    }
    elem = ty_elem(bt);
    if (elem == 0) { elem = TY_I32; }
    return ll_array_gep_i64(baseaddr, elem, wide);
}

// `getelementptr T, ptr base, i64 idx` with an already-i64 index.
char* ll_array_gep_i64(char* base, int elem, char* idx) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = getelementptr inbounds ");
    ll_out_str(ll_type_name(elem));
    ll_out_str(", ptr ");
    ll_out_str(base);
    ll_out_str(", i64 ");
    ll_out_str(idx);
    ll_out_nl();
    return r;
}

// `getelementptr T, ptr base, i64 idx` (T is the element type).
char* ll_array_gep(char* base, int elem, char* idx) {
    return ll_array_gep_i64(base, elem, ll_index_to_i64(idx));
}

// Widens an index to the runtime's i64 without assuming its width. The
// backend tracks the last expression's type in `g_expr_ty`; after conversion
// the current type becomes isize so a second call is a no-op.
char* ll_index_to_i64(char* idx) {
    int t;
    t = g_expr_ty;
    if (ty_is_untyped_lit(t)) { t = TY_I32; }
    if (!ty_is_integer(t)) { return idx; }
    if (ty_bit_width(t) == 64) { g_expr_ty = TY_ISIZE; return idx; }
    idx = ll_int_convert(idx, t, TY_ISIZE);
    g_expr_ty = TY_ISIZE;
    return idx;
}

// `call void @lc_check_index(i, n, file, col)` — the runtime traps on OOB.
// A negative index is a trap, not a wraparound. `idx` and `len` are already
// i64 SSA values (the caller widens once, before any other expression can
// change `g_expr_ty`).
void ll_bounds_check_n(char* idx, char* len, struct AstNode* at) {
    ll_out_str("  call void @lc_check_index(i64 ");
    ll_out_str(idx);
    ll_out_str(", i64 ");
    ll_out_str(len);
    ll_out_str(", i64 ");
    ll_out_int(at->file);
    ll_out_str(", i64 ");
    ll_out_int(at->start);
    ll_out_str(")\n");
}

void ll_bounds_check(char* idx, int n, struct AstNode* at) {
    char* wide;
    wide = ll_index_to_i64(idx);
    ll_bounds_check_n(wide, ll_const_int(n, TY_ISIZE), at);
}

// The two halves of a slice pair stored at `pair`.
char* ll_slice_data(char* pair) {
    char* gp;
    char* r;
    gp = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(gp);
    ll_out_str(" = getelementptr inbounds %slice, ptr ");
    ll_out_str(pair);
    ll_out_str(", i32 0, i32 0\n");
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = load ptr, ptr ");
    ll_out_str(gp);
    ll_out_nl();
    return r;
}

char* ll_slice_len(char* pair) {
    char* gp;
    char* r;
    gp = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(gp);
    ll_out_str(" = getelementptr inbounds %slice, ptr ");
    ll_out_str(pair);
    ll_out_str(", i32 0, i32 1\n");
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = load i64, ptr ");
    ll_out_str(gp);
    ll_out_nl();
    return r;
}

// `lc_slice_eq(a_ptr, a_len, b_ptr, b_len)` — contents equality of two slice
// (pointer, length) pairs (§7.4). `a`/`b` are the addresses of the pairs.
char* ll_slice_eq(char* a, char* b) {
    char* ad;
    char* al;
    char* bd;
    char* bl;
    char* r;
    ad = ll_slice_data(a);
    al = ll_slice_len(a);
    bd = ll_slice_data(b);
    bl = ll_slice_len(b);
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = call i64 @lc_slice_eq(ptr ");
    ll_out_str(ad);
    ll_out_str(", i64 ");
    ll_out_str(al);
    ll_out_str(", ptr ");
    ll_out_str(bd);
    ll_out_str(", i64 ");
    ll_out_str(bl);
    ll_out_str(")\n");
    {
        char* bv;
        bv = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(bv);
        ll_out_str(" = icmp ne i64 ");
        ll_out_str(r);
        ll_out_str(", 0\n");
        return bv;
    }
}

// Builds the slice pair for `base[lo..hi]` / `base[..]` (§5.2). `n` is the
// range index node. The bounds run through `lc_check_slice`, so a bad range
// is a T-SLICE trap, never a wild pointer.
char* ll_slice_pair(struct AstNode* n) {
    int bt;
    int elem;
    int is_str;
    char* data;
    char* len;
    char* lo;
    char* hi;
    char* slot;
    struct AstNode* r;

    r = n->b;
    bt = n->a->ty;
    is_str = 0;
    if (ty_kind(bt) == CTY_SLICE || ty_kind(bt) == CTY_STRREF) {
        // Slice / `&str`: the base is already a (pointer, length) pair; take
        // both halves and re-slice. A `&str` byte range slices bytes.
        char* pair;
        pair = ll_expr(n->a);
        if (ty_kind(bt) == CTY_STRREF) {
            elem = TY_U8;
            is_str = 1;
        } else {
            elem = ty_elem(bt);
        }
        data = ll_slice_data(pair);
        len = ll_slice_len(pair);
    } else if (ty_is_ref(bt) && ty_is_array(ty_elem(bt))) {
        int at;
        at = ty_elem(bt);
        elem = ty_elem(at);
        data = ll_expr(n->a);
        len = ll_const_int(ty_array_len(at), TY_ISIZE);
    } else if (ty_is_heap(bt) && ty_is_array(ty_elem(bt))) {
        // `&h[a..b]` on a `Heap<[T; N]>` (§5, §12.2): the box evaluates to a
        // pointer to the pointee array, and the length is the array's. Without
        // this, the base fell through to `ll_addr` (the box's own storage) and
        // the length came out 0, so the slice always trapped T-SLICE.
        int at;
        at = ty_elem(bt);
        elem = ty_elem(at);
        data = ll_expr(n->a);
        len = ll_const_int(ty_array_len(at), TY_ISIZE);
    } else if (ty_is_heap(bt) && ty_kind(ty_elem(bt)) == CTY_SLICE) {
        // `&h[a..b]` on a `Heap<[T]>`: the box points at a slice value (a
        // pair); load both halves and re-slice.
        int at;
        char* pair;
        at = ty_elem(bt);
        pair = ll_expr(n->a);
        elem = ty_elem(at);
        data = ll_slice_data(pair);
        len = ll_slice_len(pair);
    } else {
        elem = ty_elem(bt);
        data = ll_addr(n->a);
        len = ll_const_int(ty_array_len(bt), TY_ISIZE);
    }
    if (elem == 0) { elem = TY_I32; }

    // Bounds are evaluated left to right (§7.5); an absent bound defaults to
    // the start or the end.
    if (r->a != 0) {
        lo = ll_expr(r->a);
        lo = ll_index_to_i64(lo);
    } else {
        lo = "0";
    }
    if (r->b != 0) {
        hi = ll_expr(r->b);
        hi = ll_index_to_i64(hi);
        if (str_eq(r->sval, "..=")) { hi = ll_bin("add", TY_ISIZE, hi, "1"); }
    } else {
        hi = len;
    }

    ll_out_str("  call void @lc_check_slice(i64 ");
    ll_out_str(lo);
    ll_out_str(", i64 ");
    ll_out_str(hi);
    ll_out_str(", i64 ");
    ll_out_str(len);
    ll_out_str(", i64 ");
    ll_out_int(n->file);
    ll_out_str(", i64 ");
    ll_out_int(n->start);
    ll_out_str(")\n");

    // A `&str` slice must land on character boundaries (§5.2): check both ends
    // so the result is always a valid `&str` (T-SLICE otherwise). Plain slices
    // skip this — their elements have no boundary structure.
    if (is_str) {
        ll_out_str("  call void @lc_check_boundary(ptr ");
        ll_out_str(data);
        ll_out_str(", i64 ");
        ll_out_str(len);
        ll_out_str(", i64 ");
        ll_out_str(lo);
        ll_out_str(", i64 ");
        ll_out_int(n->file);
        ll_out_str(", i64 ");
        ll_out_int(n->start);
        ll_out_str(")\n");
        ll_out_str("  call void @lc_check_boundary(ptr ");
        ll_out_str(data);
        ll_out_str(", i64 ");
        ll_out_str(len);
        ll_out_str(", i64 ");
        ll_out_str(hi);
        ll_out_str(", i64 ");
        ll_out_int(n->file);
        ll_out_str(", i64 ");
        ll_out_int(n->start);
        ll_out_str(")\n");
    }

    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca %slice\n");
    {
        char* f0;
        char* newdata;
        char* f1;
        char* newlen;
        newdata = ll_array_gep_i64(data, elem, lo);
        newlen = ll_bin("sub", TY_ISIZE, hi, lo);
        f0 = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(f0);
        ll_out_str(" = getelementptr inbounds %slice, ptr ");
        ll_out_str(slot);
        ll_out_str(", i32 0, i32 0\n");
        ll_out_str("  store ptr ");
        ll_out_str(newdata);
        ll_out_str(", ptr ");
        ll_out_str(f0);
        ll_out_nl();
        f1 = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(f1);
        ll_out_str(" = getelementptr inbounds %slice, ptr ");
        ll_out_str(slot);
        ll_out_str(", i32 0, i32 1\n");
        ll_out_str("  store i64 ");
        ll_out_str(newlen);
        ll_out_str(", ptr ");
        ll_out_str(f1);
        ll_out_nl();
    }
    g_expr_ty = ll_node_ty(n);
    return slot;
}

// `.len()` on an array (a constant) or a slice (its length half).
char* ll_len_value(struct AstNode* n) {
    struct AstNode* recv;
    int rt;
    int lt;
    recv = n->a->a;
    rt = recv->ty;
    lt = rt;
    // Unwrap references and `Heap` boxes to reach the array underneath; a
    // slice/`&str` is the fat pair itself and stops here.
    while ((ty_is_ref(lt) || ty_is_heap(lt))
           && ty_kind(lt) != CTY_SLICE && ty_kind(lt) != CTY_STRREF) {
        lt = ty_elem(lt);
    }
    if (ty_is_array(lt)) {
        g_expr_ty = TY_USIZE;
        return ll_const_int(ty_array_len(lt), TY_USIZE);
    }
    // Slice: read the length half of the pair (evaluate the receiver first;
    // it may itself be a call and update g_expr_ty).
    {
        char* pair;
        pair = ll_expr(recv);
        g_expr_ty = TY_USIZE;
        return ll_slice_len(pair);
    }
}

// Stores one value into `addr`. Aggregates (structs, enums, arrays, slices)
// are address-represented, so they are copied; scalars are stored directly.
void ll_store_value(char* addr, int ty, char* v) {
    if (ll_is_aggregate(ty)) {
        ll_out_str("  call void @llvm.memcpy.p0.p0.i64(ptr align 8 ");
        ll_out_str(addr);
        ll_out_str(", ptr align 8 ");
        ll_out_str(v);
        ll_out_str(", i64 ");
        ll_out_int(ty_size(ty));
        ll_out_str(", i1 false)\n");
        return;
    }
    ll_out_str("  store ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" ");
    ll_out_str(v);
    ll_out_str(", ptr ");
    ll_out_str(addr);
    ll_out_nl();
}

// A `&str` literal (§5.3): register the bytes as a global (deduped) and build
// the fat pair { ptr, len } in an alloca, returning its address.
char* ll_str_literal(char* s, int len) {
    int idx;
    char* sym;
    char* slot;
    char* f0;
    char* f1;
    idx = ll_str_intern(s, len);
    sym = ll_str_symbol(idx);
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca %slice\n");
    f0 = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(f0);
    ll_out_str(" = getelementptr inbounds %slice, ptr ");
    ll_out_str(slot);
    ll_out_str(", i32 0, i32 0\n");
    ll_out_str("  store ptr ");
    ll_out_str(sym);
    ll_out_str(", ptr ");
    ll_out_str(f0);
    ll_out_nl();
    f1 = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(f1);
    ll_out_str(" = getelementptr inbounds %slice, ptr ");
    ll_out_str(slot);
    ll_out_str(", i32 0, i32 1\n");
    ll_out_str("  store i64 ");
    ll_out_int(len);
    ll_out_str(", ptr ");
    ll_out_str(f1);
    ll_out_nl();
    g_expr_ty = ty_new(CTY_STRREF, "&str", TY_U8, 0);
    return slot;
}

// ---------------------------------------------------------------------------
// Prelude builtins (§15.1): `trap`, `assert`, `unreachable`, `exit`. Each
// lowers to a runtime hook; the trap-like ones end the basic block.
// ---------------------------------------------------------------------------
// Emits `call void @sym(args)` and marks the block terminated.
void ll_call_noreturn(char* symbol, char* arglist) {
    ll_out_str("  call void @");
    ll_out_str(symbol);
    ll_out_str("(");
    ll_out_str(arglist);
    ll_out_str(")\n");
    ll_out_str("  unreachable\n");
    ll_set_terminated(1);
}

// The `(&str)` halves of a `&str` argument as `ptr <data>, i64 <len>`.
char* ll_str_arg(struct AstNode* a) {
    char* pair;
    char* data;
    char* len;
    char* b;
    pair = ll_expr(a);
    data = ll_slice_data(pair);
    len = ll_slice_len(pair);
    b = arena_alloc(96);
    b[0] = 0;
    ll_str_append(b, "ptr ");
    ll_str_append(b, data);
    ll_str_append(b, ", i64 ");
    ll_str_append(b, len);
    return b;
}

// `trap(msg)` -> lc_trap_msg(ptr, len, line, col).
char* ll_builtin_trap(struct AstNode* n, struct AstList* args) {
    char* b;
    b = arena_alloc(160);
    b[0] = 0;
    ll_str_append(b, ll_str_arg(args->items[0]));
    ll_str_append(b, ", i64 ");
    ll_str_append(b, ll_i64_const(n->file));
    ll_str_append(b, ", i64 ");
    ll_str_append(b, ll_i64_const(n->start));
    ll_call_noreturn("lc_trap_msg", b);
    g_expr_ty = TY_NEVER;
    return "0";
}

// `assert(cond[, msg])` -> lc_assert(cond, ptr, len, line, col). The message
// halves are zero when the one-argument form is used.
char* ll_builtin_assert(struct AstNode* n, struct AstList* args) {
    char* cond;
    char* b;
    cond = ll_expr(args->items[0]);
    cond = ll_int_convert(cond, TY_BOOL, TY_I64);
    b = arena_alloc(192);
    b[0] = 0;
    ll_str_append(b, "i64 ");
    ll_str_append(b, cond);
    ll_str_append(b, ", ");
    if (args->len == 2) {
        ll_str_append(b, ll_str_arg(args->items[1]));
    } else {
        ll_str_append(b, "ptr null, i64 0");
    }
    ll_str_append(b, ", i64 ");
    ll_str_append(b, ll_i64_const(n->file));
    ll_str_append(b, ", i64 ");
    ll_str_append(b, ll_i64_const(n->start));
    ll_call_void("lc_assert", b);
    // `assert` may return (the condition held), so the block continues.
    g_expr_ty = TY_UNIT;
    return "0";
}

// `unreachable()` -> lc_unreachable(line, col).
char* ll_builtin_unreachable(struct AstNode* n, struct AstList* args) {
    char* b;
    b = arena_alloc(64);
    b[0] = 0;
    ll_str_append(b, "i64 ");
    ll_str_append(b, ll_i64_const(n->file));
    ll_str_append(b, ", i64 ");
    ll_str_append(b, ll_i64_const(n->start));
    ll_call_noreturn("lc_unreachable", b);
    g_expr_ty = TY_NEVER;
    return "0";
}

// `exit(code)` -> lc_exit(code).
char* ll_builtin_exit(struct AstNode* n, struct AstList* args) {
    char* code;
    char* b;
    code = ll_expr(args->items[0]);
    code = ll_int_convert(code, TY_I32, TY_I64);
    b = arena_alloc(64);
    b[0] = 0;
    ll_str_append(b, "i64 ");
    ll_str_append(b, code);
    ll_call_noreturn("lc_exit", b);
    g_expr_ty = TY_NEVER;
    return "0";
}

// `args() -> &[&str]` (§15.6): the runtime keeps a static slice of argument
// pairs and returns its address from `lc_args()`. Copy the 16 bytes into a
// fresh alloca (the aggregate-represented value this expression produces) so
// the result behaves like any other slice value.
char* ll_builtin_args(struct AstNode* n) {
    char* slot;
    char* src;
    int ty;
    ty = ll_node_ty(n);
    src = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(src);
    ll_out_str(" = call ptr @lc_args()\n");
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(ty));
    ll_out_nl();
    ll_out_str("  call void @llvm.memcpy.p0.p0.i64(ptr align 8 ");
    ll_out_str(slot);
    ll_out_str(", ptr align 8 ");
    ll_out_str(src);
    ll_out_str(", i64 16, i1 false)\n");
    g_expr_ty = ty;
    return slot;
}

// `Enum::Variant(payload...)` (§6.5): allocate the `{ i32 tag, [N x i8] }`
// aggregate, zero it, store the tag, then store each payload field at its
// offset within the payload area (8 bytes in, since the enum is 8-aligned).
char* ll_enum_construct(struct AstNode* n, int ty, int vi, struct AstList* args) {
    int pid;
    char* slot;
    char* tp;
    int i;
    pid = ty_member_type(ty, vi);
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(ty));
    ll_out_nl();
    ll_out_str("  store ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" zeroinitializer, ptr ");
    ll_out_str(slot);
    ll_out_nl();
    tp = ll_struct_gep(slot, ty, 0);
    ll_out_str("  store i32 ");
    ll_out_int(vi);
    ll_out_str(", ptr ");
    ll_out_str(tp);
    ll_out_nl();
    // Payload: a byte offset into the enum, starting past the 8-byte header.
    if (args != 0) {
        i = 0;
        while (i < args->len) {
            int ft;
            char* v;
            char* addr;
            ft = ty_member_type(pid, i);
            v = ll_expr(args->items[i]);
            addr = ll_offset_addr(slot, 8 + ty_field_offset(pid, i));
            ll_store_value(addr, ft, v);
            i = i + 1;
        }
    }
    g_expr_ty = ty;
    return slot;
}

// The address of `base + byteoff` as an i8 pointer (for enum payloads).
char* ll_offset_addr(char* base, int byteoff) {
    char* r;
    if (byteoff == 0) { return base; }
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = getelementptr inbounds i8, ptr ");
    ll_out_str(base);
    ll_out_str(", i64 ");
    ll_out_int(byteoff);
    ll_out_nl();
    return r;
}

// Kept for callers that only have an i32 index; same as ll_index_to_i64.
char* ll_widen_index(char* idx) {
    return ll_index_to_i64(idx);
}

// ---------------------------------------------------------------------------
// `print`/`println`/`eprintln` (§15.1). The checker parsed the format (FMT-01)
// and left the pieces in the `g_fmt_*` arrays; here we lower the call to a
// run of runtime hooks: pick the fd, write each literal run, and render each
// placeholder with the width/precision/zero-pad it carries. `n->ival` is 1
// for `print`, 2 for `println`, 3 for `eprintln`.
// ---------------------------------------------------------------------------
void ll_call_void(char* symbol, char* arglist) {
    ll_out_str("  call void @");
    ll_out_str(symbol);
    ll_out_str("(");
    ll_out_str(arglist);
    ll_out_str(")\n");
}

// Width/precision are passed as i64 constants (0 = none).
char* ll_i64_const(int v) {
    char* r;
    r = arena_alloc(24);
    ll_int_into(r, v);
    return r;
}

char* ll_format_call(struct AstNode* n, struct AstList* args) {
    int argi;      // next runtime argument (1 = first value arg)
    int k;
    int println;
    struct AstNode* fmt;

    println = (n->ival == 2 || n->ival == 3);
    // Re-parse this call's format string: `g_fmt_*` is shared checker state
    // that a later call would have overwritten.
    fmt = args->items[0];
    fmt_parse(fmt->sval, fmt->ival);
    // Choose the target fd first: 2 for `eprintln`, 1 otherwise.
    {
        char* b;
        b = arena_alloc(64);
        b[0] = 0;
        if (n->ival == 3) { ll_str_append(b, "i64 2"); } else { ll_str_append(b, "i64 1"); }
        ll_call_void("lc_set_fd", b);
    }

    argi = 1;   // args->items[0] is the format string
    k = 0;
    while (k < g_fmt_n) {
        if (g_fmt_kind[k] == FMT_LIT) {
            // Literal run: intern the piece on its own (deduped) and write it
            // with lc_put_str(ptr, len).
            int idx;
            char* sym;
            char* b;
            idx = ll_str_intern(g_fmt_litbuf + g_fmt_start[k], g_fmt_len[k]);
            sym = ll_str_symbol(idx);
            b = arena_alloc(256);
            b[0] = 0;
            ll_str_append(b, "ptr ");
            ll_str_append(b, sym);
            ll_str_append(b, ", i64 ");
            {
                char* lenb;
                lenb = arena_alloc(24);
                ll_int_into(lenb, g_fmt_len[k]);
                ll_str_append(b, lenb);
            }
            ll_call_void("lc_put_str", b);
        } else {
            // A placeholder: evaluate its argument, then call the right hook
            // with (value, width, zero) or (value, width, prec, has_prec).
            struct AstNode* arg;
            char* val;
            int aty;
            char* b;
            int has_w;
            int has_p;
            int zero;
            arg = args->items[argi];
            val = ll_expr(arg);
            aty = g_expr_ty;
            has_w = g_fmt_has_width[k];
            has_p = g_fmt_has_prec[k];
            zero = g_fmt_zero[k];
            b = arena_alloc(256);
            b[0] = 0;
            // Normalize the value into the hook's parameter type: integers
            // widen/sign-extend to i64; floats to double; bool to i64; a
            // char scalar to i64. An untyped literal adopts i64/f64.
            if (ty_is_untyped_lit(aty)) {
                if (aty == TY_UINT_LIT) { aty = TY_I32; } else { aty = TY_F64; }
            }
            if (ty_is_integer(aty) || ty_is_bool(aty) || ty_is_char(aty)) {
                if (ty_is_char(aty)) {
                    // `char` is a scalar; render it as a Unicode character
                    // (the hook takes the scalar value alone).
                    ll_str_append(b, "i64 ");
                    ll_str_append(b, ll_int_convert(val, aty, TY_I64));
                    ll_call_void("lc_put_char", b);
                } else {
                    val = ll_int_convert(val, aty, TY_I64);
                    ll_str_append(b, "i64 ");
                    ll_str_append(b, val);
                    ll_str_append(b, ", i64 ");
                    if (has_w) { ll_str_append(b, ll_i64_const(g_fmt_width[k])); } else { ll_str_append(b, "0"); }
                    ll_str_append(b, ", i64 ");
                    if (zero) { ll_str_append(b, "1"); } else { ll_str_append(b, "0"); }
                    if (g_fmt_kind[k] == FMT_HEX) {
                        ll_call_void("lc_put_hex", b);
                    } else if (ty_is_bool(aty)) {
                        ll_call_void("lc_put_bool", b);
                    } else if (ty_is_unsigned(aty)) {
                        ll_call_void("lc_put_u64", b);
                    } else {
                        ll_call_void("lc_put_i64", b);
                    }
                }
            } else if (ty_is_float(aty)) {
                if (aty != TY_F64) { val = ll_fp_convert(val, aty, TY_F64, 1); }
                ll_str_append(b, "double ");
                ll_str_append(b, val);
                ll_str_append(b, ", i64 ");
                if (has_w) { ll_str_append(b, ll_i64_const(g_fmt_width[k])); } else { ll_str_append(b, "0"); }
                ll_str_append(b, ", i64 ");
                if (has_p) { ll_str_append(b, ll_i64_const(g_fmt_prec[k])); } else { ll_str_append(b, "0"); }
                ll_str_append(b, ", i64 ");
                if (has_p) { ll_str_append(b, "1"); } else { ll_str_append(b, "0"); }
                ll_call_void("lc_put_f64", b);
            } else {
                // `&str` / `&[u8]`: the pair's data and length are the two
                // halves; write them with lc_put_str.
                char* data;
                char* len;
                char* b2;
                data = ll_slice_data(val);
                len = ll_slice_len(val);
                b2 = arena_alloc(128);
                b2[0] = 0;
                ll_str_append(b2, "ptr ");
                ll_str_append(b2, data);
                ll_str_append(b2, ", i64 ");
                ll_str_append(b2, len);
                ll_call_void("lc_put_str", b2);
            }
            argi = argi + 1;
        }
        k = k + 1;
    }

    if (println) {
        char* b;
        b = arena_alloc(16);
        b[0] = 0;
        ll_str_append(b, "i64 10");
        ll_call_void("lc_put_char", b);
    }
    // Always flush at the end of a print: the file's output should appear
    // even if the program later runs long or traps.
    ll_call_void("lc_flush", "");
    g_expr_ty = TY_UNIT;
    return "0";
}

int ty_array_len(int id) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    return g_types[id].b;
}

// ---------------------------------------------------------------------------
// Field / index reads and struct literals.
// ---------------------------------------------------------------------------
char* ll_expr_field(struct AstNode* n) {
    char* addr;
    int ft;
    addr = ll_addr(n);
    ft = ll_node_ty(n);
    g_expr_ty = ft;
    if (ft == TY_UNIT || ll_is_aggregate(ft)) {
        return addr;   // aggregates are addressed, not loaded
    }
    return ll_load(ft, addr);
}

char* ll_expr_index(struct AstNode* n) {
    char* addr;
    int et;
    addr = ll_addr(n);
    et = ll_node_ty(n);
    g_expr_ty = et;
    if (et == TY_UNIT || ll_is_aggregate(et)) {
        return addr;
    }
    return ll_load(et, addr);
}

// `[a, b, c]` or `[v; n]`: an alloca, per-element stores, then the aggregate.
char* ll_expr_array_lit(struct AstNode* n) {
    int ty;
    int et;
    char* slot;
    ty = ll_node_ty(n);
    et = ty_elem(ty);
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(ty));
    ll_out_nl();
    if (n->kids != 0 && n->kids->len > 0) {
        int i;
        i = 0;
        while (i < n->kids->len) {
            char* v;
            char* addr;
            v = ll_expr(n->kids->items[i]);
            addr = ll_array_gep(slot, et, ll_const_int(i, TY_USIZE));
            ll_store_value(addr, et, v);
            i = i + 1;
        }
    } else if (n->a != 0) {
        // `[v; n]` (§7.1): fill every element with `v`.
        //
        // A small count is unrolled (one store per element). A large count is
        // emitted as a runtime loop instead: unrolling a source-sized buffer
        // (`heap([0u8; 65536])`) would emit ~65k stores, blow the IR up to
        // megabytes, and exhaust the compiler arena (ICE-01) around N ≈ 58k.
        // The loop keeps the emitted IR a constant size and lets clang fold it
        // to `memset` at -O2. `v` is evaluated once and reused (it must be a
        // copy type to be repeated).
        int count;
        char* v;
        count = ty_array_len(ty);
        v = ll_expr(n->a);
        if (count <= 64) {
            int i;
            i = 0;
            while (i < count) {
                char* addr;
                addr = ll_array_gep(slot, et, ll_const_int(i, TY_USIZE));
                ll_store_value(addr, et, v);
                i = i + 1;
            }
        } else {
            // c = 0; while (c < count) { slot[c] = v; c += 1; }
            char* cslot;
            char* condlbl;
            char* bodylbl;
            char* endlbl;
            cslot = ll_new_reg();
            ll_out_str("  ");
            ll_out_str(cslot);
            ll_out_str(" = alloca i64\n  store i64 0, ptr ");
            ll_out_str(cslot);
            ll_out_nl();
            condlbl = ll_new_label("fill.cond");
            bodylbl = ll_new_label("fill.body");
            endlbl = ll_new_label("fill.end");
            ll_out_str("  br label %");
            ll_out_str(condlbl);
            ll_out_nl();
            ll_label(condlbl);
            {
                char* c;
                char* cmp;
                c = ll_load(TY_ISIZE, cslot);
                cmp = ll_int_cmp("<", TY_ISIZE, c,
                                 ll_const_int(count, TY_ISIZE));
                ll_out_str("  br i1 ");
                ll_out_str(cmp);
                ll_out_str(", label %");
                ll_out_str(bodylbl);
                ll_out_str(", label %");
                ll_out_str(endlbl);
                ll_out_nl();
            }
            ll_label(bodylbl);
            {
                char* c;
                char* addr;
                char* c2;
                c = ll_load(TY_ISIZE, cslot);
                addr = ll_array_gep_i64(slot, et, c);
                ll_store_value(addr, et, v);
                c2 = ll_bin("add", TY_ISIZE, c, "1");
                ll_out_str("  store i64 ");
                ll_out_str(c2);
                ll_out_str(", ptr ");
                ll_out_str(cslot);
                ll_out_nl();
                ll_out_str("  br label %");
                ll_out_str(condlbl);
                ll_out_nl();
            }
            ll_label(endlbl);
        }
    }
    g_expr_ty = ty;
    return slot;   // aggregates are represented by their address
}

// `Name { .f = v, ... }` — an alloca, per-field stores, then the aggregate.
char* ll_expr_struct_init(struct AstNode* n) {
    int ty;
    char* slot;
    struct AstList* inits;
    int i;
    ty = ll_node_ty(n);
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(ty));
    ll_out_nl();
    inits = n->kids;
    if (inits != 0) {
        i = 0;
        while (i < inits->len) {
            struct AstNode* fi;
            int ft;
            char* addr;
            char* v;
            fi = inits->items[i];
            ft = ty_member_type(ty, ty_find_member(ty, fi->sval));
            v = ll_expr(fi->a);            // evaluate in written order (§7.5)
            addr = ll_struct_gep(slot, ty, ty_find_member(ty, fi->sval));
            ll_store_value(addr, ft, v);
            i = i + 1;
        }
    }
    g_expr_ty = ty;
    return slot;   // aggregates are represented by their address
}

// ---------------------------------------------------------------------------
// References and heap.
// ---------------------------------------------------------------------------
char* ll_expr_borrow(struct AstNode* n) {
    // `&base[lo..hi]` builds a fat pair (§5.2): the borrow of a range is a
    // slice, not the address of one element.
    if (n->a != 0 && n->a->kind == AST_INDEX && n->a->b != 0
        && n->a->b->kind == AST_BINARY
        && (str_eq(n->a->b->sval, "..") || str_eq(n->a->b->sval, "..="))) {
        return ll_slice_pair(n->a);
    }
    // Borrowing a slice value (`&s`) yields the same pair (already a ref).
    if (ty_kind(ll_node_ty(n)) == CTY_SLICE || ty_kind(ll_node_ty(n)) == CTY_STRREF) {
        g_expr_ty = ll_node_ty(n);
        return ll_expr(n->a);
    }
    // `&x` / `&mut x` is the address of the place. When the operand is not a
    // place (a constructor or other rvalue, e.g. `&Val::A`), lower the value to
    // a temporary and borrow that: an aggregate is already address-represented
    // (its SSA value *is* its address), and a scalar gets a fresh alloca.
    if (!ll_is_place(n->a)) {
        int t;
        char* v;
        t = ll_node_ty(n->a);
        if (ll_is_aggregate(t)) {
            g_expr_ty = ll_node_ty(n);
            return ll_expr(n->a);
        }
        v = ll_expr(n->a);
        {
            char* slot;
            slot = ll_local_temp(t, v);
            g_expr_ty = ll_node_ty(n);
            return slot;
        }
    }
    g_expr_ty = ll_node_ty(n);
    return ll_addr(n->a);
}

// `raw(&x)` / `raw(&mut x)` (§13.5): the address of the borrowed place as an
// opaque pointer. A raw pointer is one machine word, so this is exactly the
// borrow's address with a pointer type attached. `raw(p)` on an existing raw
// pointer is the identity (`n->a` is the borrow, or another raw pointer).
char* ll_expr_raw(struct AstNode* n) {
    char* v;
    g_expr_ty = ll_node_ty(n);
    v = ll_expr(n->a);
    g_expr_ty = ll_node_ty(n);
    return v;
}

// True when `n` denotes a place (an lvalue with a stable address): a local
// binding, a dereference, a field access, or an index. A bare variant path
// (`Val::A`, or an unqualified `Empty`), a constructor call, a function call,
// a literal, or a binary expression is an rvalue and must be materialized
// before it can be borrowed.
int ll_is_place(struct AstNode* n) {
    if (n == 0) { return 0; }
    if (n->kind == AST_PATH) {
        // Only a path that names a local binding has an address; a qualified
        // path is an enum variant / associated item with no storage.
        if (str_contains(n->sval, "::")) { return 0; }
        if (ll_local_slot(n->sval) == 0) { return 0; }
        return 1;
    }
    if (n->kind == AST_DEREF || n->kind == AST_FIELD_ACC
        || n->kind == AST_INDEX) {
        return 1;
    }
    return 0;
}

// Stores an rvalue `v` of type `t` into a fresh stack slot and returns the
// slot's address. Used to materialize a temporary so an rvalue can be borrowed.
char* ll_local_temp(int t, char* v) {
    char* slot;
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(t));
    ll_out_nl();
    ll_store_value(slot, t, v);
    return slot;
}

char* ll_expr_deref(struct AstNode* n) {
    char* ptr;
    int t;
    ptr = ll_expr(n->a);
    t = ll_node_ty(n);
    g_expr_ty = t;
    if (t == TY_UNIT || ll_is_aggregate(t)) {
        return ptr;   // aggregate: the pointer is the address
    }
    return ll_load(t, ptr);
}

char* ll_expr_heap(struct AstNode* n) {
    int et;
    char* raw;
    char* v;
    et = ty_elem(ll_node_ty(n));   // pointee type
    if (et == 0) { et = ll_node_ty(n->a); }
    raw = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(raw);
    ll_out_str(" = call ptr @lc_alloc(i64 ");
    ll_out_int(ty_size(et));
    ll_out_str(")\n");
    v = ll_expr(n->a);
    if (ll_is_aggregate(et)) {
        // An aggregate value is address-represented: copy its bytes into the
        // allocation (the size covers the whole aggregate).
        ll_out_str("  call void @llvm.memcpy.p0.p0.i64(ptr align 8 ");
        ll_out_str(raw);
        ll_out_str(", ptr align 8 ");
        ll_out_str(v);
        ll_out_str(", i64 ");
        ll_out_int(ty_size(et));
        ll_out_str(", i1 false)\n");
    } else {
        ll_out_str("  store ");
        ll_out_str(ll_type_name(et));
        ll_out_str(" ");
        ll_out_str(v);
        ll_out_str(", ptr ");
        ll_out_str(raw);
        ll_out_nl();
    }
    g_expr_ty = ll_node_ty(n);
    return raw;
}

// Emits a call to the already-mangled `symbol` with the evaluated arguments.
// Shared by ordinary calls (which mangle the callee name) and monomorphized
// generic calls (whose instance `sval` is already the symbol).
char* ll_emit_call_args(struct AstNode* n, char* symbol, int retty, struct AstList* args) {
    int i;
    char* ret;
    char* buf;
    buf = arena_alloc(256);
    buf[0] = 0;
    if (args != 0) {
        i = 0;
        while (i < args->len) {
            char* a;
            int aty;
            a = ll_expr(args->items[i]);
            aty = g_expr_ty;
            if (i > 0) { ll_str_append(buf, ", "); }
            if (ll_is_aggregate(aty)) {
                ll_str_append(buf, "ptr ");
            } else {
                ll_str_append(buf, ll_type_name(aty));
                ll_str_append(buf, " ");
            }
            ll_str_append(buf, a);
            i = i + 1;
        }
    }
    if (retty == TY_UNIT || retty == TY_NEVER) {
        ll_out_str("  call void @");
        ll_out_str(symbol);
        ll_out_str("(");
        ll_out_str(buf);
        ll_out_str(")\n");
        if (retty == TY_NEVER) {
            ll_out_str("  unreachable\n");
            ll_set_terminated(1);
        }
        g_expr_ty = retty;
        return "0";
    }
    if (ll_is_aggregate(retty)) {
        char* sslot;
        sslot = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(sslot);
        ll_out_str(" = alloca ");
        ll_out_str(ll_type_name(retty));
        ll_out_nl();
        ll_out_str("  call void @");
        ll_out_str(symbol);
        ll_out_str("(ptr sret(");
        ll_out_str(ll_type_name(retty));
        ll_out_str(") ");
        ll_out_str(sslot);
        if (buf[0] != 0) {
            ll_out_str(", ");
            ll_out_str(buf);
        }
        ll_out_str(")\n");
        g_expr_ty = retty;
        return sslot;
    }
    ret = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(ret);
    ll_out_str(" = call ");
    ll_out_str(ll_type_name(retty));
    ll_out_str(" @");
    ll_out_str(symbol);
    ll_out_str("(");
    ll_out_str(buf);
    ll_out_str(")\n");
    g_expr_ty = retty;
    return ret;
}

char* ll_expr_call(struct AstNode* n) {
    struct AstNode* callee;
    struct AstList* args;
    int retty;
    int i;
    char* ret;
    char* buf;

    retty = ll_node_ty(n);
    callee = n->a;
    args = n->kids;

    if (callee == 0) {
        // Generic call `name<T>(args)`: the checker instantiated it and stored
        // the concrete instance in `n->b`, whose `sval` is the instance name.
        if (n->b != 0) {
            return ll_emit_call_args(n, ll_call_symbol(n->b->sval), n->b->ty, args);
        }
        g_expr_ty = retty;
        return ll_zero_of(retty);
    }
    if (callee->kind == AST_FIELD_ACC) {
        // Method call `recv.name(args)`: find the method on the receiver's
        // type and pass the receiver as the implicit first argument.
        return ll_method_call(n, callee, args, retty);
    }
    // `Enum::Variant(payload)` (§6.5): the checker marked the node with
    // `n->ival >= 1000` (variant index) and `n->ty` is the enum; re-resolve the
    // enum type from the callee path and build the tagged aggregate.
    if (n->ival >= 1000 && callee->kind == AST_PATH
        && ty_kind(retty) == CTY_ENUM) {
        return ll_enum_construct(n, retty, n->ival - 1000, args);
    }
    // `print`/`println`/`eprintln` (§15.1): the checker marked the builtin in
    // `n->ival`; lower to the runtime's `lc_*` formatting hooks.
    if (n->ival == 1 || n->ival == 2 || n->ival == 3) {
        return ll_format_call(n, args);
    }
    // `trap`/`assert`/`unreachable`/`exit` (§15.1): prelude builtins that lower
    // to runtime hooks. The first three stop control (the checker typed them
    // `never`/unit); `exit` stops too.
    if (n->ival == 4) { return ll_builtin_trap(n, args); }
    if (n->ival == 5) { return ll_builtin_assert(n, args); }
    if (n->ival == 6) { return ll_builtin_unreachable(n, args); }
    if (n->ival == 7) { return ll_builtin_exit(n, args); }
    if (n->ival == 8) { return ll_builtin_args(n); }

    // Emit the arguments left to right (§7.5) into a register list.
    // An aggregate argument is passed as a pointer to its value.
    buf = arena_alloc(256);
    buf[0] = 0;
    if (args != 0) {
        i = 0;
        while (i < args->len) {
            char* a;
            int aty;
            a = ll_expr(args->items[i]);
            aty = g_expr_ty;
            if (i > 0) { ll_str_append(buf, ", "); }
            if (ll_is_aggregate(aty)) {
                ll_str_append(buf, "ptr ");
            } else {
                ll_str_append(buf, ll_type_name(aty));
                ll_str_append(buf, " ");
            }
            ll_str_append(buf, a);
            i = i + 1;
        }
    }

    // An aggregate-returning function uses the sret convention: allocate the
    // result slot and pass its address as the hidden first argument.
    {
        int agg;
        char* sslot;
        agg = ll_is_aggregate(retty);
        sslot = 0;
        if (agg && retty != TY_UNIT && retty != TY_NEVER) {
            sslot = ll_new_reg();
            ll_out_str("  ");
            ll_out_str(sslot);
            ll_out_str(" = alloca ");
            ll_out_str(ll_type_name(retty));
            ll_out_nl();
        }
        if (retty == TY_UNIT || retty == TY_NEVER) {
            ll_out_str("  call void @");
            ll_out_str(ll_call_symbol(callee->sval));
            ll_out_str("(");
            ll_out_str(buf);
            ll_out_str(")\n");
            if (retty == TY_NEVER) {
                ll_out_str("  unreachable\n");
                ll_set_terminated(1);
            }
            g_expr_ty = retty;
            return "0";
        }
        if (agg) {
            ll_out_str("  call void @");
            ll_out_str(ll_call_symbol(callee->sval));
            ll_out_str("(ptr sret(");
            ll_out_str(ll_type_name(retty));
            ll_out_str(") ");
            ll_out_str(sslot);
            if (buf[0] != 0) {
                ll_out_str(", ");
                ll_out_str(buf);
            }
            ll_out_str(")\n");
            g_expr_ty = retty;
            return sslot;   // the address of the result
        }
        ret = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(ret);
        ll_out_str(" = call ");
        ll_out_str(ll_type_name(retty));
        ll_out_str(" @");
        ll_out_str(ll_call_symbol(callee->sval));
        ll_out_str("(");
        ll_out_str(buf);
        ll_out_str(")\n");
        g_expr_ty = retty;
        return ret;
    }
}

// Method call `recv.name(args)`. Resolution mirrors the checker: find the
// method registered for the receiver's (auto-derefed) type. The receiver is
// the implicit first argument — by pointer for `&self`/`&mut self`/self
// aggregates, by value for scalars.
char* ll_method_call(struct AstNode* n, struct AstNode* callee, struct AstList* args, int retty) {
    int rt;
    int m;
    int fidx;
    char* selfv;
    char* buf;
    char* ret;
    int agg;

    // Builtin `.len()` (checker marks the call node, §15.1).
    if (n->ival == 1) {
        return ll_len_value(n);
    }
    // Builtin `.as_bytes()` on `&str` (§15.2): the same (pointer, length) pair,
    // viewed as `&[u8]`. The pair is already the representation, so this is a
    // type-only change.
    if (n->ival == 2) {
        char* pair;
        pair = ll_expr(callee->a);
        g_expr_ty = retty;
        return pair;
    }

    rt = callee->a->ty;
    // Evaluate the receiver once; auto-deref through references/boxes to the
    // underlying value's address.
    selfv = ll_addr(callee->a);
    m = ll_find_method(rt, callee->sval);
    if (m < 0) {
        g_expr_ty = retty;
        return ll_zero_of(retty);
    }
    fidx = ck_meth_fn(m);

    buf = arena_alloc(256);
    buf[0] = 0;
    ll_str_append(buf, "ptr ");
    ll_str_append(buf, selfv);
    {
        int i;
        if (args != 0) {
            i = 0;
            while (i < args->len) {
                char* a;
                int aty;
                if (i > 0) { ll_str_append(buf, ", "); }
                a = ll_expr(args->items[i]);
                aty = g_expr_ty;
                if (ll_is_aggregate(aty)) {
                    ll_str_append(buf, "ptr ");
                } else {
                    ll_str_append(buf, ll_type_name(aty));
                    ll_str_append(buf, " ");
                }
                ll_str_append(buf, a);
                i = i + 1;
            }
        }
    }

    agg = ll_is_aggregate(retty);
    ret = ll_emit_call(ll_method_symbol(rt, callee->sval), buf, retty, agg);
    g_expr_ty = retty;
    return ret;
}

// Emits the `call` instruction; returns the value (or the sret slot for an
// aggregate return).
char* ll_emit_call(char* symbol, char* arglist, int retty, int agg) {
    char* sslot;
    char* ret;
    sslot = 0;
    if (agg) {
        sslot = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(sslot);
        ll_out_str(" = alloca ");
        ll_out_str(ll_type_name(retty));
        ll_out_nl();
    }
    if (retty == TY_UNIT || retty == TY_NEVER) {
        if (agg) {
            ll_out_str("  call void @");
            ll_out_str(symbol);
            ll_out_str("(ptr sret(");
            ll_out_str(ll_type_name(retty));
            ll_out_str(") ");
            ll_out_str(sslot);
            if (arglist != 0 && arglist[0] != 0) {
                ll_out_str(", ");
                ll_out_str(arglist);
            }
            ll_out_str(")\n");
        } else {
            ll_out_str("  call void @");
            ll_out_str(symbol);
            ll_out_str("(");
            ll_out_str(arglist);
            ll_out_str(")\n");
        }
        if (retty == TY_NEVER) {
            ll_out_str("  unreachable\n");
            ll_set_terminated(1);
        }
        return "0";
    }
    if (agg) {
        ll_out_str("  call void @");
        ll_out_str(symbol);
        ll_out_str("(ptr sret(");
        ll_out_str(ll_type_name(retty));
        ll_out_str(") ");
        ll_out_str(sslot);
        if (arglist != 0 && arglist[0] != 0) {
            ll_out_str(", ");
            ll_out_str(arglist);
        }
        ll_out_str(")\n");
        return sslot;
    }
    ret = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(ret);
    ll_out_str(" = call ");
    ll_out_str(ll_type_name(retty));
    ll_out_str(" @");
    ll_out_str(symbol);
    ll_out_str("(");
    ll_out_str(arglist);
    ll_out_str(")\n");
    return ret;
}

// Finds a method by receiver type + name; -1 when absent.
int ll_find_method(int rt, char* name) {
    int i;
    // Search directly on the type; fall back one auto-deref level through a
    // reference/heap receiver.
    i = 0;
    while (i < ck_nmeth()) {
        if (ck_meth_ty(i) == rt && str_eq(ck_meth_name(i), name)) { return i; }
        i = i + 1;
    }
    if (ty_is_ref(rt) || ty_is_heap(rt)) {
        return ll_find_method(ty_elem(rt), name);
    }
    return -1;
}

// `Type__method` — the §19.4 mangling for methods (no colons in IR names).
// A merged module type (`geometry::Vec2`) collapses `::` to `__`.
char* ll_method_symbol(int rt, char* name) {
    char* tname;
    char* s;
    int i;
    int j;
    tname = ty_display(rt);
    s = arena_alloc(str_len(tname) + str_len(name) + 16);
    i = 0;
    j = 0;
    while (tname[i] != 0) {
        if (tname[i] == ':' && tname[i + 1] == ':') {
            s[j] = '_';
            s[j + 1] = '_';
            j = j + 2;
            i = i + 2;
            continue;
        }
        s[j] = tname[i];
        j = j + 1;
        i = i + 1;
    }
    s[j] = 0;
    lexbuf_reset();
    lexbuf_push_str("harmony__");
    lexbuf_push_str(s);
    lexbuf_push_str("__");
    lexbuf_push_str(name);
    return lexbuf_finish();
}

void ll_str_copy(char* dst, char* src) {
    ll_str_into(dst, src);
}

// Appends `s` to the NUL-terminated buffer `buf`.
void ll_str_append(char* buf, char* s) {
    int n;
    n = ll_str_len(buf);
    ll_str_into(buf + n, s);
}

// `name` -> the emitted symbol for a called function. An `extern fn` keeps
// its plain C name (§6.5 FFI: the symbol is the C one, no module prefix).
// `main` becomes `harmony_main` (the runtime owns `_start`); everything else
// mangles `::` to `__` (colons are not valid in IR names).
char* ll_call_symbol(char* name) {
    int i;
    if (ck_sym_is_extern(name)) { return name; }
    if (str_eq(name, "main")) { return "harmony_main"; }
    lexbuf_reset();
    lexbuf_push_str("harmony__");
    i = 0;
    while (name[i] != 0) {
        if (name[i] == ':' && name[i + 1] == ':') {
            lexbuf_push('_');
            lexbuf_push('_');
            i = i + 2;
            continue;
        }
        lexbuf_push(name[i]);
        i = i + 1;
    }
    return lexbuf_finish();
}

char* ll_expr_cast(struct AstNode* n) {
    char* v;
    int from;
    int to;
    v = ll_expr(n->a);
    from = g_expr_ty;
    to = ll_node_ty(n);
    g_expr_ty = to;
    if (ty_is_untyped_lit(from)) { from = to; }
    if (from == to) { return v; }
    // `char` lowers as i32; its two documented casts (§5.10) are integer
    // conversions: `char as u32` zero-extends the scalar (always in range),
    // `u8 as char` widens the byte to i32.
    if (ty_is_integer_or_char(from) && ty_is_integer_or_char(to)) {
        return ll_int_convert(v, from, to);
    }
    if (ty_is_integer(from) && ll_is_float_ty(to)) { return ll_fp_convert(v, from, to, 0); }
    if (ll_is_float_ty(from) && ll_is_float_ty(to)) { return ll_fp_convert(v, from, to, 1); }
    return v;
}

// Integer <-> float conversions (sitofp / uitofp / fptosi / fptoui).
// Widening/narrowing between integer widths (sign/zero-extend or truncate).
// Emits `%r = <op> <from> <v> to <to>` (sext/zext/trunc/fp conversions).
char* ll_convert_instr(char* op, char* v, int from, int to) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = ");
    ll_out_str(op);
    ll_out_str(" ");
    ll_out_str(ll_type_name(from));
    ll_out_str(" ");
    ll_out_str(v);
    ll_out_str(" to ");
    ll_out_str(ll_type_name(to));
    ll_out_nl();
    return r;
}

char* ll_int_convert(char* v, int from, int to) {
    int fw;
    int tw;
    fw = ty_bit_width(from);
    tw = ty_bit_width(to);
    if (fw == tw) { return v; }
    if (ty_is_bool(from) && tw > 1) { return ll_convert_instr("zext", v, TY_BOOL, to); }
    if (tw < fw) { return ll_convert_instr("trunc", v, from, to); }
    if (ty_is_signed(from)) { return ll_convert_instr("sext", v, from, to); }
    return ll_convert_instr("zext", v, from, to);
}

char* ll_fp_convert(char* v, int from, int to, int is_float_seq) {
    char* r;
    char* op;
    if (is_float_seq) {
        op = "fpext";
        to = TY_F64;
    } else if (ll_is_float_ty(to)) {
        if (ty_is_unsigned(from)) { op = "uitofp"; } else { op = "sitofp"; }
    } else {
        if (ty_is_unsigned(to)) { op = "fptoui"; } else { op = "fptosi"; }
    }
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = ");
    ll_out_str(op);
    ll_out_str(" ");
    ll_out_str(ll_type_name(from));
    ll_out_str(" ");
    ll_out_str(v);
    ll_out_str(" to ");
    ll_out_str(ll_type_name(to));
    ll_out_nl();
    return r;
}

char* ll_int_type_suffix(int ty) {
    if (ty_bit_width(ty) == 8) { return "i8"; }
    if (ty_bit_width(ty) == 16) { return "i16"; }
    if (ty_bit_width(ty) == 64) { return "i64"; }
    return "i32";
}
