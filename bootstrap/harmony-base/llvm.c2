// harmony-base — LLVM IR text emitter, part 1: module, types, functions
// (docs/harmony.md §19.4, the primary backend).
//
// The emitter produces deterministic `.ll` text: readable symbol names
// (`harmony__name`, `%struct.X`), a fixed type/definition order, no
// addresses or timestamps. Two runs on one input diff clean.
//
// Layout:
//   llvm.c2  — output buffer, type names, the module/function driver, locals
//   lexpr.c2 — expression lowering (returns an SSA value name)
//   lstmt.c2 — statement/block lowering
//
// Register model: an expression lowers to an SSA value name (e.g. "%3"),
// returned as an arena string; instructions are appended as they are
// produced, so evaluation order is exactly the source order (§7.5). Locals
// live in `alloca` slots so they are addressable (needed for &x, fields, and
// loops); loads/stores go through them.

// ---------------------------------------------------------------------------
// Forward declarations (c2x-seed resolves names from earlier text only).
// ---------------------------------------------------------------------------
void ll_emit_type_def(int id);
void ll_emit_fn(struct AstNode* fn);
void ll_emit_param_types(struct AstList* params);
char* ll_fn_symbol(struct AstNode* fn);
char* ll_sized_field_type(int id);
int   ll_is_aggregate(int ty);
char* ll_method_symbol(int rt, char* name);
int   ll_str_intern(char* body, int len);
char* ll_str_symbol(int i);
void  ll_emit_str_def(int i);
void  ll_collect_strings(struct AstNode* n);
void  ll_out_hex_byte(int b);

// ---------------------------------------------------------------------------
// Output buffer: the module text is assembled whole, then flushed (arena
// backed, doubling, per the project's "prefer auto-resizable" rule).
// ---------------------------------------------------------------------------
char* g_out;
int g_out_len;
int g_out_cap;

void ll_out_reset(void) {
    g_out_cap = 65536;
    g_out = arena_alloc(g_out_cap);
    g_out_len = 0;
    g_out[0] = 0;
}

void ll_out_grow(void) {
    char* bigger;
    int i;
    int ncap;
    ncap = g_out_cap * 2;
    bigger = arena_alloc(ncap);
    i = 0;
    while (i < g_out_len) { bigger[i] = g_out[i]; i = i + 1; }
    g_out = bigger;
    g_out_cap = ncap;
}

void ll_out_char(char c) {
    if (g_out_len + 2 >= g_out_cap) { ll_out_grow(); }
    g_out[g_out_len] = c;
    g_out_len = g_out_len + 1;
    g_out[g_out_len] = 0;
}

void ll_out_str(char* s) {
    int i;
    i = 0;
    while (s[i] != 0) { ll_out_char(s[i]); i = i + 1; }
}

void ll_out_int(int v) {
    int neg;
    int div;
    int rem;
    char tmp[12];
    int n;
    neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    n = 0;
    if (v == 0) { ll_out_char('0'); return; }
    while (v > 0) {
        div = v / 10;
        rem = v - div * 10;
        tmp[n] = (char) ('0' + rem);
        n = n + 1;
        v = div;
    }
    if (neg) { ll_out_char('-'); }
    while (n > 0) { n = n - 1; ll_out_char(tmp[n]); }
}

void ll_out_nl(void) { ll_out_char('\n'); }

// Two lowercase hex digits (used to escape string-literal bytes).
void ll_out_hex_byte(int b) {
    char* hex;
    hex = "0123456789abcdef";
    ll_out_char(hex[(b >> 4) & 0xF]);
    ll_out_char(hex[b & 0xF]);
}

// ---------------------------------------------------------------------------
// SSA / label counters (reset per function).
// ---------------------------------------------------------------------------
int g_ssa;
int g_label;

char* ll_new_reg(void) {
    char* r;
    g_ssa = g_ssa + 1;
    r = arena_alloc(16);
    r[0] = '%';
    ll_int_into(r + 1, g_ssa);
    return r;
}

char* ll_new_label(char* hint) {
    char* l;
    g_label = g_label + 1;
    l = arena_alloc(64);
    ll_str_into(l, hint);
    {
        int n;
        n = ll_str_len(l);
        l[n] = '.';
        ll_int_into(l + n + 1, g_label);
    }
    return l;
}

// Writes `v` as decimal into `buf` (NUL-terminated); returns nothing.
void ll_int_into(char* buf, int v) {
    char tmp[12];
    int n;
    int i;
    n = 0;
    if (v == 0) { buf[0] = '0'; buf[1] = 0; return; }
    while (v > 0) { tmp[n] = (char) ('0' + (v - (v / 10) * 10)); n = n + 1; v = v / 10; }
    i = 0;
    while (n > 0) { n = n - 1; buf[i] = tmp[n]; i = i + 1; }
    buf[i] = 0;
}

void ll_str_into(char* dst, char* src) {
    int i;
    i = 0;
    while (src[i] != 0) { dst[i] = src[i]; i = i + 1; }
    dst[i] = 0;
}

int ll_str_len(char* s) {
    int n;
    n = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

// ---------------------------------------------------------------------------
// Type names in LLVM IR.
// ---------------------------------------------------------------------------

// Appends `s` to the scratch buffer with `::` collapsed to `__` (a merged
// module type `geometry::Vec2` renders as one LLVM-safe name).
void ll_out_sanitized(char* s) {
    int i;
    i = 0;
    while (s[i] != 0) {
        if (s[i] == ':' && s[i + 1] == ':') {
            lexbuf_push('_');
            lexbuf_push('_');
            i = i + 2;
            continue;
        }
        lexbuf_push(s[i]);
        i = i + 1;
    }
}

char* ll_type_name(int id) {
    int k;
    if (id == TY_BOOL) { return "i1"; }
    if (id == TY_CHAR || id == TY_I32 || id == TY_U32 || id == TY_UINT_LIT) { return "i32"; }
    if (id == TY_I8 || id == TY_U8) { return "i8"; }
    if (id == TY_I16 || id == TY_U16) { return "i16"; }
    if (id == TY_I64 || id == TY_U64 || id == TY_ISIZE || id == TY_USIZE) { return "i64"; }
    if (id == TY_F32) { return "float"; }
    if (id == TY_F64 || id == TY_FLOAT_LIT) { return "double"; }
    if (id == TY_UNIT || id == TY_NEVER) { return "void"; }
    k = ty_kind(id);
    if (k == CTY_SLICE || k == CTY_STRREF) {
        // Slices and `&str` share one (data pointer, length) pair layout
        // (§5.2, §5.3); the pointer is opaque, so the element type does not
        // appear in the IR.
        return "%slice";
    }
    if (k == CTY_REF || k == CTY_MUTREF || k == CTY_HEAP || k == CTY_PTR
        || k == CTY_MUTPTR) {
        return "ptr";
    }
    if (k == CTY_STRUCT) {
        lexbuf_reset();
        lexbuf_push_str("%struct.");
        ll_out_sanitized(ty_display(id));
        return lexbuf_finish();
    }
    if (k == CTY_ENUM) {
        lexbuf_reset();
        lexbuf_push_str("%enum.");
        ll_out_sanitized(ty_display(id));
        return lexbuf_finish();
    }
    if (k == CTY_ARRAY) {
        int esz;
        char* elemname;
        esz = ty_size(ty_elem(id));
        if (esz == 0) { esz = 1; }
        // Resolve the element name first: `ll_type_name` builds some names in
        // the shared scratch buffer, so assembling the array name around a
        // nested call would clobber the outer text.
        elemname = ll_type_name(ty_elem(id));
        lexbuf_reset();
        lexbuf_push_str("[");
        lexbuf_push_int(ty_size(id) / esz);
        lexbuf_push_str(" x ");
        lexbuf_push_str(elemname);
        lexbuf_push_str("]");
        return lexbuf_finish();
    }
    return "i32";
}

// Emits `s` into the IR output with `::` -> `__` collapsing, for emitted
// type names (`%struct.…`, `%enum.…`) of merged module types.
void ll_out_name(char* s) {
    int i;
    i = 0;
    while (s[i] != 0) {
        if (s[i] == ':' && s[i + 1] == ':') {
            ll_out_str("__");
            i = i + 2;
            continue;
        }
        ll_out_char(s[i]);
        i = i + 1;
    }
}

// A struct-field type as a *sized* LLVM type: bool/unit store as i8, char as
// i32, so every field occupies at least one byte.
char* ll_sized_field_type(int id) {
    if (id == TY_UNIT || id == TY_NEVER || id == TY_BOOL) { return "i8"; }
    return ll_type_name(id);
}

int ll_is_float_ty(int id) {
    return id == TY_F32 || id == TY_F64 || id == TY_FLOAT_LIT;
}

char* ll_zero_of(int id) {
    if (id == TY_BOOL) { return "false"; }
    if (ll_is_float_ty(id)) { return "0.0"; }
    if (ty_kind(id) == CTY_STRUCT || ty_kind(id) == CTY_ENUM || ty_is_array(id)
        || ty_kind(id) == CTY_SLICE || ty_kind(id) == CTY_STRREF) {
        return "zeroinitializer";
    }
    if (ty_kind(id) == CTY_REF || ty_kind(id) == CTY_MUTREF || ty_kind(id) == CTY_HEAP
        || ty_kind(id) == CTY_PTR || ty_kind(id) == CTY_MUTPTR) {
        return "null";
    }
    return "0";
}

// ---------------------------------------------------------------------------
// Local-variable environment: name -> alloca slot + type. Resizable, with
// scope marks so shadowed names and block scopes work.
// ---------------------------------------------------------------------------
const int LL_MAX_LOCALS = 4096;
char* g_loc_name[4096];
char* g_loc_slot[4096];
int   g_loc_ty[4096];
int   g_nlocals;
int   g_lscope[256];
int   g_nlscope;

void ll_env_reset(void) {
    g_nlocals = 0;
    g_nlscope = 0;
}

void ll_env_scope_push(void) {
    g_lscope[g_nlscope] = g_nlocals;
    g_nlscope = g_nlscope + 1;
}

void ll_env_scope_pop(void) {
    if (g_nlscope > 0) {
        g_nlscope = g_nlscope - 1;
        g_nlocals = g_lscope[g_nlscope];
    }
}

void ll_local_declare(char* name, char* slot, int ty) {
    g_loc_name[g_nlocals] = name;
    g_loc_slot[g_nlocals] = slot;
    g_loc_ty[g_nlocals] = ty;
    g_nlocals = g_nlocals + 1;
}

int ll_local_find(char* name) {
    int i;
    i = g_nlocals - 1;
    while (i >= 0) {
        if (str_eq(g_loc_name[i], name)) { return i; }
        i = i - 1;
    }
    return -1;
}

char* ll_local_slot(char* name) {
    int i;
    i = ll_local_find(name);
    if (i < 0) { return 0; }
    return g_loc_slot[i];
}

int ll_local_ty(char* name) {
    int i;
    i = ll_local_find(name);
    if (i < 0) { return TY_INVALID; }
    return g_loc_ty[i];
}

// ---------------------------------------------------------------------------
// Block/terminator tracking. A block "has a terminator" once it ends with
// ret/br/unreachable; emitting more instructions there is invalid IR, so the
// statement emitter guards on this. Shared by lexpr.c2 (which restores it
// after a guarded trap sequence) and lstmt.c2.
// ---------------------------------------------------------------------------
int g_terminated;

void ll_set_terminated(int v) { g_terminated = v; }
int  ll_get_terminated(void) { return g_terminated; }

// ---------------------------------------------------------------------------
// sret convention for aggregate returns. When the current function returns a
// struct/enum/array, LLVM gives it a hidden leading pointer argument; `return`
// copies the aggregate there and returns that pointer.
// ---------------------------------------------------------------------------
int g_sret_on;      // current function returns an aggregate
int g_sret_ty;      // ... of this type

void ll_set_sret(int on, int ty) {
    g_sret_on = on;
    g_sret_ty = ty;
}

int ll_sret_on(void) { return g_sret_on; }
int ll_sret_ty(void) { return g_sret_ty; }

// ---------------------------------------------------------------------------
// String-literal pool. Each distinct literal becomes one private global
// `@.str.N = private unnamed_addr constant [n x i8] c"...", align 1`. The
// pool dedups by bytes and is reset per module, so the emitted symbols are a
// pure function of the input (determinism, §19.4).
// ---------------------------------------------------------------------------
const int LL_MAX_STRS = 1024;
char* g_str_body[1024];      // the bytes (may contain NULs)
int   g_str_len[1024];       // byte length
int   g_nstrs;

void ll_strs_reset(void) { g_nstrs = 0; }

// Interns a literal; returns its index. The bytes are copied into a private
// buffer (the source may live in a scratch arena that gets reused), and
// deduped by (bytes, len).
int ll_str_intern(char* body, int len) {
    int i;
    i = 0;
    while (i < g_nstrs) {
        char* prev;
        prev = g_str_body[i];
        if (g_str_len[i] == len) {
            int k;
            int same;
            same = 1;
            k = 0;
            while (k < len) {
                if (prev[k] != body[k]) { same = 0; break; }
                k = k + 1;
            }
            if (same) { return i; }
        }
        i = i + 1;
    }
    if (g_nstrs >= LL_MAX_STRS) { return 0; }
    g_str_body[g_nstrs] = str_prefix(body, len);
    g_str_len[g_nstrs] = len;
    g_nstrs = g_nstrs + 1;
    return g_nstrs - 1;
}

// The symbol for interned literal `i`.
char* ll_str_symbol(int i) {
    char* r;
    r = arena_alloc(24);
    ll_str_into(r, "@.str.");
    ll_int_into(r + ll_str_len(r), i);
    return r;
}

// Emits one global definition. Bytes are escaped two hex digits per char so
// any content (NULs, UTF-8) round-trips through the text IR.
void ll_emit_str_def(int i) {
    char* sym;
    int k;
    sym = ll_str_symbol(i);
    ll_out_str(sym);
    ll_out_str(" = private unnamed_addr constant [");
    ll_out_int(g_str_len[i] + 1);   // include the trailing NUL
    ll_out_str(" x i8] c\"");
    k = 0;
    while (k < g_str_len[i]) {
        int b;
        b = g_str_body[i][k];
        // LLVM string literals use `\XX` hex escapes; the backslash is
        // required or the digits are read as literal characters.
        ll_out_char('\\');
        ll_out_hex_byte(b & 0xFF);
        k = k + 1;
    }
    ll_out_str("\\00\", align 1\n");
}

// True when `n` is a call to a print-family builtin (recognized by name here;
// the checker marks the node in `n->ival`).
int ll_is_format_call(struct AstNode* n) {
    if (n->kind != AST_CALL) { return 0; }
    if (n->a == 0 || n->a->kind != AST_PATH) { return 0; }
    if (str_eq(n->a->sval, "print")) { return 1; }
    if (str_eq(n->a->sval, "println")) { return 1; }
    if (str_eq(n->a->sval, "eprintln")) { return 1; }
    return 0;
}

// Walks the AST and interns every string literal, in source order, so the
// pool (and the `@.str.N` numbering) is deterministic and complete before any
// function is emitted. A format string's *decoded* literal runs are interned
// here too (the raw format text is not a value), so the emitter's later
// re-parse finds them already pooled.
void ll_collect_strings(struct AstNode* n) {
    if (n == 0) { return; }
    if (ll_is_format_call(n) && n->kids != 0 && n->kids->len > 0) {
        struct AstNode* fmt;
        fmt = n->kids->items[0];
        if (fmt->kind == AST_STRING_LIT && fmt_parse(fmt->sval, fmt->ival) >= 0) {
            int k;
            k = 0;
            while (k < g_fmt_n) {
                if (g_fmt_kind[k] == FMT_LIT && g_fmt_len[k] > 0) {
                    ll_str_intern(g_fmt_litbuf + g_fmt_start[k], g_fmt_len[k]);
                }
                k = k + 1;
            }
        }
        // Recurse into the value arguments (the format literal is handled).
        ll_collect_strings(fmt);
        {
            int i;
            i = 1;
            while (i < n->kids->len) {
                ll_collect_strings(n->kids->items[i]);
                i = i + 1;
            }
        }
        return;
    }
    if (n->kind == AST_STRING_LIT) {
        ll_str_intern(n->sval, n->ival);
    }
    ll_collect_strings(n->a);
    ll_collect_strings(n->b);
    // An `unchecked fn` keeps its contract string on the fn node in `c`
    // (§13.1); it is compile-time metadata (an `audit`/diagnostic input), not
    // a runtime value, so it is not interned into the string pool.
    if (!((n->kind == AST_FN || n->kind == AST_EXTERN_FN) && (n->ival & 1))) {
        ll_collect_strings(n->c);
    }
    if (n->kids != 0) {
        int i;
        i = 0;
        while (i < n->kids->len) {
            ll_collect_strings(n->kids->items[i]);
            i = i + 1;
        }
    }
    if (n->kids2 != 0) {
        int i;
        i = 0;
        while (i < n->kids2->len) {
            ll_collect_strings(n->kids2->items[i]);
            i = i + 1;
        }
    }
}

// ---------------------------------------------------------------------------
// Module driver.
// ---------------------------------------------------------------------------

// True when `name` is one of the runtime hooks the module prelude already
// declares (ll_emit_module's fixed list). An `extern fn` with such a name must
// not re-declare it: LLVM rejects a duplicate `declare` even with a matching
// signature, so the prelude's declaration is authoritative.
int ll_is_predeclared(char* name) {
    return str_eq(name, "lc_trap")
        || str_eq(name, "lc_check_index")
        || str_eq(name, "lc_check_slice")
        || str_eq(name, "lc_alloc")
        || str_eq(name, "lc_set_fd")
        || str_eq(name, "lc_flush")
        || str_eq(name, "lc_put_str")
        || str_eq(name, "lc_put_i64")
        || str_eq(name, "lc_put_u64")
        || str_eq(name, "lc_put_hex")
        || str_eq(name, "lc_put_bool")
        || str_eq(name, "lc_put_char")
        || str_eq(name, "lc_put_f64")
        || str_eq(name, "lc_trap_msg")
        || str_eq(name, "lc_assert")
        || str_eq(name, "lc_unreachable")
        || str_eq(name, "lc_exit")
        || str_eq(name, "lc_args");
}

void ll_emit_module(struct AstNode* prog) {
    int i;
    struct AstList* items;

    ll_out_reset();
    ll_env_reset();
    ll_strs_reset();

    // Intern every string literal before emitting anything, so `@.str.N`
    // numbering follows source order.
    ll_collect_strings(prog);

    ll_out_str("; harmony module — generated by harmony-base\n");
    ll_out_str("target triple = \"x86_64-pc-linux-gnu\"\n\n");

    // The one slice value layout: a (data pointer, length) pair (§5.2).
    ll_out_str("%slice = type { ptr, i64 }\n\n");

    // Runtime hooks the compiler emits calls to (§19.8.4: only names/shapes).
    ll_out_str("declare void @lc_trap(i64, i64, i64, i64)\n");
    ll_out_str("declare void @lc_check_index(i64, i64, i64, i64)\n");
    ll_out_str("declare void @lc_check_slice(i64, i64, i64, i64, i64)\n");
    ll_out_str("declare ptr @lc_alloc(i64)\n");
    // Formatting hooks (§15.1): the compiler lowers print/println/eprintln to
    // these; the bodies live in the library (§19.8.6).
    ll_out_str("declare void @lc_set_fd(i64)\n");
    ll_out_str("declare void @lc_flush()\n");
    ll_out_str("declare void @lc_put_str(ptr, i64)\n");
    ll_out_str("declare void @lc_put_i64(i64, i64, i64)\n");
    ll_out_str("declare void @lc_put_u64(i64, i64, i64)\n");
    ll_out_str("declare void @lc_put_hex(i64, i64, i64)\n");
    ll_out_str("declare void @lc_put_bool(i64, i64, i64)\n");
    ll_out_str("declare void @lc_put_char(i64)\n");
    ll_out_str("declare void @lc_put_f64(double, i64, i64, i64)\n");
    // Prelude trap hooks (§15.1): trap/assert/unreachable/exit.
    ll_out_str("declare void @lc_trap_msg(ptr, i64, i64, i64)\n");
    ll_out_str("declare void @lc_assert(i64, ptr, i64, i64, i64)\n");
    ll_out_str("declare void @lc_unreachable(i64, i64)\n");
    ll_out_str("declare void @lc_exit(i64)\n");
    // Process arguments (§15.6): `args()` copies the safe view from here.
    ll_out_str("declare ptr @lc_args()\n\n");

    // String-literal globals (§5.3), in pool order.
    {
        int s;
        s = 0;
        while (s < g_nstrs) { ll_emit_str_def(s); s = s + 1; }
        if (g_nstrs > 0) { ll_out_nl(); }
    }

    items = prog->kids;
    if (items == 0) { return; }

    // Nominal type definitions, in declaration order (deterministic). A
    // struct/enum decl node does not carry its own type id (the checker keys
    // types by name), so walk the program's decls and resolve each name.
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if (it->kind == AST_STRUCT || it->kind == AST_ENUM) {
            int id;
            id = ck_lookup_type(it->sval);
            if (id != TY_INVALID) { ll_emit_type_def(id); }
        }
        i = i + 1;
    }
    ll_out_nl();

    // Functions. Two passes so every definition precedes no other (order in
    // the file is kept): free functions first, then methods. A generic
    // template (`fn id<T>`) has no concrete signature and is skipped; its
    // monomorphized instances are emitted after the source functions.
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if ((it->kind == AST_FN || it->kind == AST_EXTERN_FN) && it->kids == 0) {
            ll_emit_fn(it);
        }
        i = i + 1;
    }
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if (it->kind == AST_METHODS && it->kids2 != 0) {
            int k;
            k = 0;
            while (k < it->kids2->len) {
                ll_emit_fn(it->kids2->items[k]);
                k = k + 1;
            }
        }
        i = i + 1;
    }
    // Monomorphized generic instances, in instantiation order (deterministic).
    i = 0;
    while (i < ck_ngen_inst()) {
        ll_emit_fn(ck_gen_inst(i));
        i = i + 1;
    }
}

void ll_emit_type_def(int id) {
    int k;
    int i;
    k = ty_kind(id);
    if (k == CTY_STRUCT) {
        ll_out_str("%struct.");
        ll_out_name(ty_display(id));
        ll_out_str(" = type { ");
        if (ty_member_count(id) == 0) { ll_out_str("i8"); }
        i = 0;
        while (i < ty_member_count(id)) {
            if (i > 0) { ll_out_str(", "); }
            ll_out_str(ll_sized_field_type(ty_member_type(id, i)));
            i = i + 1;
        }
        ll_out_str(" }\n");
    } else if (k == CTY_ENUM) {
        int maxpay;
        maxpay = 0;
        i = 0;
        while (i < ty_member_count(id)) {
            int ps;
            ps = ty_size(ty_member_type(id, i));
            if (ps > maxpay) { maxpay = ps; }
            i = i + 1;
        }
        if (maxpay == 0) { maxpay = 1; }
        // The tag region occupies 8 bytes (i32 tag + 4 padding) so the payload
        // starts at byte offset 8, matching `ty_size` (align_up(4,8) +
        // align_up(maxpay,8)). The payload is rounded up to an 8-byte stride.
        ll_out_str("%enum.");
        ll_out_name(ty_display(id));
        ll_out_str(" = type { i32, [4 x i8], [");
        ll_out_int((maxpay + 7) & (0 - 8));
        ll_out_str(" x i8] }\n");
    }
}

void ll_emit_fn(struct AstNode* fn) {
    struct AstList* params;
    int i;
    char* name;
    int retty;
    int sret;

    name = ll_fn_symbol(fn);
    params = fn->kids2;
    retty = fn->ty;
    if (retty == 0) { retty = TY_UNIT; }
    // A struct/enum/array return uses the sret convention (§19.4: structs are
    // named types; LLVM returns aggregates through a caller-provided slot).
    sret = ll_is_aggregate(retty);
    ll_set_sret(sret, retty);

    if (fn->b == 0) {
        // extern fn: a plain C-ABI declaration. A name the prelude already
        // declares (a runtime hook like `lc_put_str`) must NOT be re-declared:
        // LLVM rejects the duplicate (`invalid redefinition of function`) even
        // when the signatures match. The prelude's signature wins.
        if (ll_is_predeclared(name)) { return; }
        ll_out_str("declare ");
        if (sret) { ll_out_str("void "); } else { ll_out_str(ll_type_name(retty)); }
        ll_out_str(" @");
        ll_out_str(name);
        ll_out_str("(");
        if (sret) {
            ll_out_str("ptr sret(");
            ll_out_str(ll_type_name(retty));
            ll_out_str(") %sret");
            // A comma only when there are real parameters.
            if (params != 0 && params->len > 0) { ll_out_str(", "); }
        }
        ll_emit_param_types(params);
        ll_out_str(")\n\n");
        return;
    }

    ll_out_str("define ");
    if (sret) { ll_out_str("void "); } else { ll_out_str(ll_type_name(retty)); }
    ll_out_str(" @");
    ll_out_str(name);
    ll_out_str("(");
    if (sret) {
        ll_out_str("ptr sret(");
        ll_out_str(ll_type_name(retty));
        ll_out_str(") %sret");
        if (params != 0 && params->len > 0) { ll_out_str(", "); }
    }
    ll_emit_param_types(params);
    ll_out_str(") {\n");
    ll_out_str("entry:\n");
    g_ssa = 0;
    g_label = 0;
    g_nlocals = 0;
    g_nlscope = 0;
    g_terminated = 0;

    // Parameters: spill each SSA arg into an alloca slot. Three cases:
    //  - an aggregate-by-value arg arrives as a pointer to the value, so its
    //    slot IS that pointer;
    //  - a by-value `self` receiver likewise binds directly;
    //  - everything else (including references) gets an ordinary alloca and
    //    a store, so loads through the slot work.
    if (params != 0) {
        i = 0;
        while (i < params->len) {
            struct AstNode* p;
            char* bindname;
            p = params->items[i];
            bindname = p->sval;
            if (ck_is_self_param(p)) { bindname = "self"; }
            if (ll_is_aggregate(p->ty)
                || (ck_is_self_param(p) && !ty_is_ref(p->ty))) {
                // Pointer-passed aggregate by value (struct/enum/array/slice/
                // &str): bind directly — `%argN` IS the address of the value.
                lexbuf_reset();
                lexbuf_push_str("%arg");
                lexbuf_push_int(i);
                ll_local_declare(bindname, lexbuf_finish(), p->ty);
            } else {
                char* slot;
                int isref;
                isref = ty_is_ref(p->ty);
                slot = ll_new_reg();
                ll_out_str("  ");
                ll_out_str(slot);
                ll_out_str(" = alloca ");
                if (isref) { ll_out_str("ptr"); } else { ll_out_str(ll_type_name(p->ty)); }
                ll_out_nl();
                ll_out_str("  store ");
                if (isref) { ll_out_str("ptr"); } else { ll_out_str(ll_type_name(p->ty)); }
                ll_out_str(" %arg");
                ll_out_int(i);
                ll_out_str(", ptr ");
                ll_out_str(slot);
                ll_out_nl();
                ll_local_declare(bindname, slot, p->ty);
            }
            i = i + 1;
        }
    }

    ll_block(fn->b);

    if (!g_terminated) {
        if (fn->ty == TY_UNIT || fn->ty == TY_NEVER) {
            ll_out_str("  ret void\n");
        } else if (sret) {
            ll_out_str("  ret void\n");
        } else {
            ll_out_str("  ret ");
            ll_out_str(ll_type_name(fn->ty));
            ll_out_str(" ");
            ll_out_str(ll_zero_of(fn->ty));
            ll_out_nl();
        }
    }
    ll_out_str("}\n\n");
}

void ll_emit_param_types(struct AstList* params) {
    int i;
    int n;
    if (params == 0) { return; }
    n = 0;
    i = 0;
    while (i < params->len) {
        struct AstNode* p;
        p = params->items[i];
        // `self` parameters ARE emitted (they are the receiver); only the
        // hidden sret slot is implicit.
        if (n > 0) { ll_out_str(", "); }
        // Struct/enum/array parameters pass by pointer (an aggregate cannot
        // be an SSA function argument in LLVM); a receiver of `&self` shape
        // is a pointer already.
        if (ll_is_aggregate(p->ty) || ty_is_ref(p->ty) || ck_is_self_param(p)) {
            ll_out_str("ptr ");
            // §5.4: a `&mut T` or `&mut [T]` is exclusive, so it can carry
            // `noalias` (the borrow rules guarantee nothing else reaches the
            // same place).
            if (ty_kind(p->ty) == CTY_MUTREF || ty_slice_is_mut(p->ty)) {
                ll_out_str("noalias ");
            }
            ll_out_str("%arg");
        } else {
            ll_out_str(ll_type_name(p->ty));
            ll_out_str(" %arg");
        }
        ll_out_int(i);
        n = n + 1;
        i = i + 1;
    }
}

int ll_is_aggregate(int ty) {
    return ty_kind(ty) == CTY_STRUCT || ty_kind(ty) == CTY_ENUM
        || ty_is_array(ty) || ty_kind(ty) == CTY_SLICE
        || ty_kind(ty) == CTY_STRREF;
}

char* ll_fn_symbol(struct AstNode* fn) {
    int i;
    int fidx;
    // An `extern fn` is a C symbol: no mangling at all (§6.5, §19.4).
    if (fn->kind == AST_EXTERN_FN) { return fn->sval; }
    // A method (registered with a receiver type) mangles to `Type__method`
    // so call sites and definitions agree.
    fidx = 0;
    while (fidx < ck_nfn()) {
        if (ck_fn(fidx) == fn) {
            if (ck_fn_self_ty(fidx) != 0) {
                return ll_method_symbol(ck_fn_self_ty(fidx), fn->sval);
            }
            break;
        }
        fidx = fidx + 1;
    }
    lexbuf_reset();
    if (str_eq(fn->sval, "main")) {
        lexbuf_push_str("harmony_main");
        return lexbuf_finish();
    }
    lexbuf_push_str("harmony__");
    i = 0;
    while (fn->sval[i] != 0) {
        if (fn->sval[i] == ':' && fn->sval[i + 1] == ':') {
            lexbuf_push('_');
            lexbuf_push('_');
            i = i + 2;
            continue;
        }
        lexbuf_push(fn->sval[i]);
        i = i + 1;
    }
    return lexbuf_finish();
}

// ---------------------------------------------------------------------------
// Trap helper: emits a call to @lc_trap(code, line, col, detail) and marks
// the block terminated (lc_trap is noreturn, §14.1).
//
// Callers emit a `br` to the trap block and continue in a fresh block; the
// terminator flag belongs to *that* trap block, so this helper saves and
// restores the ambient flag. The following block (which the caller labels
// next) must still be emittable into.
// ---------------------------------------------------------------------------
void ll_emit_trap(int code, struct AstNode* at, char* detail) {
    int saved;
    saved = g_terminated;
    ll_out_str("  call void @lc_trap(i64 ");
    ll_out_int(code);
    ll_out_str(", i64 ");
    ll_out_int(at->file);
    ll_out_str(", i64 ");
    ll_out_int(at->start);
    ll_out_str(", i64 ");
    if (detail == 0) {
        ll_out_str("0");
    } else {
        ll_out_str(detail);
    }
    ll_out_str(")\n  unreachable\n");
    g_terminated = saved;
}
