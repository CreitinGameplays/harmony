// harmony-base — LLVM lowering, part 3: statements, blocks, control flow
// (docs/harmony.md §8, §19.4).
//
// Control flow uses explicit, deterministic block labels (`if.then.N`,
// `while.cond.N`, ...) and a loop stack for `break`/`continue` targets. A
// block that already ended in a terminator is not emitted into again, so the
// IR stays well formed even for code the M1 checker lets through after a
// `return`.

// Loop context: break/continue targets, innermost last.
char* g_brk_label[64];
char* g_cont_label[64];
int   g_loop_label_depth;

// Terminator state lives in llvm.c2 (shared with the expression lowerer),
// reached through these accessors.
int  ll_get_terminated(void);
void ll_set_terminated(int v);

// ---- shared decls (llvm.c2 / lexpr.c2) ----
char* ll_expr(struct AstNode* n);
void  ll_block(struct AstNode* blk);
void  ll_stmt(struct AstNode* n);
void  ll_emit_trap(int code, struct AstNode* at, char* detail);
char* ll_new_reg(void);
char* ll_new_label(char* hint);
char* ll_type_name(int id);
char* ll_zero_of(int id);
char* ll_load(int ty, char* ptr);
char* ll_checked_bin(char* op, int ty, struct AstNode* n, char* l, char* r);
char* ll_addr(struct AstNode* n);
int   ll_node_ty(struct AstNode* n);
int   ll_sret_on(void);
int   ll_sret_ty(void);
int   ty_size(int id);
int   ll_is_float_ty(int id);
void  ll_local_declare(char* name, char* slot, int ty);
void  ll_env_scope_push(void);
void  ll_env_scope_pop(void);
char* ll_local_slot(char* name);
int   ll_local_ty(char* name);
void  ll_out_str(char* s);
void  ll_out_int(int v);
void  ll_out_nl(void);

// ---- Forward declarations for this file ----
void ll_label(char* label);
void ll_stmt_let(struct AstNode* n);
void ll_stmt_assign(struct AstNode* n);
void ll_stmt_if(struct AstNode* n);
void ll_stmt_while(struct AstNode* n);
void ll_stmt_for(struct AstNode* n);
void ll_stmt_break(struct AstNode* n);
void ll_stmt_continue(struct AstNode* n);
void ll_stmt_return(struct AstNode* n);
void ll_stmt_switch(struct AstNode* n);
void ll_switch_test(struct AstList* pats, int st, char* subjslot, char* armlbl, char* nextlbl);
char* ll_pattern_test(struct AstNode* p, int st, char* subjslot);
void  ll_bind_pattern(struct AstList* pats, int st, char* subjslot);
char* ll_enum_tag_test(int enum_ty, char* subjslot, int index);
char* ll_load_ptr(char* ptr);
char* ll_bin(char* op, int ty, char* a, char* b);
char* ll_cmp(char* op, int ty, char* a, char* b);
char* ll_const_int(int v, int ty);
char* ll_struct_gep(char* base, int struct_ty, int field);
char* ll_compound(char* opassign, struct AstNode* n, int ty, char* cur);
char* ll_compound_op(char* opassign);
void ll_loop_push(char* brk, char* cont);
void ll_loop_pop(void);

// Emits a `label:` line.
void ll_label(char* label) {
    ll_out_str(label);
    ll_out_str(":\n");
}

// ---------------------------------------------------------------------------
// Blocks and statements.
// ---------------------------------------------------------------------------
void ll_block(struct AstNode* blk) {
    struct AstList* stmts;
    int i;
    if (blk == 0) { return; }
    ll_env_scope_push();
    stmts = blk->kids;
    if (stmts != 0) {
        i = 0;
        while (i < stmts->len) {
            ll_stmt(stmts->items[i]);
            i = i + 1;
        }
    }
    ll_env_scope_pop();
}

void ll_stmt(struct AstNode* n) {
    if (n == 0) { return; }
    if (ll_get_terminated()) { return; }   // dead code after ret/br
    if (n->kind == AST_LET) { ll_stmt_let(n); return; }
    if (n->kind == AST_ASSIGN) { ll_stmt_assign(n); return; }
    if (n->kind == AST_EXPR_STMT) { ll_expr(n->a); return; }
    if (n->kind == AST_IF) { ll_stmt_if(n); return; }
    if (n->kind == AST_WHILE) { ll_stmt_while(n); return; }
    if (n->kind == AST_FOR) { ll_stmt_for(n); return; }
    if (n->kind == AST_RETURN) { ll_stmt_return(n); return; }
    if (n->kind == AST_BREAK) { ll_stmt_break(n); return; }
    if (n->kind == AST_CONTINUE) { ll_stmt_continue(n); return; }
    if (n->kind == AST_BLOCK) { ll_block(n); return; }
    if (n->kind == AST_UNCHECKED) { ll_block(n->a); return; }
    if (n->kind == AST_SWITCH) { ll_stmt_switch(n); return; }
    // Anything else: evaluate for effect.
    ll_expr(n);
}

// `let [mut] name [: T] = init;` — an alloca slot plus an initial store.
// A deferred `let x: T;` (no initializer) allocates an uninitialized slot.
void ll_stmt_let(struct AstNode* n) {
    int ty;
    char* slot;
    ty = ll_node_ty(n);
    slot = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(slot);
    ll_out_str(" = alloca ");
    ll_out_str(ll_type_name(ty));
    ll_out_nl();
    if (n->b != 0) {
        char* v;
        v = ll_expr(n->b);
        if (ll_is_aggregate(ty)) {
            // Aggregate values are represented by their address: copy the
            // bytes into the new binding's slot (copy = by-value binding).
            ll_out_str("  call void @llvm.memcpy.p0.p0.i64(ptr align 8 ");
            ll_out_str(slot);
            ll_out_str(", ptr align 8 ");
            ll_out_str(v);
            ll_out_str(", i64 ");
            ll_out_int(ty_size(ty));
            ll_out_str(", i1 false)\n");
        } else {
            ll_out_str("  store ");
            ll_out_str(ll_type_name(ty));
            ll_out_str(" ");
            ll_out_str(v);
            ll_out_str(", ptr ");
            ll_out_str(slot);
            ll_out_nl();
        }
    }
    // `_` discards: still allocate so the initializer is evaluated, but do
    // not bind a name.
    if (!str_eq(n->sval, "_")) {
        ll_local_declare(n->sval, slot, ty);
    }
}

void ll_stmt_assign(struct AstNode* n) {
    char* slot;
    int ty;
    char* v;
    if (n->a->kind == AST_PATH) {
        // Local binding.
        slot = ll_local_slot(n->a->sval);
        if (slot == 0) { return; }
        ty = ll_local_ty(n->a->sval);
    } else {
        // Field, index, or deref target: compute the address of the place.
        slot = ll_addr(n->a);
        ty = ll_node_ty(n->a);
    }

    if (str_eq(n->sval, "=")) {
        v = ll_expr(n->b);
        ty = g_expr_ty;   // the stored value's type (for casts that adapt)
        if (ll_is_aggregate(ty)) {
            // Aggregate values are represented by their address.
            ll_out_str("  call void @llvm.memcpy.p0.p0.i64(ptr align 8 ");
            ll_out_str(slot);
            ll_out_str(", ptr align 8 ");
            ll_out_str(v);
            ll_out_str(", i64 ");
            ll_out_int(ty_size(ty));
            ll_out_str(", i1 false)\n");
            return;
        }
    } else {
        // Compound: desugar `x op= y` to `x = x op y` on the current value.
        char* cur;
        if (ty_kind(ty) == CTY_STRUCT || ty_is_array(ty)) { return; }  // no struct compound
        cur = ll_load(ty, slot);
        v = ll_compound(n->sval, n, ty, cur);
    }
    ll_out_str("  store ");
    ll_out_str(ll_type_name(ty));
    ll_out_str(" ");
    ll_out_str(v);
    ll_out_str(", ptr ");
    ll_out_str(slot);
    ll_out_nl();
}

// Applies a compound assignment's operator to the loaded current value.
char* ll_compound(char* opassign, struct AstNode* n, int ty, char* cur) {
    char* rhs;
    char* op;
    rhs = ll_expr(n->b);
    op = ll_compound_op(opassign);
    if (op == 0) { return cur; }
    return ll_checked_bin(op, ty, n, cur, rhs);
}

// Maps `+=` -> "+", `<<=` -> "<<", etc.
char* ll_compound_op(char* opassign) {
    if (str_eq(opassign, "+=")) { return "+"; }
    if (str_eq(opassign, "-=")) { return "-"; }
    if (str_eq(opassign, "*=")) { return "*"; }
    if (str_eq(opassign, "/=")) { return "/"; }
    if (str_eq(opassign, "%=")) { return "%"; }
    if (str_eq(opassign, "&=")) { return "&"; }
    if (str_eq(opassign, "|=")) { return "|"; }
    if (str_eq(opassign, "^=")) { return "^"; }
    if (str_eq(opassign, "<<=")) { return "<<"; }
    if (str_eq(opassign, ">>=")) { return ">>"; }
    return 0;
}

// ---------------------------------------------------------------------------
// if / else.
// ---------------------------------------------------------------------------
void ll_stmt_if(struct AstNode* n) {
    char* cond;
    char* thenlbl;
    char* elselbl;
    char* endlbl;
    cond = ll_expr(n->a);
    ll_set_terminated(0);
    thenlbl = ll_new_label("if.then");
    elselbl = ll_new_label("if.else");
    endlbl = ll_new_label("if.end");
    if (n->c != 0) {
        ll_out_str("  br i1 ");
        ll_out_str(cond);
        ll_out_str(", label %");
        ll_out_str(thenlbl);
        ll_out_str(", label %");
        ll_out_str(elselbl);
        ll_out_nl();
    } else {
        ll_out_str("  br i1 ");
        ll_out_str(cond);
        ll_out_str(", label %");
        ll_out_str(thenlbl);
        ll_out_str(", label %");
        ll_out_str(endlbl);
        ll_out_nl();
    }
    ll_label(thenlbl);
    ll_block(n->b);
    if (!ll_get_terminated()) {
        ll_out_str("  br label %");
        ll_out_str(endlbl);
        ll_out_nl();
    }
    if (n->c != 0) {
        ll_label(elselbl);
        if (n->c->kind == AST_BLOCK) {
            ll_block(n->c);
        } else {
            ll_stmt_if(n->c);   // else if
        }
        if (!ll_get_terminated()) {
            ll_out_str("  br label %");
            ll_out_str(endlbl);
            ll_out_nl();
        }
    }
    ll_label(endlbl);
    ll_set_terminated(0);
}

// ---------------------------------------------------------------------------
// while.
// ---------------------------------------------------------------------------
void ll_stmt_while(struct AstNode* n) {
    char* condlbl;
    char* bodylbl;
    char* endlbl;
    condlbl = ll_new_label("while.cond");
    bodylbl = ll_new_label("while.body");
    endlbl = ll_new_label("while.end");
    ll_out_str("  br label %");
    ll_out_str(condlbl);
    ll_out_nl();
    ll_label(condlbl);
    {
        char* cond;
        cond = ll_expr(n->a);
        ll_out_str("  br i1 ");
        ll_out_str(cond);
        ll_out_str(", label %");
        ll_out_str(bodylbl);
        ll_out_str(", label %");
        ll_out_str(endlbl);
        ll_out_nl();
    }
    ll_label(bodylbl);
    ll_loop_push(endlbl, condlbl);
    ll_set_terminated(0);
    ll_block(n->b);
    ll_loop_pop();
    if (!ll_get_terminated()) {
        ll_out_str("  br label %");
        ll_out_str(condlbl);
        ll_out_nl();
    }
    ll_label(endlbl);
    ll_set_terminated(0);
}

// for (let i = a; cond; step) { body } — lowered to the while shape with the
// step at the end of the body and `continue` targeting the step.
void ll_stmt_for(struct AstNode* n) {
    char* condlbl;
    char* bodylbl;
    char* steplbl;
    char* endlbl;
    ll_env_scope_push();
    if (n->a != 0) { ll_stmt(n->a); }   // init, e.g. let i = 0;
    condlbl = ll_new_label("for.cond");
    bodylbl = ll_new_label("for.body");
    steplbl = ll_new_label("for.step");
    endlbl = ll_new_label("for.end");
    ll_out_str("  br label %");
    ll_out_str(condlbl);
    ll_out_nl();
    ll_label(condlbl);
    if (n->b != 0) {
        char* cond;
        cond = ll_expr(n->b);
        ll_out_str("  br i1 ");
        ll_out_str(cond);
        ll_out_str(", label %");
        ll_out_str(bodylbl);
        ll_out_str(", label %");
        ll_out_str(endlbl);
        ll_out_nl();
    } else {
        ll_out_str("  br label %");
        ll_out_str(bodylbl);
        ll_out_nl();
    }
    ll_label(bodylbl);
    ll_loop_push(endlbl, steplbl);
    ll_set_terminated(0);
    if (n->kids != 0 && n->kids->len > 0) {
        ll_block(n->kids->items[0]);
    } else if (n->b != 0 && n->b->kind == AST_BLOCK) {
        ll_block(n->b);
    }
    ll_loop_pop();
    if (!ll_get_terminated()) {
        ll_out_str("  br label %");
        ll_out_str(steplbl);
        ll_out_nl();
    }
    ll_label(steplbl);
    ll_set_terminated(0);
    if (n->c != 0) { ll_stmt(n->c); }   // step
    ll_out_str("  br label %");
    ll_out_str(condlbl);
    ll_out_nl();
    ll_label(endlbl);
    ll_set_terminated(0);
    ll_env_scope_pop();
}

void ll_loop_push(char* brk, char* cont) {
    g_brk_label[g_loop_label_depth] = brk;
    g_cont_label[g_loop_label_depth] = cont;
    g_loop_label_depth = g_loop_label_depth + 1;
}

void ll_loop_pop(void) {
    if (g_loop_label_depth > 0) { g_loop_label_depth = g_loop_label_depth - 1; }
}

void ll_stmt_break(struct AstNode* n) {
    if (g_loop_label_depth <= 0) { return; }
    ll_out_str("  br label %");
    ll_out_str(g_brk_label[g_loop_label_depth - 1]);
    ll_out_nl();
    ll_set_terminated(1);
}

void ll_stmt_continue(struct AstNode* n) {
    if (g_loop_label_depth <= 0) { return; }
    ll_out_str("  br label %");
    ll_out_str(g_cont_label[g_loop_label_depth - 1]);
    ll_out_nl();
    ll_set_terminated(1);
}

// ---------------------------------------------------------------------------
// return.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// switch. M1 lowers it to a chain of tests: evaluate the subject once, then
// for each arm compare against its pattern(s) and branch to the arm body or
// on to the next test. Enum subjects compare the hidden tag; scalar subjects
// compare the value. A `default` arm (or the end) is the fall-through.
// ---------------------------------------------------------------------------
void ll_stmt_switch(struct AstNode* n) {
    int st;
    char* subj;
    char* subjslot;
    char* endlbl;
    struct AstList* arms;
    int i;
    int has_default;
    char* deflbl;

    st = n->a->ty;
    subj = ll_expr(n->a);
    // Switching through a reference or heap box switches on the pointee
    // (§10.1). `ll_expr` of a reference/box value already yields the pointee's
    // address (a loaded pointer), so only the type needs unwrapping.
    while (ty_is_ref(st) || ty_is_heap(st)) {
        st = ty_elem(st);
    }
    if (ll_is_aggregate(st)) {
        // An aggregate subject arrives as an address (the callee's sret slot
        // or its own alloca) — spill the *pointer*, not the value.
        subjslot = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(subjslot);
        ll_out_str(" = alloca ptr\n");
        ll_out_str("  store ptr ");
        ll_out_str(subj);
        ll_out_str(", ptr ");
        ll_out_str(subjslot);
        ll_out_nl();
        // From here on, the subject's address is loaded once.
        subj = ll_load_ptr(subjslot);
        subjslot = subj;
    } else {
        subjslot = ll_new_reg();
        ll_out_str("  ");
        ll_out_str(subjslot);
        ll_out_str(" = alloca ");
        ll_out_str(ll_type_name(st));
        ll_out_nl();
        ll_out_str("  store ");
        ll_out_str(ll_type_name(st));
        ll_out_str(" ");
        ll_out_str(subj);
        ll_out_str(", ptr ");
        ll_out_str(subjslot);
        ll_out_nl();
    }

    endlbl = ll_new_label("switch.end");
    arms = n->kids;
    has_default = 0;
    deflbl = 0;
    if (arms != 0) {
        i = 0;
        while (i < arms->len) {
            struct AstNode* arm;
            arm = arms->items[i];
            if (arm->kids == 0 || arm->kids->len == 0) {
                has_default = 1;
                deflbl = ll_new_label("switch.default");
            }
            i = i + 1;
        }
    }
    if (!has_default) { deflbl = endlbl; }

    // Emit the tests and arm bodies in order.
    if (arms != 0) {
        i = 0;
        while (i < arms->len) {
            struct AstNode* arm;
            char* armlbl;
            char* nextlbl;
            arm = arms->items[i];
            if (arm->kids == 0 || arm->kids->len == 0) {
                ll_out_str("  br label %");
                ll_out_str(deflbl);
                ll_out_nl();
                ll_label(deflbl);
                ll_block(arm->b);
                if (!ll_get_terminated()) {
                    ll_out_str("  br label %");
                    ll_out_str(endlbl);
                    ll_out_nl();
                }
                ll_set_terminated(0);
                ll_label(endlbl);
                ll_set_terminated(0);
                return;
            }
            armlbl = ll_new_label("switch.arm");
            nextlbl = ll_new_label("switch.test");
            // One test per pattern in this arm (or-patterns are `||`).
            ll_switch_test(arm->kids, st, subjslot, armlbl, nextlbl);
            ll_label(armlbl);
            // Bind any variant payload patterns (`case Circle(r)`) before the
            // arm body runs (§8.6). The subject's address is `subjslot`.
            ll_bind_pattern(arm->kids, st, subjslot);
            ll_block(arm->b);
            if (!ll_get_terminated()) {
                ll_out_str("  br label %");
                ll_out_str(endlbl);
                ll_out_nl();
            }
            ll_set_terminated(0);
            ll_label(nextlbl);
            i = i + 1;
        }
    }
    // Fall through to the default/end.
    if (has_default) {
        ll_out_str("  br label %");
        ll_out_str(deflbl);
        ll_out_nl();
    } else {
        ll_out_str("  br label %");
        ll_out_str(deflbl);
        ll_out_nl();
    }
    if (!has_default) {
        ll_label(endlbl);
        ll_set_terminated(0);
    }
}

// Groups an arm's patterns into a branch to `armlbl` when any matches, else
// to `nextlbl`. Emits `br i1 <any>, label %armlbl, label %nextlbl`.
void ll_switch_test(struct AstList* pats, int st, char* subjslot, char* armlbl, char* nextlbl) {
    // Build the boolean with `||` semantics; M1 folds with `or i1` after
    // evaluating each test (patterns are constants, so no short-circuit cost).
    char* acc;
    int k;
    acc = 0;
    k = 0;
    while (k < pats->len) {
        struct AstNode* p;
        char* t;
        p = pats->items[k];
        t = ll_pattern_test(p, st, subjslot);
        if (t == 0) {
            // A wildcard/binding pattern matches everything: go straight to
            // the arm.
            ll_out_str("  br label %");
            ll_out_str(armlbl);
            ll_out_nl();
            return;
        }
        if (acc == 0) {
            acc = t;
        } else {
            acc = ll_bin("or", TY_BOOL, acc, t);
        }
        k = k + 1;
    }
    if (acc == 0) { acc = "false"; }
    ll_out_str("  br i1 ");
    ll_out_str(acc);
    ll_out_str(", label %");
    ll_out_str(armlbl);
    ll_out_str(", label %");
    ll_out_str(nextlbl);
    ll_out_nl();
}

// The `i1` test for one pattern against the spilled subject. Returns 0 for a
// catch-all pattern (wildcard / plain binding), which matches everything.
// Binds the payload variables of variant patterns for one arm (§8.6). For
// each `Enum::Variant(sub...)` pattern, load every payload field from the
// subject aggregate (tag at offset 0, payload from offset 8) into an alloca,
// and declare the sub-pattern's name. A non-binding sub-pattern is skipped
// (nested patterns are not bound in M1).
void ll_bind_pattern(struct AstList* pats, int st, char* subjslot) {
    int k;
    if (pats == 0) { return; }
    if (ty_kind(st) != CTY_ENUM) { return; }
    k = 0;
    while (k < pats->len) {
        struct AstNode* p;
        p = pats->items[k];
        if (p->kind == AST_PAT_VARIANT && p->kids != 0) {
            char* vname;
            int vi;
            int pid;
            int j;
            vname = p->sval;
            if (str_contains(vname, "::")) { vname = vname + str_rfind(vname, "::") + 2; }
            vi = ty_find_member(st, vname);
            if (vi >= 0) {
                pid = ty_member_type(st, vi);
                j = 0;
                while (j < p->kids->len && j < ty_member_count(pid)) {
                    struct AstNode* sub;
                    int ft;
                    char* addr;
                    char* v;
                    char* slot;
                    sub = p->kids->items[j];
                    ft = ty_member_type(pid, j);
                    addr = ll_offset_addr(subjslot, 8 + ty_field_offset(pid, j));
                    v = ll_load(ft, addr);
                    if (sub->kind == AST_PAT_BIND) {
                        slot = ll_new_reg();
                        ll_out_str("  ");
                        ll_out_str(slot);
                        ll_out_str(" = alloca ");
                        ll_out_str(ll_type_name(ft));
                        ll_out_nl();
                        ll_out_str("  store ");
                        ll_out_str(ll_type_name(ft));
                        ll_out_str(" ");
                        ll_out_str(v);
                        ll_out_str(", ptr ");
                        ll_out_str(slot);
                        ll_out_nl();
                        ll_local_declare(sub->sval, slot, ft);
                    }
                    j = j + 1;
                }
            }
        }
        k = k + 1;
    }
}

char* ll_pattern_test(struct AstNode* p, int st, char* subjslot) {
    if (p == 0) { return 0; }
    if (p->kind == AST_PAT_WILD) { return 0; }
    if (p->kind == AST_PAT_BIND) {
        // A bare name may be a unit variant (enum subject) or a catch-all.
        if (ty_kind(st) == CTY_ENUM) {
            char* vname;
            vname = p->sval;
            if (str_contains(vname, "::")) { vname = vname + str_rfind(vname, "::") + 2; }
            if (ty_find_member(st, vname) >= 0) {
                return ll_enum_tag_test(st, subjslot, ty_find_member(st, vname));
            }
        }
        return 0;
    }
    if (p->kind == AST_PAT_VARIANT) {
        char* vname;
        vname = p->sval;
        if (str_contains(vname, "::")) { vname = vname + str_rfind(vname, "::") + 2; }
        return ll_enum_tag_test(st, subjslot, ty_find_member(st, vname));
    }
    if (p->kind == AST_PAT_LIT) {
        char* v;
        char* cur;
        v = ll_expr(p->a);
        cur = ll_load(st, subjslot);
        if (ll_is_float_ty(st)) { return ll_cmp("fcmp oeq", st, cur, v); }
        return ll_cmp("icmp eq", st, cur, v);
    }
    if (p->kind == AST_PAT_RANGE) {
        // lo <= cur && cur <= hi
        char* cur;
        char* lo;
        char* hi;
        char* a;
        char* b;
        cur = ll_load(st, subjslot);
        lo = ll_expr(p->a);
        hi = ll_expr(p->b);
        a = ll_cmp("icmp sge", st, cur, lo);
        b = ll_cmp("icmp sle", st, cur, hi);
        return ll_bin("and", TY_BOOL, a, b);
    }
    return 0;
}

// `tag(subject) == index` for an enum-typed subject.
char* ll_enum_tag_test(int enum_ty, char* subjslot, int index) {
    char* tp;
    char* tag;
    tp = ll_struct_gep(subjslot, enum_ty, 0);
    tag = ll_load(TY_I32, tp);
    return ll_cmp("icmp eq", TY_I32, tag, ll_const_int(index, TY_I32));
}

// Loads a pointer-typed value from `ptr`.
char* ll_load_ptr(char* ptr) {
    char* r;
    r = ll_new_reg();
    ll_out_str("  ");
    ll_out_str(r);
    ll_out_str(" = load ptr, ptr ");
    ll_out_str(ptr);
    ll_out_nl();
    return r;
}

// ---------------------------------------------------------------------------
// return.
// ---------------------------------------------------------------------------
void ll_stmt_return(struct AstNode* n) {
    if (ll_sret_on()) {
        // The aggregate is returned through the hidden `%sret` slot: copy the
        // value there and return the pointer.
        int retty;
        char* v;
        retty = ll_sret_ty();
        v = ll_expr(n->a);
        // `v` is the address of the aggregate (aggregate expressions yield
        // addresses in this backend).
        ll_out_str("  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %sret, ptr align 8 ");
        ll_out_str(v);
        ll_out_str(", i64 ");
        ll_out_int(ty_size(retty));
        ll_out_str(", i1 false)\n");
        ll_out_str("  ret void\n");
        ll_set_terminated(1);
        return;
    }
    if (n->a != 0) {
        int ty;
        char* v;
        v = ll_expr(n->a);
        ty = g_expr_ty;
        ll_out_str("  ret ");
        ll_out_str(ll_type_name(ty));
        ll_out_str(" ");
        ll_out_str(v);
        ll_out_nl();
    } else {
        ll_out_str("  ret void\n");
    }
    ll_set_terminated(1);
}
