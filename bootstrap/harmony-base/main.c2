// harmony-base — driver: argument parsing and pipeline dispatch
// (docs/harmony.md §19.5).
//
//   lc build <file>       compile to an executable (LLVM path)
//   lc run   <file>       build and run
//   lc check <file>       analyses only, no code generation
//   lc emit-llvm <file>   print the generated LLVM IR (primary backend)
//   lc emit-c <file>      print the generated C (secondary backend)
//   lc explain <CODE>     long-form lesson for a diagnostic code
//   lc audit [file]       list every `unchecked` site (block or fn)
//
//   flags: --format=pretty|line|json   --all   --strict   --deny-unchecked
//          --dump-ast   --no-color   --ascii   -o <out>
//          -O0|-O1|-O2|-O3|-Os|-Oz|-Og|-Ofast  (optimization; -O2 default)

char* usage_text() {
    return "usage: harmony-base build <file.harmony> [-o out] [-O<level>]\n       harmony-base run   <file.harmony> [-O<level>]\n       harmony-base check <file.harmony>\n       harmony-base emit-llvm <file.harmony> [-O<level>]\n       harmony-base emit-c <file.harmony>\n       harmony-base explain <CODE>\n       harmony-base audit [file.harmony]\n       -O<level>: -O0 -O1 -O2 -O3 -Os -Oz -Og -Ofast (default -O2)\n";
}

void print_usage(void) {
    err_str(usage_text());
}

// Returns the `=`-attached value of `--flag=` (e.g. "json" from
// "--format=json"), or 0 when `a` is not that flag. `flag` must include the
// trailing `=`.
char* flag_str_value(char* a, char* flag) {
    int base;
    if (!str_has_prefix(a, flag)) { return 0; }
    base = str_len(flag);
    if (a[base] == 0) { return 0; }           // "--flag=" with nothing after
    return &a[base];
}

int parse_options(int argc, char** argv, struct Options* opts) {
    int i;
    char* a;
    char* v;

    opts->cmd = CMD_BUILD;
    opts->input = 0;
    opts->output = 0;
    opts->format = FORMAT_PRETTY;
    opts->all = 0;
    opts->strict = 0;
    opts->deny_unchecked = 0;
    opts->dump_ast = 0;
    opts->explain_code = 0;
    opts->ascii = 0;
    opts->no_color = 0;
    opts->verbose = 0;
    opts->opt_flag = "-O2";   // default level (docs/harmony.md §19.5)
    opts->opt_given = 0;

    if (argc < 2) {
        return 0;
    }

    i = 1;
    // Single pass: recognize the subcommand word, flags, and the input path.
    // Flags may appear before or after the subcommand (e.g. `-v check file`).
    while (i < argc) {
        a = argv[i];
        if (str_eq(a, "build"))   { opts->cmd = CMD_BUILD;   i = i + 1; continue; }
        if (str_eq(a, "run"))     { opts->cmd = CMD_RUN;     i = i + 1; continue; }
        if (str_eq(a, "check"))   { opts->cmd = CMD_CHECK;   i = i + 1; continue; }
        if (str_eq(a, "emit-llvm")) { opts->cmd = CMD_EMIT_LLVM; i = i + 1; continue; }
        if (str_eq(a, "emit-c"))  { opts->cmd = CMD_EMIT_C;  i = i + 1; continue; }
        if (str_eq(a, "explain")) {
            if (i + 1 < argc) { opts->explain_code = argv[i + 1]; }
            opts->cmd = CMD_EXPLAIN;
            i = i + 2;
            continue;
        }
        if (str_eq(a, "audit"))  { opts->cmd = CMD_AUDIT;  i = i + 1; continue; }
        if (str_eq(a, "-h") || str_eq(a, "--help")) { return 0; }
        if (str_eq(a, "-v") || str_eq(a, "--verbose")) {
            opts->verbose = 1; i = i + 1; continue;
        }
        if (str_eq(a, "-o") && i + 1 < argc) {
            opts->output = argv[i + 1]; i = i + 2; continue;
        }
        // Optimization level (§19.5): every LLVM level passes straight to
        // clang. `-O` alone means -O2 (clang's own convention).
        if (str_eq(a, "-O0") || str_eq(a, "-O1") || str_eq(a, "-O2")
            || str_eq(a, "-O3") || str_eq(a, "-Os") || str_eq(a, "-Oz")
            || str_eq(a, "-Og") || str_eq(a, "-Ofast") || str_eq(a, "-O")) {
            opts->opt_flag = a;
            if (str_eq(a, "-O")) { opts->opt_flag = "-O2"; }
            opts->opt_given = 1;
            i = i + 1;
            continue;
        }
        if (str_eq(a, "--all"))            { opts->all = 1;            i = i + 1; continue; }
        if (str_eq(a, "--strict"))         { opts->strict = 1;         i = i + 1; continue; }
        if (str_eq(a, "--deny-unchecked")) { opts->deny_unchecked = 1; i = i + 1; continue; }
        if (str_eq(a, "--dump-ast")) { opts->dump_ast = 1; i = i + 1; continue; }
        if (str_eq(a, "--ascii"))          { opts->ascii = 1;          i = i + 1; continue; }
        if (str_eq(a, "--no-color"))       { opts->no_color = 1;       i = i + 1; continue; }
        v = flag_str_value(a, "--format=");
        if (v != 0) {
            if (str_eq(v, "pretty")) { opts->format = FORMAT_PRETTY; }
            else if (str_eq(v, "line")) { opts->format = FORMAT_LINE; }
            else if (str_eq(v, "json")) { opts->format = FORMAT_JSON; }
            else {
                diag_plain("usage.bad-format", v);
                return -1;
            }
            i = i + 1;
            continue;
        }
        if (str_has_prefix(a, "-")) {
            // A `-O…` we do not recognize is worth its own message: `-O4` or
            // a typo like `-O2x` should not read as a generic unknown flag.
            if (str_has_prefix(a, "-O")) {
                diag_plain("usage.bad-opt", a);
                return -1;
            }
            diag_plain("usage.unknown-flag", a);
            return -1;
        }
        // `explain`'s CODE argument may come after the subcommand.
        if (opts->cmd == CMD_EXPLAIN && opts->explain_code == 0) {
            opts->explain_code = a; i = i + 1; continue;
        }
        if (opts->input == 0) {
            opts->input = a; i = i + 1; continue;
        }
        diag_plain("usage.too-many-inputs", a);
        return -1;
    }

    // Subcommands that need no input file.
    if (opts->cmd == CMD_EXPLAIN) {
        if (opts->explain_code == 0) { return 0; }
        return 1;
    }
    if (opts->cmd == CMD_AUDIT) { return 1; }

    if (opts->input == 0) { return 0; }
    return 1;
}

int main(int argc, char** argv) {
    struct Options opts;
    int ok;

    ok = parse_options(argc, argv, &opts);
    if (ok == 0) {
        print_usage();
        return EXIT_USAGE;
    }
    if (ok < 0) {
        print_usage();
        return EXIT_USAGE;
    }

    // `explain <CODE>` and `audit` need no source and no pipeline.
    if (opts.cmd == CMD_EXPLAIN) {
        if (explain_lookup(opts.explain_code) == 0) { return EXIT_OK; }
        diag_plain("usage.unknown-code", opts.explain_code);
        return EXIT_USAGE;
    }
    if (opts.cmd == CMD_AUDIT) {
        return audit_run(&opts);
    }

    return pipeline_run(&opts);
}
