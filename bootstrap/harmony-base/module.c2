// harmony-base — module loader (docs/harmony.md 6.7, pipeline stage 3).
//
// One file is one module. `import "path";` makes that file's items available
// under the file's base name as a namespace: importing "geometry.harmony"
// binds its items as `geometry::name`. The root module (the file named on
// the command line) stays un-prefixed.
//
// Bootstrap model (simpler than the final compiler's stage 3, §19.1):
//   * Every module is loaded eagerly, depth-first over each module's imports
//     in source order; a module with several importers is merged once.
//   * The merged program is ONE flat item list:
//       [imported items, renamed `modname::orig`, in merge order]
//       [the root module's items, unchanged]
//     so the existing checker and backend see a single-module program. The
//     rename is textual: the flat symbol table then holds `geometry::Vec2`
//     exactly like a nested enum path, which the symbol mangling already
//     converts to identifier-safe bytes.
//   * Only names a module itself declares top-level are renamed: a use of
//     `Vec2` inside geometry becomes `geometry::Vec2`, while `Heap`, `i32`,
//     generic parameters and locals pass through untouched.
//   * Bootstrap visibility gap, deliberately: non-`export` items of an
//     imported module are merged too (renamed like everything else), so a
//     module's private helpers stay callable from its own exports. The
//     final compiler's loader enforces export visibility; harmony-base
//     documents the gap instead of half-implementing it.
//
// NAME-04: an imported file that does not exist, or an import cycle.
// `main` in a library module is not special-cased: it merges as
// `modname::main`, so the program correctly stops with TYPE-06 ("no main").
//
// Determinism: merge order and renamed bytes are a pure function of the
// import graph, so the same files compile to identical IR bytes.

const int MOD_MAX     = 64;    // modules per program (cap with a diagnostic)
const int MOD_MAXNAMES = 256;  // top-level names collected per module

struct SourceFile* g_mod_files[64];  // arena-allocated, diag-registered
struct AstNode*    g_mod_roots[64];   // each module's program tree
char*              g_mod_names[64];   // namespace (base name sans dir/ext)
char*              g_mod_paths[64];   // resolved path (dedupe key)
int                g_mod_inflight[64];// cycle detection: being expanded
int                g_mod_renamed[64]; // items already merged (rename once)
int                g_nmods;
int                g_mod_failed;       // a hard load error was reported
struct SourceFile* g_mod_cur_sf;      // module being expanded (for stops)

// A module table entry's index by path, or -1.
int mod_find(char* path) {
    int i;
    i = 0;
    while (i < g_nmods) {
        if (str_eq(g_mod_paths[i], path)) { return i; }
        i = i + 1;
    }
    return -1;
}

// True when `c` may appear in a harmony identifier (ASCII; module names are
// file base names, so this is what keeps namespaces sane).
int mod_ident_char(char c) {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c >= '0' && c <= '9') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

// The namespace name of a module: the file name without directories and
// extension. "library/std/geometry.harmony" -> "geometry". Non-identifier
// characters are folded to `_` (a kebab-case file `my-lib.harmony` becomes
// the namespace `my_lib`), so the merged symbol names stay identifier-safe.
// Returns 0 only for an empty name.
char* mod_base_name(char* path) {
    int i;
    int start;
    int dot;
    char* s;
    i = 0;
    start = 0;
    dot = -1;
    while (path[i] != 0) {
        if (path[i] == '/') { start = i + 1; dot = -1; }
        if (path[i] == '.') { dot = i; }
        i = i + 1;
    }
    if (dot < 0 || dot <= start) { dot = i; }
    s = arena_alloc(dot - start + 1);
    i = start;
    while (i < dot) {
        if (mod_ident_char(path[i])) {
            s[i - start] = path[i];
        } else {
            s[i - start] = '_';
        }
        i = i + 1;
    }
    s[dot - start] = 0;
    if (s[0] == 0) { return 0; }
    return s;
}

// Normalizes a path: collapses "." segments and resolves ".." against the
// preceding segment, so the same file always has ONE spelling.
//
// This matters because the normalized path is a module's identity (§6.7: a
// module with several importers is merged once). Without it, "shared.harmony"
// and "../shared.harmony" are two different keys for the same file, so the
// file is loaded and merged twice and its names collide (NAME-03).
//
// A leading "/" is preserved (absolute paths stay absolute); a ".." that has
// nothing to pop (a relative path climbing above its root) is kept as-is,
// because there is nothing sensible to resolve it to.
char* mod_normalize(char* path) {
    int n;
    int i;
    int start;
    int outlen;
    int seg;
    int seglen;
    int absolute;
    int nsegs;
    int starts[64];
    int lens[64];
    char* out;
    n = str_len(path);
    absolute = 0;
    if (n > 0 && path[0] == '/') { absolute = 1; }
    // Split into segments, dropping "" and "." and resolving "..".
    nsegs = 0;
    i = 0;
    while (i < n) {
        while (i < n && path[i] == '/') { i = i + 1; }
        if (i >= n) { break; }
        start = i;
        while (i < n && path[i] != '/') { i = i + 1; }
        seglen = i - start;
        if (seglen == 1 && path[start] == '.') { continue; }
        if (seglen == 2 && path[start] == '.' && path[start + 1] == '.') {
            if (nsegs > 0) {
                nsegs = nsegs - 1;
                continue;
            }
            if (absolute) { continue; }   // "/.." is "/"
            // A relative ".." with nothing to pop: keep it.
        }
        if (nsegs >= 64) { continue; }   // absurdly long path: drop the rest
        starts[nsegs] = start;
        lens[nsegs] = seglen;
        nsegs = nsegs + 1;
    }
    // Rebuild.
    outlen = 0;
    if (absolute) { outlen = 1; }
    out = arena_alloc(n + 2);
    if (absolute) { out[0] = '/'; }
    seg = 0;
    while (seg < nsegs) {
        if (outlen > 0 && out[outlen - 1] != '/') { out[outlen] = '/'; outlen = outlen + 1; }
        i = 0;
        while (i < lens[seg]) { out[outlen] = path[starts[seg] + i]; outlen = outlen + 1; i = i + 1; }
        seg = seg + 1;
    }
    out[outlen] = 0;
    return out;
}

// Joins `dir` ("" or 0 = none) and `path` into one normalized arena string.
//
// The result is the module's identity, so it must be canonical: the same file
// reached by different spellings has to produce the same string, or the loader
// merges it twice (see mod_normalize).
char* mod_join(char* dir, char* path) {
    int n;
    int i;
    char* s;
    if (dir == 0 || dir[0] == 0) { return mod_normalize(path); }
    n = str_len(dir) + 1 + str_len(path);
    s = arena_alloc(n + 1);
    i = 0;
    while (dir[i] != 0) { s[i] = dir[i]; i = i + 1; }
    s[i] = '/';
    n = i + 1;
    i = 0;
    while (path[i] != 0) { s[n + i] = path[i]; i = i + 1; }
    s[n + i] = 0;
    return mod_normalize(s);
}

// The directory part of `path` ("" for a bare name); arena-copied.
char* mod_dir_of(char* path) {
    int i;
    int last;
    char* s;
    i = 0;
    last = -1;
    while (path[i] != 0) {
        if (path[i] == '/') { last = i; }
        i = i + 1;
    }
    s = arena_alloc(last + 2);
    if (last < 0) { s[0] = 0; return s; }
    i = 0;
    while (i <= last) { s[i] = path[i]; i = i + 1; }
    s[last] = 0;
    return s;
}

// Was the first segment of a `::`-qualified name declared top-level in the
// module being renamed? (`Shape::Circle` -> yes for geometry; `Heap::...`,
// or an already-namespaced `geometry::...`, -> no.)
int mod_first_in_set(char* sval, char** names, int nnames) {
    int i;
    int n;
    char* first;
    n = 0;
    while (sval[n] != 0 && !(sval[n] == ':' && sval[n + 1] == ':')) { n = n + 1; }
    if (n == 0) { return 0; }
    first = arena_alloc(n + 1);
    i = 0;
    while (i < n) { first[i] = sval[i]; i = i + 1; }
    first[n] = 0;
    i = 0;
    while (i < nnames) {
        if (str_eq(names[i], first)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Is the bare name one this module declares top-level?
int mod_in_set(char* sval, char** names, int nnames) {
    int i;
    i = 0;
    while (i < nnames) {
        if (str_eq(names[i], sval)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// True while `mod_rename_node` is walking inside a `methods` block, so a
// method's own fn node is not renamed as if it were a module-level item.
int g_mod_in_methods;

// Renames `n` (an item, or a node inside one) into its module's namespace:
// every *bare name this module declares top-level* becomes `modname::name`.
// Qualified names rewrite only when their first segment is such a name.
// Everything else — `Heap`, primitives, generic parameters, locals, field
// and method names, enum variants — passes through untouched, which is what
// keeps references to other modules and the prelude intact.
void mod_rename_node(struct AstNode* n, char* pre, char** names, int nnames) {
    int i;
    if (n == 0) { return; }
    if ((n->kind == AST_TYPE_NAME || n->kind == AST_PATH
         || n->kind == AST_STRUCT_INIT)
        && n->sval != 0) {
        // A generic head the module does not own (`Heap<Vec2>`) stays put;
        // its type arguments rename through the kids walk below.
        int rename_head;
        rename_head = 1;
        if (n->kind == AST_TYPE_NAME && n->kids != 0 && n->kids->len > 0
            && !mod_in_set(n->sval, names, nnames)) {
            rename_head = 0;
        }
        if (rename_head) {
            if (str_contains(n->sval, "::")) {
                if (mod_first_in_set(n->sval, names, nnames)) {
                    n->sval = str_concat(pre, n->sval);
                }
            } else if (mod_in_set(n->sval, names, nnames)) {
                n->sval = str_concat(pre, n->sval);
            }
        }
        if (n->kind == AST_PATH) {
            // A path's segment list pins the final segment (a variant or a
            // field name): never rewrite segments, only the base if any.
            mod_rename_node(n->a, pre, names, nnames);
            // EXCEPT when there is no base: a bare generic path like
            // `Vec<N>::make` stores its type arguments in `kids` (set by
            // parse_expr's `tyargs` branch). Those arguments are types this
            // module may declare, so they must be renamed too. The old
            // unconditional `return` skipped them: inside a module, the
            // `N` in `vec::Vec<N>::make()` stayed bare, so importing the
            // module produced a `Vec__X` instance and NAME-01 "no type
            // named `N`". With a base, `kids` are the path's segments,
            // which must stay untouched.
            if (n->a == 0 && n->kids != 0) {
                i = 0;
                while (i < n->kids->len) {
                    mod_rename_node(n->kids->items[i], pre, names, nnames);
                    i = i + 1;
                }
            }
            return;
        }
    }
    if ((n->kind == AST_STRUCT || n->kind == AST_ENUM || n->kind == AST_CONST
         || n->kind == AST_METHODS || n->kind == AST_FN
         || n->kind == AST_EXTERN_FN)
        && n->sval != 0 && mod_in_set(n->sval, names, nnames)) {
        // A method's bare name is *not* a module-level name: its identity is
        // `(receiver type, name)`, and the backend mangles it per receiver
        // (`Type__method`). The loader reaches a method's `AST_FN` by walking
        // into its `methods` block, so renaming it here would rewrite the
        // string the method table is keyed by — and then a free function of
        // the same name in the same module silently shadowed the method
        // (`str::len` vs `String::len`), which was a TYPE-02 "no such field".
        // `AST_METHODS` itself is a top-level item and does rename.
        if (n->kind != AST_FN || !g_mod_in_methods) {
            n->sval = str_concat(pre, n->sval);
        }
    }
    if (n->kind == AST_CALL && n->a == 0 && n->sval != 0) {
        // `name(args)` — an inferred generic call or plain call: the callee
        // name follows the same rule (only this module's own names move).
        if (str_contains(n->sval, "::")) {
            if (mod_first_in_set(n->sval, names, nnames)) {
                n->sval = str_concat(pre, n->sval);
            }
        } else if (mod_in_set(n->sval, names, nnames)) {
            n->sval = str_concat(pre, n->sval);
        }
    }
    mod_rename_node(n->a, pre, names, nnames);
    mod_rename_node(n->b, pre, names, nnames);
    mod_rename_node(n->c, pre, names, nnames);
    if (n->kids != 0) {
        i = 0;
        while (i < n->kids->len) {
            mod_rename_node(n->kids->items[i], pre, names, nnames);
            i = i + 1;
        }
    }
    if (n->kids2 != 0) {
        int saved_in_methods;
        saved_in_methods = g_mod_in_methods;
        if (n->kind == AST_METHODS) { g_mod_in_methods = 1; }
        i = 0;
        while (i < n->kids2->len) {
            mod_rename_node(n->kids2->items[i], pre, names, nnames);
            i = i + 1;
        }
        g_mod_in_methods = saved_in_methods;
    }
}

// Collects a module's top-level declared names (pre-rename) into `names`.
void mod_collect_names(struct AstNode* root, char** names, int* nnames) {
    struct AstList* items;
    int i;
    items = root->kids;
    if (items == 0) { return; }
    i = 0;
    while (i < items->len) {
        struct AstNode* it;
        it = items->items[i];
        if (it->kind == AST_STRUCT || it->kind == AST_ENUM
            || it->kind == AST_CONST || it->kind == AST_FN
            || it->kind == AST_EXTERN_FN || it->kind == AST_METHODS) {
            if (it->sval != 0 && *nnames < MOD_MAXNAMES) {
                names[*nnames] = it->sval;
                *nnames = *nnames + 1;
            }
        }
        i = i + 1;
    }
}

// True when the last mod_load_one landed on a file that could not even be
// read (a usage error, exit 2) — distinct from lex/parse stops inside it.
int g_mod_io_failed;

// Loads `path` (resolved against `dir`), parses it, and records the module.
// Returns its index, or -1 after a reported error. Cycles are the caller's
// (only it knows the in-flight chain).
int mod_load_one(char* dir, char* path) {
    struct SourceFile* sf;
    struct AstNode* root;
    struct Token* toks;
    int n;
    int idx;
    char* full;
    char* name;

    g_mod_io_failed = 0;
    full = mod_join(dir, path);
    idx = mod_find(full);
    if (idx >= 0) { return idx; }
    if (g_nmods >= MOD_MAX) {
        diag_plain("module.too-many", full);
        g_mod_failed = 1;
        g_mod_io_failed = 1;
        return -1;
    }
    idx = g_nmods;
    sf = (struct SourceFile*) arena_alloc(64);   // 5 fields; padded safely
    if (source_load(full, sf) != 0) {
        diag_plain("module.not-found", full);
        g_mod_failed = 1;
        g_mod_io_failed = 1;
        return -1;
    }
    // Register with diagnostics BEFORE parsing so this module's stops render
    // under its own name.
    diag_register_file(sf);
    n = lexer_run(sf, &toks);
    if (n < 0) { g_mod_failed = 1; return -1; }
    root = parser_run(sf, toks, n);
    if (root == 0) { g_mod_failed = 1; return -1; }
    name = mod_base_name(full);
    if (name == 0) {
        diag_plain("module.bad-name", full);
        g_mod_failed = 1;
        g_mod_io_failed = 1;
        return -1;
    }
    g_mod_files[idx] = sf;
    g_mod_roots[idx] = root;
    g_mod_paths[idx] = full;
    g_mod_names[idx] = name;
    g_nmods = g_nmods + 1;
    return idx;
}

// Expands module `idx`: loads its imports (depth-first, source order),
// appends their merged items to `out`, then appends its own renamed items.
// `chain` is the in-flight import chain for NAME-04 cycle reporting; its
// entry 0 is the root path. Returns 0, or -1 after a reported error.
int mod_expand(int idx, struct AstList* out, char** chain, int chain_len) {
    struct AstList* items;
    char* names[MOD_MAXNAMES];
    int nnames;
    char* pre;
    int i;
    int j;

    g_mod_inflight[idx] = 1;
    g_mod_cur_sf = g_mod_files[idx];
    items = g_mod_roots[idx]->kids;
    if (items != 0) {
        i = 0;
        while (i < items->len) {
            struct AstNode* it;
            it = items->items[i];
            if (it->kind == AST_IMPORT) {
                char* dir;
                char* full;
                int sub;
                int nchain;
                dir = mod_dir_of(g_mod_paths[idx]);
                full = mod_join(dir, it->sval);
                sub = mod_find(full);
                if (sub >= 0 && g_mod_inflight[sub]) {
                    lexbuf_reset();
                    lexbuf_push_str("import cycle: ");
                    lexbuf_push_str(chain[0]);
                    j = 1;
                    while (j < chain_len) {
                        lexbuf_push_str(" -> ");
                        lexbuf_push_str(chain[j]);
                        j = j + 1;
                    }
                    lexbuf_push_str(" -> ");
                    lexbuf_push_str(full);
                    diag_stop("NAME-04", "import cycle",
                              lexbuf_finish(), g_mod_cur_sf, it->start, it->end);
                    g_mod_inflight[idx] = 0;
                    g_mod_failed = 1;
                    return -1;
                }
                if (sub < 0) {
                    sub = mod_load_one(dir, it->sval);
                    if (sub < 0) {
                        // mod_load_one reported the hard error; point a
                        // buffered stop at the import line as well.
                        lexbuf_reset();
                        lexbuf_push_str("imported file not found: ");
                        lexbuf_push_str(full);
                        diag_stop("NAME-04", "unknown module",
                                  lexbuf_finish(), g_mod_cur_sf,
                                  it->start, it->end);
                        g_mod_inflight[idx] = 0;
                        g_mod_failed = 1;
                        return -1;
                    }
                }
                nchain = chain_len;
                if (nchain < MOD_MAX) {
                    chain[nchain] = full;
                    nchain = nchain + 1;
                }
                if (mod_expand(sub, out, chain, nchain) < 0) {
                    g_mod_inflight[idx] = 0;
                    return -1;
                }
            }
            i = i + 1;
        }
    }
    // This module's own contribution: its items renamed into its namespace,
    // in source order (the root module, idx 0, keeps its names: the caller
    // appends those separately). A module imported by several importers is
    // expanded once — the first merge renames and appends its items; later
    // imports of the same path reuse that work (renaming twice would produce
    // `geometry::geometry::name`).
    if (idx != 0 && !g_mod_renamed[idx]) {
        g_mod_renamed[idx] = 1;
        nnames = 0;
        mod_collect_names(g_mod_roots[idx], names, &nnames);
        pre = str_concat(g_mod_names[idx], "::");
        if (items != 0) {
            i = 0;
            while (i < items->len) {
                struct AstNode* it;
                it = items->items[i];
                if (it->kind != AST_IMPORT) {
                    mod_rename_node(it, pre, names, nnames);
                    ast_list_push(out, it);
                }
                i = i + 1;
            }
        }
    }
    g_mod_inflight[idx] = 0;
    return 0;
}

// True when the module loader hit a hard error (already reported).
int mod_failed(void) {
    return g_mod_failed;
}

// True when the root input itself could not be read (vs. stops inside it).
int mod_io_failed(void) {
    return g_mod_io_failed;
}

// Loads the whole program for `opts->input`: the root module plus every
// module it imports (transitively), merged into one flat program tree.
// Returns the program root, or 0 when the root module itself cannot load
// (missing file, too many modules, bad name — reported via diag_plain; the
// caller exits 2). Import errors surface as buffered stops / mod_failed().
struct AstNode* module_program(struct Options* opts) {
    struct AstNode* root;
    struct AstList* out;
    struct AstList* root_items;
    char* chain[MOD_MAX];
    int i;

    g_nmods = 0;
    g_mod_failed = 0;
    g_mod_cur_sf = 0;
    i = 0;
    while (i < MOD_MAX) {
        g_mod_inflight[i] = 0;
        g_mod_renamed[i] = 0;
        i = i + 1;
    }

    // The root module is index 0. It is spelled relative to the process CWD,
    // so no directory is joined.
    if (mod_load_one("", opts->input) < 0) { return 0; }
    if (opts->verbose) {
        err_str("harmony-base: read ");
        err_int(g_mod_files[0]->len);
        err_str(" bytes from ");
        err_str(g_mod_files[0]->path);
        err_nl();
    }

    out = ast_list_new();
    chain[0] = opts->input;
    if (mod_expand(0, out, chain, 1) < 0) {
        // A hard import error was reported; return the (unmerged) root so the
        // caller stops rather than checking a half program.
        return g_mod_roots[0];
    }

    // The root module's items keep their names and order, appended after the
    // imported surface.
    root = g_mod_roots[0];
    root_items = root->kids;
    if (root_items != 0) {
        i = 0;
        while (i < root_items->len) {
            struct AstNode* it;
            it = root_items->items[i];
            if (it->kind != AST_IMPORT) {
                ast_list_push(out, it);
            }
            i = i + 1;
        }
    }
    // Hand the merged tree to the pipeline; `g_prog` (used by --dump-ast) is
    // set in check_program, which runs after the merge.
    root->kids = out;
    return root;
}