// harmony-base — parser core: token cursor, recovery, types, items
// (docs/harmony.md §18 grammar, §19.1 stage 2).
//
// Recursive descent, one token of extra lookahead (§18 "Parsing notes").
// The cursor is module-global (one parse at a time). A syntax stop enters
// panic mode; parsing skips to the next `;`/`}` boundary (p_sync) so one
// malformed construct does not hide the rest of the file.
//
// Layout:
//   parser.c2  — cursor, p_* helpers, types, imports/consts/fns/structs/enums
//   pstmts.c2  — statements, blocks, patterns
//   pexpr.c2   — expressions (precedence chain, §18)
//   pastout.c2 — the AST pretty-printer (round-trip tests)

// ---------------------------------------------------------------------------
// State.
// ---------------------------------------------------------------------------
struct Token* g_ptoks;          // token array (lexer-owned)
int g_pntoks;                  // token count, incl. the trailing EOF
int g_ppos;                    // index of the current token
struct SourceFile* g_psf;       // active source (diagnostics)
int g_pstops;                  // syntax stops reported
int g_ppanic;                   // panic mode until the next sync boundary
int g_ploop_depth;              // nested loop depth (break/continue checks)
struct AstNode* g_pprogram;    // program root (for later stages)

// Recursion depth guard. The grammar is recursive descent, so a deeply nested
// source (`(((((...`, `[[[[[...`, `{{{{...`) would exhaust the native stack
// and crash the compiler. A fuzzer (tests/harmony/fuzz2.sh) found the cliff at
// ~8k-12k levels. We refuse instead: past the limit the parser reports one
// clear stop and stops descending, so the process stays alive and well-defined
// on *any* input. The limit is deliberately far above real code (a machine-
// generated 4k-deep expression still parses) and far below the stack ceiling.
int g_pdepth;
int g_pdepth_limit = 2000;

// Enters one level of recursion. Returns 1 when the limit is exceeded (the
// caller must recover without descending); in that case a single SYN-05 stop
// is reported (once — repeated reports in panic mode would be noise).
int p_depth_enter(struct Token* at) {
    g_pdepth = g_pdepth + 1;
    if (g_pdepth > g_pdepth_limit) {
        g_pdepth = g_pdepth - 1;
        if (!g_ppanic) {
            p_syn("SYN-05",
                  "the nesting is too deep",
                  "The parser refuses recursion beyond its depth limit; nest it less, or split the expression.",
                  "flatten the nesting",
                  "a.b().c instead of (((a).b()).c)",
                  at);
        }
        return 1;
    }
    return 0;
}

void p_depth_leave(void) {
    if (g_pdepth > 0) { g_pdepth = g_pdepth - 1; }
}

// ---------------------------------------------------------------------------
// Cursor helpers.
// ---------------------------------------------------------------------------
struct Token* p_cur(void) {
    return &g_ptoks[g_ppos];
}

struct Token* p_peek(int n) {
    int i;
    i = g_ppos + n;
    if (i >= g_pntoks) { return &g_ptoks[g_pntoks - 1]; }   // clamp to EOF
    return &g_ptoks[i];
}

struct Token* p_prev(void) {
    if (g_ppos == 0) { return p_cur(); }
    return &g_ptoks[g_ppos - 1];
}

void p_advance(void) {
    if (g_ppos < g_pntoks - 1) { g_ppos = g_ppos + 1; }
}

int p_at(int kind) {
    return p_cur()->kind == kind;
}

int p_at_kw(char* kw) {
    return tok_is_kw(p_cur(), kw);
}

int p_eat(int kind) {
    if (p_at(kind)) {
        p_advance();
        return 1;
    }
    return 0;
}

int p_eat_kw(char* kw) {
    if (p_at_kw(kw)) {
        p_advance();
        return 1;
    }
    return 0;
}

// Reports a syntax stop with a `try:` fix (§16.2), bumps the counter, and
// enters panic mode. An empty fix_label means "no fix proposed".
int p_syn(char* code, char* title, char* summary,
          char* fix_label, char* fix_text, struct Token* at) {
    int idx;
    idx = diag_stop(code, title, summary, g_psf, at->start, at->end);
    if (idx >= 0 && fix_label != 0 && !str_eq(fix_label, "")) {
        diag_fix(diag_get(idx), fix_label, fix_text);
    }
    g_pstops = g_pstops + 1;
    g_ppanic = 1;
    return idx;
}

// Consumes `kind` or reports SYN-05 with a `what`-named hint.
int p_expect(int kind, char* what) {
    if (p_at(kind)) {
        p_advance();
        return 1;
    }
    p_syn("SYN-05",
          "unexpected token",
          "This token does not fit here; the grammar expects another one at this position (docs/harmony.md 18).",
          what,
          "",
          p_cur());
    return 0;
}

// The §4.4 semicolon rule: simple statements end with `;`.
int p_expect_semi(void) {
    if (p_at(TOK_SEMI)) {
        p_advance();
        return 1;
    }
    if (p_at(TOK_RBRACE) || p_at(TOK_EOF)) {
        // `let n = 5` directly before `}` (or EOF): the classic forgotten `;`.
        p_syn("SYN-04",
              "missing `;`",
              "Simple statements end with `;` (4.4). This statement has no `;` before the closing brace or the end of the file.",
              "add the `;`",
              ";",
              p_prev());
        return 0;
    }
    p_syn("SYN-04",
          "missing `;`",
          "Simple statements end with `;` (4.4). The token after this statement cannot follow it.",
          "add the `;`",
          ";",
          p_cur());
    return 0;
}

// Consumes the keyword or reports SYN-05.
int p_expect_kw(char* kw) {
    if (p_at_kw(kw)) {
        p_advance();
        return 1;
    }
    p_syn("SYN-05",
          "unexpected token",
          "This token does not fit here; the grammar expects another one at this position (docs/harmony.md 18).",
          "add the keyword",
          kw,
          p_cur());
    return 0;
}

// Consumes one `>` even when the lexer produced `>>` or `>=` (nested
// generics: `Vec<Vec<i32>>`). Rewrites the current token in place to the
// remaining half. Returns 1 when a `>` was (possibly virtually) consumed.
int p_eat_gt_split(void) {
    struct Token* t;
    if (p_at(TOK_GT)) {
        p_advance();
        return 1;
    }
    t = p_cur();
    if (t->kind == TOK_SHR) {
        // `>>` -> `>` + `>`: keep one in place, cursor stays.
        t->kind = TOK_GT;
        t->len = 1;
        t->end = t->start + 1;
        return 1;
    }
    if (t->kind == TOK_GE) {
        // `>=` -> `>` + `=`
        t->kind = TOK_GT;
        t->len = 1;
        t->end = t->start + 1;
        return 1;
    }
    return 0;
}

// Recovery (§19.1 stage 2): skip to just after the next `;`, or up to (not
// past) the enclosing `}` / EOF. Panic mode ends at the boundary.
void p_sync(void) {    while (!p_at(TOK_EOF)) {
        if (p_at(TOK_SEMI)) {
            p_advance();
            return;
        }
        if (p_at(TOK_RBRACE)) {
            return;
        }
        p_advance();
    }
    g_ppanic = 0;
}

// Clears panic mode (call after a successful recovery boundary).
void p_panic_off(void) {
    g_ppanic = 0;
}

int parser_stop_count(void) {
    return g_pstops;
}

// ---------------------------------------------------------------------------
// Nodes and spans.
// ---------------------------------------------------------------------------
struct AstNode* p_node(int kind) {
    struct AstNode* n;
    n = ast_node_new(kind);
    n->file = 0;      // single module for now; stage 3 (resolve) adds more
    n->start = p_cur()->start;
    n->end = p_cur()->end;
    return n;
}

// Widens `n`s span to include token `t` (usually the one just consumed).
void p_end_at(struct AstNode* n, struct Token* t) {
    if (t->end > n->end) { n->end = t->end; }
}

// Copies the current token's spelling into the arena.
char* p_cur_word(void) {
    return arena_alloc_str(p_cur()->text);
}

// Copies the previous token's spelling into the arena.
char* p_prev_word(void) {
    return arena_alloc_str(p_prev()->text);
}

// ---------------------------------------------------------------------------
// Types (§18).
//
//   ref_type   = "&" [ "mut" ] [ life_use ] type       -> AST_TYPE_REF
//   raw_type   = "raw" [ "mut" ] type                  -> AST_TYPE_RAW
//   array_type = "[" type ";" expr "]"                  -> AST_TYPE_ARRAY
//   slice_type = "[" type "]"                           -> AST_TYPE_SLICE
//   path_type  = ID { "::" ID } [ "<" targ+ ">" ]       -> AST_TYPE_NAME
//   life_use   = "life" "(" ID ")"                       (inside ref types)
// ---------------------------------------------------------------------------

// Parses `life` "(" ID|static ")" into a *string* "life(a)". The cursor must
// sit on the `life` keyword. Returns the arena string, or 0 after a stop.
char* parse_life_use(void) {
    char* name;
    p_advance();      // life (verified by caller)
    if (!p_expect(TOK_LPAREN, "add `(` after `life`")) { return 0; }
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "a life needs a name",
              "`life(a)` names a life parameter with an identifier (or `static`).",
              "name the life",
              "life(a)",
              p_cur());
        return 0;
    }
    lexbuf_reset();
    lexbuf_push_str("life(");
    lexbuf_push_str(p_cur()->text);
    p_advance();
    if (!p_expect(TOK_RPAREN, "add `)` to close the life use")) { return 0; }
    lexbuf_push(')');
    name = lexbuf_finish();
    return name;
}

// Parses a path: ID { "::" ID } and joins it ("A::B").
// Returns the arena string, or 0 after a stop. Cursor ends after the path.
char* parse_path_name(void) {
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "expected a name",
              "A path (`A::B`) starts with an identifier here.",
              "write the name",
              "geometry::length",
              p_cur());
        return 0;
    }
    lexbuf_reset();
    lexbuf_push_str(p_cur()->text);
    p_advance();
    while (p_at(TOK_DCOLON)) {
        p_advance();
        lexbuf_push_str("::");
        if (!p_at(TOK_IDENT)) {
            p_syn("SYN-05",
                  "`::` needs a name after it",
                  "A path segment must be an identifier: `mod::name`.",
                  "write the name",
                  "geometry::length",
                  p_cur());
            return 0;
        }
        lexbuf_push_str(p_cur()->text);
        p_advance();
    }
    return lexbuf_finish();
}

// Parses generic arguments `< targ { , targ } >` onto `onto->kids`.
// Returns 1, or 0 after a stop. The cursor must sit on `<`.
int parse_generic_args(struct AstNode* onto) {
    if (onto->kids == 0) { onto->kids = ast_list_new(); }
    p_advance();      // consume `<`
    if (p_eat_gt_split()) { return 1; }   // empty `<>`: tolerated, nothing to add
    while (1) {
        struct AstNode* targ;
        targ = parse_type();
        if (targ == 0) { return 0; }
        ast_list_push(onto->kids, targ);
        if (p_eat(TOK_COMMA)) { continue; }
        break;
    }
    if (!p_eat_gt_split()) {
        p_syn("SYN-05",
              "expected `>` to close the generic arguments",
              "Generic arguments close with `>`: Vec<i32>, Stack<T>, Vec<Vec<i32>> (nested closers split the >> token).",
              "add `>` to close the arguments",
              ">",
              p_cur());
        return 0;
    }
    return 1;
}

// parse_type (§18). Returns a type node, or 0 after a stop.
struct AstNode* parse_type_core(void) {
    struct AstNode* n;
    int start;

    start = p_cur()->start;

    // Reference: `&` [mut] [life(...)] type
    if (p_at(TOK_AMP)) {
        int is_mut;
        p_advance();
        is_mut = 0;
        if (p_at_kw("mut")) {
            p_advance();
            is_mut = 1;
        }
        n = ast_node_new(AST_TYPE_REF);
        n->start = start;
        n->ival = is_mut;
        n->sval = 0;
        // `life` is contextual (§4.2): spelled as an identifier here.
        if (p_at(TOK_IDENT) && str_eq(p_cur()->text, "life")
            && p_peek(1)->kind == TOK_LPAREN) {
            char* life;
            life = parse_life_use();
            if (life == 0) { return 0; }
            n->sval = life;
        }
        n->a = parse_type();
        if (n->a == 0) { return 0; }
        p_end_at(n, p_prev());
        return n;
    }

    // Raw pointer: `raw` [mut] type
    if (p_at_kw("raw")) {
        int is_mut;
        p_advance();
        is_mut = 0;
        if (p_at_kw("mut")) {
            p_advance();
            is_mut = 1;
        }
        n = ast_node_new(AST_TYPE_RAW);
        n->start = start;
        n->ival = is_mut;
        n->a = parse_type();
        if (n->a == 0) { return 0; }
        p_end_at(n, p_prev());
        return n;
    }

    // Array `[T; N]` or slice `[T]`
    if (p_at(TOK_LBRACKET)) {
        p_advance();
        n = ast_node_new(AST_TYPE_SLICE);
        n->start = start;
        n->a = parse_type();
        if (n->a == 0) { return 0; }
        if (p_eat(TOK_SEMI)) {
            n->kind = AST_TYPE_ARRAY;
            n->b = parse_expr();
            if (n->b == 0) { return 0; }
        }
        if (!p_expect(TOK_RBRACKET, "add `]` to close the type")) { return 0; }
        p_end_at(n, p_prev());
        return n;
    }

    // Path type: ID { :: ID } [ < targs > ]
    {
        char* name;
        name = parse_path_name();
        if (name == 0) { return 0; }
        n = ast_node_new(AST_TYPE_NAME);
        n->sval = name;
        n->start = start;
        if (p_at(TOK_LT)) {
            // In type position, `<` after a path is always generic arguments
            // (the expression grammar's `<`-is-comparison rule does not
            // apply to types; §18 note re one extra lookahead).
            if (!parse_generic_args(n)) { return 0; }
        }
        p_end_at(n, p_prev());
        return n;
    }
}

// The depth-guarded type entry point (see `p_depth_enter`). Nested type forms
// (`[[[[...`, `&&&&...`, `Box<Box<...>>`) all re-enter here.
struct AstNode* parse_type(void) {
    struct AstNode* n;
    if (p_depth_enter(p_cur())) { return 0; }
    n = parse_type_core();
    p_depth_leave();
    return n;
}

// ---------------------------------------------------------------------------
// Items (§18).
// ---------------------------------------------------------------------------

// fn params: ( params ) where param = self_param | [mut] ID ":" type,
// self_param = [mut] self | "&" [mut] self.
// Returns the params list (owned by the caller), or 0 after a stop.
struct AstList* parse_params(struct AstNode* onto) {
    struct AstList* list;
    list = ast_list_new();
    if (p_eat(TOK_RPAREN)) {
        return list;      // ()
    }
    while (!p_at(TOK_RPAREN) && !p_at(TOK_EOF)) {
        struct AstNode* prm;
        prm = 0;

        // self shapes: self | mut self | &self | &mut self
        if (p_at_kw("self")) {
            p_advance();
            prm = ast_node_new(AST_PARAM);
            prm->sval = "self";
            prm->start = p_prev()->start;
            prm->end = p_prev()->end;
        } else if (p_at_kw("mut") && p_peek_is_kw("self", 1)) {
            p_advance();      // mut
            p_advance();      // self
            prm = ast_node_new(AST_PARAM);
            prm->sval = "mut self";
            prm->start = p_prev()->start - 4;
            prm->end = p_prev()->end;
        } else if (p_at(TOK_AMP)) {
            struct Token* amp;
            amp = p_cur();
            p_advance();
            if (p_at_kw("mut") && p_peek_is_kw("self", 1)) {
                p_advance();      // mut
                p_advance();      // self
                prm = ast_node_new(AST_PARAM);
                prm->sval = "&mut self";
                prm->start = amp->start;
                prm->end = p_prev()->end;
            } else if (p_at_kw("self")) {
                p_advance();
                prm = ast_node_new(AST_PARAM);
                prm->sval = "&self";
                prm->start = amp->start;
                prm->end = p_prev()->end;
            } else {
                // Not a self shape after all: bare `mut`-less param like
                // `&` used as a type prefix cannot happen; recover by
                // reporting. (`&` here is always part of a self param.)
                p_syn("SYN-05",
                      "a parameter needs a name",
                      "Parameters are `name: type` pairs; `&` here only introduces `&self` or `&mut self`.",
                      "name the parameter",
                      "n: i32",
                      amp);
                return 0;
            }
        } else {
            // Ordinary param: [mut] ID ":" type
            int is_mut;
            is_mut = 0;
            if (p_at_kw("mut")) {
                p_advance();
                is_mut = 1;
            }
            if (!p_at(TOK_IDENT)) {
                p_syn("SYN-05",
                      "a parameter needs a name",
                      "Parameters are `name: type` pairs.",
                      "name the parameter",
                      "n: i32",
                      p_cur());
                return 0;
            }
            prm = ast_node_new(AST_PARAM);
            prm->sval = p_cur_word();
            prm->ival = is_mut;
            prm->start = p_cur()->start;
            p_advance();
            if (!p_expect(TOK_COLON, "add `: type` to the parameter")) { return 0; }
            prm->a = parse_type();
            if (prm->a == 0) { return 0; }
            prm->end = p_prev()->end;
        }
        ast_list_push(list, prm);
        if (p_eat(TOK_COMMA)) { continue; }
        break;
    }
    if (!p_expect(TOK_RPAREN, "add `)` to close the parameter list")) { return 0; }
    return list;
}

// True when token n ahead is the keyword `kw` (for param prefixes).
int p_peek_is_kw(char* kw, int n) {
    return tok_is_kw(p_peek(n), kw);
}

// fn generics: < gparam { , gparam } >  where gparam = `life` ID | ID [":" bound+]
// Bounds are recorded in a joined string on the param node (sval).
struct AstList* parse_generics(void) {
    struct AstList* list;
    list = ast_list_new();
    p_advance();      // consume `<`
    while (1) {
        struct AstNode* gp;
        // `life a` (contextual keyword context: generic lists, §4.2)
        if (p_at(TOK_IDENT) && str_eq(p_cur()->text, "life")) {
            gp = ast_node_new(AST_PARAM);
            gp->ival = 1;      // marks a life param
            p_advance();
            if (!p_at(TOK_IDENT)) {
                p_syn("SYN-05",
                      "a life parameter needs a name",
                      "`<life a>` declares a life parameter.",
                      "name the life",
                      "<life a>",
                      p_cur());
                return 0;
            }
            gp->sval = p_cur_word();
            p_advance();
            gp->start = 0;
            gp->end = 0;
            ast_list_push(list, gp);
        } else {
            int has_bounds;
            gp = ast_node_new(AST_PARAM);
            gp->ival = 0;
            if (!p_at(TOK_IDENT)) {
                p_syn("SYN-05",
                      "a generic parameter needs a name",
                      "`<T: copy + eq>` declares a type parameter with optional bounds.",
                      "name the parameter",
                      "<T: copy>",
                      p_cur());
                return 0;
            }
            gp->sval = p_cur_word();
            p_advance();
            has_bounds = 0;
            if (p_eat(TOK_COLON)) {
                lexbuf_reset();
                while (1) {
                    // `copy` is a keyword; `eq` and `ord` are bound names
                    // (plain identifiers, §5.8).
                    int is_bound;
                    is_bound = 0;
                    if (p_at_kw("copy")) { is_bound = 1; }
                    if (p_at(TOK_IDENT) && (str_eq(p_cur()->text, "eq")
                                            || str_eq(p_cur()->text, "ord"))) {
                        is_bound = 1;
                    }
                    if (!is_bound) {
                        p_syn("SYN-05",
                              "a bound must be copy, eq, or ord",
                              "Bounds are the compiler-known markers copy, eq, ord (5.8).",
                              "pick a bound",
                              "T: copy + ord",
                              p_cur());
                        return 0;
                    }
                    if (has_bounds) { lexbuf_push_str(" + "); }
                    lexbuf_push_str(p_cur()->text);
                    has_bounds = 1;
                    p_advance();
                    if (!p_eat(TOK_PLUS)) { break; }
                }
                gp->kids = ast_list_new();
                gp->kids2 = 0;
                gp->sval = str_concat(gp->sval, str_concat(":", lexbuf_finish()));
            }
            ast_list_push(list, gp);
        }
        if (p_eat(TOK_COMMA)) { continue; }
        break;
    }
    if (!p_eat_gt_split()) {
        p_syn("SYN-05",
              "expected `>` to close the generic parameter list",
              "Generic parameter lists close with `>`: <T, life a>.",
              "add `>` to close the list",
              ">",
              p_cur());
        return 0;
    }
    return list;
}

// fn_decl = [unchecked("...")] "fn" ID [generics] "(" params ")" [-> type] block
struct AstNode* parse_fn_decl(int unck, struct Token* start_tok) {
    struct AstNode* n;
    struct Token* start;
    start = start_tok;
    p_advance();      // fn
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "a function needs a name",
              "`fn name(params) -> type { body }`",
              "name the function",
              "fn main() {",
              p_cur());
        return 0;
    }
    n = ast_node_new(AST_FN);
    n->sval = p_cur_word();
    n->start = start->start;
    p_advance();
    if (p_at(TOK_LT)) {
        n->kids = parse_generics();
        if (n->kids == 0) { return 0; }
    }
    if (!p_expect(TOK_LPAREN, "add `(` for the parameters")) { return 0; }
    n->kids2 = parse_params(n);
    if (n->kids2 == 0) { return 0; }
    if (p_at(TOK_ARROW)) {
        p_advance();
        n->a = parse_type();
        if (n->a == 0) { return 0; }
    }
    if (unck) { n->ival = 1; }
    n->b = parse_block();
    if (n->b == 0) { return 0; }
    p_end_at(n, p_prev());
    return n;
}

// extern_decl = "extern" STRING "fn" ID "(" [params] ")" ["->" type] ";"
struct AstNode* parse_extern_fn(void) {
    struct AstNode* n;
    struct Token* start;
    struct Token* abi;
    start = p_cur();
    p_advance();      // extern
    // The ABI is part of the declaration, never an implicit default (§6.8):
    // the calling convention across the boundary is written down, so a reader
    // (and the compiler) never has to guess it.
    if (!p_at(TOK_STRING)) {
        p_syn("SYN-05",
              "a foreign function needs an ABI",
              "`extern` must name the calling convention: `extern \"C\" fn ...`.",
              "add the ABI",
              "extern \"C\" fn abs(x: i32) -> i32;",
              p_cur());
        return 0;
    }
    abi = p_cur();
    p_advance();
    if (!p_eat_kw("fn")) {
        p_syn("SYN-05",
              "`extern \"C\" fn` declares a foreign function",
              "`extern \"C\" fn name(params) -> type;` — external declarations end with `;`, no body.",
              "write the declaration",
              "extern \"C\" fn abs(x: i32) -> i32;",
              p_cur());
        return 0;
    }
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "a foreign function needs a name",
              "`extern \"C\" fn name(params) -> type;`",
              "name the function",
              "extern \"C\" fn abs(x: i32) -> i32;",
              p_cur());
        return 0;
    }
    n = ast_node_new(AST_EXTERN_FN);
    n->sval = p_cur_word();
    n->abi = abi->sval;   // the ABI string, cooked ("C")
    n->ival = abi->start; // byte offset of the ABI string (for diagnostics)
    n->start = start->start;
    p_advance();
    if (!p_expect(TOK_LPAREN, "add `(` for the parameters")) { return 0; }
    n->kids2 = parse_params(n);
    if (n->kids2 == 0) { return 0; }
    if (p_at(TOK_ARROW)) {
        p_advance();
        n->a = parse_type();
        if (n->a == 0) {
            return 0;
        }
    }
    if (!p_expect_semi()) { return 0; }
    p_end_at(n, p_prev());
    return n;
}

// const_decl = "const" ID ":" type "=" expr ";"
struct AstNode* parse_const_decl(int is_export) {
    struct AstNode* n;
    struct Token* start;
    start = p_cur();
    p_advance();      // const
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "a constant needs a name",
              "`const NAME: type = value;` (6.2)",
              "name the constant",
              "const MAX: i32 = 8;",
              p_cur());
        return 0;
    }
    n = ast_node_new(AST_CONST);
    n->sval = p_cur_word();
    n->ival = is_export;
    n->start = start->start;
    p_advance();
    if (!p_expect(TOK_COLON, "add `: type` to the constant")) { return 0; }
    n->a = parse_type();
    if (n->a == 0) { return 0; }
    if (!p_expect(TOK_ASSIGN, "add `= value` to the constant")) { return 0; }
    n->b = parse_expr();
    if (n->b == 0) { return 0; }
    if (!p_expect_semi()) { return 0; }
    p_end_at(n, p_prev());
    return n;
}

// struct_decl = [copy] "struct" ID [generics] { { field } }
struct AstNode* parse_struct_decl(int is_copy) {
    struct AstNode* n;
    struct Token* start;
    int start_off;
    start = p_cur();
    start_off = start->start;
    p_advance();      // struct
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "a struct needs a name",
              "`struct Name { field: type; }`",
              "name the struct",
              "struct Point { x: i32; y: i32; }",
              p_cur());
        return 0;
    }
    n = ast_node_new(AST_STRUCT);
    n->sval = p_cur_word();
    n->ival = is_copy;
    n->start = start_off;
    p_advance();
    if (p_at(TOK_LT)) {
        n->kids = parse_generics();
        if (n->kids == 0) { return 0; }
    }
    if (!p_expect(TOK_LBRACE, "add `{` to open the struct body")) { return 0; }
    n->kids2 = ast_list_new();
    while (!p_at(TOK_RBRACE) && !p_at(TOK_EOF)) {
        struct AstNode* f;
        f = ast_node_new(AST_FIELD);
        if (!p_at(TOK_IDENT)) {
            p_syn("SYN-05",
                  "a field needs a name",
                  "Fields are `name: type;` (§6.4).",
                  "name the field",
                  "x: i32;",
                  p_cur());
            return 0;
        }
        f->sval = p_cur_word();
        f->start = p_cur()->start;
        p_advance();
        if (!p_expect(TOK_COLON, "add `: type` to the field")) { return 0; }
        f->a = parse_type();
        if (f->a == 0) { return 0; }
        if (!p_expect_semi()) { return 0; }
        f->end = p_prev()->end;
        f->file = 0;
        ast_list_push(n->kids2, f);
    }
    if (!p_expect(TOK_RBRACE, "add `}` to close the struct")) { return 0; }
    p_end_at(n, p_prev());
    return n;
}

// enum_decl = [copy] "enum" ID [generics] { variant { , variant } [ , ] }
struct AstNode* parse_enum_decl(int is_copy) {
    struct AstNode* n;
    struct Token* start;
    start = p_cur();
    p_advance();      // enum
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "an enum needs a name",
              "`enum Name { Variant, ... }`",
              "name the enum",
              "copy enum Shape { Circle(f64), Rect(f64, f64), Dot, }",
              p_cur());
        return 0;
    }
    n = ast_node_new(AST_ENUM);
    n->sval = p_cur_word();
    n->ival = is_copy;
    n->start = start->start;
    p_advance();
    if (p_at(TOK_LT)) {
        n->kids = parse_generics();
        if (n->kids == 0) { return 0; }
    }
    if (!p_expect(TOK_LBRACE, "add `{` to open the enum body")) { return 0; }
    n->kids2 = ast_list_new();
    while (!p_at(TOK_RBRACE) && !p_at(TOK_EOF)) {
        struct AstNode* v;
        v = ast_node_new(AST_VARIANT);
        if (!p_at(TOK_IDENT)) {
            p_syn("SYN-05",
                  "a variant needs a name",
                  "Variants are `Name` or `Name(type, ...)`.",
                  "name the variant",
                  "Circle(f64),",
                  p_cur());
            return 0;
        }
        v->sval = p_cur_word();
        v->start = p_cur()->start;
        p_advance();
        // Optional payload: "(" type { , type } ")"
        if (p_eat(TOK_LPAREN)) {
            v->kids = ast_list_new();
            while (1) {
                struct AstNode* pt;
                pt = parse_type();
                if (pt == 0) { return 0; }
                ast_list_push(v->kids, pt);
                if (p_eat(TOK_COMMA)) { continue; }
                break;
            }
            if (!p_expect(TOK_RPAREN, "add `)` to close the payload list")) {
                return 0;
            }
        }
        v->end = p_prev()->end;
        ast_list_push(n->kids2, v);
        if (!p_eat(TOK_COMMA)) { break; }
    }
    if (!p_expect(TOK_RBRACE, "add `}` to close the enum")) { return 0; }
    p_end_at(n, p_prev());
    return n;
}

// methods_block = "methods" [generics] type { { [export] fn_decl } }
// Sweeps the `<...>` in a methods type header (`methods<T> Stack<T>`).
// Returns 1, or 0 after a stop.
int methods_type_args(struct AstNode* onto);   // fwd decl

struct AstNode* parse_methods_block(void) {
    struct AstNode* n;
    struct Token* start;
    start = p_cur();
    p_advance();      // methods
    n = ast_node_new(AST_METHODS);
    n->start = start->start;
    if (p_at(TOK_LT)) {
        n->kids = parse_generics();
        if (n->kids == 0) { return 0; }
    }
    // The type: a path with optional generic args (`methods<T> Stack<T>`).
    if (!p_at(TOK_IDENT)) {
        p_syn("SYN-05",
              "`methods` needs a type name",
              "`methods Type { ... }` adds methods to a type in the same module (6.6).",
              "write the type name",
              "methods Counter { ... }",
              p_cur());
        return 0;
    }
    n->sval = parse_path_name();
    if (n->sval == 0) { return 0; }
    if (p_at(TOK_LT)) {
        // Sweep `<...>` args directly (a methods type header is type-like).
        if (!methods_type_args(n)) { return 0; }
    }
    if (!p_expect(TOK_LBRACE, "add `{` to open the methods block")) { return 0; }
    n->kids2 = ast_list_new();
    while (!p_at(TOK_RBRACE) && !p_at(TOK_EOF)) {
        struct AstNode* f;
        int is_export;
        is_export = 0;
        if (p_eat_kw("export")) { is_export = 1; }
        if (!p_at_kw("fn")) {
            p_syn("SYN-05",
                  "only `fn` declarations live in a methods block",
                  "A methods block holds `[export] fn name(...) { ... }` (6.6).",
                  "write a function",
                  "export fn bump(&mut self) { ... }",
                  p_cur());
            return 0;
        }
        f = parse_fn_decl(0, p_cur());
        if (f == 0) { return 0; }
        f->ival = is_export;
        ast_list_push(n->kids2, f);
    }
    if (!p_expect(TOK_RBRACE, "add `}` to close the methods block")) { return 0; }
    p_end_at(n, p_prev());
    return n;
}

// Sweeps the `<...>` in a methods type header (`methods<T> Stack<T>`).
// Returns 1, or 0 after a stop.
int methods_type_args(struct AstNode* onto) {
    p_advance();      // consume `<`
    while (1) {
        struct AstNode* targ;
        targ = parse_type();
        if (targ == 0) { return 0; }
        // The receiver's type arguments go into `kids3`: `kids` holds the
        // block's own generics and `kids2` holds the function list, so this is
        // the only free slot. Writing them into `kids2` (as this used to) lost
        // them the moment the function list was built, and the stray empty
        // `kids` list made the block look generic.
        if (onto->kids3 == 0) { onto->kids3 = ast_list_new(); }
        ast_list_push(onto->kids3, targ);
        if (p_eat(TOK_COMMA)) { continue; }
        break;
    }
    if (!p_expect(TOK_GT, "add `>` to close the type arguments")) { return 0; }
    return 1;
}
