// harmony-base — pipeline (docs/harmony.md §19.1).
//
// M0 wires: load source -> lex -> parse -> flush diagnostics. Codegen and the
// checker passes are stubbed and added in later milestones (§19.7).

int pipeline_run(struct Options* opts) {
    struct SourceFile* sf;
    struct AstNode* root;

    arena_reset();
    lexbuf_release();
    diag_reset();

    // Stage 1+2+3: load the root module plus everything it imports, merged
    // into one flat item list (module.c2). A single-file program with no
    // imports flows through the same path (zero extra modules).
    // `--dump-ast` is a parser round-trip tool: it skips import resolution
    // entirely (a fictional `import "std/io.src";` still parses — the check
    // that the file exists belongs to the compilation commands, not the
    // parse-tree dump).
    if (opts->dump_ast || opts->dump_tokens) {
        struct SourceFile* dsf;
        struct Token* toks;
        int ntoks;
        dsf = (struct SourceFile*) arena_alloc(64);
        if (source_load(opts->input, dsf) != 0) {
            diag_plain("source.not-found", opts->input);
            return EXIT_USAGE;
        }
        diag_register_file(dsf);
        ntoks = lexer_run(dsf, &toks);
        if (ntoks < 0) {
            diag_flush(opts->format, opts->all);
            return EXIT_STOP;
        }
        // `--dump-tokens` stops right here: it is the lexer's differential
        // oracle, so it must not depend on the parser accepting the file.
        if (opts->dump_tokens) {
            tokdump_run(dsf, toks, ntoks);
            return EXIT_OK;
        }
        root = parser_run(dsf, toks, ntoks);
        if (root == 0 || parser_stop_count() > 0) {
            diag_flush(opts->format, opts->all);
            return EXIT_STOP;
        }
        sf = dsf;
    } else {
        root = module_program(opts);
        if (root == 0) {
            // module_program reported the plain error. An unreadable root
            // file is a usage error (exit 2); lex/parse stops inside it are
            // not (they flow through the checks below and exit 1).
            if (mod_io_failed()) { return EXIT_USAGE; }
        }
        if (mod_failed() || parser_stop_count() > 0) {
            // Import or syntax stops were reported; flush and stop.
            diag_flush(opts->format, opts->all);
            return EXIT_STOP;
        }
        // The root module's registered source file (module 0).
        sf = diag_file(0);
    }

    if (opts->verbose) {
        err_str("harmony-base: parsed ");
        err_int(ast_list_len(root->kids));
        err_str(" items");
        err_nl();
    }

    // --dump-ast: print the parse tree to stdout (M0 round-trip tests;
    // byte-deterministic, a pure function of the tree).
    if (opts->dump_ast) {
        ast_print(root);
    }

    // Stage 4: the type checker (§19.1). Runs for every command that needs
    // to understand the program; `--dump-ast` skips it so the parse tree can
    // be inspected even when the program does not type-check yet.
    if (!opts->dump_ast) {
        ck_set_deny_unchecked(opts->deny_unchecked);
        check_program(root);
        if (opts->verbose) {
            err_str("harmony-base: checked ");
            err_int(diag_stop_count());
            err_str(" stop(s)");
            err_nl();
        }
    }

    // Emission stages (§19.1 stage 9). `emit-llvm`/`build`/`run` now have a
    // working LLVM backend for the M1 slice; `emit-c` is M7 (§19.4b).
    if (opts->cmd == CMD_EMIT_LLVM || opts->cmd == CMD_BUILD || opts->cmd == CMD_RUN) {
        if (diag_stop_count() > 0) {
            diag_flush(opts->format, opts->all);
            return EXIT_STOP;
        }
        return emit_command(opts, root);
    }
    if (opts->cmd == CMD_EMIT_C) {
        int idx;
        idx = diag_stop("ICE-01",
                        "the C backend is not implemented in this build yet",
                        "The C backend (`emit-c`) is the cross-check backend and lands with milestone M7 (§19.4b). The LLVM path (`emit-llvm`, `build`, `run`) works today.",
                        sf, 0, 1);
        if (idx >= 0) {
            diag_fix(diag_get(idx), "use the LLVM backend", "harmony-base emit-llvm main.harmony");
        }
    }

    // Flush stored diagnostics (only stops/warns render; a clean build
    // prints nothing at all, §16.6).
    diag_flush(opts->format, opts->all);

    if (diag_stop_count() > 0) { return EXIT_STOP; }
    if (opts->strict && diag_warn_count() > 0) { return EXIT_STOP; }
    return EXIT_OK;
}
