// harmony-base — diagnostic catalogue: `explain` lessons and the `audit`
// listing (docs/harmony.md §16.8, §13.6).
//
// `harmony-base explain <CODE>` prints the long-form lesson for a diagnostic
// code: WHAT/WHY/BAD/GOOD/NOTE/SEE (§16.8). The lessons live next to the
// compiler so the documentation cannot drift from the binary that renders it.
//
// The `audit` command lives in audit.c2 (it runs the lexer/parser, which the
// explain catalogue does not need).

const char* EXPLAIN_HEADER =
"WHAT   A %s\n";

// The lesson template: WHAT/WHY/BAD/GOOD/NOTE/SEE (§16.8).
void explain_page(char* code) {
    out_str(code);
    out_nl();
    out_nl();
    out_str("WHAT   This diagnostic code exists but its long-form lesson has\n");
    out_str("       not been written for this build yet.\n");
    out_str("WHY    Stable codes, one lesson each (docs/harmony.md 16.8).\n");
    out_str("SEE    docs/harmony.md - 16.10 Code catalogue\n");
    out_nl();
}

// One lesson per code. The driver-level codes get real lessons now; the
// language codes gain theirs as the analyses land.
void explain_page_compiler(void) {
    out_str("ICE-01 - the compiler broke its own rules\n");
    out_nl();
    out_str("WHAT   The compiler hit a condition it promises is unreachable:\n");
    out_str("       a stage failed before its output could be produced.\n");
    out_str("WHY    The compiler's job is a verdict for every input; bail-outs\n");
    out_str("       mean a bug in the compiler, not in your program.\n");
    out_str("BAD    any input that ends in a compiler crash\n");
    out_str("GOOD   the same input getting a diagnostic, or compiling\n");
    out_str("NOTE   Please report it: the source that triggered it is the\n");
    out_str("       most useful thing you can attach.\n");
    out_str("SEE    docs/harmony.md - 16.10 Code catalogue\n");
    out_nl();
}

// Returns 1 when `code` is recognized by this build.
int explain_known(char* code) {
    return str_eq(code, "ICE-01")
        || str_eq(code, "SYN-01")
        || str_eq(code, "SYN-02")
        || str_eq(code, "SYN-03")
        || str_eq(code, "SYN-04")
        || str_eq(code, "SYN-05")
        || str_eq(code, "LEX-01")
        || str_eq(code, "NAME-02")
        || str_eq(code, "USE-01")
        || str_eq(code, "CFG-01")
        || str_eq(code, "FFI-01")
        || str_eq(code, "CONST-01");
}

// SYN-01: conditions need parentheses (§8.1).
void explain_syn01(void) {
    out_str("SYN-01 - the condition needs parentheses\n");
    out_nl();
    out_str("WHAT   if, while, for, and switch write their condition in\n");
    out_str("       parentheses, C-style. This keeps `Point { .x = 1 }` and\n");
    out_str("       other brace forms unambiguous inside a condition.\n");
    out_str("WHY    Conditions in `if (x > 5) { ... }` read the same as C;\n");
    out_str("       the grammar never guesses where a condition ends.\n");
    out_str("BAD    if x > 5 { return; }\n");
    out_str("GOOD   if (x > 5) { return; }\n");
    out_str("NOTE   The braces around the body are not optional either\n");
    out_str("       (SYN-02). Two small rules, no surprises later.\n");
    out_str("SEE    docs/harmony.md - 8.1, 16.10 Code catalogue\n");
    out_nl();
}

// SYN-02: bodies need braces.
void explain_syn02(void) {
    out_str("SYN-02 - the body needs braces\n");
    out_nl();
    out_str("WHAT   Every if/else/while/for/switch body is a braced block.\n");
    out_str("       There is no single-statement form.\n");
    out_str("WHY    The goto-fail bug class (Apple's `goto fail;`) came from a\n");
    out_str("       brace-less body. Mandatory braces make that mistake\n");
    out_str("       impossible to write and invisible to diffs.\n");
    out_str("BAD    if (x) return;\n");
    out_str("GOOD   if (x) { return; }\n");
    out_str("NOTE   There is no `loop` keyword; `while (true) { ... }` is the\n");
    out_str("       infinite loop, with `break` to leave.\n");
    out_str("SEE    docs/harmony.md - 8.1, 16.10 Code catalogue\n");
    out_nl();
}

// SYN-03: assignment as a condition.
void explain_syn03(void) {
    out_str("SYN-03 - assignment used as a condition\n");
    out_nl();
    out_str("WHAT   `=` assigns; it is a statement form and cannot appear\n");
    out_str("       inside a condition.\n");
    out_str("WHY    `if (x = 5)` compiles in C and silently overwrites x.\n");
    out_str("       Here the grammar cannot express it, so the stop fires at\n");
    out_str("       the `=` itself.\n");
    out_str("BAD    if (x = 5) { ... }\n");
    out_str("GOOD   if (x == 5) { ... }\n");
    out_str("NOTE   All compound assignments (+=, -=, ...) are statements too.\n");
    out_str("SEE    docs/harmony.md - 8.1, 16.10 Code catalogue\n");
    out_nl();
}

// SYN-04: missing semicolon.
void explain_syn04(void) {
    out_str("SYN-04 - missing `;`\n");
    out_nl();
    out_str("WHAT   Simple statements (let, assignment, expression, return,\n");
    out_str("       break, continue) end with `;`. Block statements (if,\n");
    out_str("       while, for, switch, unchecked, bare `{ }`) do not.\n");
    out_str("WHY    The rule from C, minus its exceptions: one look at the\n");
    out_str("       line ending tells you whether the statement continues.\n");
    out_str("BAD    let n = 5\n");
    out_str("GOOD   let n = 5;\n");
    out_str("NOTE   Struct fields also end with `;`; enum variants and struct\n");
    out_str("       initializer fields are `,`-separated (trailing comma ok).\n");
    out_str("SEE    docs/harmony.md - 4.4, 16.10 Code catalogue\n");
    out_nl();
}

// SYN-05: unexpected token.
void explain_syn05(void) {
    out_str("SYN-05 - unexpected token\n");
    out_nl();
    out_str("WHAT   This token does not fit the grammar at this position (or\n");
    out_str("       a delimiter is unbalanced).\n");
    out_str("WHY    One honest stop at the exact byte beats a cascade; the\n");
    out_str("       parser recovers at the next `;` or `}` and keeps going, so\n");
    out_str("       several mistakes are reported per run.\n");
    out_str("BAD    fn main() { return; )\n");
    out_str("GOOD   fn main() { return; }\n");
    out_str("NOTE   Nested generics close the `>>` cleanly: Vec<Vec<i32>>.\n");
    out_str("       Comparisons do not chain: write `a < b && b < c`.\n");
    out_str("SEE    docs/harmony.md - 18, 16.10 Code catalogue\n");
    out_nl();
}

// LEX-01: malformed literal or unterminated comment.
void explain_lex01(void) {
    out_str("LEX-01 - malformed literal or comment\n");
    out_nl();
    out_str("WHAT   A literal (number, char, byte, string) or a block comment\n");
    out_str("       is not written in one of the legal forms.\n");
    out_str("WHY    The token the rest of the compiler would see does not\n");
    out_str("       exist, so naming the exact bytes is cheaper than a\n");
    out_str("       confusing parse error downstream.\n");
    out_str("BAD    'ab   1_000_   42q   \\q   \"unterminated   /* unclosed\n");
    out_str("GOOD   'a'   1_000    42u8   \\n   \"closed\"       /* closed */\n");
    out_str("NOTE   Numbers: `42`, `1_000_000`, `0xFF`, `0o17`, `0b1010`, a\n");
    out_str("       suffix from the primitive types (42u8). Chars hold one\n");
    out_str("       Unicode scalar: '\\n', '\\u{1F980}'. b'...' holds one byte.\n");
    out_str("       Block comments nest.\n");
    out_str("SEE    docs/harmony.md - 4.3, 16.10 Code catalogue\n");
    out_nl();
}

// FFI-01: an ABI the backend does not implement (§6.8).
void explain_ffi01(void) {
    out_str("FFI-01 - unknown ABI\n");
    out_nl();
    out_str("WHAT   An `extern` declaration names the calling convention\n");
    out_str("       it uses, in a string: `extern \"C\" fn ...`.\n");
    out_str("WHY    The convention decides how arguments are passed, who\n");
    out_str("       cleans the stack, and where the return value lands.\n");
    out_str("       Only the C ABI is implemented, so any other name is a\n");
    out_str("       promise the compiler cannot keep.\n");
    out_str("BAD    extern \"Win64\" fn abs(x: i32) -> i32;\n");
    out_str("GOOD   extern \"C\" fn abs(x: i32) -> i32;\n");
    out_str("NOTE   The ABI string is mandatory: `extern fn ...` without\n");
    out_str("       one is a syntax error (SYN-05), never a default.\n");
    out_str("SEE    docs/harmony.md - 6.8, 16.10 Code catalogue\n");
    out_nl();
}

// CONST-01: a `const` initializer that is not a compile-time constant (§6.2).
void explain_const01(void) {
    out_str("CONST-01 - not a compile-time constant\n");
    out_nl();
    out_str("WHAT   A `const` is inlined at every use site, so its value must\n");
    out_str("       be known when the program is compiled.\n");
    out_str("WHY    There is no storage for a constant to read at run time;\n");
    out_str("       the initializer is copied into each use. A value that\n");
    out_str("       depends on run-time work cannot be inlined.\n");
    out_str("BAD    const N: i32 = compute();\n");
    out_str("GOOD   const N: i32 = 42;   let n = compute();\n");
    out_str("NOTE   Literals, arithmetic on literals, other constants, and\n");
    out_str("       array/struct literals are all allowed.\n");
    out_str("SEE    docs/harmony.md - 6.2, 16.10 Code catalogue\n");
    out_nl();
}

int explain_lookup(char* code) {
    if (!explain_known(code)) { return -1; }
    if (str_eq(code, "ICE-01")) {
        explain_page_compiler();
        return 0;
    }
    if (str_eq(code, "SYN-01")) { explain_syn01(); return 0; }
    if (str_eq(code, "SYN-02")) { explain_syn02(); return 0; }
    if (str_eq(code, "SYN-03")) { explain_syn03(); return 0; }
    if (str_eq(code, "SYN-04")) { explain_syn04(); return 0; }
    if (str_eq(code, "SYN-05")) { explain_syn05(); return 0; }
    if (str_eq(code, "LEX-01")) { explain_lex01(); return 0; }
    if (str_eq(code, "FFI-01")) { explain_ffi01(); return 0; }
    if (str_eq(code, "CONST-01")) { explain_const01(); return 0; }
    // The remaining codes currently share the stub lesson; each gets its
    // own WHAT/WHY/BAD/GOOD text as the stage that emits it lands.
    explain_page(code);
    return 0;
}
