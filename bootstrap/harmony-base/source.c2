// harmony-base — source manager.

int source_load(char* path, struct SourceFile* out) {
    int fd;
    int cap;
    int total;
    int n;
    char* buf;
    int* starts;
    int nl;
    int i;

    fd = syscall_open(path, O_RDONLY, 0);
    if (fd < 0) { return fd; }

    // Read the whole file into a growable arena buffer. Start at 64 KiB and
    // double on demand.
    cap = 65536;
    buf = arena_alloc(cap);
    total = 0;
    while (1) {
        if (total + 1 >= cap) {
            int ncap;
            char* nbuf;
            ncap = cap * 2;
            nbuf = arena_alloc(ncap);
            i = 0;
            while (i < total) { nbuf[i] = buf[i]; i = i + 1; }
            buf = nbuf;
            cap = ncap;
        }
        n = syscall_read(fd, &buf[total], cap - total - 1);
        if (n < 0) { syscall_close(fd); return n; }
        if (n == 0) { break; }
        total = total + n;
    }
    syscall_close(fd);
    buf[total] = 0;

    out->path = path;
    out->data = buf;
    out->len = total;

    // Count lines, then record each line's start offset.
    nl = 1;
    i = 0;
    while (i < total) {
        if (buf[i] == 10) { nl = nl + 1; }
        i = i + 1;
    }
    starts = arena_alloc((nl + 1) * 8);
    starts[0] = 0;
    nl = 1;
    i = 0;
    while (i < total) {
        if (buf[i] == 10) {
            starts[nl] = i + 1;
            nl = nl + 1;
        }
        i = i + 1;
    }
    // Trailing sentinel so off == len maps to the last line's end.
    starts[nl] = total;
    out->line_starts = starts;
    out->line_count = nl;
    return 0;
}

void source_line_col(struct SourceFile* sf, int off, int* line, int* col) {
    int lo;
    int hi;
    int mid;
    int idx;
    if (off < 0) { off = 0; }
    if (off > sf->len) { off = sf->len; }
    // Binary search for the greatest line start <= off.
    lo = 0;
    hi = sf->line_count - 1;
    idx = 0;
    while (lo <= hi) {
        mid = (lo + hi) / 2;
        if (sf->line_starts[mid] <= off) {
            idx = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    *line = idx + 1;
    *col = off - sf->line_starts[idx];
}

char* source_line(struct SourceFile* sf, int line) {
    int start;
    int end;
    int i;
    char* p;
    if (line < 1 || line > sf->line_count) { return ""; }
    start = sf->line_starts[line - 1];
    if (line < sf->line_count) {
        end = sf->line_starts[line];
    } else {
        end = sf->len;
    }
    // Trim a trailing newline / carriage return.
    while (end > start && (sf->data[end - 1] == 10 || sf->data[end - 1] == 13)) {
        end = end - 1;
    }
    p = arena_alloc(end - start + 1);
    i = 0;
    while (start + i < end) { p[i] = sf->data[start + i]; i = i + 1; }
    p[end - start] = 0;
    return p;
}
