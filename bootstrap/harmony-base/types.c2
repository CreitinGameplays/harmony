// harmony-base — the type model (docs/harmony.md §5).
//
// Types are small integer ids. The primitives get fixed ids (TY_I8..TY_UNIT)
// so several modules can compare them without a lookup. Composite types are
// created on demand and get ids starting at TY_DYNAMIC. The table grows by
// doubling and lives in the arena, like every other structure here.
//
// Layout note: the tables are FLAT arrays of structs indexed by id, not
// arrays of pointers — `g_types[id].kind` and
// `g_members[g_types[id].mstart + i].ty` are the only access shapes, which
// keeps the seed's struct-array indexing path (the well-tested one) in play.
// The harmony *language* layout (ty_size / ty_align / ty_field_offset) is
// computed here from the resolved member types; those are the numbers the
// LLVM backend emits.

// ---------------------------------------------------------------------------
// Align up (no libc).
// ---------------------------------------------------------------------------
int align_up(int n, int a) {
    if (a <= 1) { return n; }
    return (n + a - 1) & (0 - a);
}

// ---------------------------------------------------------------------------
// Member and type-table storage.
// ---------------------------------------------------------------------------
struct TyMember {
    char* name;     // field name / variant name
    int   ty;       // field type, or (for a variant) its payload struct type
    int   ival;     // reserved (flags)
    int   pad;      // keep the record 4 qwords wide
};

struct TypeEntry {
    int   kind;       // primitive id, or CTY_* for composites
    int   a;          // element / pointee / payload element
    int   b;          // array length
    char* name;       // display name ("i32", "Point", "Shape::Circle")
    int   mstart;     // first member index in g_members
    int   nmembers;   // struct fields / enum variants
    struct AstNode* decl;   // the decl node (0 for built-ins)
    int   size;       // cached byte size (0 = not yet computed)
    int   align;      // cached alignment
    int   nocopy;     // 1 = owns a resource (never copy) — M2 drop glue
    int   is_computing;  // re-entrancy guard while computing size
};

struct TypeEntry* g_types;    // flat array, indexed by type id; [0] unused
int g_ntypes;
int g_tcap;

struct TyMember* g_members;   // flat array, contiguous per type
int g_nmembers;
int g_mcap;

// Creates an empty entry at the next id.
int ty_alloc(void) {
    struct TypeEntry* nt;
    int i;
    if (g_ntypes >= g_tcap) {
        g_tcap = g_tcap * 2;
        nt = (struct TypeEntry*) arena_alloc(g_tcap * 96);
        i = 0;
        while (i < g_ntypes) {
            nt[i].kind = g_types[i].kind;
            nt[i].a = g_types[i].a;
            nt[i].b = g_types[i].b;
            nt[i].name = g_types[i].name;
            nt[i].mstart = g_types[i].mstart;
            nt[i].nmembers = g_types[i].nmembers;
            nt[i].decl = g_types[i].decl;
            nt[i].size = g_types[i].size;
            nt[i].align = g_types[i].align;
            nt[i].nocopy = g_types[i].nocopy;
            nt[i].is_computing = g_types[i].is_computing;
            i = i + 1;
        }
        g_types = nt;
    }
    g_types[g_ntypes].kind = 0;
    g_types[g_ntypes].a = 0;
    g_types[g_ntypes].b = 0;
    g_types[g_ntypes].name = 0;
    g_types[g_ntypes].mstart = g_nmembers;
    g_types[g_ntypes].nmembers = 0;
    g_types[g_ntypes].decl = 0;
    g_types[g_ntypes].size = 0;
    g_types[g_ntypes].align = 0;
    g_types[g_ntypes].nocopy = 0;
    g_types[g_ntypes].is_computing = 0;
    g_ntypes = g_ntypes + 1;
    return g_ntypes - 1;
}

// Clears the tables for a fresh compilation (called once per program).
// Both tables start with real capacity: the grow path doubles, and doubling
// from zero would allocate nothing (and then index through a null pointer).
void types_reset(void) {
    int i;
    g_ntypes = 0;
    g_nmembers = 0;
    g_tcap = 128;
    g_mcap = 64;
    g_types = (struct TypeEntry*) arena_alloc(g_tcap * 96);
    g_members = (struct TyMember*) arena_alloc(g_mcap * 32);
    // Slot 0 stays unused (TY_INVALID) so id 0 never means a real type.
    ty_alloc();
    // Zero the gap between the fixed primitive ids and TY_DYNAMIC so a stray
    // id there reads as "no type" rather than whatever the arena held.
    i = TY_UNIT + 1;
    while (i < TY_DYNAMIC) { g_types[i].kind = 0; g_types[i].name = 0; i = i + 1; }
    // The untyped literal types are real ids so ty_display/ty_eq work on
    // them like any other type (§5.9: they adapt to the context's type).
    g_types[TY_UINT_LIT].kind = CTY_UINT_LIT;
    g_types[TY_UINT_LIT].name = "integer literal";
    g_types[TY_FLOAT_LIT].kind = CTY_FLOAT_LIT;
    g_types[TY_FLOAT_LIT].name = "float literal";
    // Primitive entries: kind = the id itself, plus display names.
    g_types[TY_I8].kind = TY_I8;       g_types[TY_I8].name = "i8";
    g_types[TY_I16].kind = TY_I16;     g_types[TY_I16].name = "i16";
    g_types[TY_I32].kind = TY_I32;     g_types[TY_I32].name = "i32";
    g_types[TY_I64].kind = TY_I64;     g_types[TY_I64].name = "i64";
    g_types[TY_ISIZE].kind = TY_ISIZE; g_types[TY_ISIZE].name = "isize";
    g_types[TY_U8].kind = TY_U8;       g_types[TY_U8].name = "u8";
    g_types[TY_U16].kind = TY_U16;     g_types[TY_U16].name = "u16";
    g_types[TY_U32].kind = TY_U32;     g_types[TY_U32].name = "u32";
    g_types[TY_U64].kind = TY_U64;     g_types[TY_U64].name = "u64";
    g_types[TY_USIZE].kind = TY_USIZE; g_types[TY_USIZE].name = "usize";
    g_types[TY_F32].kind = TY_F32;     g_types[TY_F32].name = "f32";
    g_types[TY_F64].kind = TY_F64;     g_types[TY_F64].name = "f64";
    g_types[TY_BOOL].kind = TY_BOOL;   g_types[TY_BOOL].name = "bool";
    g_types[TY_CHAR].kind = TY_CHAR;   g_types[TY_CHAR].name = "char";
    g_types[TY_NEVER].kind = TY_NEVER; g_types[TY_NEVER].name = "never";
    g_types[TY_UNIT].kind = TY_UNIT;   g_types[TY_UNIT].name = "()";
    // The primitive ids are fixed and always "exist"; the first *dynamic*
    // type id is TY_DYNAMIC, so bump the count past the primitives.
    g_ntypes = TY_DYNAMIC;
}

// Appends a member to the flat member array. A type's members must be
// contiguous, so the start index is captured at the *first* add (payload
// construction can interleave with other types' member arrays).
void ty_add_member(int id, char* name, int ty) {
    struct TyMember* nm;
    int i;
    if (g_nmembers >= g_mcap) {
        g_mcap = g_mcap * 2;
        nm = (struct TyMember*) arena_alloc(g_mcap * 32);
        i = 0;
        while (i < g_nmembers) {
            nm[i].name = g_members[i].name;
            nm[i].ty = g_members[i].ty;
            nm[i].ival = g_members[i].ival;
            i = i + 1;
        }
        g_members = nm;
    }
    if (g_types[id].nmembers == 0) {
        g_types[id].mstart = g_nmembers;   // first member: fix the start here
    }
    g_members[g_nmembers].name = name;
    g_members[g_nmembers].ty = ty;
    g_members[g_nmembers].ival = 0;
    g_nmembers = g_nmembers + 1;
    g_types[id].nmembers = g_types[id].nmembers + 1;
}

int ty_new(int kind, char* name, int a, int b) {
    int id;
    id = ty_alloc();
    g_types[id].kind = kind;
    g_types[id].name = name;
    g_types[id].a = a;
    g_types[id].b = b;
    return id;
}

// As ty_new, but records the originating decl node (used for nominal types).
int ty_new_typed(int kind, char* name, struct AstNode* decl) {
    int id;
    id = ty_alloc();
    g_types[id].kind = kind;
    g_types[id].name = name;
    g_types[id].decl = decl;
    return id;
}

int ty_kind(int id) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    return g_types[id].kind;
}

char* ty_display(int id) {
    if (id <= 0 || id >= g_ntypes) { return "?"; }
    if (g_types[id].name == 0) {
        // Untyped literals have no declared name; show what they are.
        if (g_types[id].kind == CTY_UINT_LIT) { return "integer"; }
        if (g_types[id].kind == CTY_FLOAT_LIT) { return "float"; }
        return "?";
    }
    return g_types[id].name;
}

// ---------------------------------------------------------------------------
// Primitive predicates.
// ---------------------------------------------------------------------------
int ty_is_primitive(int id) {
    return id >= TY_I8 && id <= TY_UNIT;
}

int ty_is_integer(int id) {
    if (id >= TY_I8 && id <= TY_ISIZE) { return 1; }
    if (id >= TY_U8 && id <= TY_USIZE) { return 1; }
    return 0;
}

// `char` is a 32-bit scalar value: it participates in integer casts
// (`char as u32`, `u8 as char`, §5.10) though it is not an arithmetic
// integer for `+ - *` (those want numbers, §7.3).
int ty_is_integer_or_char(int id) {
    if (ty_is_integer(id)) { return 1; }
    return id == TY_CHAR;
}

int ty_is_signed(int id) {
    return id >= TY_I8 && id <= TY_ISIZE;
}

int ty_is_unsigned(int id) {
    return id >= TY_U8 && id <= TY_USIZE;
}

int ty_is_float(int id) {
    return id == TY_F32 || id == TY_F64;
}

int ty_is_bool(int id) { return id == TY_BOOL; }
int ty_is_char(int id) { return id == TY_CHAR; }
int ty_is_never(int id) { return id == TY_NEVER; }

int ty_is_untyped_lit(int id) {
    return id == TY_UINT_LIT || id == TY_FLOAT_LIT;
}

int ty_is_ref(int id) {
    int k;
    k = ty_kind(id);
    return k == CTY_REF || k == CTY_MUTREF || k == CTY_STRREF;
}

// A thin reference is a single pointer (`&T`, `&mut T`): LLVM `ptr`. A fat
// reference (`&str`, `&[T]`) is a (pointer, length) pair and prints as
// `%slice`/`%str`; the two groups need different handling in the backend.
int ty_is_thin_ref(int id) {
    int k;
    k = ty_kind(id);
    return k == CTY_REF || k == CTY_MUTREF;
}

int ty_is_fatref(int id) {
    int k;
    k = ty_kind(id);
    return k == CTY_STRREF || k == CTY_SLICE;
}

// A `&mut [T]` slice is exclusive (writable through); `&[T]` is shared. The
// exclusivity lives in the `b` slot of the slice type entry (§5.2), since a
// slice has no length there (its length is a runtime value in the fat pair).
int ty_slice_is_mut(int id) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    if (g_types[id].kind != CTY_SLICE) { return 0; }
    return g_types[id].b;
}

int ty_is_heap(int id) { return ty_kind(id) == CTY_HEAP; }

int ty_is_array(int id) { return ty_kind(id) == CTY_ARRAY; }

int ty_is_nominal(int id) {
    int k;
    k = ty_kind(id);
    return k == CTY_STRUCT || k == CTY_ENUM;
}

int ty_is_ptr(int id) {
    int k;
    k = ty_kind(id);
    return k == CTY_PTR || k == CTY_MUTPTR;
}

int ty_is_genparam(int id) { return ty_kind(id) == CTY_GENPARAM; }

// The element/pointee of a composite (0 for primitives).
int ty_elem(int id) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    return g_types[id].a;
}

int ty_bit_width(int id) {
    if (id == TY_I8 || id == TY_U8) { return 8; }
    if (id == TY_I16 || id == TY_U16) { return 16; }
    if (id == TY_I32 || id == TY_U32 || id == TY_CHAR || id == TY_F32) { return 32; }
    if (id == TY_I64 || id == TY_U64 || id == TY_ISIZE || id == TY_USIZE || id == TY_F64) { return 64; }
    if (id == TY_BOOL) { return 1; }
    return 0;
}

// ---------------------------------------------------------------------------
// §5.6: which types are `copy`.
//
// Primitives, shared references, raw pointers, arrays of copy, and user
// structs/enums explicitly marked `copy` (whose fields must all be copy).
// ---------------------------------------------------------------------------
int ty_is_copy(int id) {
    int i;
    int k;
    if (id == TY_NEVER || id == TY_UNIT) { return 1; }
    if (ty_is_primitive(id) || ty_is_untyped_lit(id)) { return 1; }
    if (id <= 0 || id >= g_ntypes) { return 0; }
    if (g_types[id].nocopy) { return 0; }
    k = g_types[id].kind;
    if (k == CTY_REF || k == CTY_STRREF) { return 1; }
    if (k == CTY_MUTREF) { return 0; }   // §5.4: reborrowed, not copied
    if (k == CTY_PTR || k == CTY_MUTPTR) { return 1; }
    if (k == CTY_HEAP) { return 0; }      // owns a resource
    if (k == CTY_ARRAY) { return ty_is_copy(g_types[id].a); }
    if (k == CTY_STRUCT || k == CTY_ENUM) {
        // Marked copy iff the decl says so AND every member is copy.
        if (g_types[id].decl == 0) { return 0; }
        if (g_types[id].decl->ival == 0) { return 0; }   // not `copy struct/enum`
        i = 0;
        while (i < g_types[id].nmembers) {
            if (!ty_is_copy(g_members[g_types[id].mstart + i].ty)) { return 0; }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

void ty_set_nocopy(int id) {
    if (id > 0 && id < g_ntypes) { g_types[id].nocopy = 1; }
}

// ---------------------------------------------------------------------------
// Structural equality. Nominal types compare by id (the table dedups by
// name); composites compare by constructor and parts.
// ---------------------------------------------------------------------------
int ty_eq(int a, int b) {
    if (a == b) { return 1; }
    // An untyped literal adapts to any numeric type of its class.
    if (a == TY_UINT_LIT) { return ty_is_integer(b) || b == TY_UINT_LIT; }
    if (b == TY_UINT_LIT) { return ty_is_integer(a) || a == TY_UINT_LIT; }
    if (a == TY_FLOAT_LIT) { return ty_is_float(b) || b == TY_FLOAT_LIT; }
    if (b == TY_FLOAT_LIT) { return ty_is_float(a) || a == TY_FLOAT_LIT; }
    if (a <= 0 || a >= g_ntypes || b <= 0 || b >= g_ntypes) { return 0; }
    if (g_types[a].kind != g_types[b].kind) { return 0; }
    if (g_types[a].kind == CTY_ARRAY) {
        return ty_eq(g_types[a].a, g_types[b].a) && g_types[a].b == g_types[b].b;
    }
    if (g_types[a].kind == CTY_REF || g_types[a].kind == CTY_MUTREF
        || g_types[a].kind == CTY_HEAP || g_types[a].kind == CTY_PTR
        || g_types[a].kind == CTY_MUTPTR || g_types[a].kind == CTY_STRREF) {
        return ty_eq(g_types[a].a, g_types[b].a);
    }
    // Slices compare by element *and* exclusivity: `&[T]` and `&mut [T]` are
    // different types (§5.2), so a shared slice cannot stand in for an
    // exclusive one or vice versa.
    if (g_types[a].kind == CTY_SLICE) {
        return ty_eq(g_types[a].a, g_types[b].a)
            && g_types[a].b == g_types[b].b;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// Layout: byte size and alignment (the harmony layout, not the seed's).
//
// A function of the type alone, so codegen and sizeof() agree byte for byte.
// Composites are computed on first use and cached; a re-entrant computation
// (a type containing itself by value) yields 0, which the checker rejects.
// ---------------------------------------------------------------------------
int ty_size(int id) {
    int k;
    int off;
    int i;
    int amax;
    int maxpay;
    if (id == TY_INVALID) { return 0; }
    if (id == TY_UNIT || id == TY_NEVER) { return 0; }
    if (id == TY_FLOAT_LIT) { return 8; }
    if (id == TY_UINT_LIT) { return 4; }   // an untyped integer literal defaults to i32
    if (ty_is_primitive(id)) {
        if (id == TY_I8 || id == TY_U8 || id == TY_BOOL) { return 1; }
        if (id == TY_I16 || id == TY_U16) { return 2; }
        if (id == TY_I32 || id == TY_U32 || id == TY_F32 || id == TY_CHAR) { return 4; }
        return 8;   // i64/u64/isize/usize/f64
    }
    if (id <= 0 || id >= g_ntypes) { return 0; }
    if (g_types[id].size != 0) { return g_types[id].size; }
    if (g_types[id].is_computing) { return 0; }   // recursive by value: unusable
    g_types[id].is_computing = 1;
    k = g_types[id].kind;
    if (k == CTY_REF || k == CTY_MUTREF || k == CTY_PTR || k == CTY_MUTPTR
        || k == CTY_HEAP) {
        g_types[id].size = 8;
    } else if (k == CTY_STRREF || k == CTY_SLICE) {
        // A slice is a (pointer, length) pair, like &str (§5.2).
        g_types[id].size = 16;
    } else if (k == CTY_ARRAY) {
        g_types[id].size = ty_size(g_types[id].a) * g_types[id].b;
    } else if (k == CTY_STRUCT) {
        // Natural alignment, tail padding to the struct alignment.
        off = 0;
        amax = 1;
        i = 0;
        while (i < g_types[id].nmembers) {
            int ft;
            int fs;
            int fa;
            ft = g_members[g_types[id].mstart + i].ty;
            fs = ty_size(ft);
            fa = ty_align(ft);
            off = align_up(off, fa);
            off = off + fs;
            if (fa > amax) { amax = fa; }
            i = i + 1;
        }
        g_types[id].size = align_up(off, amax);
        g_types[id].align = amax;
    } else if (k == CTY_ENUM) {
        // { i32 tag; <payload of the largest variant> }, 8-byte aligned.
        maxpay = 0;
        i = 0;
        while (i < g_types[id].nmembers) {
            int ps;
            ps = ty_size(g_members[g_types[id].mstart + i].ty);
            if (ps > maxpay) { maxpay = ps; }
            i = i + 1;
        }
        // Payload region: the emitter rounds up to an 8-byte stride and keeps
        // one stride even when every variant is fieldless (`[8 x i8]`). §19.4
        // spells the enum as `{ i32 tag, [4 x i8], [payload x i8] }`, so the
        // tag region is 8 bytes and the payload region is at least 8.
        //
        // ty_size must agree with that, or a struct *containing* the enum is
        // given the wrong size: with `Diag { code: &str; severity: Severity;
        // ...; line: u32; col: u32 }` the checker computed 80 bytes and memcpy'd
        // 80, while LLVM's type was 88 -- so the trailing fields were silently
        // truncated and read back as zero.
        if (maxpay == 0) { maxpay = 1; }
        g_types[id].size = align_up(4, 8) + align_up(maxpay, 8);
        g_types[id].align = 8;
    } else {
        g_types[id].size = 8;
    }
    g_types[id].is_computing = 0;
    return g_types[id].size;
}

int ty_align(int id) {
    int s;
    if (ty_is_primitive(id) || ty_is_untyped_lit(id)) {
        if (id == TY_BOOL || id == TY_I8 || id == TY_U8) { return 1; }
        if (id == TY_I16 || id == TY_U16) { return 2; }
        s = ty_size(id);
        if (s == 4) { return 4; }
        return 8;
    }
    if (id <= 0 || id >= g_ntypes) { return 1; }
    if (g_types[id].align != 0) { return g_types[id].align; }
    // Pointer-shaped composites are one machine word; a slice/&str pair is
    // two. The array alignment follows its element.
    if (g_types[id].kind == CTY_ARRAY) { return ty_align(g_types[id].a); }
    if (ty_is_ref(id) || ty_is_ptr(id) || ty_is_heap(id)
        || g_types[id].kind == CTY_SLICE
        || g_types[id].kind == CTY_STRREF) {
        // A slice and a `&str` are both a `{ ptr, i64 }` pair. Missing the
        // `CTY_STRREF` case gave `&str` alignment 1, so a struct whose fields
        // mixed `&str` with anything else laid its trailing fields out at the
        // wrong offsets: `struct { code: &str; ...; line: u32; col: u32; }`
        // was 80 bytes instead of 96, and the final fields read back as zero
        // (found by library/core/fmt.hr's `Diag`).
        return 8;
    }
    // Structs/enum: trigger the size pass, which fills `align`.
    ty_size(id);
    if (g_types[id].align != 0) { return g_types[id].align; }
    return 1;
}

// Byte offset of struct member `i` (fields are laid out in decl order).
int ty_field_offset(int id, int i) {
    int off;
    int j;
    int ft;
    if (id <= 0 || id >= g_ntypes) { return 0; }
    if (g_types[id].kind != CTY_STRUCT) { return 0; }
    off = 0;
    j = 0;
    while (j < i) {
        ft = g_members[g_types[id].mstart + j].ty;
        off = align_up(off, ty_align(ft));
        off = off + ty_size(ft);
        j = j + 1;
    }
    if (i < g_types[id].nmembers) {
        ft = g_members[g_types[id].mstart + i].ty;
        off = align_up(off, ty_align(ft));
    }
    return off;
}

int ty_member_count(int id) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    return g_types[id].nmembers;
}

// Finds a struct field / enum variant by name. Returns -1 when absent.
int ty_find_member(int id, char* name) {
    int i;
    if (id <= 0 || id >= g_ntypes) { return -1; }
    i = 0;
    while (i < g_types[id].nmembers) {
        if (str_eq(g_members[g_types[id].mstart + i].name, name)) { return i; }
        i = i + 1;
    }
    return -1;
}

char* ty_member_name(int id, int i) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    if (i < 0 || i >= g_types[id].nmembers) { return 0; }
    return g_members[g_types[id].mstart + i].name;
}

int ty_member_type(int id, int i) {
    if (id <= 0 || id >= g_ntypes) { return TY_INVALID; }
    if (i < 0 || i >= g_types[id].nmembers) { return TY_INVALID; }
    return g_members[g_types[id].mstart + i].ty;
}

// The decl node of a nominal type (0 for built-ins).
struct AstNode* ty_decl(int id) {
    if (id <= 0 || id >= g_ntypes) { return 0; }
    return g_types[id].decl;
}
