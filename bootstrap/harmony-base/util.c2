// harmony-base — arena allocator, string helpers, raw output.

char g_arena[16777216];
int  g_arena_used;

// ---------------------------------------------------------------------------
// Arena
//
// Two regions. The fixed 16 MiB BSS block is the fast path (no syscall) and
// covers all small inputs. When it fills, the arena grows from the OS in large
// `mmap` chunks, so the compiler is no longer capped at 16 MiB of generated IR
// — the `harmony` rewrite is far larger (§19.4). Every chunk is kept mapped and
// never reused mid-run, so all earlier pointers stay valid; the region is only
// rewound by `arena_reset` (a fresh program/audit), which reuses the chunks.
// ---------------------------------------------------------------------------

char g_arena[16777216];
int  g_arena_used;

// The current spill chunk (0 until the fixed block first overflows).
char* g_spill_base;
int   g_spill_used;
int   g_spill_cap;

void arena_reset(void) {
    g_arena_used = 0;
    g_spill_used = 0;   // reuse the first chunk; earlier pointers are dead
}

int arena_used(void) {
    return g_arena_used;
}

// Grows the spill region by one chunk, big enough for `need` bytes.
void arena_spill_grow(int need) {
    int want;
    int base;
    want = 32 * 1024 * 1024;            // 32 MiB chunks
    if (need > want) { want = (need + 4095) & (0 - 4096); }
    // mmap(NULL, want, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0).
    // Raw syscall 9 through the seed's `asm()` seam (docs/c2x-seed.md): the
    // generated-binary runtime only emits the read/write/fork family, not mmap,
    // so the compiler reaches the kernel directly for its scratch region.
    base = 0;
    asm("    mov rax, 9\n    xor rdi, rdi\n    mov rsi, %0\n    mov rdx, 3\n    mov r10, 34\n    mov r8, -1\n    xor r9, r9\n    syscall\n    mov %1, rax",
        want, base);
    if (base == 0 || base < 0) {
        err_str("harmony-base: internal: out of memory (ICE-01)\n");
        syscall_exit(EXIT_STOP);
    }
    g_spill_base = (char*) base;
    g_spill_used = 0;
    g_spill_cap = want;
}

char* arena_alloc(int n) {
    char* p;
    // 8-byte align (c2x-seed structs/pointers want natural alignment).
    n = (n + 7) & (0 - 8);
    // Fast path: the fixed block, as long as this request still fits.
    if (g_arena_used + n <= 16777216) {
        p = &g_arena[g_arena_used];
        g_arena_used = g_arena_used + n;
        return p;
    }
    // Spill path: a fresh OS chunk (or the current one if the request fits).
    if (g_spill_base == 0 || g_spill_used + n > g_spill_cap) {
        arena_spill_grow(n);
    }
    p = g_spill_base + g_spill_used;
    g_spill_used = g_spill_used + n;
    return p;
}

char* arena_alloc_str(char* s) {
    int n;
    char* p;
    int i;
    n = str_len(s);
    p = arena_alloc(n + 1);
    i = 0;
    while (i < n) { p[i] = s[i]; i = i + 1; }
    p[n] = 0;
    return p;
}

// ---------------------------------------------------------------------------
// Strings
// ---------------------------------------------------------------------------

int str_len(char* s) {
    int n;
    n = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

int str_eq(char* a, char* b) {
    int i;
    i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return a[i] == b[i];
}

int str_has_prefix(char* s, char* prefix) {
    int i;
    i = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// True when `needle` occurs anywhere in `haystack`.
int str_contains(char* haystack, char* needle) {
    int i;
    i = 0;
    while (haystack[i] != 0) {
        if (str_has_prefix(haystack + i, needle)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Index of the *last* occurrence of `needle`, or -1. `needle` must be
// one or two characters; the checker only uses it for `::`.
int str_rfind(char* haystack, char* needle) {
    int i;
    int hit;
    hit = -1;
    i = 0;
    while (haystack[i] != 0) {
        if (str_has_prefix(haystack + i, needle)) { hit = i; }
        i = i + 1;
    }
    return hit;
}

// Arena copy of the first `n` bytes of `s` (NUL-terminated).
char* str_prefix(char* s, int n) {
    char* p;
    int i;
    p = arena_alloc(n + 1);
    i = 0;
    while (i < n) { p[i] = s[i]; i = i + 1; }
    p[n] = 0;
    return p;
}

char* str_copy(char* s) {
    return arena_alloc_str(s);
}

char* str_concat(char* a, char* b) {
    int na;
    int nb;
    char* p;
    int i;
    na = str_len(a);
    nb = str_len(b);
    p = arena_alloc(na + nb + 1);
    i = 0;
    while (i < na) { p[i] = a[i]; i = i + 1; }
    i = 0;
    while (i < nb) { p[na + i] = b[i]; i = i + 1; }
    p[na + nb] = 0;
    return p;
}

// Writes a signed decimal integer to `fd`. Returns the number of bytes.
int write_int(int fd, int n) {
    char buf[32];
    int len;
    int neg;
    int i;
    int j;
    if (n == 0) {
        syscall_write(fd, "0", 1);
        return 1;
    }
    neg = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    i = 0;
    while (n > 0 && i < 30) {
        buf[i] = '0' + (n - (n / 10) * 10);
        n = n / 10;
        i = i + 1;
    }
    if (neg) { buf[i] = '-'; i = i + 1; }
    len = i;
    // Reverse in place.
    j = 0;
    i = len - 1;
    while (j < i) {
        char t;
        t = buf[j];
        buf[j] = buf[i];
        buf[i] = t;
        j = j + 1;
        i = i - 1;
    }
    syscall_write(fd, buf, len);
    return len;
}

// ---------------------------------------------------------------------------
// Raw output
// ---------------------------------------------------------------------------

void out_str(char* s) {
    int n;
    n = str_len(s);
    if (n > 0) { syscall_write(FD_STDOUT, s, n); }
}

void out_nl(void) {
    syscall_write(FD_STDOUT, "\n", 1);
}

// One raw byte to stdout (used by the audit/JSON writers for `:` etc.).
void out_char(char c) {
    syscall_write(FD_STDOUT, &c, 1);
}

void out_int(int n) {
    write_int(FD_STDOUT, n);
}

void err_str(char* s) {
    int n;
    n = str_len(s);
    if (n > 0) { syscall_write(FD_STDERR, s, n); }
}

void err_nl(void) {
    syscall_write(FD_STDERR, "\n", 1);
}

void err_int(int n) {
    write_int(FD_STDERR, n);
}
