// harmony/ast/node.hr — the flat AST node model (roadmap/harmony R3).
//
// The node shape deliberately mirrors harmony-base's `struct AstNode`: a
// kind, a byte span, up to three direct children, two resizable child lists,
// a string payload (`sval`), and an integer payload (`ival`). It is flat
// because Harmony has no unions (v0): fields not meaningful for a kind stay
// empty. The payoff is that `--dump-ast` can be byte-identical to
// harmony-base's printer -- the two compilers can then be diffed on any file
// instead of trusting that a second parser "looks right".
//
// Nodes live in the compiler's arena and are never freed individually (a
// compile is short-lived). Child lists grow by doubling -- no fixed cap.
import "../../library/core/mem.hr";
import "../../library/core/vec.hr";

// Node kinds, grouped with gaps so new kinds slot in without renumbering.
// These are the *same* numbers as harmony-base's AST_* constants; keeping
// them identical makes cross-compiler debugging easier (the numbers are not
// a public API).
const AST_PROGRAM: i32 = 1;
const AST_IMPORT: i32 = 9;
const AST_FN: i32 = 10;
const AST_EXTERN_FN: i32 = 11;
const AST_STRUCT: i32 = 12;
const AST_ENUM: i32 = 13;
const AST_METHODS: i32 = 14;
const AST_CONST: i32 = 15;
const AST_FIELD: i32 = 16;
const AST_VARIANT: i32 = 17;
const AST_PARAM: i32 = 18;
const AST_TYPE_NAME: i32 = 20;
const AST_TYPE_REF: i32 = 21;
const AST_TYPE_ARRAY: i32 = 22;
const AST_TYPE_SLICE: i32 = 23;
const AST_TYPE_UNIT: i32 = 24;
const AST_TYPE_RAW: i32 = 25;
const AST_BLOCK: i32 = 30;
const AST_LET: i32 = 31;
const AST_ASSIGN: i32 = 32;
const AST_EXPR_STMT: i32 = 33;
const AST_IF: i32 = 34;
const AST_WHILE: i32 = 35;
const AST_FOR: i32 = 36;
const AST_SWITCH: i32 = 37;
const AST_ARM: i32 = 38;
const AST_RETURN: i32 = 39;
const AST_BREAK: i32 = 40;
const AST_CONTINUE: i32 = 41;
const AST_UNCHECKED: i32 = 42;
// v1: the `else` clause on a fallible simple statement (let/assignment/
// expression statement). ival selects its exit form, sval names the payload
// binding, a holds a block or a terminal call, b an optional `return` value.
const AST_ELSE: i32 = 43;
const AST_INT_LIT: i32 = 50;
const AST_FLOAT_LIT: i32 = 51;
const AST_STRING_LIT: i32 = 52;
const AST_CHAR_LIT: i32 = 53;
const AST_BOOL_LIT: i32 = 54;
const AST_UNIT_LIT: i32 = 55;
const AST_PATH: i32 = 56;
const AST_BINARY: i32 = 57;
const AST_UNARY: i32 = 58;
const AST_FIELD_ACC: i32 = 59;
const AST_INDEX: i32 = 60;
const AST_CALL: i32 = 61;
const AST_AS: i32 = 62;
const AST_STRUCT_INIT: i32 = 63;
const AST_FIELD_INIT: i32 = 64;
const AST_ARRAY_LIT: i32 = 65;
const AST_BORROW: i32 = 66;
const AST_DEREF: i32 = 67;
const AST_HEAP: i32 = 68;
const AST_SIZEOF: i32 = 69;
const AST_RAW_EXPR: i32 = 70;
const AST_PAT_WILD: i32 = 80;
const AST_PAT_LIT: i32 = 81;
const AST_PAT_BIND: i32 = 82;
const AST_PAT_VARIANT: i32 = 83;
const AST_PAT_RANGE: i32 = 84;

// One node. `kids` and `kids2` are arena-backed vectors of node handles;
// using handles (int indices into a global table) instead of pointers keeps
// the model simple and makes the printer's recursion obvious.
// `ty` is the resolved type id, stamped by the checker (R5). It starts at 0
// (unset) and mirrors harmony-base's `struct AstNode.ty`. The printer reads
// explicit fields, so adding it does not change `--dump-ast` output.
struct Node {
    kind: i32;
    file: i32;       // source-file index (0 until the loader assigns one)
    start: usize;
    end: usize;
    ty: i32;
    // Semantic links used by LLVM lowering. They are deliberately outside the
    // parser-visible payload: `target` is a resolved fn/const declaration,
    // `self_ty` a method receiver, and `instance` marks a monomorphized fn.
    target: i32;
    self_ty: i32;
    instance: i32;
    ival: i64;
    sval: &str;
    sfx: &str;       // literal type suffix (`42u8` -> "u8"), else ""
    abi: &str;       // extern fn ABI string ("C"), else ""
    a: i32;          // -1 = no child
    b: i32;
    c: i32;
    kids: vec::Vec<i32>;
    kids2: vec::Vec<i32>;
    kids3: vec::Vec<i32>;   // methods-block type args (`methods<T> Stack<T>`)
}

// The node table: a resizable `Vec<Node>` of nodes; handles are indices.
// `Vec<i32>` for the child lists. Both are now usable across modules --
// the module loader used to skip the type argument on a bare generic path,
// and `ll_addr` used to drop a field access on a call result; both fixed in
// harmony-base (regressions: module-generic-path, field-call-result).
struct Nodes {
    items: vec::Vec<Node>;
}

export fn nodes_make() -> Nodes {
    return Nodes { .items = vec::Vec<Node>::make() };
}

// Creates a node and returns its handle.
export fn new_node(ns: &mut Nodes, kind: i32) -> i32 {
    ns.items.push(Node {
        .kind = kind,
        .file = 0,
        .start = 0,
        .end = 0,
        .ty = 0,
        .target = -1,
        .self_ty = 0,
        .instance = 0,
        .ival = 0,
        .sval = "",
        .sfx = "",
        .abi = "",
        .a = -1,
        .b = -1,
        .c = -1,
        .kids = vec::Vec<i32>::make(),
        .kids2 = vec::Vec<i32>::make(),
        .kids3 = vec::Vec<i32>::make(),
    });
    return ns.items.len() as i32 - 1;
}

export fn get(ns: &Nodes, h: i32) -> Node { return *ns.items.get(h as usize); }
export fn ref(ns: &Nodes, h: i32) -> &Node { return ns.items.get(h as usize); }
export fn put(ns: &mut Nodes, h: i32, n: Node) { ns.items.set(h as usize, n); }

// Deep-clones a subtree into fresh handles. Monomorphization needs an
// independent body for every concrete instance: sharing the template body
// leaves its expression types and call targets stamped for whichever instance
// happened to be checked first. Strings are immutable source/arena views and
// are shared; every node and child list is new.
export fn clone(ns: &mut Nodes, h: i32) -> i32 {
    if (h < 0) { return -1; }
    let old = get(&*ns, h);
    let out = new_node(ns, old.kind);
    let mut n = get(&*ns, out);
    n.file = old.file;
    n.start = old.start;
    n.end = old.end;
    n.ty = old.ty;
    n.target = old.target;
    n.self_ty = old.self_ty;
    n.instance = old.instance;
    n.ival = old.ival;
    n.sval = old.sval;
    n.sfx = old.sfx;
    n.abi = old.abi;
    put(ns, out, n);
    set_a(ns, out, clone(ns, old.a));
    set_b(ns, out, clone(ns, old.b));
    set_c(ns, out, clone(ns, old.c));
    let mut i: usize = 0;
    while (i < old.kids.len()) {
        push_kid(ns, out, clone(ns, *old.kids.get(i)));
        i += 1;
    }
    i = 0;
    while (i < old.kids2.len()) {
        push_kid2(ns, out, clone(ns, *old.kids2.get(i)));
        i += 1;
    }
    i = 0;
    while (i < old.kids3.len()) {
        push_kid3(ns, out, clone(ns, *old.kids3.get(i)));
        i += 1;
    }
    return out;
}

export fn set_sval(ns: &mut Nodes, h: i32, s: &str) {
    let mut n = get(&*ns, h);
    n.sval = s;
    put(ns, h, n);
}
export fn set_sfx(ns: &mut Nodes, h: i32, s: &str) {
    let mut n = get(&*ns, h);
    n.sfx = s;
    put(ns, h, n);
}
export fn set_abi(ns: &mut Nodes, h: i32, s: &str) {
    let mut n = get(&*ns, h);
    n.abi = s;
    put(ns, h, n);
}
export fn set_ival(ns: &mut Nodes, h: i32, v: i64) {
    let mut n = get(&*ns, h);
    n.ival = v;
    put(ns, h, n);
}
export fn set_ty(ns: &mut Nodes, h: i32, ty: i32) {
    let mut n = get(&*ns, h);
    n.ty = ty;
    put(ns, h, n);
}
export fn set_span(ns: &mut Nodes, h: i32, start: usize, end: usize) {
    let mut n = get(&*ns, h);
    n.start = start;
    n.end = end;
    put(ns, h, n);
}
export fn set_a(ns: &mut Nodes, h: i32, child: i32) {
    let mut n = get(&*ns, h);
    n.a = child;
    put(ns, h, n);
}
export fn set_b(ns: &mut Nodes, h: i32, child: i32) {
    let mut n = get(&*ns, h);
    n.b = child;
    put(ns, h, n);
}
export fn set_c(ns: &mut Nodes, h: i32, child: i32) {
    let mut n = get(&*ns, h);
    n.c = child;
    put(ns, h, n);
}
export fn push_kid(ns: &mut Nodes, h: i32, child: i32) {
    let mut n = get(&*ns, h);
    n.kids.push(child);
    put(ns, h, n);
}
export fn push_kid2(ns: &mut Nodes, h: i32, child: i32) {
    let mut n = get(&*ns, h);
    n.kids2.push(child);
    put(ns, h, n);
}
export fn push_kid3(ns: &mut Nodes, h: i32, child: i32) {
    let mut n = get(&*ns, h);
    n.kids3.push(child);
    put(ns, h, n);
}

// The stable kind name used by `--dump-ast`. This must match harmony-base's
// `ast_kind_name` exactly -- the dump is diffed between the two compilers.
export fn kind_name(kind: i32) -> &str {
    if (kind == AST_PROGRAM) { return "program"; }
    if (kind == AST_IMPORT) { return "import"; }
    if (kind == AST_FN) { return "fn"; }
    if (kind == AST_EXTERN_FN) { return "extern-fn"; }
    if (kind == AST_STRUCT) { return "struct"; }
    if (kind == AST_ENUM) { return "enum"; }
    if (kind == AST_METHODS) { return "methods"; }
    if (kind == AST_CONST) { return "const"; }
    if (kind == AST_FIELD) { return "field"; }
    if (kind == AST_VARIANT) { return "variant"; }
    if (kind == AST_PARAM) { return "param"; }
    if (kind == AST_TYPE_NAME) { return "type-name"; }
    if (kind == AST_TYPE_REF) { return "type-ref"; }
    if (kind == AST_TYPE_ARRAY) { return "type-array"; }
    if (kind == AST_TYPE_SLICE) { return "type-slice"; }
    if (kind == AST_TYPE_UNIT) { return "type-unit"; }
    if (kind == AST_TYPE_RAW) { return "type-raw"; }
    if (kind == AST_BLOCK) { return "block"; }
    if (kind == AST_LET) { return "let"; }
    if (kind == AST_ASSIGN) { return "assign"; }
    if (kind == AST_EXPR_STMT) { return "expr-stmt"; }
    if (kind == AST_IF) { return "if"; }
    if (kind == AST_WHILE) { return "while"; }
    if (kind == AST_FOR) { return "for"; }
    if (kind == AST_SWITCH) { return "switch"; }
    if (kind == AST_ARM) { return "arm"; }
    if (kind == AST_RETURN) { return "return"; }
    if (kind == AST_BREAK) { return "break"; }
    if (kind == AST_CONTINUE) { return "continue"; }
    if (kind == AST_UNCHECKED) { return "unchecked"; }
    if (kind == AST_INT_LIT) { return "int"; }
    if (kind == AST_FLOAT_LIT) { return "float"; }
    if (kind == AST_STRING_LIT) { return "string"; }
    if (kind == AST_CHAR_LIT) { return "char"; }
    if (kind == AST_BOOL_LIT) { return "bool"; }
    if (kind == AST_UNIT_LIT) { return "unit"; }
    if (kind == AST_PATH) { return "path"; }
    if (kind == AST_BINARY) { return "binary"; }
    if (kind == AST_UNARY) { return "unary"; }
    if (kind == AST_FIELD_ACC) { return "field"; }
    if (kind == AST_INDEX) { return "index"; }
    if (kind == AST_CALL) { return "call"; }
    if (kind == AST_AS) { return "as"; }
    if (kind == AST_STRUCT_INIT) { return "struct-init"; }
    if (kind == AST_FIELD_INIT) { return "field-init"; }
    if (kind == AST_ARRAY_LIT) { return "array-lit"; }
    if (kind == AST_BORROW) { return "borrow"; }
    if (kind == AST_DEREF) { return "deref"; }
    if (kind == AST_HEAP) { return "heap"; }
    if (kind == AST_SIZEOF) { return "sizeof"; }
    if (kind == AST_RAW_EXPR) { return "raw-expr"; }
    if (kind == AST_PAT_WILD) { return "pat-wild"; }
    if (kind == AST_PAT_LIT) { return "pat-lit"; }
    if (kind == AST_PAT_BIND) { return "pat-bind"; }
    if (kind == AST_PAT_VARIANT) { return "pat-variant"; }
    if (kind == AST_PAT_RANGE) { return "pat-range"; }
    return "?";
}
