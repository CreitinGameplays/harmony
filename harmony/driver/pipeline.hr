// harmony/driver/pipeline.hr — the compiler pipeline and build/run driver.
//
// The pipeline is the same shape as harmony-base's: load the module graph,
// resolve, type-check, and (for build/run/emit-llvm) lower to LLVM IR. The
// generated IR stays in memory and is piped to clang on stdin, so the default
// path never creates a `.ll` temporary file (docs/harmony.md §19.4).
import "../../library/core/mem.hr";
import "../../library/core/fmt.hr";
import "../../library/core/str.hr";
import "../../library/core/vec.hr";
import "../../library/std/sys.hr";
import "../../library/std/llvm.hr";
import "../../harmony/ast/node.hr";
import "../../harmony/ast/print.hr";
import "../../harmony/lexer/token.hr";
import "../../harmony/lexer/ctx.hr";
import "../../harmony/lexer/scan.hr";
import "../../harmony/parser/pctx.hr";
import "../../harmony/parser/parse.hr";
import "../../harmony/parser/item.hr";
import "../../harmony/driver/loader.hr";
import "../../harmony/sema/check.hr";
import "../../harmony/borrowck/moves.hr";
import "../../harmony/borrowck/loans.hr";
import "../../harmony/borrowck/lifetimes.hr";
import "../../harmony/codegen/llvm/emit.hr";
import "diagnostics.hr";
import "process.hr";

struct Discovery {
    ok: i32;                    // 0 = all modules found
    mods: vec::Vec<loader::Module>;
    root: &str;
    missing: &str;
}

fn already_seen(visited: &mut vec::Vec<str::String>, path: &str) -> bool {
    let mut i: usize = 0;
    while (i < visited.len()) {
        if (visited.get(i).as_str() == path) { return true; }
        i += 1;
    }
    return false;
}

// Parses one module only to discover its imports. The loader parses it again
// when it builds the merged program.
fn module_imports(src: &str, path: &str) -> vec::Vec<str::String> {
    let mut arena: mem::Arena = mem::Arena { .cur = Raw::null() };
    let mut ns: node::Nodes = node::nodes_make();
    let mut lx: ctx::Ctx = ctx::make(src, path);
    scan::scan(&mut lx, &mut arena);
    let mut p: pctx::Parser = pctx::make(&mut ns, lx.toks.clone(), path);
    let program = item::parse_program(&mut p);
    return loader::import_names(&ns, program);
}

// Adds a module and its transitive imports. Returns 0, or -1 with `missing`
// set to the path that could not be read.
fn discover_module(path: &str, mods: &mut vec::Vec<loader::Module>,
                   visited: &mut vec::Vec<str::String>,
                   missing: &mut str::String) -> i32 {
    if (already_seen(visited, path)) { return 0; }
    let mut seen: str::String = str::String::make();
    seen.push(path);
    visited.push(seen);
    let file = sys::read_file(path);
    if (file.ok != 0) {
        missing.clear();
        missing.push(path);
        return -1;
    }
    let imports = module_imports(file.data, path);
    mods.push(loader::Module { .path = path, .src = file.data });
    let dir = loader::module_dir(path);
    let mut i: usize = 0;
    while (i < imports.len()) {
        let child = loader::resolve_path(dir, imports.get(i).as_str());
        if (discover_module(child, mods, visited, missing) != 0) { return -1; }
        i += 1;
    }
    return 0;
}

fn discover(root: &str) -> Discovery {
    let mut d = Discovery {
        .ok = 0,
        .mods = vec::Vec<loader::Module>::make(),
        .root = root,
        .missing = "",
    };
    let mut visited: vec::Vec<str::String> = vec::Vec<str::String>::make();
    let mut missing: str::String = str::String::make();
    if (discover_module(root, &mut d.mods, &mut visited, &mut missing) != 0) {
        d.ok = -1;
        d.missing = missing.as_str();
    }
    return d;
}

// True when the module graph declares the LLVM-C shim. This is cheaper and
// safer than scanning multi-megabyte IR chunks: source modules are small and
// always NUL-terminated by the loader.
fn uses_llvmc(mods: &vec::Vec<loader::Module>) -> i32 {
    let mut i: usize = 0;
    while (i < mods.len()) {
        if (str::find(mods.get(i).src, "hc_llvm_") >= 0) { return 1; }
        i += 1;
    }
    return 0;
}

// The parser's import list is the authority for discovery; the loader then
// reparses the same modules and expands them in dependency order.
fn print_clang_error(log_path: &str) {
    let log = sys::read_file(log_path);
    if (log.ok != 0) { return; }
    let bytes = log.data.as_bytes();
    let mut start: usize = 0;
    while (start < log.data.len()) {
        let mut end = start;
        while (end < log.data.len() && bytes[end] != 10u8) { end += 1; }
        let line = &log.data[start..end];
        if (str::find(line, "error:") >= 0) {
            eprintln("harmony: clang rejected the generated IR");
            eprintln("{}", line);
            return;
        }
        start = end + 1;
    }
    eprintln("harmony: clang rejected the generated IR");
}

fn temp_path(stem: &str, suffix: &str) -> &life(static) str {
    let mut s: str::String = str::String::make();
    s.push("/tmp/harmony-");
    s.push_i64(sys::getpid() as i64);
    s.push(stem);
    s.push(suffix);
    return s.as_str();
}

fn build_args(output: &str, opt: &str) -> process::ArgList {
    let mut a = process::args_make();
    process::args_push(&mut a, "/usr/bin/clang");
    process::args_push(&mut a, "-x");
    process::args_push(&mut a, "ir");
    process::args_push(&mut a, "-");
    process::args_push(&mut a, "-x");
    process::args_push(&mut a, "c");
    process::args_push(&mut a, "library/runtime/rt.c");
    process::args_push(&mut a, "-o");
    process::args_push(&mut a, output);
    process::args_push(&mut a, opt);
    process::args_push(&mut a, "-ffreestanding");
    process::args_push(&mut a, "-fno-stack-protector");
    process::args_push(&mut a, "-fstack-clash-protection");
    process::args_push(&mut a, "-nostdlib");
    process::args_push(&mut a, "-static");
    process::args_push(&mut a, "-Wno-override-module");
    return a;
}

fn optimize_args(opt: &str) -> process::ArgList {
    let mut a = process::args_make();
    process::args_push(&mut a, "/usr/bin/clang");
    process::args_push(&mut a, "-x");
    process::args_push(&mut a, "ir");
    process::args_push(&mut a, "-");
    process::args_push(&mut a, "-S");
    process::args_push(&mut a, "-emit-llvm");
    process::args_push(&mut a, "-o");
    process::args_push(&mut a, "-");
    process::args_push(&mut a, opt);
    process::args_push(&mut a, "-Wno-override-module");
    return a;
}

fn run_binary(path: &str) -> i32 {
    let mut a = process::args_make();
    process::args_push(&mut a, path);
    return process::spawn(&a, "");
}

// ---- parallel clang --------------------------------------------------------
//
// LLVM's -O2 pipeline is single-threaded, so one clang on a 3 MB module
// dominates self-hosting time. For large programs the driver gives each
// chunk to its own clang, compiles the runtime once, and links the objects
// in a stable order. Every path is PID-derived and never reaches the IR or
// the final binary.

fn object_path(stem: &str) -> &str {
    let mut s: str::String = str::String::make();
    s.push("/tmp/harmony-");
    s.push_i64(sys::getpid() as i64);
    s.push(stem);
    return s.as_str();
}

fn clang_chunk_args(obj: &str, opt: &str) -> process::ArgList {
    let mut a = process::args_make();
    process::args_push(&mut a, "/usr/bin/clang");
    process::args_push(&mut a, "-x");
    process::args_push(&mut a, "ir");
    process::args_push(&mut a, "-");
    process::args_push(&mut a, "-c");
    process::args_push(&mut a, "-o");
    process::args_push(&mut a, obj);
    process::args_push(&mut a, opt);
    process::args_push(&mut a, "-ffreestanding");
    process::args_push(&mut a, "-fno-stack-protector");
    process::args_push(&mut a, "-fstack-clash-protection");
    process::args_push(&mut a, "-Wno-override-module");
    return a;
}

fn clang_object_args(obj: &str, opt: &str) -> process::ArgList {
    let mut a = process::args_make();
    process::args_push(&mut a, "/usr/bin/clang");
    process::args_push(&mut a, "-x");
    process::args_push(&mut a, "ir");
    process::args_push(&mut a, "-");
    process::args_push(&mut a, "-c");
    process::args_push(&mut a, "-o");
    process::args_push(&mut a, obj);
    process::args_push(&mut a, opt);
    process::args_push(&mut a, "-fPIC");
    process::args_push(&mut a, "-ffreestanding");
    process::args_push(&mut a, "-fno-stack-protector");
    process::args_push(&mut a, "-Wno-override-module");
    return a;
}

fn compile_clang_object(ir: &str, obj: &str, opt: &str) -> i32 {
    let log = temp_path(".clang.log", "");
    let a = clang_object_args(obj, opt);
    let rc = process::spawn_with_input(&a, ir, log);
    if (rc != 0) { print_clang_error(log); }
    sys::unlink_if_empty(log);
    return rc;
}

fn clang_runtime_args(obj: &str) -> process::ArgList {
    let mut a = process::args_make();
    process::args_push(&mut a, "/usr/bin/clang");
    process::args_push(&mut a, "-x");
    process::args_push(&mut a, "c");
    process::args_push(&mut a, "library/runtime/rt.c");
    process::args_push(&mut a, "-c");
    process::args_push(&mut a, "-o");
    process::args_push(&mut a, obj);
    process::args_push(&mut a, "-O2");
    process::args_push(&mut a, "-ffreestanding");
    process::args_push(&mut a, "-fno-stack-protector");
    process::args_push(&mut a, "-fstack-clash-protection");
    return a;
}

fn clang_link_args(objs: &vec::Vec<str::String>, output: &str) -> process::ArgList {
    let mut a = process::args_make();
    process::args_push(&mut a, "/usr/bin/clang");
    let mut i: usize = 0;
    while (i < objs.len()) {
        process::args_push(&mut a, objs.get(i).as_str());
        i += 1;
    }
    process::args_push(&mut a, "-o");
    process::args_push(&mut a, output);
    process::args_push(&mut a, "-nostdlib");
    process::args_push(&mut a, "-static");
    return a;
}

fn finish_logs(pids: &vec::Vec<i32>, logs: &vec::Vec<str::String>) -> i32 {
    let mut bad: i32 = 0;
    let mut i: usize = 0;
    while (i < pids.len()) {
        if (process::wait_for(*pids.get(i)) != 0) {
            if (bad == 0) { print_clang_error(logs.get(i).as_str()); }
            bad = 1;
        }
        i += 1;
    }
    i = 0;
    while (i < logs.len()) {
        sys::unlink_if_empty(logs.get(i).as_str());
        i += 1;
    }
    return bad;
}

fn cleanup_objects(objs: &vec::Vec<str::String>) {
    let mut i: usize = 0;
    while (i < objs.len()) {
        sys::unlink(objs.get(i).as_str());
        i += 1;
    }
}

fn compile_chunks(chunks: &vec::Vec<str::String>, output: &str,
                  opt: &str) -> i32 {
    let mut pids: vec::Vec<i32> = vec::Vec<i32>::make();
    let mut logs: vec::Vec<str::String> = vec::Vec<str::String>::make();
    let mut objs: vec::Vec<str::String> = vec::Vec<str::String>::make();
    let mut i: usize = 0;
    while (i < chunks.len()) {
        let obj = object_path("-obj-");
        let mut obj_name: str::String = str::String::make();
        obj_name.push(obj);
        obj_name.push_i64(i as i64);
        obj_name.push(".o");
        let log_path = object_path("-clang-");
        let mut log_name: str::String = str::String::make();
        log_name.push(log_path);
        log_name.push_i64(i as i64);
        log_name.push(".log");
        let a = clang_chunk_args(obj_name.as_str(), opt);
        let pid = process::spawn_input_begin(&a, chunks.get(i).as_str(), log_name.as_str());
        if (pid < 0) { break; }
        pids.push(pid);
        objs.push(obj_name);
        logs.push(log_name);
        i += 1;
    }
    if (pids.len() != chunks.len()) {
        // A spawn failure cannot be repaired by partial objects: join the
        // children we did start, clean up, and let the caller use one clang.
        finish_logs(&pids, &logs);
        cleanup_objects(&objs);
        return -1;
    }
    let rt_obj = object_path("-rt.o");
    let mut rt_name: str::String = str::String::make();
    rt_name.push(rt_obj);
    let rt_log = object_path("-rt.log");
    let mut rt_log_name: str::String = str::String::make();
    rt_log_name.push(rt_log);
    let rt_args = clang_runtime_args(rt_name.as_str());
    let rt_pid = process::spawn_input_begin(&rt_args, "", rt_log_name.as_str());
    if (rt_pid >= 0) {
        pids.push(rt_pid);
        objs.push(rt_name);
        logs.push(rt_log_name);
    }
    let failed = finish_logs(&pids, &logs);
    if (failed != 0 || rt_pid < 0) {
        cleanup_objects(&objs);
        return process::EXIT_STOP;
    }
    // Objects stay alive until after the link. Their order is the stable
    // chunk order followed by the runtime object, so repeated builds produce
    // identical binaries.
    let link_log = object_path("-link.log");
    let a = clang_link_args(&objs, output);
    let rc = process::spawn(&a, link_log);
    if (rc != 0) { print_clang_error(link_log); }
    sys::unlink_if_empty(link_log);
    cleanup_objects(&objs);
    return rc;
}

// ---- native LLVM-C backend -------------------------------------------------
//
// The default build/run path parses the byte-identical IR text in-process,
// runs LLVM's -O pipeline and emits a relocatable object through libLLVM.
// Linking uses `ld` with the host's crt/libc paths discovered at build time;
// no clang process is spawned. `emit-llvm` keeps the original text path.

fn link_llvm_objects(objs: &vec::Vec<str::String>, output: &str,
                     need_core: i32) -> i32 {
    let mut all: vec::Vec<str::String> = vec::Vec<str::String>::make();
    let mut rt: str::String = str::String::make(); rt.push("build/llvmc.o"); all.push(rt);
    let mut hm: str::String = str::String::make(); hm.push("build/hostrt.o"); all.push(hm);
    let mut mn: str::String = str::String::make(); mn.push("build/hostmain.o"); all.push(mn);
    let mut i: usize = 0;
    while (i < objs.len()) {
        let mut copy_s: str::String = str::String::make();
        copy_s.push(objs.get(i).as_str());
        all.push(copy_s);
        i += 1;
    }
    let flags: i32 = 1 | (need_core * 2);
    return llvm::link(&all, output, flags);
}

fn compile_llvmc(ir: &str, output: &str, opt: &str, need_core: i32) -> i32 {
    let text = sys::cstr(ir);
    let obj = object_path("-llvm.o");
    let m: raw u8 = llvm::parse(raw(text), ir.len());
    if (m.is_null()) {
        sys::unlink(obj);
        return process::EXIT_STOP;
    }
    let obj_path = sys::cstr(obj);
    let opt_flag = sys::cstr(opt);
    let rc: i32 = llvm::object(m, raw(obj_path), raw(opt_flag));
    llvm::dispose(m);
    if (rc != 0) {
        sys::unlink(obj);
        return process::EXIT_STOP;
    }
    let mut objs: vec::Vec<str::String> = vec::Vec<str::String>::make();
    let mut copy_obj: str::String = str::String::make();
    copy_obj.push(obj);
    objs.push(copy_obj);
    let link_rc = link_llvm_objects(&objs, output, need_core);
    sys::unlink(obj);
    return link_rc;
}

// Parallel native backend. Each worker parses and optimises one self-contained
// chunk in its own process; libLLVM is initialised after the fork, so there is
// no shared mutable LLVM state. The parent links every object in order.
fn compile_llvmc_chunks(chunks: &vec::Vec<str::String>, output: &str,
                        opt: &str, need_core: i32) -> i32 {
    let mut pool = process::workers_make();
    let mut objs: vec::Vec<str::String> = vec::Vec<str::String>::make();
    let mut i: usize = 0;
    while (i < chunks.len()) {
        let obj = object_path("-llvm-");
        let mut obj_name: str::String = str::String::make();
        obj_name.push(obj);
        obj_name.push_i64(i as i64);
        obj_name.push(".o");
        let spawned = process::worker_spawn(&mut pool, obj_name.as_str());
        if (spawned < 0) { break; }
        if (spawned == 1) {
            let text = sys::cstr(chunks.get(i).as_str());
            let obj_path = sys::cstr(obj_name.as_str());
            let opt_flag = sys::cstr(opt);
            let m = llvm::parse(raw(text), chunks.get(i).as_str().len());
            if (m.is_null()) { sys::exit(1); }
            let rc = llvm::object(m, raw(obj_path), raw(opt_flag));
            llvm::dispose(m);
            if (rc != 0) { sys::exit(1); }
            process::worker_exit();
        }
        objs.push(obj_name);
        i += 1;
    }
    let mut bad = process::worker_join(&pool);
    if (objs.len() != chunks.len()) { bad = 1; }
    if (bad != 0) {
        let mut k: usize = 0;
        while (k < objs.len()) { sys::unlink(objs.get(k).as_str()); k += 1; }
        return process::EXIT_STOP;
    }
    let rc = link_llvm_objects(&objs, output, need_core);
    let mut k: usize = 0;
    while (k < objs.len()) { sys::unlink(objs.get(k).as_str()); k += 1; }
    return rc;
}

fn render_diags(ds: &vec::Vec<fmt::Diag>, format: i32, all: i32,
                ascii: i32, no_color: i32) {
    // Colour is decoration only (§16.3). It is on for an interactive terminal
    // unless the user asks for ASCII, plain output, or sets NO_COLOR.
    let mut color = 1;
    if (ascii != 0 || no_color != 0 || sys::env_has("NO_COLOR")) { color = 0; }
    if (!sys::is_terminal(1)) { color = 0; }
    let opts = diagnostics::Options {
        .format = format, .all = all, .ascii = ascii, .color = color,
    };
    diagnostics::render_all(ds, &opts);
}

// Parse-only AST dump (the legacy compiler's `--dump-ast` surface). It reads
// one module, scans it, prints the tree, and stops before name resolution.
export fn dump_ast(path: &str, format: i32, all: i32,
                   ascii: i32, no_color: i32) -> i32 {
    let file = sys::read_file(path);
    if (file.ok != 0) {
        eprintln("harmony: module not found: {}", path);
        return process::EXIT_USAGE;
    }
    let mut arena: mem::Arena = mem::Arena { .cur = Raw::null() };
    let mut lx: ctx::Ctx = ctx::make(file.data, path);
    scan::scan(&mut lx, &mut arena);
    let mut ns: node::Nodes = node::nodes_make();
    let mut p: pctx::Parser = pctx::make(&mut ns, lx.toks.clone(), path);
    let root = item::parse_program(&mut p);
    render_diags(&p.diags, format, all, ascii, no_color);
    if (root < 0 || diagnostics::stop_count(&p.diags) != 0) {
        return process::EXIT_STOP;
    }
    let text = print::dump(&ns, root);
    print("{}", text.as_str());
    return process::EXIT_OK;
}

// The C11 backend is deferred (docs: M7). Keep the legacy CLI surface honest:
// `emit-c` reports a structured ICE-01 instead of being parsed as an input.
export fn emit_c_stub(format: i32, all: i32, ascii: i32, no_color: i32) -> i32 {
    let mut ds: vec::Vec<fmt::Diag> = vec::Vec<fmt::Diag>::make();
    ds.push(fmt::diag("ICE-01", fmt::Severity::Stop, "the C backend is not implemented",
                      "The C11 cross-check backend lands with M7; use the LLVM backend.",
                      "", 0u32, 0u32));
    render_diags(&ds, format, all, ascii, no_color);
    return process::EXIT_STOP;
}

// Runs the full compiler pipeline for one command.
export fn run(cmd: i32, input: &str, output: &str, opt: &str,
             opt_given: i32, format: i32, jobs: i32, llvmc: i32,
             strict: i32, deny_unchecked: i32, all: i32,
             ascii: i32, no_color: i32) -> i32 {
    if (input == "") {
        eprintln("harmony: no input file");
        return process::EXIT_USAGE;
    }
    let root = loader::normalize_path(input);
    let d = discover(root);
    if (d.ok != 0) {
        // A missing *input file* remains a usage error (exit 2), matching the
        // legacy driver. A missing *import* is a structured NAME-04 stop.
        if (d.missing == root) {
            eprintln("harmony: module not found: {}", d.missing);
            return process::EXIT_USAGE;
        }
        let mut ds: vec::Vec<fmt::Diag> = vec::Vec<fmt::Diag>::make();
        ds.push(fmt::diag("NAME-04", fmt::Severity::Stop, "module not found",
                          "The imported file does not exist.", d.missing,
                          1u32, 0u32));
        render_diags(&ds, format, all, ascii, no_color);
        return process::EXIT_STOP;
    }
    let need_core = uses_llvmc(&d.mods);

    let mut arena: mem::Arena = mem::Arena { .cur = Raw::null() };
    let mut ns: node::Nodes = node::nodes_make();
    let loaded = loader::load(&mut ns, &mut arena, &d.mods, root);
    render_diags(&loaded.diags, format, all, ascii, no_color);
    if (loaded.program < 0 || diagnostics::stop_count(&loaded.diags) != 0) {
        return process::EXIT_STOP;
    }

    let mut c = check::make(ns, root);
    let mut smi: usize = 0;
    while (smi < d.mods.len()) {
        check::add_source(&mut c, d.mods.get(smi).path, d.mods.get(smi).src);
        smi += 1;
    }
    c.deny_unchecked = deny_unchecked;
    check::check_program(&mut c, loaded.program);
    if (diagnostics::stop_count(&c.diags) != 0) {
        render_diags(&c.diags, format, all, ascii, no_color);
        return process::EXIT_STOP;
    }
    // M2: type-correct programs get definite-move dataflow. A type error in
    // any function already stopped the pipeline, so ownership diagnostics
    // never cascade from a broken type table.
    let mut fi: usize = 0;
    while (fi < c.fns.len()) {
        let fh = *c.fns.get(fi);
        let f = node::get(&c.nodes, fh);
        if (f.b >= 0 && f.instance != 4) {
            let _ = moves::check_fn(&mut c, fh);
        }
        fi += 1;
    }
    if (diagnostics::stop_count(&c.diags) != 0) {
        render_diags(&c.diags, format, all, ascii, no_color);
        return process::EXIT_STOP;
    }
    // M3: loan checking runs only for programs that are type-correct and
    // move-correct, so a broken table never produces loan cascades.
    fi = 0;
    while (fi < c.fns.len()) {
        let fh = *c.fns.get(fi);
        let f = node::get(&c.nodes, fh);
        if (f.b >= 0 && f.instance != 4) {
            let _ = loans::check_fn(&mut c, fh);
        }
        fi += 1;
    }
    if (diagnostics::stop_count(&c.diags) != 0) {
        render_diags(&c.diags, format, all, ascii, no_color);
        return process::EXIT_STOP;
    }
    // M4: region/lifetime checking is the last semantic gate. It runs only
    // for programs that are type-, move- and loan-correct.
    fi = 0;
    while (fi < c.fns.len()) {
        let fh = *c.fns.get(fi);
        let f = node::get(&c.nodes, fh);
        if (f.b >= 0 && f.instance != 4) {
            let _ = lifetimes::check_fn(&mut c, fh);
        }
        fi += 1;
    }
    if (diagnostics::stop_count(&c.diags) != 0) {
        render_diags(&c.diags, format, all, ascii, no_color);
        return process::EXIT_STOP;
    }
    render_diags(&c.diags, format, all, ascii, no_color);
    if (strict != 0 && diagnostics::warn_count(&c.diags) > 0) {
        return process::EXIT_STOP;
    }
    if (cmd == 2) { return process::EXIT_OK; }   // check

    let mut binary = output;
    let default_binary = temp_path(".bin", "");
    if (binary == "") { binary = default_binary; }

    if (cmd == 3) {   // emit-llvm: always the one byte-identical module
        let ir = emit::emit_module(&mut c, loaded.program, jobs);
        if (opt_given == 0) {
            print("{}", ir);
            return process::EXIT_OK;
        }
        let log = temp_path(".clang.log", "");
        let a = optimize_args(opt);
        let rc = process::spawn_with_input(&a, ir, log);
        if (rc != 0) { print_clang_error(log); }
        sys::unlink_if_empty(log);
        return rc;
    }

    let mut rc: i32 = 0;
    if (llvmc != 0) {
        let chunks = emit::emit_module_chunks(&mut c, loaded.program, jobs);
        if (chunks.len() > 1) {
            rc = compile_llvmc_chunks(&chunks, binary, opt, need_core);
        } else {
            rc = compile_llvmc(chunks.get(0).as_str(), binary, opt, need_core);
        }
    } else {
        // A program that calls the LLVM-C shim cannot use the freestanding
        // runtime link; clang compiles it to an object and the host link
        // template supplies libLLVM and the host entry point.
        let full = emit::emit_module(&mut c, loaded.program, jobs);
        if (str::find(full, "hc_llvm_") >= 0) {
            let obj = object_path("-clang.o");
            let mut obj_name: str::String = str::String::make();
            obj_name.push(obj);
            if (compile_clang_object(full, obj_name.as_str(), opt) == 0) {
                let mut objs: vec::Vec<str::String> = vec::Vec<str::String>::make();
                objs.push(obj_name);
                rc = link_llvm_objects(&objs, binary, 1);
            } else {
                rc = 1;
            }
            sys::unlink(obj);
        } else {
            let chunks = emit::emit_module_chunks(&mut c, loaded.program, jobs);
            if (chunks.len() > 1) {
                rc = compile_chunks(&chunks, binary, opt);
                if (rc == -1) {
                    // Fork or spawn failed before any object was linked:
                    // retry with the original single-module clang invocation.
                    let again = emit::emit_module(&mut c, loaded.program, jobs);
                    let log = temp_path(".clang.log", "");
                    let a = build_args(binary, opt);
                    rc = process::spawn_with_input(&a, again, log);
                    if (rc != 0) { print_clang_error(log); }
                    sys::unlink_if_empty(log);
                }
            } else {
                let log = temp_path(".clang.log", "");
                let a = build_args(binary, opt);
                rc = process::spawn_with_input(&a, chunks.get(0).as_str(), log);
                if (rc != 0) { print_clang_error(log); }
                sys::unlink_if_empty(log);
            }
        }
    }
    if (rc != 0) { return process::EXIT_STOP; }
    if (cmd == 0) { return process::EXIT_OK; }   // build
    let run_rc = run_binary(binary);
    if (output == "") { sys::unlink(binary); }
    return run_rc;
}
