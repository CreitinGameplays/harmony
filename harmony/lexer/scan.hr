// harmony/lexer/scan.hr — the Harmony scanner (roadmap/harmony R2).
//
// Byte-oriented, UTF-8 transparent: identifiers accept any byte >= 128 as a
// continuation (so a non-ASCII identifier stays one token), and the byte
// view of a `&str` is the only thing the scanner indexes. A `'` always
// starts a char literal (§4.3 -- lifetimes use `life(...)`, not ticks), so
// there is no unclosed-char ambiguity.
//
// Token spellings are slices of the source, not arena copies, so the common
// path allocates nothing per token. Only a cooked string (escapes expanded)
// needs the arena, and that is passed in by the caller.
//
// The token stream must match harmony-base's `--dump-tokens` byte for byte;
// tests/harmony-final/tokens/ diff the two on a corpus that covers every
// token class.
import "../../library/core/vec.hr";
import "../../library/core/str.hr";
import "../../library/core/fmt.hr";
import "../../library/core/mem.hr";
import "token.hr";
import "ctx.hr";
import "lit.hr";
import "quoted.hr";

// ---------------------------------------------------------------------------
// Keywords (§4.2). `life` is deliberately absent: it is contextual, so it
// only becomes a keyword in a generic list or a type, which the parser
// decides. Everything else here is unconditional.
// ---------------------------------------------------------------------------
fn is_keyword(s: &str) -> bool {
    // A chain, not a `switch`: harmony-base's switch patterns are scalar
    // literals, and a `&str` subject cannot match a string pattern.
    if (s == "fn") { return true; }
    // v1: the trait-like feature is a keyword (§20.4). harmony-base stays v0
    // and still lexes it as a reserved word, never as a declaration.
    if (s == "abilities") { return true; }
    if (s == "let") { return true; }
    if (s == "mut") { return true; }
    if (s == "const") { return true; }
    if (s == "struct") { return true; }
    if (s == "enum") { return true; }
    if (s == "methods") { return true; }
    if (s == "copy") { return true; }
    if (s == "export") { return true; }
    if (s == "import") { return true; }
    if (s == "extern") { return true; }
    if (s == "if") { return true; }
    if (s == "else") { return true; }
    if (s == "while") { return true; }
    if (s == "for") { return true; }
    if (s == "switch") { return true; }
    if (s == "case") { return true; }
    if (s == "default") { return true; }
    if (s == "return") { return true; }
    if (s == "break") { return true; }
    if (s == "continue") { return true; }
    if (s == "unchecked") { return true; }
    if (s == "raw") { return true; }
    if (s == "self") { return true; }
    if (s == "true") { return true; }
    if (s == "false") { return true; }
    if (s == "as") { return true; }
    if (s == "sizeof") { return true; }
    if (s == "heap") { return true; }
    return false;
}

// Identifiers `[A-Za-z_][A-Za-z0-9_]*`, plus non-ASCII payload bytes so a
// UTF-8 name stays a single token.
fn scan_ident(c: &mut ctx::Ctx) {
    let start = c.pos;
    let line = c.line;
    let col = c.col;
    ctx::bump(c);   // the first byte was already checked by the driver
    while (str::is_ident_cont(ctx::at(&*c, 0)) || ctx::at(&*c, 0) >= 128u8) {
        ctx::bump(c);
    }
    let text = ctx::spelling(&*c, start, c.pos);
    let k = token::TokKind::Ident;
    if (is_keyword(text)) {
        ctx::push(c, token::TokKind::Keyword, text, start, c.pos, line, col, 0, "");
    } else {
        ctx::push(c, k, text, start, c.pos, line, col, 0, "");
    }
}

// Trivia: whitespace and comments, including nested block comments. Returns
// true when anything was skipped (caller re-checks at EOF).
fn skip_trivia(c: &mut ctx::Ctx) -> bool {
    let mut skipped = false;
    while (ctx::at(&*c, 0) != 0u8) {
        let ch = ctx::at(&*c, 0);
        if (ch == 32u8 || ch == 9u8 || ch == 10u8 || ch == 13u8
            || ch == 11u8 || ch == 12u8) {
            ctx::bump(c);
            skipped = true;
            continue;
        }
        if (ch == 47u8 && ctx::at(&*c, 1) == 47u8) {
            // // to end of line (a trailing \r is left for the whitespace
            // branch, which does not advance the line counter for it).
            while (ctx::at(&*c, 0) != 0u8 && ctx::at(&*c, 0) != 10u8) {
                ctx::bump(c);
            }
            skipped = true;
            continue;
        }
        if (ch == 47u8 && ctx::at(&*c, 1) == 42u8) {
            // /* ... */, nesting
            ctx::bump(c);
            ctx::bump(c);
            let mut depth: i32 = 1;
            skipped = true;
            while (depth > 0 && ctx::at(&*c, 0) != 0u8) {
                if (ctx::at(&*c, 0) == 47u8 && ctx::at(&*c, 1) == 42u8) {
                    ctx::bump(c);
                    ctx::bump(c);
                    depth += 1;
                } else if (ctx::at(&*c, 0) == 42u8 && ctx::at(&*c, 1) == 47u8) {
                    ctx::bump(c);
                    ctx::bump(c);
                    depth -= 1;
                } else {
                    ctx::bump(c);
                }
            }
            if (depth > 0) {
                ctx::error(c, "LEX-01", "unclosed block comment",
                           "A block comment must end with `*/`.");
            }
            continue;
        }
        break;
    }
    return skipped;
}

// ---------------------------------------------------------------------------
// Punctuation and operators. Two-byte forms are tested first so `>>` is one
// token, not two `>` (the parser splits it when generic nesting needs it).
// ---------------------------------------------------------------------------
fn two_byte(c: &mut ctx::Ctx) -> bool {
    let a = ctx::at(&*c, 0);
    let b = ctx::at(&*c, 1);
    let start = c.pos;
    let line = c.line;
    let col = c.col;
    let mut k: i32 = -1;
    // The pairs are encoded as (first, second, kind). Rather than a table
    // (no function pointers / no tuples in this language), test each pair.
    if (a == 45u8 && b == 62u8) { k = 18; }        // ->
    else if (a == 58u8 && b == 58u8) { k = 21; }   // ::
    else if (a == 46u8 && b == 46u8) { k = 22; }   // ..
    else if (a == 60u8 && b == 60u8) { k = 28; }   // <<
    else if (a == 62u8 && b == 62u8) { k = 29; }   // >>
    else if (a == 38u8 && b == 38u8) { k = 32; }   // &&
    else if (a == 124u8 && b == 124u8) { k = 33; } // ||
    else if (a == 61u8 && b == 61u8) { k = 34; }   // ==
    else if (a == 33u8 && b == 61u8) { k = 35; }   // !=
    else if (a == 60u8 && b == 61u8) { k = 36; }   // <=
    else if (a == 62u8 && b == 61u8) { k = 37; }   // >=
    else if (a == 43u8 && b == 61u8) { k = 42; }   // +=
    else if (a == 45u8 && b == 61u8) { k = 43; }   // -=
    else if (a == 42u8 && b == 61u8) { k = 44; }   // *=
    else if (a == 47u8 && b == 61u8) { k = 45; }   // /=
    else if (a == 37u8 && b == 61u8) { k = 46; }   // %=
    else if (a == 38u8 && b == 61u8) { k = 47; }   // &=
    else if (a == 124u8 && b == 61u8) { k = 48; }  // |=
    else if (a == 94u8 && b == 61u8) { k = 49; }   // ^=
    if (k < 0) { return false; }
    // `..=` is three bytes: the two-byte `..` is recognized first, then
    // extended here so its spelling is the whole operator.
    ctx::bump(c);
    ctx::bump(c);
    if (k == 22 && ctx::at(&*c, 0) == 61u8) {
        ctx::bump(c);
        k = 23;   // ..=
    }
    ctx::push(c, kind_from_code(k), ctx::spelling(&*c, start, c.pos),
              start, c.pos, line, col, 0, "");
    return true;
}

// Maps the small kind codes used above to TokKind. Kept in one switch so the
// pairing table stays readable.
fn kind_from_code(k: i32) -> token::TokKind {
    switch (k) {
        case 18: { return token::TokKind::Arrow; }
        case 19: { return token::TokKind::FatArrow; }
        case 21: { return token::TokKind::DColon; }
        case 22: { return token::TokKind::Range; }
        case 23: { return token::TokKind::RangeInclusive; }
        case 28: { return token::TokKind::Shl; }
        case 29: { return token::TokKind::Shr; }
        case 32: { return token::TokKind::AndAnd; }
        case 33: { return token::TokKind::OrOr; }
        case 34: { return token::TokKind::EqEq; }
        case 35: { return token::TokKind::Neq; }
        case 36: { return token::TokKind::Le; }
        case 37: { return token::TokKind::Ge; }
        case 42: { return token::TokKind::PlusEq; }
        case 43: { return token::TokKind::MinusEq; }
        case 44: { return token::TokKind::StarEq; }
        case 45: { return token::TokKind::SlashEq; }
        case 46: { return token::TokKind::PercentEq; }
        case 47: { return token::TokKind::AmpEq; }
        case 48: { return token::TokKind::PipeEq; }
        case 49: { return token::TokKind::CaretEq; }
        default: { return token::TokKind::Dot; }
    }
}

fn one_byte(c: &mut ctx::Ctx) -> bool {
    let ch = ctx::at(&*c, 0);
    let start = c.pos;
    let line = c.line;
    let col = c.col;
    let mut k: token::TokKind;
    switch (ch) {
        case 40: { k = token::TokKind::LParen; }       // (
        case 41: { k = token::TokKind::RParen; }       // )
        case 123: { k = token::TokKind::LBrace; }      // {
        case 125: { k = token::TokKind::RBrace; }      // }
        case 91: { k = token::TokKind::LBracket; }     // [
        case 93: { k = token::TokKind::RBracket; }     // ]
        case 44: { k = token::TokKind::Comma; }        // ,
        case 58: { k = token::TokKind::Colon; }        // :
        case 59: { k = token::TokKind::Semi; }         // ;
        case 46: { k = token::TokKind::Dot; }          // .
        case 43: { k = token::TokKind::Plus; }         // +
        case 45: { k = token::TokKind::Minus; }        // -
        case 42: { k = token::TokKind::Star; }         // *
        case 47: { k = token::TokKind::Slash; }        // /
        case 37: { k = token::TokKind::Percent; }      // %
        case 38: { k = token::TokKind::Amp; }          // &
        case 124: { k = token::TokKind::Pipe; }        // |
        case 94: { k = token::TokKind::Caret; }        // ^
        case 126: { k = token::TokKind::Tilde; }       // ~
        case 33: { k = token::TokKind::Not; }          // !
        case 60: { k = token::TokKind::Lt; }           // <
        case 62: { k = token::TokKind::Gt; }           // >
        case 61: { k = token::TokKind::Assign; }       // =
        default: { return false; }
    }
    ctx::bump(c);
    ctx::push(c, k, ctx::spelling(&*c, start, c.pos), start, c.pos,
              line, col, 0, "");
    return true;
}

// Main entry: scan the whole source into `c.toks`, appending an EOF token.
// Diagnostics are accumulated in `c.diags`; one bad byte is skipped so a
// single error does not cascade into hundreds.
export fn scan(c: &mut ctx::Ctx, arena: &mut mem::Arena) {
    while (ctx::at(&*c, 0) != 0u8) {
        skip_trivia(c);
        if (ctx::at(&*c, 0) == 0u8) { break; }
        let ch = ctx::at(&*c, 0);
        // `b'...'` is a byte literal, so test it before the identifier path
        // (`b` is an identifier start).
        if (ch == 98u8 && ctx::at(&*c, 1) == 39u8) {
            quoted::quoted_char(c, arena, true);
            continue;
        }
        if (str::is_ident_start(ch) || ch >= 128u8) {
            scan_ident(c);
            continue;
        }
        if (str::is_digit(ch)) {
            lit::number(c);
            continue;
        }
        if (ch == 39u8) {
            quoted::quoted_char(c, arena, false);
            continue;
        }
        if (ch == 34u8) {
            quoted::quoted_string(c, arena);
            continue;
        }
        if (two_byte(c)) { continue; }
        if (one_byte(c)) { continue; }
        // Nothing matched: report and skip one byte.
        ctx::error(c, "SYN-05", "unexpected byte",
                   "This byte cannot start a token.");
        ctx::bump(c);
    }
    ctx::push(c, token::TokKind::Eof, "", c.pos, c.pos,
              c.line, c.col, 0, "");
}
