// harmony/sema/types.hr — the type table (roadmap/harmony R5).
//
// Types are small integer ids, with the same fixed ids and the same CTY_*
// kinds as harmony-base (common.c2). Keeping them identical lets the two
// compilers stamp and compare types byte for byte. Composite entries are
// created on demand; `ty_eq`, `ty_size` and `ty_align` are pure functions of
// the table, so the checker and the backend agree on layout.
//
// The tables are flat `Vec` structures (not `Vec<T>` of pointers), mirroring
// harmony-base's `g_types[id].kind` / `g_members[mstart + i].ty` access shape.
import "../../library/core/str.hr";
import "../../library/core/vec.hr";

// ---- fixed ids (common.c2) ------------------------------------------------

export const TY_INVALID: i32 = 0;
export const TY_I8: i32 = 1;
export const TY_I16: i32 = 2;
export const TY_I32: i32 = 3;
export const TY_I64: i32 = 4;
export const TY_ISIZE: i32 = 5;
export const TY_U8: i32 = 6;
export const TY_U16: i32 = 7;
export const TY_U32: i32 = 8;
export const TY_U64: i32 = 9;
export const TY_USIZE: i32 = 10;
export const TY_F32: i32 = 11;
export const TY_F64: i32 = 12;
export const TY_BOOL: i32 = 13;
export const TY_CHAR: i32 = 14;
export const TY_NEVER: i32 = 15;
export const TY_UNIT: i32 = 16;
export const TY_UINT_LIT: i32 = 17;
export const TY_FLOAT_LIT: i32 = 18;
export const TY_DYNAMIC: i32 = 100;

export const CTY_STRUCT: i32 = 200;
export const CTY_ENUM: i32 = 201;
export const CTY_ARRAY: i32 = 202;
export const CTY_REF: i32 = 203;
export const CTY_MUTREF: i32 = 204;
export const CTY_STRREF: i32 = 205;
export const CTY_HEAP: i32 = 206;
export const CTY_UINT_LIT: i32 = 207;
export const CTY_FLOAT_LIT: i32 = 208;
export const CTY_PTR: i32 = 209;
export const CTY_MUTPTR: i32 = 210;
export const CTY_SLICE: i32 = 211;
export const CTY_GENPARAM: i32 = 212;
// v1: a first-class function pointer type `fn(A, B) -> R`. `a` is the return
// type; the parameter types live in the member list (like a tuple). It is a
// scalar, pointer-sized type, never a nominal aggregate.
export const CTY_FN: i32 = 213;

// ---- storage --------------------------------------------------------------

copy struct Member {
    name: &str;
    ty: i32;
}

copy struct TypeEntry {
    kind: i32;
    a: i32;
    b: i32;
    name: &str;
    mstart: usize;
    nmembers: usize;
    decl: i32;        // AST handle of the declaring node (-1 for built-ins)
    size: i32;        // 0 = not computed
    align: i32;
    nocopy: i32;
    computing: i32;   // re-entrancy guard for recursive-by-value types
}

export struct Types {
    entries: vec::Vec<TypeEntry>;
    members: vec::Vec<Member>;
}



// Creates a new entry at id = entries.len() and returns that id. Slot 0 is
// reserved (TY_INVALID) so id 0 never means a real type.

// Registers the fixed primitive ids. Called once per compilation.


// ---- constructors ---------------------------------------------------------





// ---- accessors ------------------------------------------------------------






// ---- predicates -----------------------------------------------------------

// ---- structural equality --------------------------------------------------

// Nominal types compare by id (the table dedups by name); composites compare
// by constructor and parts. An untyped literal adapts to any numeric type of
// its class (§5.9).

// ---- layout ---------------------------------------------------------------


// Byte size, mirroring harmony-base's ty_size: a function of the type alone,
// cached on first use, with a re-entrancy guard for recursive-by-value types.


// Byte offset of struct member i.

// ---- member lookup --------------------------------------------------------




// A display name for a reference type: "raw mut i32", "&i32", "&mut i32".

fn blank() -> TypeEntry {
    return TypeEntry {
        .kind = 0, .a = 0, .b = 0, .name = "",
        .mstart = 0, .nmembers = 0, .decl = -1, .size = 0, .align = 0,
        .nocopy = 0, .computing = 0,
    };
}

fn alloc_entry(t: &mut Types) -> i32 {
    let mut e = blank();
    e.mstart = t.members.len();
    t.entries.push(e);
    return t.entries.len() as i32 - 1;
}


export fn make() -> Types {
    let t = Types {
        .entries = vec::Vec<TypeEntry>::make(),
        .members = vec::Vec<Member>::make(),
    };
    return t;
}

fn set_prim(t: &mut Types, id: i32, kind: i32, name: &str) {
    let mut e = *t.entries.get(id as usize);
    e.kind = kind;
    e.name = name;
    t.entries.set(id as usize, e);
}

export fn reset(t: &mut Types) {
    t.entries.clear();
    t.members.clear();
    alloc_entry(t);   // 0: TY_INVALID
    // Gap 19..99 stays zeroed; the dynamic ids start at 100. We fill each
    // slot explicitly so a stray id in the gap reads as "no type".
    let mut i: i32 = 1;
    while (i < TY_DYNAMIC) {
        alloc_entry(t);
        i += 1;
    }
    set_prim(t, TY_UINT_LIT, CTY_UINT_LIT, "integer literal");
    set_prim(t, TY_FLOAT_LIT, CTY_FLOAT_LIT, "float literal");
    set_prim(t, TY_I8, TY_I8, "i8");
    set_prim(t, TY_I16, TY_I16, "i16");
    set_prim(t, TY_I32, TY_I32, "i32");
    set_prim(t, TY_I64, TY_I64, "i64");
    set_prim(t, TY_ISIZE, TY_ISIZE, "isize");
    set_prim(t, TY_U8, TY_U8, "u8");
    set_prim(t, TY_U16, TY_U16, "u16");
    set_prim(t, TY_U32, TY_U32, "u32");
    set_prim(t, TY_U64, TY_U64, "u64");
    set_prim(t, TY_USIZE, TY_USIZE, "usize");
    set_prim(t, TY_F32, TY_F32, "f32");
    set_prim(t, TY_F64, TY_F64, "f64");
    set_prim(t, TY_BOOL, TY_BOOL, "bool");
    set_prim(t, TY_CHAR, TY_CHAR, "char");
    set_prim(t, TY_NEVER, TY_NEVER, "never");
    set_prim(t, TY_UNIT, TY_UNIT, "()");
}

export fn new_type(t: &mut Types, kind: i32, name: &str, a: i32, b: i32) -> i32 {
    let id = alloc_entry(t);
    let mut e = blank();
    e.kind = kind;
    e.name = name;
    e.a = a;
    e.b = b;
    t.entries.set(id as usize, e);
    return id;
}

export fn new_named(t: &mut Types, kind: i32, name: &str, decl: i32) -> i32 {
    let id = alloc_entry(t);
    let mut e = blank();
    e.kind = kind;
    e.name = name;
    e.decl = decl;
    t.entries.set(id as usize, e);
    return id;
}

export fn add_member(t: &mut Types, id: i32, name: &str, ty: i32) {
    let mut e = *t.entries.get(id as usize);
    // A type's members are contiguous, so the start is fixed on the first
    // add (payload construction can interleave with other types' members).
    if (e.nmembers == 0) { e.mstart = t.members.len(); }
    e.nmembers += 1;
    t.entries.set(id as usize, e);
    t.members.push(Member { .name = name, .ty = ty });
}

export fn member_count(t: &Types, id: i32) -> usize {
    if (id <= 0 || id >= t.entries.len() as i32) { return 0; }
    return t.entries.get(id as usize).nmembers;
}

export fn type_kind(t: &Types, id: i32) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return 0; }
    return t.entries.get(id as usize).kind;
}

export fn tname(t: &Types, id: i32) -> &str {
    if (id <= 0 || id >= t.entries.len() as i32) { return "?"; }
    let n = t.entries.get(id as usize).name;
    if (n != "") { return n; }
    if (t.entries.get(id as usize).kind == CTY_UINT_LIT) { return "integer"; }
    if (t.entries.get(id as usize).kind == CTY_FLOAT_LIT) { return "float"; }
    return "?";
}

export fn set_a(t: &mut Types, id: i32, a: i32) {
    if (id <= 0 || id >= t.entries.len() as i32) { return; }
    let mut e = *t.entries.get(id as usize);
    e.a = a;
    t.entries.set(id as usize, e);
}

export fn elem(t: &Types, id: i32) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return 0; }
    return t.entries.get(id as usize).a;
}

export fn array_len(t: &Types, id: i32) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return 0; }
    return t.entries.get(id as usize).b;
}

export fn tdecl(t: &Types, id: i32) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return -1; }
    return t.entries.get(id as usize).decl;
}

export fn is_primitive(id: i32) -> bool {
    return id >= TY_I8 && id <= TY_UNIT;
}

export fn is_integer(id: i32) -> bool {
    return (id >= TY_I8 && id <= TY_ISIZE) || (id >= TY_U8 && id <= TY_USIZE);
}

export fn is_signed(id: i32) -> bool { return id >= TY_I8 && id <= TY_ISIZE; }
export fn is_unsigned(id: i32) -> bool { return id >= TY_U8 && id <= TY_USIZE; }

export fn is_float(id: i32) -> bool { return id == TY_F32 || id == TY_F64; }
export fn is_bool(id: i32) -> bool { return id == TY_BOOL; }

export fn is_char(id: i32) -> bool { return id == TY_CHAR; }
export fn is_untyped_lit(id: i32) -> bool {
    return id == TY_UINT_LIT || id == TY_FLOAT_LIT;
}

export fn is_ref(t: &Types, id: i32) -> bool {
    let k = type_kind(t, id);
    return k == CTY_REF || k == CTY_MUTREF || k == CTY_STRREF;
}

export fn is_thin_ref(t: &Types, id: i32) -> bool {
    let k = type_kind(t, id);
    return k == CTY_REF || k == CTY_MUTREF;
}

export fn is_heap(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_HEAP; }
export fn is_array(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_ARRAY; }

export fn is_slice(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_SLICE; }
export fn is_nominal(t: &Types, id: i32) -> bool {
    let k = type_kind(t, id);
    return k == CTY_STRUCT || k == CTY_ENUM;
}

export fn is_ptr(t: &Types, id: i32) -> bool {
    let k = type_kind(t, id);
    return k == CTY_PTR || k == CTY_MUTPTR;
}

export fn is_enum(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_ENUM; }
export fn is_struct(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_STRUCT; }

export fn is_genparam(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_GENPARAM; }

// v1 function-pointer helpers. `a` is the return type and the member list
// holds the parameter types in declaration order.
export fn is_fn(t: &Types, id: i32) -> bool { return type_kind(t, id) == CTY_FN; }
export fn fn_ret(t: &Types, id: i32) -> i32 {
    if (!is_fn(t, id)) { return TY_INVALID; }
    return elem(t, id);
}
export fn fn_param_count(t: &Types, id: i32) -> usize {
    if (!is_fn(t, id)) { return 0; }
    return member_count(t, id);
}
export fn fn_param(t: &Types, id: i32, i: i32) -> i32 {
    if (!is_fn(t, id)) { return TY_INVALID; }
    return member_type(t, id, i);
}


export fn eq(a: i32, b: i32, t: &Types) -> bool {
    if (a == b) { return true; }
    if (a == TY_UINT_LIT) { return is_integer(b) || b == TY_UINT_LIT; }
    if (b == TY_UINT_LIT) { return is_integer(a) || a == TY_UINT_LIT; }
    if (a == TY_FLOAT_LIT) { return is_float(b) || b == TY_FLOAT_LIT; }
    if (b == TY_FLOAT_LIT) { return is_float(a) || a == TY_FLOAT_LIT; }
    if (a <= 0 || a >= t.entries.len() as i32 || b <= 0 || b >= t.entries.len() as i32) {
        return false;
    }
    if (type_kind(t, a) != type_kind(t, b)) { return false; }
    let k = type_kind(t, a);
    // Generic parameters are stand-ins: two references to `T` name the same
    // type even though each resolution allocated its own placeholder id.
    if (k == CTY_GENPARAM) { return tname(t, a) == tname(t, b); }
    // Function pointers are structural: same return and parameter types.
    if (k == CTY_FN) {
        if (!eq(elem(t, a), elem(t, b), &*t)) { return false; }
        if (member_count(t, a) != member_count(t, b)) { return false; }
        let mut i: usize = 0;
        while (i < member_count(t, a)) {
            if (!eq(member_type(t, a, i as i32), member_type(t, b, i as i32), &*t)) {
                return false;
            }
            i += 1;
        }
        return true;
    }
    if (k == CTY_ARRAY) {
        return eq(elem(t, a), elem(t, b), &*t) && array_len(t, a) == array_len(t, b);
    }
    if (k == CTY_REF || k == CTY_MUTREF || k == CTY_HEAP
        || k == CTY_PTR || k == CTY_MUTPTR || k == CTY_STRREF) {
        return eq(elem(t, a), elem(t, b), &*t);
    }
    // Slices compare by element *and* exclusivity (§5.2).
    if (k == CTY_SLICE) {
        return eq(elem(t, a), elem(t, b), &*t) && t.entries.get(a as usize).b == t.entries.get(b as usize).b;
    }
    return false;
}

fn align_up(n: i32, a: i32) -> i32 {
    if (a <= 1) { return n; }
    return (n + a - 1) & (0 - a);
}

export fn size(id: i32, t: &mut Types) -> i32 {
    if (id == TY_INVALID) { return 0; }
    if (id == TY_UNIT || id == TY_NEVER) { return 0; }
    if (id == TY_FLOAT_LIT) { return 8; }
    if (id == TY_UINT_LIT) { return 4; }
    if (is_primitive(id)) {
        if (id == TY_I8 || id == TY_U8 || id == TY_BOOL) { return 1; }
        if (id == TY_I16 || id == TY_U16) { return 2; }
        if (id == TY_I32 || id == TY_U32 || id == TY_F32 || id == TY_CHAR) { return 4; }
        return 8;
    }
    if (id <= 0 || id >= t.entries.len() as i32) { return 0; }
    let e = *t.entries.get(id as usize);
    if (e.size != 0) { return e.size; }
    if (e.computing != 0) { return 0; }
    let mut ne = e;
    ne.computing = 1;
    t.entries.set(id as usize, ne);
    let k = e.kind;
    let mut sz: i32 = 8;
    let mut al: i32 = 0;
    if (k == CTY_REF || k == CTY_MUTREF || k == CTY_PTR || k == CTY_MUTPTR
        || k == CTY_HEAP || k == CTY_FN) {
        sz = 8;
    } else if (k == CTY_STRREF || k == CTY_SLICE) {
        sz = 16;
    } else if (k == CTY_ARRAY) {
        sz = size(e.a, t) * e.b;
    } else if (k == CTY_STRUCT) {
        let mut off: i32 = 0;
        let mut amax: i32 = 1;
        let mut i: usize = 0;
        while (i < e.nmembers) {
            let ft = t.members.get(e.mstart + i).ty;
            let fs = size(ft, t);
            let fa = align(ft, t);
            off = align_up(off, fa);
            off += fs;
            if (fa > amax) { amax = fa; }
            i += 1;
        }
        sz = align_up(off, amax);
        al = amax;
    } else if (k == CTY_ENUM) {
        let mut maxpay: i32 = 0;
        let mut i: usize = 0;
        while (i < e.nmembers) {
            let ps = size(t.members.get(e.mstart + i).ty, t);
            if (ps > maxpay) { maxpay = ps; }
            i += 1;
        }
        // { i32 tag, [4 x i8], [payload x i8] }: tag region 8, payload >= 8.
        if (maxpay == 0) { maxpay = 1; }
        sz = align_up(4, 8) + align_up(maxpay, 8);
        al = 8;
    }
    ne = *t.entries.get(id as usize);
    ne.size = sz;
    if (al != 0) { ne.align = al; }
    ne.computing = 0;
    t.entries.set(id as usize, ne);
    return sz;
}

export fn align(id: i32, t: &mut Types) -> i32 {
    if (is_primitive(id) || is_untyped_lit(id)) {
        if (id == TY_BOOL || id == TY_I8 || id == TY_U8) { return 1; }
        if (id == TY_I16 || id == TY_U16) { return 2; }
        if (size(id, t) == 4) { return 4; }
        return 8;
    }
    if (id <= 0 || id >= t.entries.len() as i32) { return 1; }
    let e = *t.entries.get(id as usize);
    if (e.align != 0) { return e.align; }
    if (e.kind == CTY_ARRAY) { return align(e.a, t); }
    if (is_ref(&*t, id) || is_ptr(&*t, id) || is_heap(&*t, id) || e.kind == CTY_FN
        || e.kind == CTY_SLICE || e.kind == CTY_STRREF) {
        return 8;
    }
    size(id, t);
    let e2 = *t.entries.get(id as usize);
    if (e2.align != 0) { return e2.align; }
    return 1;
}

export fn field_offset(id: i32, i: usize, t: &mut Types) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return 0; }
    let e = *t.entries.get(id as usize);
    if (e.kind != CTY_STRUCT) { return 0; }
    let mut off: i32 = 0;
    let mut j: usize = 0;
    while (j < i && j < e.nmembers) {
        let ft = t.members.get(e.mstart + j).ty;
        off = align_up(off, align(ft, t));
        off += size(ft, t);
        j += 1;
    }
    if (i < e.nmembers) {
        let ft = t.members.get(e.mstart + i).ty;
        off = align_up(off, align(ft, t));
    }
    return off;
}

export fn find_member(t: &Types, id: i32, mname: &str) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return -1; }
    let e = t.entries.get(id as usize);
    let mut i: usize = 0;
    while (i < e.nmembers) {
        if (t.members.get(e.mstart + i).name == mname) { return i as i32; }
        i += 1;
    }
    return -1;
}

export fn member_type(t: &Types, id: i32, i: i32) -> i32 {
    if (id <= 0 || id >= t.entries.len() as i32) { return TY_INVALID; }
    let e = t.entries.get(id as usize);
    if (i < 0 || i as usize >= e.nmembers) { return TY_INVALID; }
    return t.members.get(e.mstart + i as usize).ty;
}

export fn member_name(t: &Types, id: i32, i: i32) -> &str {
    if (id <= 0 || id >= t.entries.len() as i32) { return ""; }
    let e = t.entries.get(id as usize);
    if (i < 0 || i as usize >= e.nmembers) { return ""; }
    return t.members.get(e.mstart + i as usize).name;
}

export fn ref_name(pre: &str, inner: i32, t: &Types) -> &str {
    let mut s: str::String = str::String::make();
    s.push(pre);
    s.push(" ");
    s.push(tname(t, inner));
    return s.as_str();
}

