// harmony-base — shared declarations (header module).
//
// c2x-seed resolves names from earlier files only, and requires a declaration
// before use inside a file. So every shared type and cross-module function is
// declared here, and this file must be listed first on the compiler command
// line. Implementation lives in the later modules.

// ---------------------------------------------------------------------------
// Linux syscall wrappers. The c2x-seed runtime always emits these five as
// global functions (docs/c2x-seed.md "Syscall wrappers").
// ---------------------------------------------------------------------------
extern int syscall_read(int fd, char* buf, int count);
extern int syscall_write(int fd, char* buf, int count);
extern int syscall_open(char* path, int flags, int mode);
extern int syscall_close(int fd);
extern int syscall_exit(int code);

const int FD_STDOUT = 1;
const int FD_STDERR = 2;
const int O_RDONLY = 0;
const int O_WRONLY = 1;
const int O_CREAT = 64;
const int O_TRUNC = 512;

// ---------------------------------------------------------------------------
// Exit codes (docs/harmony.md §16.6). The compiler itself uses 0/1/2; 70 is
// the *compiled program's* trap status, kept here so the runtime (§14.3) can
// share the constant.
// ---------------------------------------------------------------------------
const int EXIT_OK = 0;      // build succeeded (warnings allowed unless --strict)
const int EXIT_STOP = 1;    // at least one STOP (or a WARN under --strict)
const int EXIT_USAGE = 2;   // usage or I/O error (bad flag, missing file)
const int EXIT_TRAP = 70;   // the compiled program trapped (§14.3)

// Diagnostic severities (docs/harmony.md §16.4).
const int SEV_STOP = 0;     // a rule was broken; stops the build
const int SEV_WARN = 1;     // legal but suspicious; stops only under --strict
const int SEV_HINT = 2;     // a suggestion or a translation; never stops

// ---------------------------------------------------------------------------
// Arena allocator: one big static block, bump-allocated, 8-byte aligned.
// Everything the compiler builds (tokens, AST, strings) lives here.
// The size below must stay a literal: c2x-seed cannot use a const as an
// array dimension.
// ---------------------------------------------------------------------------
char* arena_alloc(int n);
char* arena_alloc_str(char* s);
void arena_reset(void);
int arena_used(void);

// ---------------------------------------------------------------------------
// String helpers.
// ---------------------------------------------------------------------------
int str_len(char* s);
int str_eq(char* a, char* b);
int str_has_prefix(char* s, char* prefix);
char* str_copy(char* s);
char* str_concat(char* a, char* b);

// ---------------------------------------------------------------------------
// Raw output (reports -> stdout, driver errors -> stderr).
// ---------------------------------------------------------------------------
void out_str(char* s);
void out_int(int n);
void out_nl(void);
void err_str(char* s);
void err_int(int n);
void err_nl(void);

// ---------------------------------------------------------------------------
// Source manager: a loaded file plus a line index for offset -> line/col.
// ---------------------------------------------------------------------------
struct SourceFile {
    char* path;         // file path as given
    char* data;         // file bytes (arena), NUL-terminated for convenience
    int   len;          // number of bytes
    int*  line_starts;  // byte offset of each line start (arena)
    int   line_count;   // number of lines
};

// Loads a file into the arena. Returns 0 on success, or a negative errno.
int source_load(char* path, struct SourceFile* out);

// 1-based line / 0-based column for a byte offset.
void source_line_col(struct SourceFile* sf, int off, int* line, int* col);

// Returns a pointer to the start of the given 1-based line. The returned
// string is NUL-terminated at the newline (the byte is temporarily masked).
char* source_line(struct SourceFile* sf, int line);

// ---------------------------------------------------------------------------
// Diagnostics (docs/harmony.md §16).
//
// The diagnostic tells the story of the value, not just the location of the
// symptom: a report carries a numbered timeline of source steps (born →
// moved → used…), each labelled, with the triggering step marked. One root
// cause, one report (§16.1). Renderers:
//   * "pretty" (§16.2 anatomy) — the default human format;
//   * "line"   (§16.7)          — one grep-friendly line per diagnostic;
//   * "json"   (§16.7)          — one JSON object per diagnostic.
// By default at most 5 stops are printed, then "…and N more stops (use --all)";
// warnings are capped at 10 (§16.9). Diagnostics are sorted by primary
// location; a warnings-only run prints them after a blank line.
// ---------------------------------------------------------------------------

// Story step roles (docs/harmony.md §16.7 `story[].role`).
const int ROLE_BORN = 0;
const int ROLE_MOVED = 1;
const int ROLE_BORROWED = 2;
const int ROLE_USED = 3;
const int ROLE_MUTATED = 4;
const int ROLE_DROPPED = 5;
const int ROLE_DECLARED = 6;
const int ROLE_DEFINED = 7;

// One timeline step: a source location plus a plain-English label. Exactly
// one step of a report has `trigger` set; it is the one the diagnostic points
// at (marked `◂ here` in the rendered layout, single-site steps use `▸`).
struct Step {
    int   role;       // ROLE_*
    int   file;       // source file index
    int   start;      // byte offset
    int   end;        // byte offset (exclusive)
    char* label;      // plain-English narration (may be 0)
    int   trigger;    // 1 = this step triggers the diagnostic
};

// One `try:`/`or:` fix (§16.2): a short label plus compilable code.
struct Fix {
    char* label;      // "lend it", "give a copy", ...
    char* text;       // compilable replacement (may be 0)
};

struct Diagnostic {
    char* code;       // stable "AREA-NN" id, e.g. "MOVE-01" (§16.10)
    int   sev;        // SEV_*
    char* title;      // one short line, lowercase
    char* summary;    // one or two plain-English sentences (may be 0)
    int   pfile;      // primary location: source file index
    int   pstart;     // primary location: byte offset
    int   pend;       // primary location: byte offset (exclusive)
    int   nstory;
    struct Step story[5];    // the timeline, in time order (§16.2)
    int   nfixes;
    struct Fix fixes[3];     // `try:` first, then `or:` alternatives
};

// Byte sizes as fixed literals (c2x-seed needs literal array dimensions and
// uses an 8-byte field ABI, so every field is one qword).
const int STEP_SIZE = 48;      // 6 fields * 8
const int FIX_SIZE = 16;       // 2 fields * 8
const int DIAG_SIZE = 176;     // 22 fields * 8 (incl. arrays)
const int MAX_STORY = 5;       // §16.2: the story is 1 to 5 steps
const int MAX_FIXES = 3;       // §16.2: 1 to 3 fixes

// Registers a source file so steps can resolve file/line/col.
void diag_register_file(struct SourceFile* sf);

int diag_stop_count(void);
int diag_warn_count(void);
int diag_hint_count(void);
void diag_reset(void);

// Builds a diagnostic (stored, not printed) with no story and no fixes.
// Returns the diagnostic index, or -1 when the table is full. Fill in the
// story and fixes through diag_get(idx) afterwards.
int diag_add(char* code, int sev, char* title, char* summary,
             struct SourceFile* sf, int off, int end);
int diag_stop(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end);
int diag_warn(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end);
int diag_hint(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end);
struct Diagnostic* diag_get(int idx);

// Appends one story step. Returns 0, or -1 when the story is full.
int diag_step(struct Diagnostic* d, int role, int file, int start, int end,
              char* label, int trigger);

// Appends one fix (`try:` when it is the first, otherwise `or:`).
// Returns 0, or -1 when the fix list is full.
int diag_fix(struct Diagnostic* d, char* label, char* text);

// Prints all stored diagnostics, sorted by primary location, capped per
// §16.9 (5 stops / 10 warns unless `all`). `format` is 0=pretty, 1=line,
// 2=json.
void diag_flush(int format, int all);

// A flat message used for driver/usage errors and I/O failures.
void diag_plain(char* id, char* msg);

// ---------------------------------------------------------------------------
// Pipeline (docs/harmony.md §19.1, §19.5).
// ---------------------------------------------------------------------------
const int CMD_BUILD = 0;
const int CMD_RUN = 1;
const int CMD_CHECK = 2;
const int CMD_EMIT_LLVM = 3;
const int CMD_EMIT_C = 4;
const int CMD_EXPLAIN = 5;
const int CMD_AUDIT = 6;

// Output format (docs/harmony.md §16.7): --format=pretty|line|json.
const int FORMAT_PRETTY = 0;
const int FORMAT_LINE = 1;
const int FORMAT_JSON = 2;

// Driver options gathered from the command line.
struct Options {
    int   cmd;
    char* input;        // input .harmony path
    char* output;       // -o target (0 = default)
    int   format;       // FORMAT_* (diagnostics renderer)
    int   all;          // --all: lift the 5-stop / 10-warn caps (§16.9)
    int   strict;       // --strict: a WARN also stops the build (§16.4)
    int   deny_unchecked;// --deny-unchecked: any unchecked is UNCK-05 (§13.4)
    int   dump_ast;      // --dump-ast: print the parse tree (M0 round-trip)
    char* explain_code; // `lc explain <CODE>`: the requested code
    int   ascii;        // --ascii: (1)/(2)/> <-- here glyph fallbacks (§16.3)
    int   no_color;     // --no-color / NO_COLOR (§16.3)
    int   verbose;      // -v
};

// Prints the long-form lesson for a diagnostic code (§16.8). Returns 0 when
// the code exists, -1 otherwise (the caller reports the unknown code).
int explain_lookup(char* code);

// Prints the unchecked audit listing (§13.6): every `unchecked` block and
// `unchecked fn`, with file, line, and reason. No language surface yet, so
// the listing is empty; the scanner plugs in during M6.
void audit_print(void);

// Runs the pipeline for one input file. Returns an exit code (§16.6).
int pipeline_run(struct Options* opts);

// ---------------------------------------------------------------------------
// Lexer (M0, docs/harmony.md §4, §19.1 stage 1).
// ---------------------------------------------------------------------------
const int TOK_EOF = 0;
const int TOK_IDENT = 1;
const int TOK_NUMBER = 2;

// Full v0.3 token set (§4). Kinds are grouped with gaps; the numeric values
// are internal, never rendered.
const int TOK_KEYWORD = 3;     // sval = the keyword spelling
const int TOK_INT = 4;         // literal integer; ival = value, sval = suffix
const int TOK_FLOAT = 5;       // literal float; sval = spelling (suffix last 2)
const int TOK_STRING = 6;      // literal string; sval = cooked value, len = bytes
const int TOK_CHAR = 7;        // literal char; ival = Unicode scalar value
const int TOK_BYTE = 8;        // literal byte b'x'; ival = 0..255

const int TOK_LPAREN = 10;
const int TOK_RPAREN = 11;
const int TOK_LBRACE = 12;
const int TOK_RBRACE = 13;
const int TOK_LBRACKET = 14;
const int TOK_RBRACKET = 15;
const int TOK_COMMA = 16;
const int TOK_COLON = 17;
const int TOK_SEMI = 18;
const int TOK_ARROW = 19;      // ->
const int TOK_FAT_ARROW = 20;  // => (recognized, reserved for v1 patterns)
const int TOK_DOT = 21;
const int TOK_DCOLON = 22;     // ::
const int TOK_RANGE = 23;      // ..
const int TOK_DOTS_EQ = 24;     // ..=

const int TOK_PLUS = 30;
const int TOK_MINUS = 31;
const int TOK_STAR = 32;
const int TOK_SLASH = 33;
const int TOK_PERCENT = 34;
const int TOK_AMP = 35;
const int TOK_PIPE = 36;
const int TOK_CARET = 37;
const int TOK_TILDE = 38;
const int TOK_NOT = 39;        // !
const int TOK_SHL = 40;        // <<
const int TOK_SHR = 41;        // >>
const int TOK_AND = 42;        // &&
const int TOK_OR = 43;         // ||
const int TOK_EQEQ = 44;       // ==
const int TOK_NEQ = 45;        // !=
const int TOK_LE = 46;
const int TOK_GE = 47;
const int TOK_LT = 48;
const int TOK_GT = 49;
const int TOK_ASSIGN = 50;     // =
const int TOK_PLUSEQ = 51;
const int TOK_MINUSEQ = 52;
const int TOK_STAREQ = 53;
const int TOK_SLASHEQ = 54;
const int TOK_PERCENTEQ = 55;
const int TOK_AMPEQ = 56;
const int TOK_PIPEEQ = 57;
const int TOK_CARETEQ = 58;
const int TOK_SHLEQ = 59;
const int TOK_SHREQ = 60;

// Byte size of one `struct Token` in c2x-seed's ABI (every field is a qword;
// 9 fields: kind, text, len, start, end, line, col, ival, sval).
const int TOKEN_SIZE = 72;

struct Token {
    int   kind;
    char* text;     // arena-owned spelling (ident/keyword spelling)
    int   len;
    int   start;    // byte offset
    int   end;      // byte offset (exclusive)
    int   line;     // 1-based
    int   col;      // 0-based
    int   ival;     // INT value / CHAR/BYTE scalar (payload, unused for others)
    char* sval;     // INT suffix / FLOAT spelling / STRING cooked bytes / KEYWORD word
};

// Tokenizes the whole file into an arena array. Returns the token count, or a
// negative value on a lex stop (already reported).
int lexer_run(struct SourceFile* sf, struct Token** out_tokens);

// A stable lowercase name for a token kind (test/verbose dumps, SYN-05 text).
char* tok_kind_name(int kind);

// True when `t` is the keyword spelled `kw` (TOK_KEYWORD only).
int tok_is_kw(struct Token* t, char* kw);

// Copies one Token by field (c2x-seed has no whole-struct assignment).
void tok_copy(struct Token* dst, struct Token* src);

// ---------------------------------------------------------------------------
// Literal scanners (lexer support, §4.3). Each fills `t` (kind, text, span,
// payloads), advances `*pos` past the literal, and returns 1 on success or
// 0 after reporting a lex stop. Byte scanning treats source bytes unsigned.
// ---------------------------------------------------------------------------
int lex_scan_number(struct SourceFile* sf, int* pos, struct Token* t);
int lex_scan_char(struct SourceFile* sf, int* pos, struct Token* t, int is_byte);
int lex_scan_string(struct SourceFile* sf, int* pos, struct Token* t);

// Shared lexer scratch buffer (identifier/literal assembly; one at a time —
// the lexer and the parser both build short names through it, never nested).
void   lexbuf_reset(void);
void   lexbuf_push(char c);
void   lexbuf_push_str(char* s);
char*  lexbuf_finish(void);      // arena copy, NUL-terminated

// Character classes over unsigned bytes (UTF-8 payload passes as ident).
int is_digit(char c);
int is_hexdig(char c);
int is_ident_start(char c);
int is_ident(char c);
int hexval(char c);              // hex digit value (caller checked)
int digit_in_radix(char c, int radix);
int utf8_len(char lead);         // 1..4, or 0 = invalid lead byte
int utf8_decode(char* p, int len);

// ---------------------------------------------------------------------------
// AST (M0, docs/harmony.md §18). Nodes are arena-allocated and carry a
// byte span so diagnostics can point at exact source. Lists grow by doubling.
//
// c2x-seed has no unions and no const array dimensions, so the node is flat:
// kind + span + a few payloads + up to three direct children + two lists.
struct AstList {
    int len;
    int cap;
    struct AstNode** items;
};

struct AstNode {
    int   kind;
    int   file;      // source file index
    int   start;     // byte offset
    int   end;       // byte offset (exclusive)
    int   ival;      // integer payload (literal value, flags, repeat count)
    char* sval;      // string payload (name, operator, spelling); may be 0
    struct AstNode* a;   // first child (meaning depends on kind)
    struct AstNode* b;   // second child
    struct AstNode* c;   // third child
    struct AstList* kids;   // primary child list
    struct AstList* kids2;  // secondary child list
    int   ty;        // resolved type id (filled by the checker; 0 = unset)
};

// ---------------------------------------------------------------------------
// Parser (M0, docs/harmony.md §18 grammar, §19.1 stage 2).
//
// Recursive descent, one token of extra lookahead (§18 "Parsing notes").
// Recovers at `;` and `}` so one malformed construct does not hide the rest.
// The parser renders SYN-01..05 with a `try:` fix; it does not stop the
// world, it records the diagnostic and keeps going.
//
// Returns the program root node, or 0 after a fatal (uncoverable) stop.
// Syntax stops are queryable via parser_stop_count().
// ---------------------------------------------------------------------------
struct AstNode* parser_run(struct SourceFile* sf, struct Token* tokens, int ntokens);
int parser_stop_count(void);

// Prints a parse tree as indented S-expressions (round-trip tests, -v dumps).
void ast_print(struct AstNode* root);

// ---------------------------------------------------------------------------
// Parser internals shared across parser.c2 / pstmts.c2 / pexpr.c2 (§18).
// State is module-global (one parse at a time); helpers are declared here so
// the item/statement and expression halves can call each other.
// ---------------------------------------------------------------------------
struct Token* p_cur(void);        // current token (never advances)
struct Token* p_peek(int n);      // n tokens ahead (clamped to EOF)
struct Token* p_prev(void);       // last consumed token (EOF-safe)
void p_advance(void);
int p_at(int kind);               // cur token is of this kind?
int p_at_kw(char* kw);            // cur token is this keyword?
int p_eat(int kind);              // consume if kind matches; 1 = matched
int p_eat_kw(char* kw);
int p_expect(int kind, char* what); // consume or report SYN-05; 1 = ok
int p_expect_kw(char* kw);
int p_expect_semi(void);          // consume `;` or report SYN-04
void p_sync(void);                // recovery: skip to just after `;`, or to `}`/EOF
void p_panic_off(void);           // clear panic mode at a boundary

// Builds a node of `kind` spanning the current token (caller widens the span
// with p_end_at as more tokens are consumed).
struct AstNode* p_node(int kind);
void p_end_at(struct AstNode* n, struct Token* t); // widen span to token end
char* p_cur_word(void);           // arena copy of cur token spelling
char* p_prev_word(void);          // arena copy of prev token spelling

// Reports a syntax stop with a `try:` fix (§16.2) and enters panic mode.
// Returns the diagnostic index or -1.
int p_syn(char* code, char* title, char* summary,
          char* fix_label, char* fix_text, struct Token* at);

// The grammar halves.
struct AstNode* parse_type(void);
struct AstNode* parse_expr(void);
struct AstNode* parse_block(void);
struct AstNode* parse_stmt(void);
struct AstNode* parse_pattern(void);

// Internal parsing entry points (implemented across parser.c2/pstmts.c2/
// pexpr.c2; declared here so the halves can call each other).
char*        parse_path_name(void);          // ID { :: ID } joined ("A::B")
char*        parse_life_use(void);            // life ( ID ) -> "life(a)"
struct AstList* parse_generics(void);          // < gparam, ... >
int          parse_generic_args(struct AstNode* onto);  // < targ, ... >
int          p_eat_gt_split(void);           // `>` (splits >> and >=)
struct AstList* parse_params(struct AstNode* onto);     // ( params )
struct AstNode* parse_fn_decl(int unck, struct Token* start);
struct AstNode* parse_extern_fn(void);
struct AstNode* parse_struct_decl(int is_copy);
struct AstNode* parse_enum_decl(int is_copy);
struct AstNode* parse_methods_block(void);
struct AstNode* parse_let_stmt(void);
struct AstNode* parse_if_stmt(void);
struct AstNode* parse_while_stmt(void);
struct AstNode* parse_for_stmt(void);
struct AstNode* parse_switch_stmt(void);
struct AstNode* parse_const_decl(int is_export);
struct AstNode* parse_item(int is_export);
char*        parse_unck_head(void);           // unchecked ( "reason" )
struct AstNode* parse_literal_node(void);     // literal token -> node
int          p_at_assign_op(void);            // = += -= ... on cursor?
char*        p_cur_op_word(void);             // operator spelling
void         lexbuf_push_str(char* s);        // scratch-buffer append
int          p_peek_is_kw(char* kw, int n);

// Byte sizes as fixed literals (c2x-seed needs literal array dimensions and
// uses an 8-byte field ABI, so every field is one qword).
const int AST_NODE_SIZE = 104;   // 13 fields * 8
const int AST_LIST_SIZE = 24;    // len, cap, items
const int AST_NODE_PTR_SIZE = 8;

// ---------------------------------------------------------------------------
// Type model (M1, docs/harmony.md §5). Types are ids into a table: fixed ids
// for primitives, dynamic ids (>= TY_DYNAMIC) for composites. Every checked
// AST node stores its type id in `ty` (0 = unset).
// ---------------------------------------------------------------------------
const int TY_INVALID = 0;
const int TY_I8 = 1;
const int TY_I16 = 2;
const int TY_I32 = 3;
const int TY_I64 = 4;
const int TY_ISIZE = 5;
const int TY_U8 = 6;
const int TY_U16 = 7;
const int TY_U32 = 8;
const int TY_U64 = 9;
const int TY_USIZE = 10;
const int TY_F32 = 11;
const int TY_F64 = 12;
const int TY_BOOL = 13;
const int TY_CHAR = 14;
const int TY_NEVER = 15;
const int TY_UNIT = 16;     // ()
const int TY_DYNAMIC = 100; // composite type ids start here

// Composite type kinds (kind stored on ids >= TY_DYNAMIC).
const int CTY_STRUCT = 1;   // a = 0; decl on cty_decl
const int CTY_ENUM = 2;
const int CTY_ARRAY = 3;    // a = elem ty, b = length
const int CTY_REF = 4;      // a = pointee (shared)
const int CTY_MUTREF = 5;   // a = pointee (exclusive)
const int CTY_STRREF = 6;   // &str (fat pointer { ptr, len })
const int CTY_HEAP = 7;     // heap box over a = elem ty (§12)
const int CTY_UINT_LIT = 8; // untyped integer literal (adapts, §5.9)
const int CTY_FLOAT_LIT = 9;// untyped float literal (adapts)
const int CTY_PTR = 10;     // raw T (unchecked; M6)
const int CTY_MUTPTR = 11;  // raw mut T

// Registers the user types of a program (structs/enums) from their AST decls.
// Called once before checking bodies.
void types_init(void);

// Composite constructor. Returns the new type id.
int ty_new(int kind, char* name, int a, int b);

// Composite constructor keyed on an existing decl node (dedup by name).
int ty_new_typed(int kind, char* name, struct AstNode* decl);

// Kind of a type id: 1..16 = primitive marker (returns the id itself for
// prims), otherwise CTY_*.
int ty_kind(int id);

char* ty_display(int id);        // stable name for diagnostics ("i32", "Point")
int ty_is_primitive(int id);     // true for the fixed primitive ids
int ty_is_integer(int id);       // i*/u*/isize/usize (not untyped literals)
int ty_is_float(int id);         // f32/f64
int ty_is_bool(int id);
int ty_is_char(int id);
int ty_is_never(int id);
int ty_is_untyped_lit(int id);   // CTY_UINT_LIT / CTY_FLOAT_LIT
int ty_is_copy(int id);          // §5.6 (requires the copy flags below)
int ty_eq(int a, int b);         // structural equality (names for nominal)
int ty_size(int id);             // byte size (0 = unknown/not computed)
int ty_align(int id);
int ty_elem(int id);             // elem/pointee for composites, 0 otherwise

// A `copy` type needs no drop glue (M2 prepares the flag; v0 prims are copy).
void ty_set_nocopy(int id);

// Byte size of a *type AST node* (resolved by the checker): array lengths
// use the const evaluator. Returns 0 when the type node cannot be resolved.
int sizeof_type_node(struct AstNode* t);


struct AstNode* ast_node_new(int kind);
void ast_span(struct AstNode* n, int file, int start, int end);
struct AstList* ast_list_new(void);
void ast_list_push(struct AstList* l, struct AstNode* n);
int ast_list_len(struct AstList* l);
struct AstNode* ast_list_get(struct AstList* l, int i);
struct AstList* ast_list_concat(struct AstList* a, struct AstList* b);
char* ast_kind_name(int kind);
int ast_is_item(int kind);
int ast_is_stmt(int kind);
int ast_is_type(int kind);
