// harmony-base — shared declarations (header module).
//
// c2x-seed resolves names from earlier files only, and requires a declaration
// before use inside a file. So every shared type and cross-module function is
// declared here, and this file must be listed first on the compiler command
// line. Implementation lives in the later modules.

// ---------------------------------------------------------------------------
// Linux syscall wrappers. The c2x-seed runtime always emits these five as
// global functions (docs/c2x-seed.md "Syscall wrappers").
// ---------------------------------------------------------------------------
extern int syscall_read(int fd, char* buf, int count);
extern int syscall_write(int fd, char* buf, int count);
extern int syscall_open(char* path, int flags, int mode);
extern int syscall_close(int fd);
extern int syscall_exit(int code);

const int FD_STDOUT = 1;
const int FD_STDERR = 2;
const int O_RDONLY = 0;
const int O_WRONLY = 1;
const int O_CREAT = 64;
const int O_TRUNC = 512;

// ---------------------------------------------------------------------------
// Exit codes (docs/harmony.md §16.6). The compiler itself uses 0/1/2; 70 is
// the *compiled program's* trap status, kept here so the runtime (§14.3) can
// share the constant.
// ---------------------------------------------------------------------------
const int EXIT_OK = 0;      // build succeeded (warnings allowed unless --strict)
const int EXIT_STOP = 1;    // at least one STOP (or a WARN under --strict)
const int EXIT_USAGE = 2;   // usage or I/O error (bad flag, missing file)
const int EXIT_TRAP = 70;   // the compiled program trapped (§14.3)

// Diagnostic severities (docs/harmony.md §16.4).
const int SEV_STOP = 0;     // a rule was broken; stops the build
const int SEV_WARN = 1;     // legal but suspicious; stops only under --strict
const int SEV_HINT = 2;     // a suggestion or a translation; never stops

// ---------------------------------------------------------------------------
// Arena allocator: one big static block, bump-allocated, 8-byte aligned.
// Everything the compiler builds (tokens, AST, strings) lives here.
// The size below must stay a literal: c2x-seed cannot use a const as an
// array dimension.
// ---------------------------------------------------------------------------
char* arena_alloc(int n);
char* arena_alloc_str(char* s);
void arena_reset(void);
int arena_used(void);

// ---------------------------------------------------------------------------
// String helpers.
// ---------------------------------------------------------------------------
int str_len(char* s);
int str_eq(char* a, char* b);
int str_has_prefix(char* s, char* prefix);
char* str_copy(char* s);
char* str_concat(char* a, char* b);

// ---------------------------------------------------------------------------
// Raw output (reports -> stdout, driver errors -> stderr).
// ---------------------------------------------------------------------------
void out_str(char* s);
void out_int(int n);
void out_nl(void);
void err_str(char* s);
void err_int(int n);
void err_nl(void);

// ---------------------------------------------------------------------------
// Source manager: a loaded file plus a line index for offset -> line/col.
// ---------------------------------------------------------------------------
struct SourceFile {
    char* path;         // file path as given
    char* data;         // file bytes (arena), NUL-terminated for convenience
    int   len;          // number of bytes
    int*  line_starts;  // byte offset of each line start (arena)
    int   line_count;   // number of lines
};

// Loads a file into the arena. Returns 0 on success, or a negative errno.
int source_load(char* path, struct SourceFile* out);

// 1-based line / 0-based column for a byte offset.
void source_line_col(struct SourceFile* sf, int off, int* line, int* col);

// Returns a pointer to the start of the given 1-based line. The returned
// string is NUL-terminated at the newline (the byte is temporarily masked).
char* source_line(struct SourceFile* sf, int line);

// ---------------------------------------------------------------------------
// Diagnostics (docs/harmony.md §16).
//
// The diagnostic tells the story of the value, not just the location of the
// symptom: a report carries a numbered timeline of source steps (born →
// moved → used…), each labelled, with the triggering step marked. One root
// cause, one report (§16.1). Renderers:
//   * "pretty" (§16.2 anatomy) — the default human format;
//   * "line"   (§16.7)          — one grep-friendly line per diagnostic;
//   * "json"   (§16.7)          — one JSON object per diagnostic.
// By default at most 5 stops are printed, then "…and N more stops (use --all)";
// warnings are capped at 10 (§16.9). Diagnostics are sorted by primary
// location; a warnings-only run prints them after a blank line.
// ---------------------------------------------------------------------------

// Story step roles (docs/harmony.md §16.7 `story[].role`).
const int ROLE_BORN = 0;
const int ROLE_MOVED = 1;
const int ROLE_BORROWED = 2;
const int ROLE_USED = 3;
const int ROLE_MUTATED = 4;
const int ROLE_DROPPED = 5;
const int ROLE_DECLARED = 6;
const int ROLE_DEFINED = 7;

// One timeline step: a source location plus a plain-English label. Exactly
// one step of a report has `trigger` set; it is the one the diagnostic points
// at (marked `◂ here` in the rendered layout, single-site steps use `▸`).
struct Step {
    int   role;       // ROLE_*
    int   file;       // source file index
    int   start;      // byte offset
    int   end;        // byte offset (exclusive)
    char* label;      // plain-English narration (may be 0)
    int   trigger;    // 1 = this step triggers the diagnostic
};

// One `try:`/`or:` fix (§16.2): a short label plus compilable code.
struct Fix {
    char* label;      // "lend it", "give a copy", ...
    char* text;       // compilable replacement (may be 0)
};

struct Diagnostic {
    char* code;       // stable "AREA-NN" id, e.g. "MOVE-01" (§16.10)
    int   sev;        // SEV_*
    char* title;      // one short line, lowercase
    char* summary;    // one or two plain-English sentences (may be 0)
    int   pfile;      // primary location: source file index
    int   pstart;     // primary location: byte offset
    int   pend;       // primary location: byte offset (exclusive)
    int   nstory;
    struct Step story[5];    // the timeline, in time order (§16.2)
    int   nfixes;
    struct Fix fixes[3];     // `try:` first, then `or:` alternatives
};

// Byte sizes as fixed literals (c2x-seed needs literal array dimensions and
// uses an 8-byte field ABI, so every field is one qword).
const int STEP_SIZE = 48;      // 6 fields * 8
const int FIX_SIZE = 16;       // 2 fields * 8
const int DIAG_SIZE = 176;     // 22 fields * 8 (incl. arrays)
const int MAX_STORY = 5;       // §16.2: the story is 1 to 5 steps
const int MAX_FIXES = 3;       // §16.2: 1 to 3 fixes

// Registers a source file so steps can resolve file/line/col.
void diag_register_file(struct SourceFile* sf);

int diag_stop_count(void);
int diag_warn_count(void);
int diag_hint_count(void);
void diag_reset(void);

// Builds a diagnostic (stored, not printed) with no story and no fixes.
// Returns the diagnostic index, or -1 when the table is full. Fill in the
// story and fixes through diag_get(idx) afterwards.
int diag_add(char* code, int sev, char* title, char* summary,
             struct SourceFile* sf, int off, int end);
int diag_stop(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end);
int diag_warn(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end);
int diag_hint(char* code, char* title, char* summary,
              struct SourceFile* sf, int off, int end);
struct Diagnostic* diag_get(int idx);

// Appends one story step. Returns 0, or -1 when the story is full.
int diag_step(struct Diagnostic* d, int role, int file, int start, int end,
              char* label, int trigger);

// Appends one fix (`try:` when it is the first, otherwise `or:`).
// Returns 0, or -1 when the fix list is full.
int diag_fix(struct Diagnostic* d, char* label, char* text);

// Prints all stored diagnostics, sorted by primary location, capped per
// §16.9 (5 stops / 10 warns unless `all`). `format` is 0=pretty, 1=line,
// 2=json.
void diag_flush(int format, int all);

// A flat message used for driver/usage errors and I/O failures.
void diag_plain(char* id, char* msg);

// ---------------------------------------------------------------------------
// Pipeline (docs/harmony.md §19.1, §19.5).
// ---------------------------------------------------------------------------
const int CMD_BUILD = 0;
const int CMD_RUN = 1;
const int CMD_CHECK = 2;
const int CMD_EMIT_C = 3;
const int CMD_EXPLAIN = 4;
const int CMD_AUDIT = 5;

// Output format (docs/harmony.md §16.7): --format=pretty|line|json.
const int FORMAT_PRETTY = 0;
const int FORMAT_LINE = 1;
const int FORMAT_JSON = 2;

// Driver options gathered from the command line.
struct Options {
    int   cmd;
    char* input;        // input .harmony path
    char* output;       // -o target (0 = default)
    int   format;       // FORMAT_* (diagnostics renderer)
    int   all;          // --all: lift the 5-stop / 10-warn caps (§16.9)
    int   strict;       // --strict: a WARN also stops the build (§16.4)
    int   deny_unchecked;// --deny-unchecked: any unchecked is UNCK-05 (§13.4)
    char* explain_code; // `lc explain <CODE>`: the requested code
    int   ascii;        // --ascii: (1)/(2)/> <-- here glyph fallbacks (§16.3)
    int   no_color;     // --no-color / NO_COLOR (§16.3)
    int   verbose;      // -v
};

// Prints the long-form lesson for a diagnostic code (§16.8). Returns 0 when
// the code exists, -1 otherwise (the caller reports the unknown code).
int explain_lookup(char* code);

// Prints the unchecked audit listing (§13.6): every `unchecked` block and
// `unchecked fn`, with file, line, and reason. No language surface yet, so
// the listing is empty; the scanner plugs in during M6.
void audit_print(void);

// Runs the pipeline for one input file. Returns an exit code (§16.6).
int pipeline_run(struct Options* opts);

// ---------------------------------------------------------------------------
// Lexer (M0, docs/harmony.md §4, §19.1 stage 1). Declared here so the driver
// and later stages can call it while the body is still a stub.
// ---------------------------------------------------------------------------
const int TOK_EOF = 0;
const int TOK_IDENT = 1;
const int TOK_NUMBER = 2;

// Byte size of one `struct Token` in c2x-seed's ABI (every field is a qword).
const int TOKEN_SIZE = 56;

struct Token {
    int   kind;
    char* text;     // arena-owned spelling
    int   len;
    int   start;    // byte offset
    int   end;      // byte offset (exclusive)
    int   line;     // 1-based
    int   col;      // 0-based
};

// Tokenizes the whole file into an arena array. Returns the token count, or a
// negative value on a lex stop (already reported).
int lexer_run(struct SourceFile* sf, struct Token** out_tokens);

// ---------------------------------------------------------------------------
// Parser (M0, docs/harmony.md §18 grammar, §19.1 stage 2). Stub for now.
// ---------------------------------------------------------------------------
int parser_run(struct SourceFile* sf, struct Token* tokens, int ntokens);

// ---------------------------------------------------------------------------
// AST (M0, docs/harmony.md §18). Nodes are arena-allocated and carry a
// byte span so diagnostics can point at exact source. Lists grow by doubling.
//
// c2x-seed has no unions and no const array dimensions, so the node is flat:
// kind + span + a few payloads + up to three direct children + two lists.
struct AstList {
    int len;
    int cap;
    struct AstNode** items;
};

struct AstNode {
    int   kind;
    int   file;      // source file index
    int   start;     // byte offset
    int   end;       // byte offset (exclusive)
    int   ival;      // integer payload (literal value, flags, repeat count)
    char* sval;      // string payload (name, operator, spelling); may be 0
    struct AstNode* a;   // first child (meaning depends on kind)
    struct AstNode* b;   // second child
    struct AstNode* c;   // third child
    struct AstList* kids;   // primary child list
    struct AstList* kids2;  // secondary child list
    int   ty;        // resolved type id (filled by the checker; 0 = unset)
};

// Byte sizes as fixed literals (c2x-seed needs literal array dimensions and
// uses an 8-byte field ABI, so every field is one qword).
const int AST_NODE_SIZE = 104;   // 13 fields * 8
const int AST_LIST_SIZE = 24;    // len, cap, items
const int AST_NODE_PTR_SIZE = 8;

struct AstNode* ast_node_new(int kind);
void ast_span(struct AstNode* n, int file, int start, int end);
struct AstList* ast_list_new(void);
void ast_list_push(struct AstList* l, struct AstNode* n);
int ast_list_len(struct AstList* l);
struct AstNode* ast_list_get(struct AstList* l, int i);
struct AstList* ast_list_concat(struct AstList* a, struct AstList* b);
char* ast_kind_name(int kind);
int ast_is_item(int kind);
int ast_is_stmt(int kind);
int ast_is_type(int kind);
