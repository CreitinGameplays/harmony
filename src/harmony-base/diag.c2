// harmony-base — diagnostics (docs/harmony.md §23).
//
// Data model + two renderers. P0/P1 subset:
//   * reports are *stored* at fault time and printed once, at the end;
//   * at flush time they are ordered by primary span ascending (§23.4),
//     capped by --max-faults (default 50, 0 = see all, §23.9), and rendered
//     either as text on stdout or as the JSON twin (§23.10, one object per
//     line, stable keys);
//   * --allow=<id> suppresses matching `warn` reports (faults are never
//     suppressible);
//   * driver/usage errors stay on stderr immediately (diag_plain).
// The box renderer (§23.3), fix-it application (§23.11), and the report
// catalogue tests arrive with the later phases.

struct Report g_reports[128];
int g_nreports;
int g_nfaults;
int g_nwarns;

// Source files, registered by index so spans can resolve file/line/col.
struct SourceFile* g_files[64];
int g_nfiles;

// Emission order (report indices), sorted by primary span at flush time.
int g_order[128];

void diag_register_file(struct SourceFile* sf) {
    if (g_nfiles < 64) {
        g_files[g_nfiles] = sf;
        g_nfiles = g_nfiles + 1;
    }
}

int diag_fault_count(void) { return g_nfaults; }
int diag_warn_count(void)  { return g_nwarns; }

void diag_reset(void) {
    g_nreports = 0;
    g_nfaults = 0;
    g_nwarns = 0;
    g_nfiles = 0;
}

// Read-write access to a stored report so later phases can fill in `want`,
// `note`, `why`, `from`, and extra spans after the initial add.
struct Report* diag_report(int idx) {
    if (idx < 0 || idx >= g_nreports) { return 0; }
    return &g_reports[idx];
}

// ---------------------------------------------------------------------------
// --allow=<id1,id2> matching: comma-separated IDs, exact match only.
// ---------------------------------------------------------------------------

int diag_slice_eq(char* s, int a, int b, char* id) {
    int i;
    if (b - a != str_len(id)) { return 0; }
    i = 0;
    while (a + i < b) {
        if (s[a + i] != id[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

int diag_allowed(char* id, char* allow_list) {
    int i;
    int start;
    if (allow_list == 0) { return 0; }
    start = 0;
    i = 0;
    while (1) {
        if (allow_list[i] == 0 || allow_list[i] == 44) {   // 44 = ','
            if (i > start && diag_slice_eq(allow_list, start, i, id)) { return 1; }
            if (allow_list[i] == 0) { break; }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// JSON twin (§23.10): one object per line, stable keys.
// ---------------------------------------------------------------------------

void out_json_char(char c) {
    char b[2];
    b[0] = c;
    b[1] = 0;
    out_str(b);
}

// Emits a JSON string literal with escapes for `"`, `\`, and control chars.
// A missing value (0) renders as an empty string; JSON `null` is emitted
// explicitly by the callers that need it.
void out_json_str(char* s) {
    int i;
    char c;
    out_str("\"");
    if (s != 0) {
        i = 0;
        while (s[i] != 0) {
            c = s[i];
            if (c == 34) { out_str("\\\""); }        // 34 = '"'
            else if (c == 92) { out_str("\\\\"); }   // 92 = backslash
            else if (c == 10) { out_str("\\n"); }
            else if (c == 13) { out_str("\\r"); }
            else if (c == 9) { out_str("\\t"); }
            else { out_json_char(c); }
            i = i + 1;
        }
    }
    out_str("\"");
}

void diag_json_role(int role) {
    if (role == ROLE_PRIMARY) { out_str("\"primary\""); }
    else if (role == ROLE_ORIGIN) { out_str("\"origin\""); }
    else if (role == ROLE_USE) { out_str("\"use\""); }
    else { out_str("\"note\""); }
}

void diag_emit_json(struct Report* r) {
    struct Span* s;
    struct SourceFile* sf;
    char* fpath;
    int line;
    int col;
    int endline;
    int endcol;
    int i;

    s = 0;
    sf = 0;
    line = 0;
    col = 0;
    endline = 0;
    endcol = 0;

    out_str("{\"report\": ");
    out_json_str(r->id);
    out_str(", \"severity\": ");
    if (r->sev == SEV_FAULT) { out_str("\"fault\""); }
    else if (r->sev == SEV_WARN) { out_str("\"warn\""); }
    else { out_str("\"runtime fault\""); }
    out_str(", \"summary\": ");
    out_json_str(r->summary);

    // Primary location. Editors parse this exact object.
    out_str(", \"primary\": ");
    if (r->nspans > 0) {
        s = &r->spans[0];
        if (s->file >= 0 && s->file < g_nfiles) { sf = g_files[s->file]; }
        fpath = "";
        if (sf != 0) {
            fpath = sf->path;
            source_line_col(sf, s->start, &line, &col);
            source_line_col(sf, s->end, &endline, &endcol);
        }
        out_str("{\"file\": ");
        out_json_str(fpath);
        out_str(", \"line\": ");
        out_int(line);
        out_str(", \"col\": ");
        out_int(col);
        out_str(", \"end_line\": ");
        out_int(endline);
        out_str(", \"end_col\": ");
        out_int(endcol);
        out_str("}");
    } else {
        out_str("null");
    }

    // All spans, primary first.
    out_str(", \"spans\": [");
    i = 0;
    while (i < r->nspans) {
        s = &r->spans[i];
        if (i > 0) { out_str(", "); }
        fpath = "";
        if (s->file >= 0 && s->file < g_nfiles) {
            sf = g_files[s->file];
            fpath = sf->path;
            source_line_col(sf, s->start, &line, &col);
        }
        out_str("{\"file\": ");
        out_json_str(fpath);
        out_str(", \"line\": ");
        out_int(line);
        out_str(", \"col\": ");
        out_int(col);
        // Marker labels arrive with the box renderer (§23.3).
        out_str(", \"label\": null, \"role\": ");
        diag_json_role(s->role);
        out_str("}");
        i = i + 1;
    }
    out_str("]");

    out_str(", \"rule\": ");
    out_json_str(r->rule);
    out_str(", \"got\": ");
    out_json_str(r->got);
    out_str(", \"want\": ");
    out_json_str(r->want);
    out_str(", \"note\": ");
    out_json_str(r->note);
    out_str(", \"why\": ");
    out_json_str(r->why);
    out_str(", \"from\": ");
    out_json_str(r->from);
    // Multi-note and multi-fix support arrives with P1; today a report has at
    // most one of each, surfaced in the stable keys above.
    out_str(", \"notes\": []");
    if (r->fix != 0 && r->fix[0] != 0) {
        out_str(", \"fixes\": [{\"title\": ");
        out_json_str(r->fix);
        out_str(", \"applicability\": \"manual\"}]");
    } else {
        out_str(", \"fixes\": []");
    }
    out_str(", \"explain\": ");
    out_json_str(r->id);
    out_str("}");
    out_nl();
}

// ---------------------------------------------------------------------------
// Text renderer (§23.3 subset: no box yet, same information).
// ---------------------------------------------------------------------------

void diag_emit_text(struct Report* r) {
    struct Span* s;
    struct SourceFile* sf;
    int line;
    int col;
    int i;

    s = 0;
    sf = 0;
    line = 0;
    col = 0;
    i = 0;

    // Header: "<severity> · <id>  <path>:<line>:<col>" — the severity is the
    // first word so `grep '^fault'` works, and the location suffix is
    // editor-parseable (§23.3 parts 1-2).
    if (r->sev == SEV_FAULT) { out_str("fault · "); }
    else if (r->sev == SEV_WARN) { out_str("warn · "); }
    else { out_str("runtime fault · "); }
    out_str(r->id);
    if (r->nspans > 0) {
        s = &r->spans[0];
        if (s->file >= 0 && s->file < g_nfiles) {
            sf = g_files[s->file];
            source_line_col(sf, s->start, &line, &col);
            out_str("  ");
            out_str(sf->path);
            out_str(":");
            out_int(line);
            out_str(":");
            out_int(col);
        }
    }
    out_nl();

    if (r->summary != 0 && r->summary[0] != 0) {
        out_str("  "); out_str(r->summary); out_nl();
    }

    // Source lines with markers: at most 6 per report (§23.4).
    i = 0;
    while (i < r->nspans && i < 6) {
        s = &r->spans[i];
        if (s->file >= 0 && s->file < g_nfiles) {
            sf = g_files[s->file];
            source_line_col(sf, s->start, &line, &col);
            out_str("  ");
            out_int(line);
            out_str(" | ");
            out_str(source_line(sf, line));
            out_nl();
        }
        i = i + 1;
    }

    // Labelled lines (§23.5), aligned in the five(+1)-character column.
    if (r->rule != 0 && r->rule[0] != 0) { out_str("  rule  "); out_str(r->rule); out_nl(); }
    if (r->got != 0 && r->got[0] != 0)   { out_str("  got   "); out_str(r->got);  out_nl(); }
    if (r->want != 0 && r->want[0] != 0) { out_str("  want  "); out_str(r->want); out_nl(); }
    if (r->note != 0 && r->note[0] != 0) { out_str("  note  "); out_str(r->note); out_nl(); }
    if (r->why != 0 && r->why[0] != 0)   { out_str("  why   "); out_str(r->why);  out_nl(); }
    if (r->from != 0 && r->from[0] != 0) { out_str("  from  "); out_str(r->from); out_nl(); }
    if (r->fix != 0 && r->fix[0] != 0)   { out_str("  fix   "); out_str(r->fix);  out_nl(); }

    // Footer: pointer to long-form help (§23.3 part 7).
    if (r->id != 0 && r->id[0] != 0) {
        out_str("  see   `--explain ");
        out_str(r->id);
        out_str("`");
        out_nl();
    }
}

// ---------------------------------------------------------------------------
// Flush: sort, cap, render.
// ---------------------------------------------------------------------------

// Sort key helper: reports with a primary span come first, ordered by span
// start (then file index); spanless reports sort last.
int diag_before(int ia, int ib) {
    struct Report* a;
    struct Report* b;
    a = &g_reports[ia];
    b = &g_reports[ib];
    if (a->nspans == 0 && b->nspans == 0) { return 0; }
    if (a->nspans == 0) { return 0; }
    if (b->nspans == 0) { return 1; }
    if (a->spans[0].start != b->spans[0].start) {
        return a->spans[0].start < b->spans[0].start;
    }
    return a->spans[0].file < b->spans[0].file;
}

void diag_flush(int json, int max_faults, char* allow_list) {
    struct Report* r;
    int i;
    int j;
    int tmp;
    int limit;
    int emitted;
    int hidden;

    r = 0;

    // Order reports by primary span ascending (§23.4). Insertion sort: the
    // report count is small, and stable order matters for the golden tests.
    i = 0;
    while (i < g_nreports) { g_order[i] = i; i = i + 1; }
    i = 1;
    while (i < g_nreports) {
        j = i;
        while (j > 0 && diag_before(g_order[j], g_order[j - 1])) {
            tmp = g_order[j - 1];
            g_order[j - 1] = g_order[j];
            g_order[j] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }

    // --max-faults=N caps rendered output (default 50; 0 = see all, §23.9).
    limit = max_faults;
    if (limit <= 0) { limit = g_nreports; }
    emitted = 0;
    hidden = 0;
    i = 0;
    while (i < g_nreports) {
        r = &g_reports[g_order[i]];
        // --allow only silences warnings; faults are never suppressible.
        if (r->sev == SEV_WARN && diag_allowed(r->id, allow_list)) {
            i = i + 1;
            continue;
        }
        if (emitted >= limit) {
            if (r->sev == SEV_FAULT) { hidden = hidden + 1; }
            i = i + 1;
            continue;
        }
        if (json) { diag_emit_json(r); } else { diag_emit_text(r); }
        emitted = emitted + 1;
        i = i + 1;
    }
    if (hidden > 0 && json == 0) {
        out_str("… ");
        out_int(hidden);
        out_str(" more faults (--max-faults=0 to see all)");
        out_nl();
    }
}

// ---------------------------------------------------------------------------
// Report construction.
// ---------------------------------------------------------------------------

int diag_add(char* id, int sev, char* summary, struct SourceFile* sf, int off,
             char* rule, char* got, char* fix) {
    struct Report* r;
    struct Span* s;
    int idx;

    s = 0;
    if (g_nreports >= 128) {
        // Keep counting, but stop storing.
        if (sev == SEV_FAULT) { g_nfaults = g_nfaults + 1; }
        else { g_nwarns = g_nwarns + 1; }
        return -1;
    }
    idx = g_nreports;
    g_nreports = g_nreports + 1;
    if (sev == SEV_FAULT) { g_nfaults = g_nfaults + 1; }
    else { g_nwarns = g_nwarns + 1; }

    r = &g_reports[idx];
    r->id = id;
    r->sev = sev;
    r->summary = summary;
    r->nspans = 0;
    r->rule = rule;
    r->got = got;
    r->want = 0;
    r->note = 0;
    r->why = 0;
    r->from = 0;
    r->fix = fix;

    if (sf != 0) {
        s = &r->spans[0];
        s->file = 0;
        s->start = off;
        s->end = off + 1;
        s->role = ROLE_PRIMARY;
        r->nspans = 1;
    }
    return idx;
}

int diag_fault(char* id, char* summary, struct SourceFile* sf, int off,
               char* rule, char* got, char* fix) {
    return diag_add(id, SEV_FAULT, summary, sf, off, rule, got, fix);
}

int diag_warn(char* id, char* summary, struct SourceFile* sf, int off,
              char* rule, char* got, char* fix) {
    return diag_add(id, SEV_WARN, summary, sf, off, rule, got, fix);
}

// A flat message used for driver/usage errors and I/O failures. These are not
// language reports: they go to stderr immediately and never enter the report
// list, so --report=json output stays pure.
void diag_plain(char* id, char* msg) {
    err_str("harmony-base: ");
    err_str(id);
    err_str(": ");
    err_str(msg);
    err_nl();
}
