// harmony-base — expressions (docs/harmony.md §18, §19.1 stage 2).
//
// The §18 precedence chain, lowest to highest:
//   range → or(||) → and(&&) → cmp(nonassoc) → bor(|) → bxor(^)
//   → band(&) → shift(<< >>) → add(+ -) → mul(* / %) → as-cast
//   → unary(- ! ~ * & &mut new) → postfix(call, index, field, generics).
//
// `*` and `&` are prefix or infix by position (§18); `%`/`+` etc. are plain
// nodes with the operator string on sval. `x.narrow<u8>()` vs `a.b < c`:
// generic args after a field name only when the matching `>` is followed
// by `(` (one extra token of lookahead, §18 note).

// Forward decls (the precedence chain is mutually recursive; the last
// function in the file is called by the first).
struct AstNode* parse_postfix_expr(void);
struct AstNode* parse_cast(void);
struct AstNode* p_at_mult_end(void);

// Literal token → literal node (INT/FLOAT/STRING/CHAR/BYTE/true/false).
// The cursor must sit on the literal; returns 0 only on internal misshape.
struct AstNode* parse_literal_node(void) {
    struct AstNode* n;
    struct Token* t;
    t = p_cur();
    if (t->kind == TOK_INT) {
        n = ast_node_new(AST_INT_LIT);
        n->ival = t->ival;
        n->sval = t->sval;      // suffix ("u8", ...; 0 = unsuffixed)
        p_advance();
        n->start = t->start;
        n->end = t->end;
        return n;
    }
    if (t->kind == TOK_FLOAT) {
        n = ast_node_new(AST_FLOAT_LIT);
        n->sval = t->text;      // spelling without suffix; suffix in kids? no:
        n->ival = 0;            // suffix rides on a second string later if
                                // the checker needs it; spelling suffices.
        p_advance();
        n->start = t->start;
        n->end = t->end;
        return n;
    }
    if (t->kind == TOK_STRING) {
        n = ast_node_new(AST_STRING_LIT);
        n->sval = t->sval;      // cooked bytes
        n->ival = t->len;       // byte length
        p_advance();
        n->start = t->start;
        n->end = t->end;
        return n;
    }
    if (t->kind == TOK_CHAR) {
        n = ast_node_new(AST_CHAR_LIT);
        n->ival = t->ival;
        p_advance();
        n->start = t->start;
        n->end = t->end;
        return n;
    }
    if (t->kind == TOK_BYTE) {
        n = ast_node_new(AST_INT_LIT);   // bytes are u8 integers
        n->ival = t->ival;
        n->sval = "u8";
        p_advance();
        n->start = t->start;
        n->end = t->end;
        return n;
    }
    if (tok_is_kw(t, "true") || tok_is_kw(t, "false")) {
        n = ast_node_new(AST_BOOL_LIT);
        if (tok_is_kw(t, "true")) {
            n->ival = 1;
        } else {
            n->ival = 0;
        }
        p_advance();
        n->start = t->start;
        n->end = t->end;
        return n;
    }
    return 0;
}

// True when the `<...>` starting at the cursor is generic *call* arguments:
// scan forward for the matching `>`; it is generic args iff that `>` is
// immediately followed by `(` (§18 "one extra lookahead").
int p_looks_like_generic_call(void) {
    int depth;
    int i;
    depth = 0;
    i = g_ppos;
    while (i < g_pntoks) {
        int k;
        k = g_ptoks[i].kind;
        if (k == TOK_LT) {
            depth = depth + 1;
        } else if (k == TOK_GT) {
            depth = depth - 1;
            if (depth == 0) {
                // The matching `>`: generic args only if `(` follows.
                if (i + 1 < g_pntoks && g_ptoks[i + 1].kind == TOK_LPAREN) {
                    return 1;
                }
                return 0;
            }
        } else if (k == TOK_SEMI || k == TOK_EOF || k == TOK_RBRACE) {
            return 0;      // a statement boundary: not generic args
        }
        i = i + 1;
    }
    return 0;
}

// call_args = "(" [ expr { , expr } [ , ] ] ")"
struct AstList* parse_call_args(int* saw_trailing_comma) {
    struct AstList* args;
    args = ast_list_new();
    *saw_trailing_comma = 0;
    p_advance();      // (
    while (!p_at(TOK_RPAREN) && !p_at(TOK_EOF)) {
        struct AstNode* a;
        a = parse_expr();
        if (a == 0) { return 0; }
        ast_list_push(args, a);
        if (p_eat(TOK_COMMA)) {
            if (p_at(TOK_RPAREN)) {
                *saw_trailing_comma = 1;
            }
            continue;
        }
        break;
    }
    if (!p_expect(TOK_RPAREN, "add `)` to close the arguments")) { return 0; }
    return args;
}

struct AstNode* parse_primary(void);

// unary_expr = (- | ! | ~ | * | & [mut] | new) unary | postfix
struct AstNode* parse_unary(void) {
    struct Token* start;
    start = p_cur();

    if (p_at(TOK_MINUS)) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_UNARY);
        n->sval = "-";
        n->a = parse_unary();
        if (n->a == 0) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }
    if (p_at(TOK_NOT)) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_UNARY);
        n->sval = "!";
        n->a = parse_unary();
        if (n->a == 0) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }
    if (p_at(TOK_TILDE)) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_UNARY);
        n->sval = "~";
        n->a = parse_unary();
        if (n->a == 0) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }
    if (p_at(TOK_STAR)) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_DEREF);
        n->a = parse_unary();
        if (n->a == 0) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }
    if (p_at(TOK_AMP)) {
        struct AstNode* n;
        int is_mut;
        p_advance();
        is_mut = 0;
        if (p_at_kw("mut")) {
            p_advance();
            is_mut = 1;
        }
        n = ast_node_new(AST_BORROW);
        n->ival = is_mut;
        n->a = parse_unary();
        if (n->a == 0) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }
    if (p_at_kw("new")) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_NEW);
        n->a = parse_unary();
        if (n->a == 0) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }
    return parse_postfix_expr();
}

// postfix: primary { call args | [expr] | .ID[(call args)] | generic call }
struct AstNode* parse_postfix_expr(void) {
    struct AstNode* e;
    e = parse_primary();
    if (e == 0) { return 0; }
    while (1) {
        if (p_at(TOK_LPAREN)) {
            // Call (function or method — resolution is stage 3's job).
            struct AstNode* c;
            struct AstList* args;
            int tcomma;
            c = ast_node_new(AST_CALL);
            c->a = e;
            c->start = e->start;
            args = parse_call_args(&tcomma);
            if (args == 0) { return 0; }
            c->kids = args;
            c->end = p_prev()->end;
            e = c;
            continue;
        }
        if (p_at(TOK_LBRACKET)) {
            struct AstNode* ix;
            p_advance();
            ix = ast_node_new(AST_INDEX);
            ix->a = e;
            ix->start = e->start;
            ix->b = parse_expr();
            if (ix->b == 0) { return 0; }
            if (!p_expect(TOK_RBRACKET, "add `]` to close the index")) { return 0; }
            ix->end = p_prev()->end;
            e = ix;
            continue;
        }
        if (p_at(TOK_DOT)) {
            struct AstNode* f;
            p_advance();
            if (!p_at(TOK_IDENT)) {
                p_syn("SYN-05",
                      "a field access needs a name",
                      "After `.` comes a field or a method name (§18).",
                      "write the name",
                      "x.field",
                      p_cur());
                return 0;
            }
            f = ast_node_new(AST_FIELD_ACC);
            f->kind = AST_FIELD_ACC;
            f->a = e;
            f->sval = p_cur_word();
            f->start = e->start;
            p_advance();
            // Generic method call: `.name<targs>(...)` — only when the
            // matching `>` is followed by `(` (§18 lookahead rule).
            if (p_at(TOK_LT) && p_looks_like_generic_call()) {
                struct AstNode* g;
                g = ast_node_new(AST_TYPE_NAME);   // marker; kids = targs
                g->sval = "";
                if (!parse_generic_args(g)) { return 0; }
                f->kids2 = g->kids;
            }
            f->end = p_prev()->end;
            e = f;
            continue;
        }
        break;
    }
    return e;
}

// mul_expr = cast { (* | / | %) cast }
struct AstNode* parse_mul(void) {
    struct AstNode* l;
    l = parse_cast();
    if (l == 0) { return 0; }
    while (p_at(TOK_STAR) || p_at(TOK_SLASH) || p_at(TOK_PERCENT)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = p_cur_op_word();
        n->start = l->start;
        p_advance();
        r = parse_cast();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// add_expr = mul { (+ | -) mul }
struct AstNode* parse_add(void) {
    struct AstNode* l;
    l = parse_mul();
    if (l == 0) { return 0; }
    while (p_at(TOK_PLUS) || p_at(TOK_MINUS)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = p_cur_op_word();
        n->start = l->start;
        p_advance();
        r = parse_mul();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// shift_expr = add { (<< | >>) add }
struct AstNode* parse_shift(void) {
    struct AstNode* l;
    l = parse_add();
    if (l == 0) { return 0; }
    while (p_at(TOK_SHL) || p_at(TOK_SHR)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = p_cur_op_word();
        n->start = l->start;
        p_advance();
        r = parse_add();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// band_expr = shift { & shift }
struct AstNode* parse_band(void) {
    struct AstNode* l;
    l = parse_shift();
    if (l == 0) { return 0; }
    while (p_at(TOK_AMP)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = "&";
        n->start = l->start;
        p_advance();
        r = parse_shift();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// bxor_expr = band { ^ band }
struct AstNode* parse_bxor(void) {
    struct AstNode* l;
    l = parse_band();
    if (l == 0) { return 0; }
    while (p_at(TOK_CARET)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = "^";
        n->start = l->start;
        p_advance();
        r = parse_band();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// bor_expr = bxor { | bxor }
struct AstNode* parse_bor(void) {
    struct AstNode* l;
    l = parse_bxor();
    if (l == 0) { return 0; }
    while (p_at(TOK_PIPE)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = "|";
        n->start = l->start;
        p_advance();
        r = parse_bxor();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// cmp_expr = bor [ cmp_op bor ]   (non-associative, §18)
struct AstNode* parse_cmp(void) {
    struct AstNode* l;
    l = parse_bor();
    if (l == 0) { return 0; }
    if (p_at(TOK_EQEQ) || p_at(TOK_NEQ) || p_at(TOK_LT)
        || p_at(TOK_LE) || p_at(TOK_GT) || p_at(TOK_GE)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = p_cur_op_word();
        n->start = l->start;
        p_advance();
        r = parse_bor();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        // A comparison chained (a < b < c) is rejected: the second op
        // cannot apply to a bool with the same operator class.
        if (p_at(TOK_EQEQ) || p_at(TOK_NEQ) || p_at(TOK_LT)
            || p_at(TOK_LE) || p_at(TOK_GT) || p_at(TOK_GE)) {
            p_syn("SYN-05",
                  "comparisons do not chain",
                  "A comparison is non-associative: write `a < b && b < c`, not `a < b < c` (§18).",
                  "split the comparison",
                  "a < b && b < c",
                  p_cur());
            return 0;
        }
        return n;
    }
    return l;
}

// and_expr = cmp { && cmp }
struct AstNode* parse_and(void) {
    struct AstNode* l;
    l = parse_cmp();
    if (l == 0) { return 0; }
    while (p_at(TOK_AND)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = "&&";
        n->start = l->start;
        p_advance();
        r = parse_cmp();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// or_expr = and { || and }
struct AstNode* parse_or(void) {
    struct AstNode* l;
    l = parse_and();
    if (l == 0) { return 0; }
    while (p_at(TOK_OR)) {
        struct AstNode* n;
        struct AstNode* r;
        n = ast_node_new(AST_BINARY);
        n->sval = "||";
        n->start = l->start;
        p_advance();
        r = parse_and();
        if (r == 0) { return 0; }
        n->a = l;
        n->b = r;
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// range_expr = [ or ] ( .. | ..= ) [ or ]
struct AstNode* parse_range_expr(void) {
    struct AstNode* l;
    l = parse_or();
    if (l == 0) { return 0; }
    if (p_at(TOK_RANGE) || p_at(TOK_DOTS_EQ)) {
        struct AstNode* n;
        n = ast_node_new(AST_BINARY);
        if (p_at(TOK_RANGE)) {
            n->sval = "..";
        } else {
            n->sval = "..=";
        }
        n->start = l->start;
        p_advance();
        if (!p_at_mult_end()) {
            n->b = parse_or();
            if (n->b == 0) { return 0; }
        }
        n->a = l;
        n->end = p_prev()->end;
        return n;
    }
    return l;
}

// True when the range has no upper end in this position (e.g. `0..` before
// `)` or `]`). Kept small: the §18 grammar allows an open `..` end.
int p_at_mult_end(void) {
    if (p_at(TOK_RPAREN) || p_at(TOK_RBRACKET)) { return 1; }
    if (p_at(TOK_COMMA) || p_at(TOK_SEMI) || p_at(TOK_EOF)) { return 1; }
    return 0;
}

// expr = range_expr
struct AstNode* parse_expr(void) {
    return parse_range_expr();
}

// cast_expr = unary { "as" type }
struct AstNode* parse_cast(void) {
    struct AstNode* l;
    l = parse_unary();
    if (l == 0) { return 0; }
    while (p_at_kw("as")) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_AS);
        n->a = l;
        n->start = l->start;
        n->b = parse_type();
        if (n->b == 0) { return 0; }
        n->end = p_prev()->end;
        l = n;
    }
    return l;
}

// ---------------------------------------------------------------------------
// primary (§18):
//   literal | path [generic-call] | "(" expr ")" | array_lit | struct_init
//   | "sizeof" "(" type ")" | "raw" "(" expr ")"
// ---------------------------------------------------------------------------
struct AstNode* parse_primary(void) {
    struct Token* start;
    start = p_cur();

    // Literals
    if (p_at(TOK_INT) || p_at(TOK_FLOAT) || p_at(TOK_STRING)
        || p_at(TOK_CHAR) || p_at(TOK_BYTE)
        || p_at_kw("true") || p_at_kw("false")) {
        return parse_literal_node();
    }

    // sizeof(T) — an expression yielding usize.
    if (p_at_kw("sizeof")) {
        struct AstNode* n;
        p_advance();
        if (!p_expect(TOK_LPAREN, "add `(` after `sizeof`")) { return 0; }
        n = ast_node_new(AST_SIZEOF);
        n->a = parse_type();
        if (n->a == 0) { return 0; }
        if (!p_expect(TOK_RPAREN, "add `)` to close `sizeof`")) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }

    // raw(...) cast to raw pointer (13.5).
    if (p_at_kw("raw") && p_peek(1)->kind == TOK_LPAREN) {
        struct AstNode* n;
        p_advance();      // raw
        p_advance();      // (
        n = ast_node_new(AST_RAW_EXPR);
        n->a = parse_expr();
        if (n->a == 0) { return 0; }
        if (!p_expect(TOK_RPAREN, "add `)` to close `raw(...)`")) { return 0; }
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }

    // ( expr )
    if (p_at(TOK_LPAREN)) {
        struct AstNode* n;
        p_advance();
        // () unit literal
        if (p_at(TOK_RPAREN)) {
            p_advance();
            n = ast_node_new(AST_UNIT_LIT);
            n->start = start->start;
            n->end = p_prev()->end;
            return n;
        }
        n = parse_expr();
        if (n == 0) { return 0; }
        if (!p_expect(TOK_RPAREN, "add `)` to close the expression")) { return 0; }
        p_end_at(n, p_prev());
        return n;
    }

    // array literal [a, b, c] or [v; n]
    if (p_at(TOK_LBRACKET)) {
        struct AstNode* n;
        p_advance();
        n = ast_node_new(AST_ARRAY_LIT);
        n->start = start->start;
        n->kids = ast_list_new();
        if (p_at(TOK_RBRACKET)) {
            p_advance();
            n->end = p_prev()->end;
            return n;      // empty []
        }
        {
            struct AstNode* first;
            first = parse_expr();
            if (first == 0) { return 0; }
            if (p_eat(TOK_SEMI)) {
                // [value; count]
                struct AstNode* cnt;
                cnt = parse_expr();
                if (cnt == 0) { return 0; }
                if (!p_expect(TOK_RBRACKET, "add `]` to close the array")) { return 0; }
                n->a = first;
                n->b = cnt;
                n->end = p_prev()->end;
                return n;
            }
            ast_list_push(n->kids, first);
            while (p_eat(TOK_COMMA)) {
                struct AstNode* el;
                if (p_at(TOK_RBRACKET)) { break; }      // trailing comma
                el = parse_expr();
                if (el == 0) { return 0; }
                ast_list_push(n->kids, el);
            }
            if (!p_expect(TOK_RBRACKET, "add `]` to close the array")) { return 0; }
            n->end = p_prev()->end;
            return n;
        }
    }

    // `self` as a value (method receiver; §6.6).
    if (p_at_kw("self")) {
        struct AstNode* n;
        n = ast_node_new(AST_PATH);
        n->sval = "self";
        n->start = start->start;
        p_advance();
        n->end = p_prev()->end;
        return n;
    }

    // Path (call or plain), or struct init `Path { .f = v, ... }`
    if (p_at(TOK_IDENT)) {
        struct AstNode* n;
        char* name;
        name = parse_path_name();
        if (name == 0) { return 0; }

        // Struct literal: Path { .field = value, ... }
        if (p_at(TOK_LBRACE)) {
            n = ast_node_new(AST_STRUCT_INIT);
            n->sval = name;
            n->start = start->start;
            n->kids = ast_list_new();
            p_advance();      // {
            while (!p_at(TOK_RBRACE) && !p_at(TOK_EOF)) {
                struct AstNode* fi;
                fi = ast_node_new(AST_FIELD_INIT);
                if (!p_eat(TOK_DOT)) {
                    p_syn("SYN-05",
                          "a struct initializer field starts with `.`",
                          "Point { .x = 1, .y = 2 } (6.4).",
                          "dot the field",
                          ".x = 1",
                          p_cur());
                    return 0;
                }
                if (!p_at(TOK_IDENT)) {
                    p_syn("SYN-05",
                          "a field name is needed",
                          "Point { .x = 1, .y = 2 } — after `.` comes the field name.",
                          "write the name",
                          ".x = 1",
                          p_cur());
                    return 0;
                }
                fi->sval = p_cur_word();
                fi->start = p_cur()->start;
                p_advance();
                if (!p_expect(TOK_ASSIGN, "add `= value` to the field")) { return 0; }
                fi->a = parse_expr();
                if (fi->a == 0) { return 0; }
                fi->end = p_prev()->end;
                ast_list_push(n->kids, fi);
                if (p_eat(TOK_COMMA)) { continue; }
                break;
            }
            if (!p_expect(TOK_RBRACE, "add `}` to close the struct literal")) {
                return 0;
            }
            n->end = p_prev()->end;
            return n;
        }

        // Generic call args: Path<args>(...) — lookahead rule applies.
        if (p_at(TOK_LT) && p_looks_like_generic_call()) {
            struct AstNode* targs;
            targs = ast_node_new(AST_TYPE_NAME);
            targs->sval = "";
            if (!parse_generic_args(targs)) { return 0; }
            // The call itself must follow.
            if (!p_at(TOK_LPAREN)) {
                p_syn("SYN-05",
                      "generic arguments precede a call",
                      "`Path::make<T>(...)` — after `<...>` comes `(` (§18).",
                      "call it",
                      "Stack::make<i32>()",
                      p_cur());
                return 0;
            }
            n = ast_node_new(AST_CALL);
            n->sval = name;
            n->kids2 = targs->kids;      // generic args
            n->start = start->start;
            {
                struct AstList* args;
                int tcomma;
                args = parse_call_args(&tcomma);
                if (args == 0) { return 0; }
                n->kids = args;
            }
            n->end = p_prev()->end;
            return n;
        }

        // Bare path (value / function reference).
        n = ast_node_new(AST_PATH);
        n->sval = name;
        n->start = start->start;
        n->end = p_prev()->end;
        return n;
    }

    p_syn("SYN-05",
          "expected an expression",
          "An expression starts with a literal, a name, `(`, `[`, `sizeof(T)`, or `raw(...)` (18).",
          "write the expression",
          "x + 1",
          p_cur());
    return 0;
}
