// harmony-base — pipeline (docs/harmony.md §25.1).
//
// P0 wires: load source -> lex -> parse -> flush reports. Codegen and the
// checker passes are stubbed and added in later phases.

int pipeline_run(struct Options* opts) {
    struct SourceFile sf;
    struct Token* toks;
    int n;
    int rc;

    arena_reset();
    diag_reset();

    rc = source_load(opts->input, &sf);
    if (rc != 0) {
        diag_plain("source.not-found", opts->input);
        return EXIT_USAGE;
    }
    diag_register_file(&sf);

    if (opts->verbose) {
        err_str("harmony-base: read ");
        err_int(sf.len);
        err_str(" bytes from ");
        err_str(sf.path);
        err_nl();
    }

    n = lexer_run(&sf, &toks);
    if (n < 0) {
        return EXIT_FAULT;
    }

    parser_run(&sf, toks, n);

    // Safety profiles (§22.8): --forbid refuses to build when the audited
    // surface is non-empty. No language surface exists yet, so this only
    // guards the flag plumbing until the parser reports seams (P14).
    if (opts->forbid != 0) {
        if (!str_eq(opts->forbid, "unchecked") && !str_eq(opts->forbid, "keep")) {
            diag_plain("usage.unknown-forbid-target", opts->forbid);
            return EXIT_USAGE;
        }
    }

    if (opts->report_seams) {
        seams_print();
        if (diag_fault_count() == 0) { return EXIT_OK; }
    }

    // Later phases (type check, dataflow, borrow, drops, codegen) plug in here.
    // Until a backend exists, asking for one is reported through the normal
    // report model (so text and JSON views stay exercised) but keeps the
    // dedicated internal exit code (§25.1).
    if (opts->emit_c || opts->emit_ir || opts->emit_asm) {
        diag_fault("compiler.internal",
                   "the requested code-generation backend is not implemented yet",
                   &sf, 0,
                   "every stage the driver advertises must be able to run",
                   "no backend for --emit=c|ir|asm", 0);
    }

    // Flush every stored report: ordered by primary span, capped by
    // --max-faults, either as text on stdout or as the JSON twin. A clean
    // build prints nothing at all (§23.9).
    diag_flush(opts->report_json, opts->max_faults, opts->allow);

    if (opts->emit_c || opts->emit_ir || opts->emit_asm) {
        return EXIT_INTERNAL;
    }

    if (diag_fault_count() > 0) {
        return EXIT_FAULT;
    }
    return EXIT_OK;
}
