// harmony-base — pipeline (docs/harmony.md §19.1).
//
// M0 wires: load source -> lex -> parse -> flush diagnostics. Codegen and the
// checker passes are stubbed and added in later milestones (§19.7).

int pipeline_run(struct Options* opts) {
    struct SourceFile sf;
    struct Token* toks;
    struct AstNode* root;
    int n;
    int rc;

    arena_reset();
    diag_reset();

    rc = source_load(opts->input, &sf);
    if (rc != 0) {
        diag_plain("source.not-found", opts->input);
        return EXIT_USAGE;
    }
    diag_register_file(&sf);

    if (opts->verbose) {
        err_str("harmony-base: read ");
        err_int(sf.len);
        err_str(" bytes from ");
        err_str(sf.path);
        err_nl();
    }

    n = lexer_run(&sf, &toks);
    if (n < 0) {
        diag_flush(opts->format, opts->all);
        return EXIT_STOP;
    }

    if (opts->verbose) {
        err_str("harmony-base: lexed ");
        err_int(n);
        err_str(" tokens");
        err_nl();
    }

    root = parser_run(&sf, toks, n);
    if (root == 0 || parser_stop_count() > 0) {
        // The parser already reported each syntax stop; flush and stop.
        diag_flush(opts->format, opts->all);
        return EXIT_STOP;
    }

    if (opts->verbose) {
        err_str("harmony-base: parsed ");
        err_int(ast_list_len(root->kids));
        err_str(" items");
        err_nl();
    }

    // --dump-ast: print the parse tree to stdout (M0 round-trip tests;
    // byte-deterministic, a pure function of the tree).
    if (opts->dump_ast) {
        ast_print(root);
    }

    // Stage 4: the type checker (§19.1). Runs for every command that needs
    // to understand the program; `--dump-ast` skips it so the parse tree can
    // be inspected even when the program does not type-check yet.
    if (!opts->dump_ast) {
        check_program(root);
        if (opts->verbose) {
            err_str("harmony-base: checked ");
            err_int(diag_stop_count());
            err_str(" stop(s)");
            err_nl();
        }
    }

    // Emission stages of the pipeline (§19.1 stage 9) are not implemented yet.
    // Requesting one is an honest stop with a fix, not a silent exit: the
    // driver only advertises what it can run. `build`/`run` imply codegen too.
    if (opts->cmd == CMD_EMIT_LLVM || opts->cmd == CMD_EMIT_C
        || opts->cmd == CMD_BUILD || opts->cmd == CMD_RUN) {
        int idx;
        idx = diag_stop("ICE-01",
                        "the LLVM backend is not implemented in this build yet",
                        "Code emission (pipeline stage 9) lands with milestone M1. `check` runs every analysis that exists today.",
                        &sf, 0, 1);
        if (idx >= 0) {
            diag_fix(diag_get(idx), "run analyses only", "harmony-base check main.harmony");
        }
    }

    // Flush stored diagnostics (only stops/warns render; a clean build
    // prints nothing at all, §16.6).
    diag_flush(opts->format, opts->all);

    if (diag_stop_count() > 0) { return EXIT_STOP; }
    if (opts->strict && diag_warn_count() > 0) { return EXIT_STOP; }
    return EXIT_OK;
}
