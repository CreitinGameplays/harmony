// harmony-base — report catalogue: `--explain` pages and `--report=seams`.
//
// `--explain <id>` prints the long-form page for a report ID (§23.12). The
// pages live here, next to the compiler, so the documentation cannot drift
// from the binary that renders it.
//
// `--report=seams` lists every `unchecked` block/fn and every `keep` call
// with file, line, and reason (§22.8). P0 has no language surface, so the
// scanner returns an empty listing; the real one plugs in during P14.

int explain_known(char* id) {
    return str_eq(id, "compiler.internal")
        || str_eq(id, "source.not-found")
        || str_eq(id, "usage.unknown-flag")
        || str_eq(id, "usage.unknown-report-id")
        || str_eq(id, "usage.too-many-inputs");
}

// One long-form page: the rule, an example, common causes, related IDs.
void explain_page(char* id) {
    out_str(id);
    out_nl();
    out_nl();
    if (str_eq(id, "compiler.internal")) {
        out_str("  This is a bug in the compiler, not in your program.\n\n");
        out_str("  rule  a crash, a wrong diagnostic, or an internal abort is always\n");
        out_str("        a compiler fault and should be reported\n");
        out_str("  fix   please file an issue with the source that triggered it\n");
        out_nl();
        out_str("  related: source.not-found\n");
        return;
    }
    // Driver-level IDs share one short page.
    out_str("  Driver-level condition, not a language report.\n\n");
    if (str_eq(id, "source.not-found")) {
        out_str("  rule  the input file could not be read\n");
        out_str("  fix   check the path and file permissions\n");
    } else if (str_eq(id, "usage.unknown-flag")) {
        out_str("  rule  the flag is not recognized by this compiler version\n");
        out_str("  fix   run with --help to list accepted flags\n");
    } else if (str_eq(id, "usage.unknown-report-id")) {
        out_str("  rule  --explain needs a valid report ID (area.slug)\n");
        out_str("  fix   pick an ID from a rendered report's `see` line\n");
    } else {
        out_str("  rule  exactly one input file is accepted\n");
        out_str("  fix   pass a single .harmony source file\n");
    }
    out_nl();
}

int explain_lookup(char* id) {
    if (!explain_known(id)) { return -1; }
    explain_page(id);
    return 0;
}

void seams_print(void) {
    // §22.8: every `unchecked` block, every `unchecked fn`, every `keep`.
    // No language surface exists yet, so the audit listing is empty.
    out_str("no seams (no unchecked blocks, unchecked fns, or keep calls)");
    out_nl();
}
