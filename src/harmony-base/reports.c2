// harmony-base — diagnostic catalogue: `explain` lessons and the `audit`
// listing (docs/harmony.md §16.8, §13.6).
//
// `harmony-base explain <CODE>` prints the long-form lesson for a diagnostic
// code: WHAT/WHY/BAD/GOOD/NOTE/SEE (§16.8). The lessons live next to the
// compiler so the documentation cannot drift from the binary that renders it.
//
// `harmony-base audit` lists every `unchecked` block and `unchecked fn` with
// file, line, and reason (§13.6). No language surface exists yet, so the
// scanner returns an empty listing; it plugs in during M6.

const char* EXPLAIN_HEADER =
"WHAT   A %s\n";

// The lesson template: WHAT/WHY/BAD/GOOD/NOTE/SEE (§16.8).
void explain_page(char* code) {
    out_str(code);
    out_nl();
    out_nl();
    out_str("WHAT   This diagnostic code exists but its long-form lesson has\n");
    out_str("       not been written for this build yet.\n");
    out_str("WHY    Stable codes, one lesson each (docs/harmony.md 16.8).\n");
    out_str("SEE    docs/harmony.md - 16.10 Code catalogue\n");
    out_nl();
}

// One lesson per code. The driver-level codes get real lessons now; the
// language codes gain theirs as the analyses land.
void explain_page_compiler(void) {
    out_str("ICE-01 - the compiler broke its own rules\n");
    out_nl();
    out_str("WHAT   The compiler hit a condition it promises is unreachable:\n");
    out_str("       a stage failed before its output could be produced.\n");
    out_str("WHY    The compiler's job is a verdict for every input; bail-outs\n");
    out_str("       mean a bug in the compiler, not in your program.\n");
    out_str("BAD    any input that ends in a compiler crash\n");
    out_str("GOOD   the same input getting a diagnostic, or compiling\n");
    out_str("NOTE   Please report it: the source that triggered it is the\n");
    out_str("       most useful thing you can attach.\n");
    out_str("SEE    docs/harmony.md - 16.10 Code catalogue\n");
    out_nl();
}

// Returns 1 when `code` is recognized by this build.
int explain_known(char* code) {
    return str_eq(code, "ICE-01")
        || str_eq(code, "SYN-01")
        || str_eq(code, "SYN-04")
        || str_eq(code, "NAME-02")
        || str_eq(code, "USE-01")
        || str_eq(code, "CFG-01");
}

int explain_lookup(char* code) {
    if (!explain_known(code)) { return -1; }
    if (str_eq(code, "ICE-01")) {
        explain_page_compiler();
        return 0;
    }
    // The remaining codes currently share the stub lesson; each gets its
    // own WHAT/WHY/BAD/GOOD text as the stage that emits it lands.
    explain_page(code);
    return 0;
}

void audit_print(void) {
    // §13.6: every `unchecked` block / `unchecked fn`, with file, line, reason.
    // No language surface yet; the listing is empty until M6.
    out_str("unchecked audit - 0 sites - 0 lines total");
    out_nl();
}
