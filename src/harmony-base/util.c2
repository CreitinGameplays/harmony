// harmony-base — arena allocator, string helpers, raw output.

char g_arena[16777216];
int  g_arena_used;

// ---------------------------------------------------------------------------
// Arena
// ---------------------------------------------------------------------------

void arena_reset(void) {
    g_arena_used = 0;
}

int arena_used(void) {
    return g_arena_used;
}

char* arena_alloc(int n) {
    char* p;
    // 8-byte align (c2x-seed structs/pointers want natural alignment).
    g_arena_used = (g_arena_used + 7) & (0 - 8);
    p = &g_arena[g_arena_used];
    g_arena_used = g_arena_used + n;
    // A hard arena-overflow is a compiler bug, but failing loudly beats
    // scribbling past the block.
    if (g_arena_used > 16777216) {
        err_str("harmony-base: internal: arena exhausted\n");
        syscall_exit(EXIT_INTERNAL);
    }
    return p;
}

char* arena_alloc_str(char* s) {
    int n;
    char* p;
    int i;
    n = str_len(s);
    p = arena_alloc(n + 1);
    i = 0;
    while (i < n) { p[i] = s[i]; i = i + 1; }
    p[n] = 0;
    return p;
}

// ---------------------------------------------------------------------------
// Strings
// ---------------------------------------------------------------------------

int str_len(char* s) {
    int n;
    n = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

int str_eq(char* a, char* b) {
    int i;
    i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return a[i] == b[i];
}

int str_has_prefix(char* s, char* prefix) {
    int i;
    i = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

char* str_copy(char* s) {
    return arena_alloc_str(s);
}

char* str_concat(char* a, char* b) {
    int na;
    int nb;
    char* p;
    int i;
    na = str_len(a);
    nb = str_len(b);
    p = arena_alloc(na + nb + 1);
    i = 0;
    while (i < na) { p[i] = a[i]; i = i + 1; }
    i = 0;
    while (i < nb) { p[na + i] = b[i]; i = i + 1; }
    p[na + nb] = 0;
    return p;
}

// Writes a signed decimal integer to `fd`. Returns the number of bytes.
int write_int(int fd, int n) {
    char buf[32];
    int len;
    int neg;
    int i;
    int j;
    if (n == 0) {
        syscall_write(fd, "0", 1);
        return 1;
    }
    neg = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    i = 0;
    while (n > 0 && i < 30) {
        buf[i] = '0' + (n - (n / 10) * 10);
        n = n / 10;
        i = i + 1;
    }
    if (neg) { buf[i] = '-'; i = i + 1; }
    len = i;
    // Reverse in place.
    j = 0;
    i = len - 1;
    while (j < i) {
        char t;
        t = buf[j];
        buf[j] = buf[i];
        buf[i] = t;
        j = j + 1;
        i = i - 1;
    }
    syscall_write(fd, buf, len);
    return len;
}

// ---------------------------------------------------------------------------
// Raw output
// ---------------------------------------------------------------------------

void out_str(char* s) {
    int n;
    n = str_len(s);
    if (n > 0) { syscall_write(FD_STDOUT, s, n); }
}

void out_nl(void) {
    syscall_write(FD_STDOUT, "\n", 1);
}

void out_int(int n) {
    write_int(FD_STDOUT, n);
}

void err_str(char* s) {
    int n;
    n = str_len(s);
    if (n > 0) { syscall_write(FD_STDERR, s, n); }
}

void err_nl(void) {
    syscall_write(FD_STDERR, "\n", 1);
}

void err_int(int n) {
    write_int(FD_STDERR, n);
}
