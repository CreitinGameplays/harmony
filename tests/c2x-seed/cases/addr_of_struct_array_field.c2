// Regression: &r->spans[i] — address of a struct-array field reached through a
// pointer. Before the fix, gen_expr's `.addr_index` path assumed the operand
// was ident[index], misread the AST_MEMBER base, and segfaulted.
// EXPECT: 79
struct Span { int file; int start; };
struct Report { int nspans; struct Span spans[8]; };

int main(void) {
    struct Report r;
    struct Span* s;
    r.spans[2].file = 7;
    r.spans[2].start = 9;
    s = &r.spans[2];
    return s->file * 10 + s->start;
}
