// Regression: indexed / address-of accesses on an undeclared identifier used
// to crash the compiler (SIGSEGV in codegen): the fast paths pushed the base
// name pointer, then jumped to the shared epilogue *without popping it* when
// the name was neither a local nor a global, so the codegen operand stack
// grew on every such node and later stages walked off the end. Four paths
// were affected: `x[i]` (read), `&x[i]`, `&x`, and `x[i] = ...` (write).
//
// The crash was first patched to emit nothing and yield 0; that, however,
// silently compiled `int x = undeclared_name;` to garbage. Undeclared
// identifiers are now a hard compile error everywhere (gen_expr .ident,
// .index_no_base, and gen_addr .ga_ident), matching C.
// WANT: undeclared identifier
int read_index(void) {
    return g_buf[0];
}
int write_index(void) {
    h_buf[1] = 7;
    return 0;
}
char* addr_index(void) {
    return &k_buf[2];
}
char* addr_name(void) {
    return &m_name;
}
int main(void) {
    char* p;
    p = addr_index();
    if (p == addr_name()) { return 1; }
    return read_index() + write_index();
}
