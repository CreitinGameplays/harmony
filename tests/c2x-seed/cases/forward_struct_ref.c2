// Regression: forward references to a struct defined later, and mutually
// recursive structs. `struct A { struct B* b; }; struct B { ... };` used to
// fail to parse ("Expected identifier") because a pointer field may only name
// an already-registered struct. Forward-referenced pointer fields now register
// a placeholder that is back-patched when the struct is defined.
// EXPECT: 42
struct A { int x; struct B* b; };
struct B { int y; struct A* a; };

char g_mem[4096];
int g_off;
char* aalloc(int n) { char* p; p = &g_mem[g_off]; g_off = g_off + n; return p; }

int main(void) {
    struct A* a;
    struct B* b;
    a = (struct A*)aalloc(16);
    b = (struct B*)aalloc(16);
    a->x = 7;
    b->y = 9;
    a->b = b;
    b->a = a;
    if (a->b->y != 9) { return 1; }
    if (b->a->x != 7) { return 2; }
    return 42;
}
