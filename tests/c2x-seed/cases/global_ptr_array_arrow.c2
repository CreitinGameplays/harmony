// EXPECT: 7
// Regression: a global array of struct pointers indexed then arrowed
// (`g_slots[i]->field`) miscompiled the same way as the local case: the
// element loaded correctly but the pointee's field array was lost, so the
// field offset was skipped and the raw pointer leaked out.
struct E { int kind; int a; };
struct E* g_slots[2];
int main() {
    struct E x;
    x.a = 5;
    g_slots[0] = &x;
    g_slots[1] = &x;
    if (g_slots[0]->a != 5) { return 1; }
    if (g_slots[1]->a != 5) { return 2; }
    return 7;
}
