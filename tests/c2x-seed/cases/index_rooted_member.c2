// Regression: index-rooted member chains (o[i].field and o[i].inner.field).
// Before the fix, the chained-member handler assumed the chain was rooted at a
// plain struct name and produced wrong offsets (or crashed).
// EXPECT: 42
struct Inner { int a; int b; };
struct Outer { struct Inner inner; int c; };

int main(void) {
    struct Outer o[2];
    o[0].inner.a = 1;
    o[0].inner.b = 2;
    o[0].c = 3;
    o[1].inner.a = 10;

    if (o[0].inner.a * 100 + o[0].inner.b * 10 + o[0].c != 123) {
        return 1;
    }
    if (o[1].inner.a != 10) {
        return 2;
    }
    return 42;
}
