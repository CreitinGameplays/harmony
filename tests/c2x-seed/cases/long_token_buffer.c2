// Regression: a token longer than the lexer's inline 256-byte buffer.
// Before the fix, tok_buf was a fixed 256-byte array with no bounds check:
// scanning a 256+-byte string literal wrote past it into adjacent BSS,
// clobbering a pointer field (the compiler then segfaulted in strlen on
// garbage). The buffer now grows onto the heap and every scan loop reserves
// room, so long string literals and identifiers compile correctly instead of
// silently truncating or corrupting state.
// EXPECT: 42
char* longlit = "";

int averyveryveryveryveryveryveryveryveryveryveryveryveryveryveryverylongidentifier = 40;

int main(void) {
    // The literal must survive intact: at index 255 it holds 'V' (beyond the
    // old 256-byte inline buffer's truncation point) and at index 299 'N'.
    if (longlit[0] != 'A') { return 1; }
    if (longlit[255] != 'V') { return 2; }
    if (longlit[299] != 'N') { return 3; }
    return averyveryveryveryveryveryveryveryveryveryveryveryveryveryveryverylongidentifier + 2;
}
