// EXPECT: 7
// Regression: `arr[i]->field` on an array of struct pointers lost the
// pointee's field array, so the member offset was never applied and the
// expression evaluated to the pointer itself. The symbol table now carries
// the pointee field array in a second slot (`.fields`) while `extra` keeps
// the element count for bounds checks.
struct E { int kind; int a; };
int main() {
    struct E x;
    struct E* arr[2];
    x.a = 3;
    arr[0] = &x;
    if (arr[0]->a != 3) { return 1; }
    if (arr[0]->a != 3) { return 2; }   // repeated read, still resolves
    return 7;
}
