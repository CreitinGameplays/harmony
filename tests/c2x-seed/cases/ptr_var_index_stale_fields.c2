// EXPECT: 7
// Regression: indexing through a pointer-to-struct variable
// (`t[0].field`, `t[0]->field`) only worked when an *earlier* expression
// happened to leave the right field array in gen_expr_struct_fields. The
// pointer-index paths never set it, so a fresh function (or one whose last
// expression was an unrelated type) mis-scaled the index and dropped the
// member offset. Each pointer-index path now sets the field array from the
// symbol's own metadata.
struct E { int kind; int a; };
char g_buf[256];
int g_used;
char* arena(int n) {
    char* p;
    g_used = (g_used + 7) & (0 - 8);
    p = &g_buf[g_used];
    g_used = g_used + n;
    return p;
}
int fresh_local() {
    struct E* t;
    t = (struct E*) arena(64);
    t[0].kind = 1;
    t[0].a = 4;
    return t[0].a;          // no earlier struct expression in this function
}
int fresh_global() {
    struct E* g;
    g = (struct E*) arena(64);
    g[0].a = 6;
    return g[0]->a;         // arrow form, still no earlier struct expression
}
int main() {
    if (fresh_local() != 4) { return 1; }
    if (fresh_global() != 6) { return 2; }
    return 7;
}
