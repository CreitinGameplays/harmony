// Regression: struct-pointer depth >= 2. `struct T**` used to be mis-encoded
// as `ARRAY_TYPE_FLAG + TOK_KW_STRUCT` (a flag collision), which made the
// compiler treat a double pointer as a struct array and segfault. Indexing a
// pointer-to-pointer also mis-scaled the index (no *8), so only index 0 worked.
// EXPECT: 42
struct Node { int kind; };

char g_mem[4096];
int g_off;
char* aalloc(int n) { char* p; p = &g_mem[g_off]; g_off = g_off + n; return p; }

int main(void) {
    struct Node** pp;
    int i;
    pp = (struct Node**)aalloc(64);
    i = 0;
    while (i < 4) {
        pp[i] = (struct Node*)aalloc(16);
        pp[i]->kind = i * 10;
        i = i + 1;
    }
    if (pp[0]->kind != 0) { return 1; }
    if (pp[1]->kind != 10) { return 2; }
    if (pp[2]->kind != 20) { return 3; }
    if (pp[3]->kind != 30) { return 4; }
    return 42;
}
