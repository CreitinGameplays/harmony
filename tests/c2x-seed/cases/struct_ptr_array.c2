// Regression: struct pointer arrays and struct arrays with pointer fields.
// EXPECT: 10
struct Node { int value; struct Node* next; };
struct Node* buckets[8];

int main(void) {
    struct Node a;
    struct Node b;
    struct Node pts[4];

    a.value = 1;
    a.next = &b;
    b.value = 2;
    b.next = 0;

    buckets[0] = &a;
    pts[0].value = 3;
    pts[3].value = 4;

    return a.value + b.value + pts[0].value + pts[3].value;
}
