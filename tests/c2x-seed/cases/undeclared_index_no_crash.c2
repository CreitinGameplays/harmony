// Regression: indexed / address-of accesses on an undeclared identifier used to
// crash the compiler (SIGSEGV in codegen). The fast paths pushed the base name
// pointer, then jumped to the shared epilogue *without popping it* when the
// name was neither a local nor a global — so the codegen operand stack grew on
// every such node and later stages walked off the end. Four paths were
// affected: `x[i]` (read), `&x[i]`, `&x`, and `x[i] = ...` (write).
//
// These programs are semantically invalid (the names are undeclared), but the
// compiler must terminate cleanly rather than crash. COMPILE-ONLY: the runtime
// behaviour is undefined, only the absence of a compiler crash is checked.
// COMPILE-ONLY
int read_index(void) {
    return g_buf[0];
}
int write_index(void) {
    h_buf[1] = 7;
    return 0;
}
char* addr_index(void) {
    return &k_buf[2];
}
char* addr_name(void) {
    return &m_name;
}
int main(void) {
    char* p;
    p = addr_index();
    if (p == addr_name()) { return 1; }
    return read_index() + write_index();
}
