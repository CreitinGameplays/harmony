// Syscall wrappers with a 4th argument: the raw Linux `syscall` instruction
// takes args 4..6 in r10/r8/r9, but a C caller passes them in rcx/r8/r9. The
// emitted `syscall_wait4` stub documented "4th arg in r10" yet never moved
// rcx -> r10, so `wait4` read a garbage rusage pointer and returned -EFAULT.
//
// This forks a child that exits 7 and waits for it. Before the fix the wait
// failed (EFAULT) no matter what; r10 is clobbered first to make the bug
// deterministic (any code that used r10 earlier tripped it).
// EXPECT: 7

int syscall_wait4(int pid, int* status, int options, int rusage);
int syscall_fork(void);
int syscall_exit(int code);

int main() {
    int pid;
    int status;
    int w;
    status = 0;
    pid = syscall_fork();
    if (pid == 0) {
        syscall_exit(7);
    }
    // Clobber r10 so a stub that forgets the rcx->r10 move is caught.
    asm("    mov r10, 12345");
    w = syscall_wait4(pid, &status, 0, 0);
    if (w < 0) {
        return 1;              // EFAULT: the bug
    }
    return (status >> 8) & 0xFF;   // the child's exit code
}
