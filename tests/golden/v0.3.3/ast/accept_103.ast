        type-name Expr
      type-name Heap
        type-name Expr
  fn eval
    type-name i32
    block
      switch
        path e
        arm
          block
            return
              path n
          pat-variant Lit
            pat-bind n
        arm
          block
            return
              binary -
                int
                call
                  path eval
                  path inner
          pat-variant Neg
            pat-bind inner
        arm
          block
            return
              binary +
                call
