program
  fn fib
    type-name i32
    block
      if
        binary <
          path n
          int #2
        block
          return
            path n
      return
        binary +
          call
            path fib
            binary -
              path n
              int #1
          call
            path fib
            binary -
              path n
              int #2
    param n
      type-name i32
  fn main
    type-name i32
    block
      let i #1
        int
      let sum #1
        int
      while
        binary <
          path i
          int #7
        block
          assign +=
            path sum
            call
              path fib
              path i
          assign +=
            path i
            int #1
      return
        path sum
