  fn main
    type-name i32
    block
      let r
        call
          path use_s
      if
        binary !=
          path r
          int #42
        block
          return
            binary +
              int #100
              path r
      let r2
        call
          path use_pair
      if
        binary !=
          path r2
          int #42
        block
          return
            binary +
              int #200
              path r2
      let r3
        call
          path use_wrap
      if
        binary !=
          path r3
          int #42
        block
