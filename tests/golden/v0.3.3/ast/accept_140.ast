program
  struct Point
    field x
      type-name i32
    field y
      type-name i32
  fn sum
    type-name i32
    block
      return
        binary +
          field x
            path p
          field y
            path p
    param p
      type-name Point
  fn make
    type-name Point
    block
      return
        struct-init Point
          field-init x
            path sx
          field-init y
            path sy
    param sx
      type-name i32
    param sy
      type-name i32
  fn main
    type-name i32
    block
      let p
        struct-init Point
          field-init x
            int #10
          field-init y
            int #20
      let q #1
        call
          path make
          int #1
          int #2
      assign =
        field x
          path q
        int #5
      let a
        array-lit
          int #3
          int #4
          int #5
          int #6
      return
        binary +
          binary +
            call
              path sum
              path p
            field x
              path q
          index
            path a
            int #2
