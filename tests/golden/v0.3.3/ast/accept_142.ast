program
  enum Color
    variant Red
    variant Green
    variant Blue
  fn code
    type-name i32
    block
      switch
        path c
        arm
          block
            return
              int #1
          pat-bind Color::Red
        arm
          block
            return
              int #2
          pat-bind Color::Green
        arm
          block
            return
              int #3
          pat-bind Color::Blue
      return
        int
    param c
      type-name Color
  fn main
    type-name i32
    block
      return
        call
          path code
          path Color::Green
