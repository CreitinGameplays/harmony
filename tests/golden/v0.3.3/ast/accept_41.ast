program
  fn main
    type-name i32
    block
      switch
        path s
        arm
          block
            return
              int #1
          pat-variant Circle
            pat-bind r
        arm
          block
            return
              int #2
          pat-variant Rect
            pat-bind w
            pat-bind h
        arm
          block
            return
              int #3
          pat-bind Dot
