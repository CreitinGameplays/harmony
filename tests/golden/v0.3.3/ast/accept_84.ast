program
  struct Node
    field kind
      type-name i32
    field payload
      type-name i64
  fn make
    type-name Node
    block
      return
        struct-init Node
          field-init kind
            path k
          field-init payload
            int #1000
    param k
      type-name i32
  import field-call-result-env.hr
  fn main
    type-name i32
    block
      if
        binary !=
          field kind
            call
              path make
              int #5
          int #5
        block
          return
            int #1
      if
        binary !=
          field payload
            call
              path make
              int #9
          int #1000
        block
          return
            int #2
      if
        binary !=
          binary +
            field kind
              call
                path make
                int #3
            field kind
              call
                path make
                int #4
          int #7
        block
          return
            int #3
      let b
        field kind
          call
            path field_call_result_env::big
            int #7
      if
        binary !=
          path b
          int #7
        block
          return
            int #4
      return
        int #42
