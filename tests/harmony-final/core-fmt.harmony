// EXPECT: 42
// library/core/fmt.hr — diagnostics as data, rendered exactly like
// harmony-base (§16.7, §19.8.7).
import "../../library/core/fmt.hr";

fn render_line() -> i32 {
    let d = fmt::diag("TYPE-01", fmt::Severity::Stop, "type mismatch",
                      "Expected `i32`, found `&str`.", "main.harmony", 12, 34);
    let s = fmt::render_line(&d);
    if (s.as_str() != "main.harmony:12:34: stop[TYPE-01]: type mismatch\n") { return 1; }
    let w = fmt::diag("MUT-02", fmt::Severity::Warn, "prefer a const",
                      "This binding never changes.", "lib/x.harmony", 1, 0);
    let sw = fmt::render_line(&w);
    if (sw.as_str() != "lib/x.harmony:1:0: warn[MUT-02]: prefer a const\n") { return 2; }
    let h = fmt::diag("SHADOW-01", fmt::Severity::Hint, "shadows a name",
                      "An outer name has the same spelling.", "a.hr", 9, 7);
    let sh = fmt::render_line(&h);
    if (sh.as_str() != "a.hr:9:7: hint[SHADOW-01]: shadows a name\n") { return 3; }
    return 42;
}

fn render_json() -> i32 {
    let d = fmt::diag("LEX-01", fmt::Severity::Stop, "bad escape",
                      "Unknown escape.", "x.harmony", 3, 11);
    let s = fmt::render_json(&d);
    let want = "{\"severity\": \"stop\", \"code\": \"LEX-01\", \"title\": \"bad escape\", \"summary\": \"Unknown escape.\", \"primary\": {\"file\": \"x.harmony\", \"line\": 3, \"col\": 11}, \"story\": [], \"fixes\": []}\n";
    if (s.as_str() != want) {
        println("got: {}", s.as_str());
        return 1;
    }
    return 42;
}

fn escaping() -> i32 {
    let e = fmt::json_escape("a\"b\\c\nd\te\rf");
    if (e.as_str() != "\"a\\\"b\\\\c\\nd\\te\\rf\"") {
        println("got: {}", e.as_str());
        return 1;
    }
    // UTF-8 and ordinary bytes pass through unchanged.
    let u = fmt::json_escape("héllo");
    if (u.as_str() != "\"héllo\"") { return 2; }
    let empty = fmt::json_escape("");
    if (empty.as_str() != "\"\"") { return 3; }
    return 42;
}

fn glyphs(ascii: bool) -> i32 {
    let mut step: &str = "(3)";
    let mut site: &str = ">";
    let mut here: &str = "<-- here";
    if (!ascii) {
        step = "\u{2462}";
        site = "\u{25b8}";
        here = "\u{25c2} here";
    }
    if (fmt::step_glyph(3, ascii) != step) { return 1; }
    if (fmt::site_glyph(ascii) != site) { return 2; }
    if (fmt::here_glyph(ascii) != here) { return 3; }
    if (fmt::severity_word(fmt::Severity::Stop) != "STOP") { return 4; }
    if (fmt::severity_word_lower(fmt::Severity::Warn) != "warn") { return 5; }
    return 42;
}

fn main() -> i32 {
    let r = render_line();
    if (r != 42) { return 100 + r; }
    let r2 = render_json();
    if (r2 != 42) { return 200 + r2; }
    let r3 = escaping();
    if (r3 != 42) { return 300 + r3; }
    let r4 = glyphs(false);
    if (r4 != 42) { return 400 + r4; }
    let r5 = glyphs(true);
    if (r5 != 42) { return 500 + r5; }
    return 42;
}
