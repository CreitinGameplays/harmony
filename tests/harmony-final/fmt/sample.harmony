// A canonical-format fixture covering comments, blocks, calls, generics,
// strings, operators and `else`.
fn twice<T: copy>(x: T) -> T { return x + x; }

fn classify(n: i32) -> i32 {
    if (n > 10) {
        return 2;
    } else {
        if (n > 3) { return 1; }
        return 0;
    }
}

fn main() -> i32 {
    /* block comments are preserved, trimmed to their own line */
    let s = "a\nb";
    let mut total: i32 = twice<i32>(4);
    total = total + classify(7);
    if (s.len() > 2) { total += 1; }
    return total;
}
