// Batched LLVM-IR differential driver (R6).
//
// Like the type-check harness, this reads no files: the Python harness embeds
// every program as a string literal. Each accepted program is lowered and its
// IR is printed between unambiguous markers, so one build plus one run covers
// the whole corpus.
import "../../library/core/mem.hr";
import "../../library/core/vec.hr";
import "../../library/core/str.hr";
import "../../harmony/ast/node.hr";
import "../../harmony/lexer/token.hr";
import "../../harmony/lexer/ctx.hr";
import "../../harmony/lexer/scan.hr";
import "../../harmony/parser/pctx.hr";
import "../../harmony/parser/parse.hr";
import "../../harmony/parser/item.hr";
import "../../harmony/driver/loader.hr";
import "../../harmony/sema/check.hr";
import "../../harmony/sema/types.hr";
import "../../harmony/codegen/llvm/emit.hr";

fn run_one(i: usize, src: &str) {
    let mut arena: mem::Arena = mem::Arena { .cur = Raw::null() };
    let mut ns: node::Nodes = node::nodes_make();
    let mut lx: ctx::Ctx = ctx::make(src, "main.harmony");
    scan::scan(&mut lx, &mut arena);
    let mut p: pctx::Parser = pctx::make(&mut ns, lx.toks.clone(), "main.harmony");
    let program = item::parse_program(&mut p);
    let mut c = check::make(ns, "main.harmony");
    check::check_program(&mut c, program);
    print("@@@CASE {}\n", i);
    if (program >= 0 && p.stops == 0 && check::stop_count(&c) == 0) {
        let ir = emit::emit_module(&mut c, program, 0);
        print("@@@IR\n");
        print("{}", ir);
        print("@@@END {}\n", i);
    } else {
        let mut d: usize = 0;
        while (d < c.diags.len()) {
            print("DIAG {} at {}:{}: {}\n", c.diags.get(d).code, c.diags.get(d).line,
                  c.diags.get(d).col, c.diags.get(d).summary);
            d += 1;
        }
        print("@@@END {}\n", i);
    }
}

// Parses a decimal command-line index.
fn parse_usize(s: &str) -> usize {
    let b = s.as_bytes();
    let mut value: usize = 0;
    let mut i: usize = 0;
    while (i < s.len()) {
        let c = b[i];
        if (c < 48u8 || c > 57u8) { break; }
        value = value * 10 + (c - 48u8) as usize;
        i += 1;
    }
    return value;
}

fn main() -> i32 {
    let sources: [&str; 1] = ["fn main() -> i32 { return 0; }"];
    let module_paths: [&str; 1] = ["main.harmony"];
    let module_chunks: [&str; 1] = ["fn main() -> i32 { return 0; }"];
    let chunk_starts: [i32; 1] = [0];
    let chunk_ends: [i32; 1] = [1];
    let module_roots: [&str; 1] = ["main.harmony"];
    let module_starts: [i32; 1] = [0];
    let module_ends: [i32; 1] = [1];
    let av = args();
    if (av.len() < 2) { return 2; }
    let index = parse_usize(av[1]);
    if (index < sources.len()) {
        run_one(index, sources[index]);
        return 0;
    }
    let case_index = index - sources.len();
    if (case_index >= module_roots.len()) { return 2; }

    // Multi-module case: load the embedded module graph, check the merged
    // program, and emit its IR.
    let mut arena: mem::Arena = mem::Arena { .cur = Raw::null() };
    let mut ns: node::Nodes = node::nodes_make();
    let mut mods: vec::Vec<loader::Module> = vec::Vec<loader::Module>::make();
    let mut mi: usize = module_starts[case_index] as usize;
    let end: usize = module_ends[case_index] as usize;
    while (mi < end) {
        // A module source is stored in bounded chunks: Harmony's string
        // literals have a fixed maximum length, and an imported library file
        // can exceed it.
        let mut text: str::String = str::String::make();
        let mut ci: usize = chunk_starts[mi] as usize;
        let cend: usize = chunk_ends[mi] as usize;
        while (ci < cend) {
            text.push(module_chunks[ci]);
            ci += 1;
        }
        mods.push(loader::Module {
            .path = module_paths[mi], .src = text.as_str(),
        });
        mi += 1;
    }
    let root = module_roots[case_index];
    let loaded = loader::load(&mut ns, &mut arena, &mods, root);
    print("@@@CASE {}\n", index);
    let mut di: usize = 0;
    while (di < loaded.diags.len()) {
        print("DIAG {} at {}:{}: {}\n", loaded.diags.get(di).code,
              loaded.diags.get(di).line, loaded.diags.get(di).col,
              loaded.diags.get(di).summary);
        di += 1;
    }
    if (loaded.program >= 0 && loaded.diags.len() == 0) {
        let mut c = check::make(ns, root);
        check::check_program(&mut c, loaded.program);
        if (check::stop_count(&c) == 0) {
            let ir = emit::emit_module(&mut c, loaded.program, 0);
            print("@@@IR\n");
            print("{}", ir);
        } else {
            di = 0;
            while (di < c.diags.len()) {
                print("DIAG {}: {}\n", c.diags.get(di).code, c.diags.get(di).summary);
                di += 1;
            }
        }
    }
    print("@@@END {}\n", index);
    return 0;
}
