// Two `try`s in one function, a `mut` binding with an annotation, and a
// `Bad` payload that is itself an aggregate (copied into the sret slot).
enum ParseError { NoInput, BadChar(char), TooBig, }

fn parse(text: &str) -> Outcome<i32, ParseError> {
    if (text.len() == 0) { return Bad(ParseError::NoInput); }
    return Good(text.len() as i32);
}

fn sum(a: &str, b: &str) -> Outcome<i64, ParseError> {
    let x = try parse(a);
    let mut y: i32 = try parse(b);
    y = y + 1;
    return Good((x + y) as i64);
}

fn bad_after(a: &str) -> Outcome<i32, ParseError> {
    let x = try parse(a);
    return Bad(ParseError::TooBig);
}

fn main() -> i32 {
    let r1 = sum("ab", "cd");
    switch (r1) {
        case Good(v): { if (v != 5) { return 1; } }
        case Bad(e): { return 2; }
    }
    let r2 = sum("", "cd");
    switch (r2) {
        case Good(v): { return 3; }
        case Bad(e): {
            switch (e) {
                case NoInput: { }
                default: { return 4; }
            }
        }
    }
    let r3 = bad_after("z");
    switch (r3) {
        case Good(v): { return 5; }
        case Bad(e): {
            switch (e) {
                case TooBig: { return 42; }
                default: { return 6; }
            }
        }
    }
    return 7;
}
