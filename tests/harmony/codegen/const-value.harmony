// EXPECT: 125
// `const` in value position (§6.2). Constants are inlined at every use, so
// the backend must lower the initializer at the use site. Before this fix a
// constant in value position silently lowered to zero (and a `const` array
// indexed loaded through a null pointer).
const BASE: i32 = 10;
const STEP: i32 = 2 * 3;            // arithmetic over literals
const NEXT: i32 = BASE + STEP;      // another constant
const NEG: i32 = -6;                // unary minus
const TABLE: [i32; 3] = [40, 20, 11];   // a constant array
struct Pair { a: i32; b: i32; }
const P: Pair = Pair { .a = 5, .b = 6 };   // a constant struct

fn add(x: i32) -> i32 {
    return x + 1;                   // a constant as a call argument
}

fn main() -> i32 {
    let mut acc = 0;
    acc = acc + NEXT;               // 16
    acc = acc + NEG;                // 10
    acc = acc + TABLE[2];           // 21
    acc = acc + P.a;                // 26
    acc = acc + add(P.b);           // 33
    if (BASE == 10) { acc = acc + 1; }  // 34 (a constant condition)
    let mut i = 0;
    while (i < 3) { i = i + 1; }    // a constant in a loop condition
    acc = acc + i;                  // 37
    // 37 + 54 = 91.
    // TABLE[0] + TABLE[2] + 37 = 40 + 11 + 37 = 88; 37 + 88 = 125.
    return acc + TABLE[0] + TABLE[2] + 37;
}
