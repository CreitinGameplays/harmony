// EXPECT: 42
// Enum variants with payloads (§6.4/§6.5): `Enum::Variant(args)` constructs
// the tagged aggregate, and `case Variant(bind)` binds the payload fields.
// Guards two layout/alignment bugs: the payload must live at byte offset 8
// (past the 8-byte tag region), and a by-value enum argument must survive the
// call.
enum Shape {
    Rect(i32, i32),
    Circle(i32),
    Point,
}

fn area(s: Shape) -> i32 {
    switch (s) {
        case Rect(w, h): { return w * h; }
        case Circle(r):  { return r * r; }
        case Point:      { return 0; }
    }
    return -1;
}

fn main() -> i32 {
    let a = area(Shape::Rect(6, 7));   // 42
    let b = area(Shape::Circle(1));    // 1
    let c = area(Shape::Point);        // 0
    return a + b + c - 1;              // 42
}
