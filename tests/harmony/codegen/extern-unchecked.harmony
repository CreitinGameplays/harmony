// EXPECT: 9
// IR: declare i64 @lc_syscall3
// `extern "C" fn` FFI (§6.8): the C symbol is kept unmangled, the call must be
// inside `unchecked` (§13.2), and the runtime exposes a raw syscall hook to
// prove the ABI end to end without a libc.
extern "C" fn lc_syscall3(n: i64, a: i64, b: i64, c: i64) -> i64;

fn main() -> i32 {
    let mut pid: i64 = 0;
    unchecked("lc_syscall3(39) is getpid, which always succeeds") {
        pid = lc_syscall3(39, 0, 0, 0);
    }
    if (pid > 0) { return 9; }
    return 0;
}
