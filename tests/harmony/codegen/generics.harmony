// EXPECT: 42
// Generic functions (§18, M1 monomorphization). A `fn id<T>(...)` template is
// cloned per call site; each instance becomes a concrete `name__Ty` function.
// Multiple instantiations of one template, a bounded parameter, a nested
// instantiation, and *inferred* type arguments (`id(7)` == `id<i32>(7)`, which
// reuses the same instance) all coexist.
fn id<T>(x: T) -> T {
    return x;
}

fn max<T: ord>(a: T, b: T) -> T {
    if (a < b) { return b; }
    return a;
}

fn first<T>(xs: &[T]) -> T {
    return xs[0];
}

fn twice<T>(x: T) -> T {
    return id<T>(x);
}

fn main() -> i32 {
    let a = max<i32>(3, 7);        // 7
    let b = max(9, 2);             // 9  (inferred i32)
    let c = id<i32>(40);           // 40
    let d = id(2 as u8);           // 2  (inferred u8)
    let e = twice(5);              // 5  (inferred i32)
    let arr: [i32; 3] = [11, 22, 33];
    let f = first(&arr[..]);       // 11 (inferred i32 from &[i32])
    // 7 + 9 + 40 + 2 + 5 + 11 = 74; 74 - 32 = 42.
    return a + b + c + (d as i32) + e + f - 32;
}
