// An extern "C" declaration inside an imported module must keep its raw C
// symbol. The module loader used to namespace it as `mod::lc_syscall3`, which
// produced invalid IR (`declare i64 @mod::lc_syscall3`).
extern "C" fn lc_syscall3(n: i64, a: i64, b: i64, c: i64) -> i64;

export fn pid() -> i64 {
    unchecked("getpid cannot fail") {
        return lc_syscall3(39, 0, 0, 0);
    }
    return 0;
}
