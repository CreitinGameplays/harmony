// EXPECT: 55
// A `for` loop with `continue` and `break` inside a `while`.
fn main() -> i32 {
    let mut total = 0;
    for (let mut i = 0; i < 20; i += 1) {
        if (i % 2 == 0) { continue; }   // skip even
        total += i;                     // 1+3+5+7+9 = 25
        if (i >= 9) { break; }
    }
    let mut j = 0;
    while (true) {
        total += 6;
        j += 1;
        if (j >= 5) { break; }
    }
    return total;   // 25 + 30 = 55
}
