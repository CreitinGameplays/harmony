// Free functions and methods deliberately share names with each other:
// `scale`, `total`, and `add` each name both a module function and a method.
export fn scale(x: i32) -> i32 { return x * 3; }

export fn total(x: i32) -> i32 { return x * 100; }

export struct Acc {
    sum: i32;
}

methods Acc {
    export fn make() -> Acc { return Acc { .sum = 0 }; }
    export fn add(&mut self, v: i32) { self.sum += v; }
    export fn total(&self) -> i32 { return self.sum; }
}

export struct Counter {
    n: i32;
}

methods Counter {
    export fn make() -> Counter { return Counter { .n = 0 }; }
    export fn add(&mut self, v: i32) { self.n += v; }
    export fn total(&self) -> i32 { return self.n; }
}
