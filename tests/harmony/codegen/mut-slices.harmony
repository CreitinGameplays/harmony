// EXPECT: 25
// IR: noalias
// Exclusive slices (`&mut [T]`, §5.2): the mutability of a slice is part of
// its type, so writing through a `&mut [T]` parameter is allowed, reslicing
// keeps it exclusive, and the pair carries `noalias` like `&mut T` (§5.4).
fn scale(xs: &mut [i32], k: i32) {
    let mut i: usize = 0;
    while (i < xs.len()) {
        xs[i] = xs[i] * k;
        i = i + 1;
    }
}

fn sum(xs: &[i32]) -> i32 {
    let mut i: usize = 0;
    let mut t: i32 = 0;
    while (i < xs.len()) { t = t + xs[i]; i = i + 1; }
    return t;
}

fn main() -> i32 {
    let mut a: [i32; 4] = [1, 2, 3, 4];
    scale(&mut a[..], 3);             // a = 3, 6, 9, 12
    let mut b: [i32; 3] = [5, 5, 5];
    scale(&mut b[..], 2);             // b = 10, 10, 10
    let t = sum(&a[..]) + sum(&b[..]);  // 30 + 30 = 60
    // A reslice of an exclusive slice stays exclusive.
    let s = &mut a[1..3];             // 6, 9
    scale(s, 10);                     // 60, 90
    let t2 = sum(&a[..]);             // 3 + 60 + 90 + 12 = 165
    return (t + t2) % 100;            // 225 % 100 = 25
}
