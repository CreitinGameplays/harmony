// EXPECT: 24
// A slice may be stored in a struct field and copied by value: the fat pair
// is copied like any other aggregate (§5.2, §6.4).
struct View {
    data: &[i32];
    label: i32;
}

fn total(v: View) -> i32 {
    let mut i: usize = 0;
    let mut sum: i32 = 0;
    while (i < v.data.len()) {
        sum = sum + v.data[i];
        i = i + 1;
    }
    return sum + v.label;
}

fn main() -> i32 {
    let a: [i32; 6] = [1, 2, 3, 4, 5, 6];
    let s = &a[1..5];          // 2 + 3 + 4 + 5 = 14
    let sub = &s[1..3];        // 3 + 4 = 7
    let v = View { .data = sub, .label = 1 };
    let w = View { .data = s, .label = 2 };
    let cv = v;                // by-value copy of a slice-bearing struct
    return total(cv) + total(w);   // (7 + 1) + (14 + 2) = 24
}
