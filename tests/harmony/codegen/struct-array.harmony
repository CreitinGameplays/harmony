// EXPECT: 42
// An array of a named struct type: the element type name must build correctly
// (regression guard for the nested `ll_type_name` scratch-buffer bug), plus a
// slice over such an array.
struct Point { x: i32; y: i32; }

fn sum_x(xs: &[Point]) -> i32 {
    let mut i: usize = 0;
    let mut t: i32 = 0;
    while (i < xs.len()) {
        t = t + xs[i].x;
        i = i + 1;
    }
    return t;
}

fn main() -> i32 {
    let ps: [Point; 4] = [
        Point { .x = 1, .y = 0 },
        Point { .x = 2, .y = 0 },
        Point { .x = 3, .y = 0 },
        Point { .x = 4, .y = 0 },
    ];
    let direct = ps[0].x + ps[3].x;   // 5
    let s = &ps[1..4];                // 2 + 3 + 4 = 9
    return direct + sum_x(s) * 4 + 1; // 5 + 36 + 1 = 42
}
