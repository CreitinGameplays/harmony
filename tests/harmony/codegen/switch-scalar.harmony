// EXPECT: 50
// switch on a scalar: exact matches, or-patterns, ranges, and default.
fn main() -> i32 {
    let n = 5;
    let mut r = 0;
    switch (n) {
        case 1: { r = 10; }
        case 5: { r = 50; }
        case 2 | 3: { r = 99; }
        case 6..=9: { r = 60; }
        default: { r = 1; }
    }
    return r;
}
