// The evaluator: a classic environment-passing `eval`, written as ONE
// self-recursive function.
//
// harmony-base resolves names from earlier text only (no forward declarations),
// so `eval` and `apply` cannot be two mutually recursive functions. They are
// fused here: `mode` selects "evaluate a form" (0) or "apply a callable to an
// already-evaluated argument list" (1). Every walk that needs to re-enter the
// evaluator (argument lists, function bodies, parameter binding) is a loop
// inside this function calling it recursively.
//
// `define` and `set!` mutate the innermost frame in place (the frame lives
// behind a `Heap`, so closures that captured it observe the change). That is
// what lets a `define`d lambda call itself.

// --- primitives ------------------------------------------------------------

// The LISP truth value: the symbol `t` for true, `Nil` for false.
fn bool_val(b: bool) -> Val {
    if (b) { return Val::Sym("t"); }
    return Val::Nil;
}

// Fold the numeric `args` into `acc` left to right. `op` is 0 plus, 1 times,
// 2 subtract, 3 divide. `-` and `/` pass the first argument as `acc` and fold
// the rest; `+` seeds at 0 and `*` at 1.
fn fold_arith(op: i32, args: Val, acc: i32) -> Val {
    let mut total = acc;
    let mut cur = args;
    while (!is_nil(&cur)) {
        let n = as_int(&car(&cur));
        if (op == 0) { total = total + n; }
        else if (op == 1) { total = total * n; }
        else if (op == 2) { total = total - n; }
        else {
            if (n == 0) { return Val::Int(0); }   // tiny LISP: n/0 yields 0
            total = total / n;
        }
        cur = cdr(&cur);
    }
    return Val::Int(total);
}

// The primitive procedures, dispatched by name. None of them re-enters the
// evaluator, so they can be a plain function.
fn builtin(name: &str, args: Val) -> Val {
    let a0 = car(&args);
    let rest = cdr(&args);
    let a1 = car(&rest);
    // Variadic arithmetic: `(+ a b c ...)`, `(* ...)`, `(- a b c ...)` and
    // `(/ a b c ...)` fold over the argument list (LISP convention).
    //   +  : 0 + a + b + c ...
    //   *  : 1 * a * b * c ...
    //   -  : a - b - c ...          (- a) => -a
    //   /  : a / b / c ...          (/ a) => 1/a
    if (name == "+") { return fold_arith(0, args, 0); }
    if (name == "*") { return fold_arith(1, args, 1); }
    if (name == "-") {
        if (is_nil(&rest)) { return Val::Int(0 - as_int(&a0)); }
        return fold_arith(2, rest, as_int(&a0));
    }
    if (name == "/") {
        if (is_nil(&rest)) {
            if (as_int(&a0) == 0) { return Val::Int(0); }
            return Val::Int(1 / as_int(&a0));
        }
        return fold_arith(3, rest, as_int(&a0));
    }
    if (name == "=") { return bool_val(as_int(&a0) == as_int(&a1)); }
    if (name == "<") { return bool_val(as_int(&a0) < as_int(&a1)); }
    if (name == ">") { return bool_val(as_int(&a0) > as_int(&a1)); }
    if (name == "<=") { return bool_val(as_int(&a0) <= as_int(&a1)); }
    if (name == ">=") { return bool_val(as_int(&a0) >= as_int(&a1)); }
    if (name == "%") {
        let d = as_int(&a1);
        if (d == 0) { return Val::Int(0); }
        return Val::Int(as_int(&a0) % d);
    }
    if (name == "&") { return Val::Int(as_int(&a0) & as_int(&a1)); }
    if (name == "|") { return Val::Int(as_int(&a0) | as_int(&a1)); }
    if (name == "^") { return Val::Int(as_int(&a0) ^ as_int(&a1)); }
    if (name == "cons") { return cons(a0, a1); }
    if (name == "car") { return car(&a0); }
    if (name == "cdr") { return cdr(&a0); }
    if (name == "list") { return args; }
    if (name == "nil?") { return bool_val(is_nil(&a0)); }
    if (name == "not") { return bool_val(is_nil(&a0)); }
    return Val::Nil;
}

// True when `name` is one of the primitive procedures (so a call whose head is
// this symbol applies the builtin directly instead of looking it up).
fn is_builtin(name: &str) -> bool {
    return name == "+" || name == "-" || name == "*" || name == "/"
        || name == "%" || name == "&" || name == "|" || name == "^"
        || name == "=" || name == "<" || name == ">" || name == "<=" || name == ">="
        || name == "cons" || name == "car" || name == "cdr" || name == "list"
        || name == "nil?" || name == "not";
}

// --- the fused eval/apply --------------------------------------------------

// mode 0: evaluate `form` in `env` ( `args` is ignored, pass `Val::Nil` ).
// mode 1: apply the callable `form` to the evaluated argument list `args`
//         ( `env` is ignored, pass any environment ).
// mode 2: evaluate each form in the list `form` in `env`, returning the values
//         as a list (used for call arguments).
fn eval(form: Val, env: &Env, args: Val, mode: i32) -> Val {
    if (mode == 2) {
        let mut rev = Val::Nil;
        let mut cur = form;
        while (!is_nil(&cur)) {
            rev = cons(eval(car(&cur), env, Val::Nil, 0), rev);
            cur = cdr(&cur);
        }
        return reverse(rev);
    }
    if (mode == 1) {
        switch (&form) {
            case Sym(name): { return builtin(name, args); }
            case Closure(params, body, cenv): {
                // A child frame of the closure's captured environment, with
                // the parameters bound to the evaluated arguments.
                let mut frame = env_child(cenv);
                let mut p = *params;
                let mut a = args;
                while (!is_nil(&p) && !is_nil(&a)) {
                    let pv = car(&p);
                    let av = car(&a);
                    switch (&pv) {
                        case Sym(pname): { env_define(&frame, pname, av); }
                        case Nil: { }
                        case Int(n): { }
                        case Cons(h, t): { }
                        case Closure(x, y, z): { }
                    }
                    p = cdr(&p);
                    a = cdr(&a);
                }
                // Evaluate the body forms in sequence; the last wins. (This
                // inlines `eval_program`, which cannot be called here because
                // harmony-base has no forward declarations.)
                let mut last = Val::Nil;
                let mut body_cur = *body;
                while (!is_nil(&body_cur)) {
                    last = eval(car(&body_cur), &frame, Val::Nil, 0);
                    body_cur = cdr(&body_cur);
                }
                return last;
            }
            case Nil: { return Val::Nil; }
            case Int(n): { return Val::Nil; }
            case Cons(h, t): { return Val::Nil; }
        }
        return Val::Nil;
    }

    switch (&form) {
        case Int(n): { return form; }
        case Nil: { return Val::Nil; }
        case Sym(s): { return env_lookup(env, s); }
        case Closure(p, b, e): { return form; }
        case Cons(h, t): {
            let head = car(&form);
            let rest = cdr(&form);
            // Special forms are dispatched on the head symbol.
            switch (&head) {
                case Sym(name): {
                    if (name == "quote") { return car(&rest); }
                    if (name == "if") {
                        let cond = eval(car(&rest), env, Val::Nil, 0);
                        if (!is_nil(&cond)) {
                            return eval(car(&cdr(&rest)), env, Val::Nil, 0);
                        }
                        return eval(car(&cdr(&cdr(&rest))), env, Val::Nil, 0);
                    }
                    if (name == "define") {
                        let var = car(&rest);
                        let value = eval(car(&cdr(&rest)), env, Val::Nil, 0);
                        switch (&var) {
                            case Sym(vname): { env_define(env, vname, value); }
                            case Nil: { }
                            case Int(n): { }
                            case Cons(a, b): { }
                            case Closure(p, b2, e2): { }
                        }
                        return value;
                    }
                    if (name == "set!") {
                        let var = car(&rest);
                        let value = eval(car(&cdr(&rest)), env, Val::Nil, 0);
                        switch (&var) {
                            case Sym(vname): { env_set(env, vname, value); }
                            case Nil: { }
                            case Int(n): { }
                            case Cons(a, b): { }
                            case Closure(p, b2, e2): { }
                        }
                        return value;
                    }
                    if (name == "lambda") {
                        // Store the parameter list and the *whole* body (all
                        // forms after the parameters); the body is evaluated
                        // in sequence and the last value is the result.
                        return Val::Closure(heap(car(&rest)),
                                            heap(cdr(&rest)),
                                            *env);
                    }
                    if (is_builtin(name)) {
                        return builtin(name, eval(rest, env, Val::Nil, 2));
                    }
                    // A user call: look the name up, evaluate the arguments,
                    // and apply the resulting callable.
                    let callee = env_lookup(env, name);
                    return eval(callee, env, eval(rest, env, Val::Nil, 2), 1);
                }
                case Nil: { return Val::Nil; }
                case Int(n): { return Val::Nil; }
                case Closure(p, b, e): {
                    // ((lambda ...) args ...) — the head is already a value.
                    return eval(head, env, eval(rest, env, Val::Nil, 2), 1);
                }
                case Cons(a, b): {
                    // The head is itself a form; evaluate it, then the args.
                    let callee = eval(head, env, Val::Nil, 0);
                    return eval(callee, env, eval(rest, env, Val::Nil, 2), 1);
                }
            }
            return Val::Nil;
        }
    }
    return Val::Nil;
}

// Evaluate each top-level form in order, returning the last value. `define`s
// accumulate in the shared top-level frame.
fn eval_program(forms: Val, env: &Env) -> Val {
    let mut last = Val::Nil;
    let mut cur = forms;
    while (!is_nil(&cur)) {
        last = eval(car(&cur), env, Val::Nil, 0);
        cur = cdr(&cur);
    }
    return last;
}
