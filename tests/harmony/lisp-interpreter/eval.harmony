// The evaluator: a classic environment-passing `eval`, written as ONE
// self-recursive function.
//
// harmony-base resolves names from earlier text only (no forward declarations),
// so `eval` and `apply` cannot be two mutually recursive functions. They are
// fused here: `mode` selects "evaluate a form" (0), "apply a callable to an
// already-evaluated argument list" (1), or "evaluate a list of argument forms"
// (2). Every walk that needs to re-enter the evaluator (argument lists,
// function bodies, parameter binding) is a loop inside this function calling
// it recursively.
//
// `define` and `set!` mutate the innermost frame in place (the frame lives
// behind a `Heap`, so closures that captured it observe the change). That is
// what lets a `define`d lambda call itself.
//
// The values and the environment come from `value.harmony` (§6.7), so they are
// spelled `value::Val`, `value::is_nil`, and so on.

import "value.harmony";

// --- primitives ------------------------------------------------------------

// The LISP truth value: the symbol `t` for true, `Nil` for false.
fn bool_val(b: bool) -> value::Val {
    if (b) { return value::Val::Sym("t"); }
    return value::Val::Nil;
}

// Fold the numeric `args` into `acc` left to right. `op` is 0 plus, 1 times,
// 2 subtract, 3 divide. `-` and `/` pass the first argument as `acc` and fold
// the rest; `+` seeds at 0 and `*` at 1.
fn fold_arith(op: i32, args: value::Val, acc: i32) -> value::Val {
    let mut total = acc;
    let mut cur = args;
    while (!value::is_nil(&cur)) {
        let n = value::as_int(&value::car(&cur));
        if (op == 0) { total = total + n; }
        else if (op == 1) { total = total * n; }
        else if (op == 2) { total = total - n; }
        else {
            if (n == 0) { return value::Val::Int(0); }   // tiny LISP: n/0 yields 0
            total = total / n;
        }
        cur = value::cdr(&cur);
    }
    return value::Val::Int(total);
}

// The primitive procedures, dispatched by name. None of them re-enters the
// evaluator, so they can be a plain function.
fn builtin(name: &str, args: value::Val) -> value::Val {
    let a0 = value::car(&args);
    let rest = value::cdr(&args);
    let a1 = value::car(&rest);
    // Variadic arithmetic: `(+ a b c ...)`, `(* ...)`, `(- a b c ...)` and
    // `(/ a b c ...)` fold over the argument list (LISP convention).
    //   +  : 0 + a + b + c ...
    //   *  : 1 * a * b * c ...
    //   -  : a - b - c ...          (- a) => -a
    //   /  : a / b / c ...          (/ a) => 1/a
    if (name == "+") { return fold_arith(0, args, 0); }
    if (name == "*") { return fold_arith(1, args, 1); }
    if (name == "-") {
        if (value::is_nil(&rest)) { return value::Val::Int(0 - value::as_int(&a0)); }
        return fold_arith(2, rest, value::as_int(&a0));
    }
    if (name == "/") {
        if (value::is_nil(&rest)) {
            if (value::as_int(&a0) == 0) { return value::Val::Int(0); }
            return value::Val::Int(1 / value::as_int(&a0));
        }
        return fold_arith(3, rest, value::as_int(&a0));
    }
    if (name == "=") { return bool_val(value::as_int(&a0) == value::as_int(&a1)); }
    if (name == "<") { return bool_val(value::as_int(&a0) < value::as_int(&a1)); }
    if (name == ">") { return bool_val(value::as_int(&a0) > value::as_int(&a1)); }
    if (name == "<=") { return bool_val(value::as_int(&a0) <= value::as_int(&a1)); }
    if (name == ">=") { return bool_val(value::as_int(&a0) >= value::as_int(&a1)); }
    if (name == "%") {
        let d = value::as_int(&a1);
        if (d == 0) { return value::Val::Int(0); }
        return value::Val::Int(value::as_int(&a0) % d);
    }
    if (name == "&") { return value::Val::Int(value::as_int(&a0) & value::as_int(&a1)); }
    if (name == "|") { return value::Val::Int(value::as_int(&a0) | value::as_int(&a1)); }
    if (name == "^") { return value::Val::Int(value::as_int(&a0) ^ value::as_int(&a1)); }
    if (name == "cons") { return value::cons(a0, a1); }
    if (name == "car") { return value::car(&a0); }
    if (name == "cdr") { return value::cdr(&a0); }
    if (name == "list") { return args; }
    if (name == "nil?") { return bool_val(value::is_nil(&a0)); }
    if (name == "not") { return bool_val(value::is_nil(&a0)); }
    return value::Val::Nil;
}

// True when `name` is one of the primitive procedures (so a call whose head is
// this symbol applies the builtin directly instead of looking it up).
fn is_builtin(name: &str) -> bool {
    return name == "+" || name == "-" || name == "*" || name == "/"
        || name == "%" || name == "&" || name == "|" || name == "^"
        || name == "=" || name == "<" || name == ">" || name == "<=" || name == ">="
        || name == "cons" || name == "car" || name == "cdr" || name == "list"
        || name == "nil?" || name == "not";
}

// --- the fused eval/apply --------------------------------------------------

// mode 0: evaluate `form` in `env` ( `args` is ignored, pass `Val::Nil` ).
// mode 1: apply the callable `form` to the evaluated argument list `args`
//         ( `env` is ignored, pass any environment ).
// mode 2: evaluate each form in the list `form` in `env`, returning the values
//         as a list (used for call arguments).
export fn eval(form: value::Val, env: &value::Env, args: value::Val, mode: i32) -> value::Val {
    if (mode == 2) {
        let mut rev = value::Val::Nil;
        let mut cur = form;
        while (!value::is_nil(&cur)) {
            rev = value::cons(eval(value::car(&cur), env, value::Val::Nil, 0), rev);
            cur = value::cdr(&cur);
        }
        return value::reverse(rev);
    }
    if (mode == 1) {
        switch (&form) {
            case Sym(name): { return builtin(name, args); }
            case Closure(params, body, cenv): {
                // A child frame of the closure's captured environment, with
                // the parameters bound to the evaluated arguments.
                let mut frame = value::env_child(cenv);
                let mut p = *params;
                let mut a = args;
                while (!value::is_nil(&p) && !value::is_nil(&a)) {
                    let pv = value::car(&p);
                    let av = value::car(&a);
                    switch (&pv) {
                        case Sym(pname): { value::env_define(&frame, pname, av); }
                        case Nil: { }
                        case Int(n): { }
                        case Cons(h, t): { }
                        case Closure(x, y, z): { }
                    }
                    p = value::cdr(&p);
                    a = value::cdr(&a);
                }
                // Evaluate the body forms in sequence; the last wins. (This
                // inlines `eval_program`, which cannot be called here because
                // harmony-base has no forward declarations.)
                let mut last = value::Val::Nil;
                let mut body_cur = *body;
                while (!value::is_nil(&body_cur)) {
                    last = eval(value::car(&body_cur), &frame, value::Val::Nil, 0);
                    body_cur = value::cdr(&body_cur);
                }
                return last;
            }
            case Nil: { return value::Val::Nil; }
            case Int(n): { return value::Val::Nil; }
            case Cons(h, t): { return value::Val::Nil; }
        }
        return value::Val::Nil;
    }

    switch (&form) {
        case Int(n): { return form; }
        case Nil: { return value::Val::Nil; }
        case Sym(s): { return value::env_lookup(env, s); }
        case Closure(p, b, e): { return form; }
        case Cons(h, t): {
            let head = value::car(&form);
            let rest = value::cdr(&form);
            // Special forms are dispatched on the head symbol.
            switch (&head) {
                case Sym(name): {
                    if (name == "quote") { return value::car(&rest); }
                    if (name == "if") {
                        let cond = eval(value::car(&rest), env, value::Val::Nil, 0);
                        if (!value::is_nil(&cond)) {
                            return eval(value::car(&value::cdr(&rest)), env, value::Val::Nil, 0);
                        }
                        return eval(value::car(&value::cdr(&value::cdr(&rest))), env, value::Val::Nil, 0);
                    }
                    if (name == "define") {
                        let var = value::car(&rest);
                        let inner = eval(value::car(&value::cdr(&rest)), env, value::Val::Nil, 0);
                        switch (&var) {
                            case Sym(vname): { value::env_define(env, vname, inner); }
                            case Nil: { }
                            case Int(n): { }
                            case Cons(a, b): { }
                            case Closure(p, b2, e2): { }
                        }
                        return inner;
                    }
                    if (name == "set!") {
                        let var = value::car(&rest);
                        let inner = eval(value::car(&value::cdr(&rest)), env, value::Val::Nil, 0);
                        switch (&var) {
                            case Sym(vname): { value::env_set(env, vname, inner); }
                            case Nil: { }
                            case Int(n): { }
                            case Cons(a, b): { }
                            case Closure(p, b2, e2): { }
                        }
                        return inner;
                    }
                    if (name == "lambda") {
                        // Store the parameter list and the *whole* body (all
                        // forms after the parameters); the body is evaluated
                        // in sequence and the last value is the result.
                        return value::Val::Closure(heap(value::car(&rest)),
                                                   heap(value::cdr(&rest)),
                                                   *env);
                    }
                    if (is_builtin(name)) {
                        return builtin(name, eval(rest, env, value::Val::Nil, 2));
                    }
                    // A user call: look the name up, evaluate the arguments,
                    // and apply the resulting callable.
                    let callee = value::env_lookup(env, name);
                    return eval(callee, env, eval(rest, env, value::Val::Nil, 2), 1);
                }
                case Nil: { return value::Val::Nil; }
                case Int(n): { return value::Val::Nil; }
                case Closure(p, b, e): {
                    // ((lambda ...) args ...) — the head is already a value.
                    return eval(head, env, eval(rest, env, value::Val::Nil, 2), 1);
                }
                case Cons(a, b): {
                    // The head is itself a form; evaluate it, then the args.
                    let callee = eval(head, env, value::Val::Nil, 0);
                    return eval(callee, env, eval(rest, env, value::Val::Nil, 2), 1);
                }
            }
            return value::Val::Nil;
        }
    }
    return value::Val::Nil;
}

// Evaluate each top-level form in order, returning the last value. `define`s
// accumulate in the shared top-level frame.
export fn eval_program(forms: value::Val, env: &value::Env) -> value::Val {
    let mut last = value::Val::Nil;
    let mut cur = forms;
    while (!value::is_nil(&cur)) {
        last = eval(value::car(&cur), env, value::Val::Nil, 0);
        cur = value::cdr(&cur);
    }
    return last;
}
