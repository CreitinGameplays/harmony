// Driver: read a LISP program from a source literal, evaluate it, and print
// the result.
//
// This is the standalone entry point for the interpreter, split across modules
// with `import` (docs/harmony.md §6.7):
//
//     value.harmony   values, the frame-chain environment, list helpers
//     reader.harmony  S-expressions from a `&str`          (imports value)
//     eval.harmony    the fused eval/apply and the builtins (imports value)
//     main.harmony    this driver                           (imports all three)
//
// `make lisp` runs it directly; `tests/harmony/lisp.sh` compiles each case
// against the same imported modules with its own `main`.
//
// The program is a compile-time string literal rather than stdin: harmony-base
// has no `read_line`/`String`, and the raw syscall FFI cannot yet pass a stack
// pointer as an integer. Keeping the program in the source keeps the test
// deterministic; the reader, evaluator, and environment are exactly the code a
// REPL would use.

import "value.harmony";
import "reader.harmony";
import "eval.harmony";

fn run_lisp(src: &str) -> i32 {
    let env = value::env_new();
    let forms = reader::read_all(src);
    return value::as_int(&eval::eval_program(forms, &env));
}

fn main() -> i32 {
    // (define fact (lambda (n) (if (< n 2) 1 (* n (fact (- n 1)))))) (fact 5)
    // => 120.
    let result = run_lisp(
        "(define fact (lambda (n) (if (< n 2) 1 (* n (fact (- n 1)))))) (fact 5)"
    );
    println("(fact 5) = {}", result);
    return 0;
}
