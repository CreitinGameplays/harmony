// A small LISP interpreter written in Harmony (harmony-base).
//
// This is a robustness probe for the bootstrap compiler: it uses the parts of
// the language that are already there — recursive `Heap<T>` enums, pattern
// `switch`, `&str` byte access and byte-range slicing, `&mut` receivers,
// generic-free functions, and integer ops — and nothing that is not (no
// `String`, no `Vec`, no traits). The interpreter is deliberately tiny:
//
//   values   -> Nil, Int, Sym, Cons, Closure
//   reader   -> S-expressions from a `&str` (quote sugar, nested lists)
//   eval     -> the classic env/closure loop, with a small builtin prelude
//
// The environment is a chain of *mutable* frames (`Env`/`Frame`), each a small
// association list. A frame is held behind a `Heap`, so a closure that
// captures the frame sees later `define`s in it — that is what makes recursive
// `define` work without any top-level mutable state (harmony-base has none).

// ---------------------------------------------------------------------------
// Values.
// ---------------------------------------------------------------------------
enum Val {
    Nil,
    Int(i32),
    Sym(&str),
    Cons(Heap<Val>, Heap<Val>),
    Closure(Heap<Val>, Heap<Val>, Env),  // params, body, captured environment
}

// ---------------------------------------------------------------------------
// Environment: a chain of mutable frames. Each frame binds names to values in
// a small association list; lookup walks the chain from the innermost frame.
// `Env::Empty` ends the chain.
// ---------------------------------------------------------------------------
enum Env {
    Empty,
    Frame(Heap<Frame>),
}

struct Frame {
    binds: Val;    // an alist of (name . value) pairs, most recent first
    parent: Env;
}

// ---------------------------------------------------------------------------
// Core list and value helpers.
// ---------------------------------------------------------------------------
fn cons(a: Val, b: Val) -> Val {
    return Val::Cons(heap(a), heap(b));
}

fn car(v: &Val) -> Val {
    switch (v) {
        case Cons(h, t): { return *h; }
        case Nil:        { return Val::Nil; }
        case Int(n):     { return Val::Nil; }
        case Sym(s):     { return Val::Nil; }
        case Closure(p, b, e): { return Val::Nil; }
    }
    return Val::Nil;
}

fn cdr(v: &Val) -> Val {
    switch (v) {
        case Cons(h, t): { return *t; }
        case Nil:        { return Val::Nil; }
        case Int(n):     { return Val::Nil; }
        case Sym(s):     { return Val::Nil; }
        case Closure(p, b, e): { return Val::Nil; }
    }
    return Val::Nil;
}

fn is_nil(v: &Val) -> bool {
    switch (v) {
        case Nil: { return true; }
        case Int(n): { return false; }
        case Sym(s): { return false; }
        case Cons(h, t): { return false; }
        case Closure(p, b, e): { return false; }
    }
    return false;
}

fn as_int(v: &Val) -> i32 {
    switch (v) {
        case Int(n): { return n; }
        case Nil:    { return 0; }
        case Sym(s): { return 0; }
        case Cons(h, t): { return 0; }
        case Closure(p, b, e): { return 0; }
    }
    return 0;
}

// True when `v` is the symbol `name`.
fn is_sym(v: &Val, name: &str) -> bool {
    switch (v) {
        case Sym(s): { return s == name; }
        case Nil:    { return false; }
        case Int(n): { return false; }
        case Cons(h, t): { return false; }
        case Closure(p, b, e): { return false; }
    }
    return false;
}

// A list of values built from a slice of `Val` (used by the argument
// evaluator); `n` elements from `items`, ending in `tail`.
fn list_of(items: &[Val], n: i32, tail: Val) -> Val {
    let mut i: i32 = n - 1;
    let mut acc = tail;
    while (i >= 0) {
        acc = cons(items[i as usize], acc);
        i -= 1;
    }
    return acc;
}

// Reverse a proper list, building a fresh spine.
fn reverse(v: Val) -> Val {
    let mut out = Val::Nil;
    let mut cur = v;
    while (!is_nil(&cur)) {
        out = cons(car(&cur), out);
        cur = cdr(&cur);
    }
    return out;
}

// ---------------------------------------------------------------------------
// Environment operations.
// ---------------------------------------------------------------------------

// A fresh empty top-level frame (its parent is `Empty`).
fn env_new() -> Env {
    return Env::Frame(heap(Frame { .binds = Val::Nil, .parent = Env::Empty }));
}

// A fresh child frame that closes over `parent`.
fn env_child(parent: Env) -> Env {
    return Env::Frame(heap(Frame { .binds = Val::Nil, .parent = parent }));
}

// Prepend the binding (name . value) to the frame `cell`. The frame struct is
// replaced through the box (the box identity, and so the frame's identity to
// any closure that captured it, is preserved).
fn frame_define(cell: Heap<Frame>, key: Val, value: Val) {
    *cell = Frame { .binds = cons(cons(key, value), cell.binds), .parent = cell.parent };
}

// Bind `name` to `value` in the innermost frame of `env`.
fn env_define(env: &Env, name: &str, value: Val) {
    switch (env) {
        case Frame(c): { frame_define(c, Val::Sym(name), value); }
        case Empty:    { }
    }
}

// Replace the value of `name` inside the association list `binds`, in place.
// Returns true when the binding was found. The pair's value cell is a
// `Heap<Val>`, so writing through it updates every share of the spine.
fn alist_set(binds: Val, name: &str, value: Val) -> bool {
    let mut cur = binds;
    while (!is_nil(&cur)) {
        switch (&cur) {
            case Cons(h, t): {
                switch (h) {
                    case Cons(k, v): {
                        if (is_sym(&*k, name)) { *v = value; return true; }
                    }
                    case Nil: { }
                    case Int(n): { }
                    case Sym(s): { }
                    case Closure(p, b, e): { }
                }
                cur = *t;
            }
            case Nil: { return false; }
            case Int(n): { return false; }
            case Sym(s): { return false; }
            case Closure(p, b, e): { return false; }
        }
    }
    return false;
}

// Assign `name` in the nearest frame that already binds it (so a closure can
// mutate a captured variable); if it is unbound anywhere, define it in the
// innermost frame, as `define` would.
fn env_set(env: &Env, name: &str, value: Val) {
    let mut e = *env;
    while (true) {
        switch (&e) {
            case Frame(c): {
                if (alist_set(c.binds, name, value)) { return; }
                e = c.parent;
            }
            case Empty: {
                env_define(env, name, value);
                return;
            }
        }
    }
}

// Look up `name`, walking the frame chain; `Nil` when unbound.
fn env_lookup(env: &Env, name: &str) -> Val {
    let mut e = *env;
    while (true) {
        switch (&e) {
            case Frame(c): {
                let mut cur = c.binds;
                while (!is_nil(&cur)) {
                    let pair = car(&cur);
                    if (is_sym(&car(&pair), name)) {
                        return cdr(&pair);
                    }
                    cur = cdr(&cur);
                }
                e = c.parent;
            }
            case Empty: { return Val::Nil; }
        }
    }
    return Val::Nil;
}
